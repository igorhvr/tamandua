{
  "name": "M6-hermes-TUI-modelturn",
  "argv": [
    "{{MTLK_TAMANDUA_ARGV0}}",
    "matchlock",
    "hermes",
    "--working-directory-for-harness",
    "{{MTLK_WORKDIR}}",
    "--matchlock-allow-private",
    "{{MTLK_ALLOW_PRIVATE}}"
  ],
  "cwd": "{{MTLK_CWD}}",
  "term": "xterm-256color",
  "rows": 24,
  "cols": 80,
  "timeout_s": 2100,
  "grace_s": 120,
  "any_exit": true,
  "forbid": [
    "panicked",
    "Unhandled [Ee]rror"
  ],
  "events": [
    {
      "wait_for": "matchlock: interactive hermes session",
      "timeout_s": 90
    },
    {
      "wait_for": "matchlock: igorhvr/tamandua( \\(standard image\\))? cpus=\\d+ memory=\\d+MB disk=\\d+MB swap=8192MB",
      "regex": true,
      "timeout_s": 90
    },
    {
      "wait_for": "image provenance: standard",
      "timeout_s": 90
    },
    {
      "wait_for": "image identity: tag=igorhvr/tamandua digest={{MTLK_EXPECT_DIGEST}} config=sha256:[0-9a-f]{64}",
      "regex": true,
      "timeout_s": 90
    },
    {
      "wait_for": "guest identity: uid={{MTLK_UID}} gid={{MTLK_GID}}",
      "timeout_s": 90
    },
    {
      "wait_for": "Help improve Hermes\\?",
      "regex": true,
      "timeout_s": 240,
      "required": true
    },
    {
      "sleep": 1
    },
    {
      "send": "\r"
    },
    {
      "sleep": 2
    },
    {
      "wait_for": "Shared metrics off",
      "timeout_s": 90,
      "required": true
    },
    {
      "wait_for": "❯",
      "timeout_s": 420
    },
    {
      "sleep": 2
    },
    {
      "send": "What is 111 + 222? Reply with exactly ZX- followed by your answer. Nothing else."
    },
    {
      "sleep": 2.5
    },
    {
      "send": "\r"
    },
    {
      "wait_for": "ZX\\s*-\\s*333",
      "regex": true,
      "timeout_s": 600
    },
    {
      "sleep": 2
    },
    {
      "send_ctrl": "C"
    },
    {
      "sleep": 2
    },
    {
      "send_ctrl": "C",
      "optional": true
    },
    {
      "sleep": 2
    },
    {
      "send_ctrl": "D",
      "optional": true
    },
    {
      "sleep": 3
    }
  ]
}
