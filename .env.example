# Tamandua environment variables
# Copy this file to .env and adjust as needed

# Optional: Custom binary paths
# TAMANDUA_PI_BINARY=/path/to/pi
# TAMANDUA_HERMES_BINARY=/path/to/hermes

# Optional: Override default ports
# TAMANDUA_DASHBOARD_PORT=3334
# TAMANDUA_MCP_PORT=3338

# Optional: Bind host for servers (default: 127.0.0.1)
# TAMANDUA_BIND_HOST=127.0.0.1

# Optional: Disable test caching shim
# TAMANDUA_TSTX=0

# Debugging
# TAMANDUA_DEBUG=1
# TAMANDUA_DEBUG_EVENTS=1
