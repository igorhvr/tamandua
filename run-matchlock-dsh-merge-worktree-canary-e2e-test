#!/usr/bin/env bash
# Run the MTLK-ALL-WORKFLOWS US-010 REAL-MODEL dsh canary for the genuine
# bundled `feature-dev-merge-worktree` workflow under the Matchlock dsh route:
#
#   isolated daemon -> scheduler -> dsh Matchlock invocation runner -> fresh VMs
#   -> real workflow completion, a REAL final squash landing on the tiny OWNED
#   origin, positive per-round dsh v3-store token attribution, and exact-owned
#   VM teardown with retained evidence.
#
# This tier makes REAL model calls (REAL TOKENS) through the operator's own dsh
# credential home and boots REAL Firecracker VMs with the real operator image
# `igorhvr/bedlam-ubuntu`. It is deliberately NOT part of the default fast lanes
# (npm test / run-all-smoke / run-all-scripted / run-all-e2e-tests). Run it on
# demand UNDER THE SHARED GATE LOCK:
#
#   flock --exclusive /home/kaladin/matchlock-work/vaivm-gate.lock \
#     ./run-matchlock-dsh-merge-worktree-canary-e2e-test
#
# The runner does NOT take the lock itself (the caller holds it; a nested flock
# on the same file would deadlock).
#
# Runtime resolution: this host (vaimetal) runs the SYSTEM matchlock pair (no
# hash pins; see /home/kaladin/matchlock-work/matchlock-runtime.env). The pair
# is resolved from TAMANDUA_MATCHLOCK_RPC_BIN / MATCHLOCK_GUEST_INIT /
# MATCHLOCK_GUEST_FUSED when set, else from TAMANDUA_MATCHLOCK_RUNTIME_DIR, else
# from PATH. The observed matchlock --version + sha256 hashes are recorded as
# gate evidence instead of being checked against runtime pins (MTLK-UNPIN,
# tamandua-6sy.33.10.36).
#
# What it does:
#   1. resolves + records the observed runtime binaries (no pins)
#   2. npm run build (compiled dist is what the isolated daemon runs)
#   3. allocates a NEW evidence directory with mkdtemp under
#      ${TAMANDUA_GATE_EVIDENCE_ROOT:-/home/kaladin/matchlock-work/evidence}
#      (outside the repo; NEVER pre-cleaned/reused) plus a private fresh TMPDIR
#      inside it
#   4. sources the REAL operator image store (TAMANDUA_GATE_OPERATOR_CACHE,
#      default $HOME/.cache/matchlock) and the operator's real dsh credential
#      home (TAMANDUA_GATE_REAL_DSH_HOME, default $HOME/.dsh). Credentials are
#      never printed.
#   5. runs e2e-tests/matchlock-dsh-merge-worktree-canary.test.ts with all logs
#      tee'd into the evidence dir; exit code propagates (cleanup failures
#      included).
#
# Never touches the live worker daemon, live tamandua state, the operator's
# matchlock store, or any live branch: the canary uses a private fresh HOME and
# a tiny OWNED origin repository under the evidence dir.
set -u

cd "$(dirname "$0")"

# -- UNPINNED runtime resolution (MTLK-UNPIN, tamandua-6sy.33.10.36) ----------
# No runtime sha256 pins: default to whatever `matchlock` resolves on PATH
# (system /usr/local/bin/matchlock on vaimetal) and let matchlock resolve its
# own guest-init. TAMANDUA_MATCHLOCK_RPC_BIN / MATCHLOCK_GUEST_INIT /
# MATCHLOCK_GUEST_FUSED are OPTIONAL overrides; TAMANDUA_MATCHLOCK_RUNTIME_DIR
# remains the fallback location for the pair. The observed version and hashes
# are recorded as gate evidence instead of being checked against pins.
fail() { echo "run-matchlock-dsh-merge-worktree-canary-e2e-test: FATAL: $*" >&2; exit 90; }

if [ -n "${TAMANDUA_MATCHLOCK_RUNTIME_DIR:-}" ]; then
  RUNTIME_DIR="$TAMANDUA_MATCHLOCK_RUNTIME_DIR"
else
  RUNTIME_DIR=""
fi
MATCHLOCK_RPC_BIN="${TAMANDUA_MATCHLOCK_RPC_BIN:-${RUNTIME_DIR:+$RUNTIME_DIR/matchlock}}"
MATCHLOCK_RPC_BIN="${MATCHLOCK_RPC_BIN:-$(command -v matchlock 2>/dev/null || true)}"
GUEST_INIT="${MATCHLOCK_GUEST_INIT:-${RUNTIME_DIR:+$RUNTIME_DIR/guest-init}}"
GUEST_INIT="${GUEST_INIT:-$(command -v guest-init 2>/dev/null || true)}"
GUEST_FUSED="${MATCHLOCK_GUEST_FUSED:-$GUEST_INIT}"

[ -n "$MATCHLOCK_RPC_BIN" ] || fail "matchlock not found on PATH; set TAMANDUA_MATCHLOCK_RPC_BIN to the matchlock CLI"
[ -f "$MATCHLOCK_RPC_BIN" ] || fail "matchlock binary not found: $MATCHLOCK_RPC_BIN"
[ -x "$MATCHLOCK_RPC_BIN" ] || fail "matchlock binary not executable: $MATCHLOCK_RPC_BIN"
if [ -n "$GUEST_INIT" ]; then
  [ -f "$GUEST_INIT" ] || fail "guest-init not found: $GUEST_INIT (unset MATCHLOCK_GUEST_INIT to let matchlock resolve it)"
fi
if [ -n "$GUEST_FUSED" ]; then
  [ -f "$GUEST_FUSED" ] || fail "guest-fused not found: $GUEST_FUSED (unset MATCHLOCK_GUEST_FUSED to let matchlock resolve it)"
fi

# Observed (NOT pinned) runtime identity: recorded into the gate evidence dir.
OBSERVED_MATCHLOCK_VERSION="$("$MATCHLOCK_RPC_BIN" --version 2>&1 | head -n 1 || true)"
OBSERVED_MATCHLOCK_SHA="$(sha256sum "$MATCHLOCK_RPC_BIN" | awk '{print $1}')"
if [ -n "$GUEST_INIT" ]; then
  OBSERVED_GUEST_INIT_SHA="$(sha256sum "$GUEST_INIT" | awk '{print $1}')"
else
  OBSERVED_GUEST_INIT_SHA="unset => resolved by matchlock"
fi
if [ -n "$GUEST_FUSED" ]; then
  OBSERVED_GUEST_FUSED_SHA="$(sha256sum "$GUEST_FUSED" | awk '{print $1}')"
else
  OBSERVED_GUEST_FUSED_SHA="unset => resolved by matchlock"
fi
echo "runtime observed (unpinned): matchlock ${OBSERVED_MATCHLOCK_VERSION:-no-version} sha256 $OBSERVED_MATCHLOCK_SHA"
echo "runtime observed (unpinned): guest-init ${GUEST_INIT:-resolved-by-matchlock} sha256 $OBSERVED_GUEST_INIT_SHA"
echo "runtime observed (unpinned): guest-fused ${GUEST_FUSED:-resolved-by-matchlock} sha256 $OBSERVED_GUEST_FUSED_SHA"

# The REAL qualified `igorhvr/bedlam-ubuntu` image (dsh 0.1.5-rc.2) lives ONLY
# in the operator matchlock store; the plain docker tag is a different,
# tool-less image. The operator's real dsh home carries the credentials the
# canary stages into a fresh gate-owned DSH_HOME. Neither is printed.
OPERATOR_CACHE="${TAMANDUA_GATE_OPERATOR_CACHE:-$HOME/.cache/matchlock}"
REAL_DSH_HOME="${TAMANDUA_GATE_REAL_DSH_HOME:-$HOME/.dsh}"
[ -f "$OPERATOR_CACHE/images/metadata.db" ] \
  || fail "operator matchlock image store missing at $OPERATOR_CACHE/images/metadata.db"
[ -f "$REAL_DSH_HOME/.credentials.yaml" ] \
  || fail "operator dsh credentials missing at $REAL_DSH_HOME/.credentials.yaml"

export TAMANDUA_GATE_OPERATOR_CACHE="$OPERATOR_CACHE"
export TAMANDUA_GATE_FIXTURE_IMAGE_CACHE="$OPERATOR_CACHE"
export TAMANDUA_GATE_REAL_DSH_HOME="$REAL_DSH_HOME"

npm run build || fail "npm run build failed"

EVIDENCE_ROOT="${TAMANDUA_GATE_EVIDENCE_ROOT:-/home/kaladin/matchlock-work/evidence}"
mkdir -p "$EVIDENCE_ROOT"
EV="$(mktemp -d "$EVIDENCE_ROOT/dsh-merge-worktree-canary-XXXXXX")" || fail "mktemp -d under $EVIDENCE_ROOT failed"
echo "evidence dir: $EV"

export TAMANDUA_MATCHLOCK_RPC_BIN="$MATCHLOCK_RPC_BIN"
if [ -n "$GUEST_INIT" ]; then export MATCHLOCK_GUEST_INIT="$GUEST_INIT"; fi
if [ -n "$GUEST_FUSED" ]; then export MATCHLOCK_GUEST_FUSED="$GUEST_FUSED"; fi
export TAMANDUA_GATE_EVIDENCE_DIR="$EV"
export TAMANDUA_GATE_EVIDENCE_ROOT="$EVIDENCE_ROOT"

# Observed-not-pinned runtime evidence (MTLK-UNPIN): the gate accepts whatever
# `matchlock` resolves and records the observed version/hashes here.
RUNTIME_OBSERVED="$EV/runtime-observed.txt"
{
  echo "matchlock.path=$MATCHLOCK_RPC_BIN"
  echo "matchlock.version=${OBSERVED_MATCHLOCK_VERSION:-no-version}"
  echo "matchlock.sha256=$OBSERVED_MATCHLOCK_SHA"
  echo "guest_init.path=${GUEST_INIT:-unset => resolved by matchlock}"
  echo "guest_init.sha256=$OBSERVED_GUEST_INIT_SHA"
  echo "guest_fused.path=${GUEST_FUSED:-unset => resolved by matchlock}"
  echo "guest_fused.sha256=$OBSERVED_GUEST_FUSED_SHA"
} > "$RUNTIME_OBSERVED"
echo "runtime evidence: $RUNTIME_OBSERVED"
cat "$RUNTIME_OBSERVED"

# Private fresh TMPDIR inside the evidence dir (guest-pack builds and any canary
# scratch stay under owned evidence).
export TMPDIR="$EV/tmp"
mkdir -p "$TMPDIR"

LOG="$EV/canary-run.log"
CANARY_CMD="node --test e2e-tests/matchlock-dsh-merge-worktree-canary.test.ts"
echo "=== MATCHLOCK DSH MERGE-WORKTREE REAL CANARY START $(date -u +%FT%TZ) EV=$EV ===" | tee "$LOG"
echo "runtime:            $MATCHLOCK_RPC_BIN" | tee -a "$LOG"
echo "operator image:     $OPERATOR_CACHE" | tee -a "$LOG"
echo "operator dsh home:  $REAL_DSH_HOME (credentials copied, never printed)" | tee -a "$LOG"
echo "canary command:     $CANARY_CMD" | tee -a "$LOG"
$CANARY_CMD 2>&1 | tee -a "$LOG"
RC=${PIPESTATUS[0]}
echo "=== MATCHLOCK DSH MERGE-WORKTREE REAL CANARY END $(date -u +%FT%TZ) rc=$RC ===" | tee -a "$LOG"
exit "$RC"
