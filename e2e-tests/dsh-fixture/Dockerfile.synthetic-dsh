# MTLK-DSH-EXEC US-003 — EXPLICITLY TEST-ONLY synthetic-dsh fixture image.
#
# A DERIVED fixture image used ONLY by the on-demand whole-path synthetic dsh
# gate (run-matchlock-dsh-gate-e2e-test / e2e-tests/matchlock-dsh-gate.test.ts).
#
# It derives from a stock node LTS image (node:22-bookworm-slim — the SAME
# base the accepted pi whole-path gate fixture uses) and ADDS a deterministic
# synthetic `dsh` at /usr/local/bin/dsh (e2e-tests/dsh-fixture/fake-dsh.mjs)
# plus git (committed-tree/tracked-tree hashing for the suite ledger). The
# guest runtime contract the RO helper pack needs (node >= 22, /bin/sh, core
# utils, git) is therefore satisfied. NOTE: the synthetic image does NOT need
# to be the 4.95 GB igorhvr/bedlam-ubuntu qualification base to exercise the
# whole dsh opt-in path; that base is a preference, and the operator image
# remains igorhvr/bedlam-ubuntu, which is NEVER overwritten, retagged or
# mutated by this gate.
#
# It contains NO provider credentials and performs NO model calls. The fake
# dsh lives IN THE IMAGE (never mounted from the host) and no real user
# harness is ever replaced or auto-installed. The image PATH stays the node
# base default so the guest `dsh` resolves on PATH with only the helper-pack
# prepend.

FROM node:22-bookworm-slim

LABEL org.tamandua.synthetic-dsh="TEST-ONLY"

# git (committed/tracked-tree hashing for the suite ledger) + ca-certificates
# keeps git usable offline-free. No build toolchain is installed.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Deterministic test-only synthetic dsh harness (see fake-dsh.mjs).
COPY fake-dsh.mjs /usr/local/bin/dsh
RUN chmod 0755 /usr/local/bin/dsh

# Root runs the guest pack launchers; default shell is /bin/sh via node base.
WORKDIR /root
CMD ["/bin/sh"]
