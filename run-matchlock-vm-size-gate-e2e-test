#!/usr/bin/env bash
# Run the MTLK-VM-SIZE US-006 focused ONE-VM resource-limits gate.
#
# It boots exactly ONE fresh real Matchlock VM through the PRODUCTION
# MatchlockController `resolveAndAdmitIdentity -> prepareAndCreate ->
# execStream -> close` seam with a policy whose `resourceLimits` are
# {cpus:4, memoryMB:4096, diskSizeMB:20480}, then proves the resolved limits
# reach the VM:
#   - the create request resources are {cpus:4, memory_mb:4096, disk_size_mb:20480};
#   - guest `nproc` is exactly 4;
#   - guest `/proc/meminfo` MemTotal is within tolerance of 4096 MB;
#   - the single owned VM is positively closed and removed BY EXACT ID.
#
# This tier is a REAL-VM gate and is deliberately NOT part of the default fast
# lanes (npm test / run-all-smoke / run-all-scripted / run-all-e2e-tests). Run
# it on demand:
#
#   ./run-matchlock-vm-size-gate-e2e-test
#
# The runner itself takes the SHARED GATE LOCK
# (`flock --exclusive /home/kaladin/matchlock-work/vaivm-gate.lock`), so a
# concurrent real-VM gate cannot race the host. Override the lock path with
# TAMANDUA_GATE_LOCK.
#
# What it does:
#   1. resolves the system matchlock pair (env overrides, else
#      /usr/local/bin/matchlock + /usr/local/bin/guest-init)
#   2. npm run build (compiled dist is what the isolated gate runs)
#   3. creates a NEW mkdtemp evidence directory under the operator evidence
#      root (outside the repo; NEVER pre-cleaned/reused) with a private
#      TMPDIR/HOME, and exports TAMANDUA_GATE_EVIDENCE_DIR
#   4. seeds from the operator matchlock image store (read-only; the gate copies
#      it into its private HOME)
#   5. runs e2e-tests/matchlock-vm-size-gate.test.ts under the shared gate lock
#      with all logs tee'd into the evidence dir; the exit code propagates.
set -u

cd "$(dirname "$0")"

MATCHLOCK_RPC_BIN="${TAMANDUA_MATCHLOCK_RPC_BIN:-/usr/local/bin/matchlock}"
GUEST_INIT="${MATCHLOCK_GUEST_INIT:-/usr/local/bin/guest-init}"
GUEST_FUSED="${MATCHLOCK_GUEST_FUSED:-$GUEST_INIT}"

GATE_LOCK="${TAMANDUA_GATE_LOCK:-/home/kaladin/matchlock-work/vaivm-gate.lock}"
OPERATOR_CACHE="${TAMANDUA_GATE_OPERATOR_CACHE:-$HOME/.cache/matchlock}"

fail() { echo "run-matchlock-vm-size-gate-e2e-test: FATAL: $*" >&2; exit 90; }

for p in "$MATCHLOCK_RPC_BIN" "$GUEST_INIT" "$GUEST_FUSED"; do
  [ -x "$p" ] || fail "runtime binary missing or not executable: $p"
done

[ -f "$OPERATOR_CACHE/images/metadata.db" ] \
  || fail "operator matchlock image store missing at $OPERATOR_CACHE/images/metadata.db"
[ -d "$OPERATOR_CACHE/kernels" ] \
  || fail "operator matchlock kernel cache missing at $OPERATOR_CACHE/kernels"

echo "runtime: $MATCHLOCK_RPC_BIN"
"$MATCHLOCK_RPC_BIN" version 2>/dev/null | head -1 || true

npm run build || fail "npm run build failed"

EVIDENCE_ROOT="${TAMANDUA_GATE_EVIDENCE_ROOT:-/home/kaladin/matchlock-work/evidence}"
mkdir -p "$EVIDENCE_ROOT" || fail "cannot create evidence root $EVIDENCE_ROOT"
EV="$(mktemp -d "$EVIDENCE_ROOT/vm-size-XXXXXX")" || fail "mktemp -d under $EVIDENCE_ROOT failed"
echo "evidence dir: $EV"

export TAMANDUA_MATCHLOCK_RPC_BIN="$MATCHLOCK_RPC_BIN"
export MATCHLOCK_GUEST_INIT="$GUEST_INIT"
export MATCHLOCK_GUEST_FUSED="$GUEST_FUSED"
export TAMANDUA_GATE_EVIDENCE_DIR="$EV"
export TAMANDUA_GATE_EVIDENCE_ROOT="$EVIDENCE_ROOT"
export TAMANDUA_GATE_OPERATOR_CACHE="$OPERATOR_CACHE"
# Private fresh TMPDIR/HOME inside the owned evidence dir (guest-pack builds and
# any scratch stay under owned evidence; never the operator's real HOME).
export TMPDIR="$EV/tmp"
mkdir -p "$TMPDIR"
export HOME="$EV/home"
mkdir -p "$HOME"

LOG="$EV/gate-run.log"
{
  echo "=== MATCHLOCK VM-SIZE GATE START $(date -u +%FT%TZ) EV=$EV ==="
  echo "runtime: $MATCHLOCK_RPC_BIN"
  echo "operator image store: $OPERATOR_CACHE"
  echo "shared gate lock: $GATE_LOCK"
  echo "private HOME: $HOME"
} | tee "$LOG"

# The shared real-VM gate lock: a concurrent gate must never race this host.
# flock propagates the wrapped command's exit status, so PIPESTATUS[0] is the
# real test exit code.
flock --exclusive "$GATE_LOCK" \
  node --test --test-force-exit e2e-tests/matchlock-vm-size-gate.test.ts 2>&1 | tee -a "$LOG"
RC=${PIPESTATUS[0]}
echo "$RC" > "$EV/gate-exit-code.txt"
echo "=== MATCHLOCK VM-SIZE GATE END $(date -u +%FT%TZ) rc=$RC ===" | tee -a "$LOG"

# ── no-fake-green: refuse PASS when no in-VM round was observed ──────────
# The driver writes <EV>/observed-rounds.json (TESTER-HONESTY item 3). This
# guard reads it and exits 92 — distinct from a test failure (1) and this
# runner's FATAL (90) — when the count is zero or the evidence is
# missing/malformed. A gate whose VM creation fails (or whose probe never
# reached a round) must fail loudly, never report a vacuous round-rejection
# assertion as a green run.
GUARD_RC=0
node scripts/observed-rounds-guard.mjs --dir "$EV" --gate vm-size 2>&1 | tee -a "$LOG"
GUARD_RC=${PIPESTATUS[0]}
if [ "$GUARD_RC" -eq 92 ]; then
  echo "run-matchlock-vm-size-gate-e2e-test: ZERO-ROUND REFUSAL: no VM round observed (VM creation or probe failed before any round)" >&2
  exit 92
fi
exit "$RC"
