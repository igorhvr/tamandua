#!/usr/bin/env bash
# Run the MTLK-CLEANUP US-009 real-VM post-harness close/dispose CLEANUP gate.
#
# This tier is a REAL-VM gate: it boots one fresh Firecracker VM with the
# AUTHORIZED PAIRED runtime (matchlock CLI + guest-init) and the TEST-ONLY
# synthetic-pi derived fixture image, injects a close/dispose failure AFTER the
# synthetic harness exits, and proves the round is kept, the run continues, and
# the reaper disposes the stopped VM. It is deliberately NOT part of the default
# fast lanes (npm test / run-all-smoke / run-all-scripted / run-all-e2e-tests).
#
# It takes the shared VAIVM gate lock EXCLUSIVELY
# (flock --exclusive /home/kaladin/matchlock-work/vaivm-gate.lock) for the whole
# run, so it never races another real-VM gate on the host. The single VM is
# capped at <= 16 vCPUs (TAMANDUA_GATE_VCPUS, default 1).
#
# Run on demand:
#
#   ./run-matchlock-cleanup-e2e-test
#
# What it does:
#   1. re-execs itself under `flock --exclusive <gate lock>` (once)
#   2. validates the paired runtime binaries (TAMANDUA_MATCHLOCK_RPC_BIN =
#      matchlock CLI; MATCHLOCK_GUEST_INIT / MATCHLOCK_GUEST_FUSED = guest-init)
#   3. npm run build (compiled dist is what the gate imports)
#   4. allocates a NEW mkdtemp evidence directory under the evidence root
#      (outside the repo; NEVER pre-cleaned, NEVER reused) plus a private fresh
#      TMPDIR inside it
#   5. runs e2e-tests/matchlock-cleanup-gate.test.ts with all logs tee'd into the
#      evidence dir; exit code propagates (cleanup failures included).
#
# Never touches the live worker daemon, the live tamandua state, or the
# operator's matchlock store: the gate uses a private fresh HOME under the
# evidence dir.
set -u

cd "$(dirname "$0")"

LOCK_FILE="${TAMANDUA_GATE_LOCK:-/home/kaladin/matchlock-work/vaivm-gate.lock}"
if [ "${TAMANDUA_GATE_FLOCK_HELD:-}" != "1" ]; then
  command -v flock >/dev/null 2>&1 || {
    echo "run-matchlock-cleanup-e2e-test: FATAL: flock not found (required for the exclusive VM gate lock)" >&2
    exit 90
  }
  mkdir -p "$(dirname "$LOCK_FILE")" || exit 90
  export TAMANDUA_GATE_FLOCK_HELD=1
  # Re-exec under the exclusive lock; this process (and every child) holds it.
  exec flock --exclusive "$LOCK_FILE" "$0" "$@"
fi

MATCHLOCK_RPC_BIN="${TAMANDUA_MATCHLOCK_RPC_BIN:-$(command -v matchlock || true)}"
GUEST_INIT="${MATCHLOCK_GUEST_INIT:-$(command -v guest-init || true)}"
GUEST_FUSED="${MATCHLOCK_GUEST_FUSED:-$GUEST_INIT}"

fail() { echo "run-matchlock-cleanup-e2e-test: FATAL: $*" >&2; exit 90; }

for p in "$MATCHLOCK_RPC_BIN" "$GUEST_INIT" "$GUEST_FUSED"; do
  [ -x "$p" ] || fail "runtime binary missing or not executable: $p"
done

echo "runtime: $MATCHLOCK_RPC_BIN (guest-init $GUEST_INIT, guest-fused $GUEST_FUSED)"
echo "flock: $LOCK_FILE (exclusive)"

# <= 16 vCPUs for the single VM (default 1).
GATE_VCPUS="${TAMANDUA_GATE_VCPUS:-1}"
case "$GATE_VCPUS" in
  ''|*[!0-9]*) fail "TAMANDUA_GATE_VCPUS must be a positive integer (got '$GATE_VCPUS')" ;;
esac
[ "$GATE_VCPUS" -ge 1 ] && [ "$GATE_VCPUS" -le 16 ] \
  || fail "TAMANDUA_GATE_VCPUS must be between 1 and 16 (got $GATE_VCPUS)"
export TAMANDUA_GATE_VCPUS="$GATE_VCPUS"

npm run build || fail "npm run build failed"

EVIDENCE_ROOT="${TAMANDUA_GATE_EVIDENCE_ROOT:-/home/kaladin/matchlock-work/evidence}"
EV="$(mktemp -d "$EVIDENCE_ROOT/cleanup-XXXXXX")" || fail "mktemp -d under $EVIDENCE_ROOT failed"
echo "evidence dir: $EV"

export TAMANDUA_MATCHLOCK_RPC_BIN="$MATCHLOCK_RPC_BIN"
export MATCHLOCK_GUEST_INIT="$GUEST_INIT"
export MATCHLOCK_GUEST_FUSED="$GUEST_FUSED"
export TAMANDUA_GATE_EVIDENCE_DIR="$EV"
export TAMANDUA_GATE_EVIDENCE_ROOT="$EVIDENCE_ROOT"
# The private matchlock HOME resolves kernels/cache under HOME/.cache/matchlock;
# default the kernel source to the operator cache (never mutated).
export TAMANDUA_GATE_KERNEL_CACHE="${TAMANDUA_GATE_KERNEL_CACHE:-${HOME}/.cache/matchlock/kernels}"
# Private fresh TMPDIR inside the evidence dir (guest-pack builds and any
# /tmp-scratch the gate needs stay under the owned evidence).
export TMPDIR="$EV/tmp"
mkdir -p "$TMPDIR"

LOG="$EV/gate-run.log"
echo "=== MATCHLOCK CLEANUP GATE START $(date -u +%FT%TZ) EV=$EV vcpus=$GATE_VCPUS ===" | tee "$LOG"
node --test e2e-tests/matchlock-cleanup-gate.test.ts 2>&1 | tee -a "$LOG"
RC=${PIPESTATUS[0]}
echo "=== MATCHLOCK CLEANUP GATE END $(date -u +%FT%TZ) rc=$RC ===" | tee -a "$LOG"

# ── no-fake-green: refuse PASS when no in-VM round was observed ──────────
# The driver writes <EV>/observed-rounds.json (TESTER-HONESTY item 3). This
# guard reads it and exits 92 — distinct from a test failure (1) and this
# runner's FATAL (90) — when the count is zero or the evidence is
# missing/malformed. A gate whose VM creation fails (or whose probe never
# reached a round) must fail loudly, never report a vacuous round-rejection
# assertion as a green run.
GUARD_RC=0
node scripts/observed-rounds-guard.mjs --dir "$EV" --gate cleanup 2>&1 | tee -a "$LOG"
GUARD_RC=${PIPESTATUS[0]}
if [ "$GUARD_RC" -eq 92 ]; then
  echo "run-matchlock-cleanup-e2e-test: ZERO-ROUND REFUSAL: no VM round observed (VM creation or probe failed before any round)" >&2
  exit 92
fi
exit "$RC"
