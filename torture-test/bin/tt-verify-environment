registerCheck('login-shell-path', 'Harness binaries resolvable via login-shell PATH', 'REQUIRED', 'harness', async () => ({
  result: 'SKIPPED',
  evidence: 'Not yet implemented — requires zsh -lic / bash -lc probing',
  remedy: null,
  skipReason: 'not yet implemented',
}));

// ── Toolchain build+test probes (US-007) ─────────────────────────────
// Per spec 04: hello-world build+test executed for each toolchain, NOT just --version.
// Temp probe dirs under torture-test/var/w0/toolchain-probes/ cleaned/recreated deterministically.

/**
 * Check if a binary is available on PATH by running it with --version.
 * Returns the first line of output on success, null if not found.
 */
/**
 * Check if a binary is on PATH at all (via `which`, no execution).
 * Returns true even if the binary is broken (e.g. wrong arch).
 */
function binaryOnPath(name) {
  try {
    const result = spawnSync('which', [name], { encoding: 'utf-8', timeout: 5000, stdio: ['ignore', 'pipe', 'pipe'] });
    return result.status === 0 && result.stdout?.trim();
  } catch (_) {
    return false;
  }
}

/**
 * Resolve a harness binary honoring the TAMANDUA_<NAME>_BINARY env override
 * first, then PATH discovery (mirrors tt-harness-auth-probe's resolver
 * precedence). An env override that is set but NOT executable fails closed to
 * absent (no PATH fallback — the same invalid_env_binary path the real
 * resolver uses). Returns the absolute path string or null.
 */
function resolveHarnessBinary(name, envVar) {
  const envBin = process.env[envVar];
  if (typeof envBin === 'string' && envBin.trim() !== '') {
    try {
      fs.accessSync(envBin.trim(), fs.constants.X_OK);
      return envBin.trim();
    } catch (_) {
      return null;
    }
  }
  const onPath = binaryOnPath(name);
  return onPath || null;
}

/**
 * Check if a binary is available on PATH by running it with --version.
 * Returns the first line of output on success, null if not found or broken.
 */
function binaryPresent(name, versionArg) {
  try {
    const result = spawnSync(name, [versionArg || '--version'], {
      encoding: 'utf-8', timeout: 15000, stdio: ['ignore', 'pipe', 'pipe'],
    });
    if (result.status === 0 && result.stdout?.trim()) {
      return result.stdout.trim().split('\n')[0];
    }
    return null;
  } catch (_) {
    return null;
  }
}

/** Get the deterministic probe directory path for a toolchain. */
function probeDir(name) {
  return path.join(W0_DIR, 'toolchain-probes', name);
}

// --- java+maven ---
registerCheck('toolchain-java-maven', 'java+maven toolchain build+test probe', 'REQUIRED', 'toolchains', async () => {
  if (OPT.fast) {
    const ver = binaryPresent('mvn');
    recordHostProfile('toolchains', 'java+maven', { present: !!ver, buildPassed: null, testPassed: null, evidence: ver ? `present (--fast, --version only): ${ver}` : 'not found (--fast)' });
    return { result: 'SKIPPED', evidence: 'Toolchain build probe skipped (--fast)', remedy: null, skipReason: '--fast' };
  }

  const ver = binaryPresent('mvn');
  if (!ver) {
    recordHostProfile('toolchains', 'java+maven', { present: false, buildPassed: false, testPassed: false, evidence: 'mvn not found' });
    return { result: 'FAIL', evidence: 'mvn not found on PATH', remedy: 'Install maven + JDK >= 21 (https://maven.apache.org/)', skipReason: null };
  }

  const dir = probeDir('java-maven');
  try { fs.rmSync(dir, { recursive: true, force: true }); } catch (_) { /* ok */ }
  try {
    fs.mkdirSync(dir, { recursive: true });
    fs.mkdirSync(path.join(dir, 'src', 'main', 'java', 'tt'), { recursive: true });

    fs.writeFileSync(path.join(dir, 'pom.xml'), `<?xml version="1.0" encoding="UTF-8"?>
<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>tt</groupId>
  <artifactId>hello</artifactId>
  <version>1.0</version>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
      </plugin>
    </plugins>
  </build>
</project>
`);

    fs.writeFileSync(path.join(dir, 'src', 'main', 'java', 'tt', 'Hello.java'), `package tt;
public class Hello {
    public static String greet() { return "hello"; }
    public static void main(String[] args) {
        if (!"hello".equals(greet())) { System.out.println("FAIL"); System.exit(1); }
        System.out.println("OK");
    }
}
`);

    const build = spawnSync('mvn', ['-q', 'compile'], { cwd: dir, encoding: 'utf-8', timeout: 120000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (build.status !== 0) {
      const err = build.stderr?.trim() || build.stdout?.trim() || `exit ${build.status}`;
      recordHostProfile('toolchains', 'java+maven', { present: true, buildPassed: false, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `maven build failed: ${err.substring(0, 150)}`, remedy: 'Check maven and JDK installation', skipReason: null };
    }

    const testRun = spawnSync('mvn', ['-q', 'exec:java', '-Dexec.mainClass=tt.Hello'], { cwd: dir, encoding: 'utf-8', timeout: 30000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (testRun.status !== 0 || !testRun.stdout?.includes('OK')) {
      const err = testRun.stderr?.trim() || testRun.stdout?.trim() || `exit ${testRun.status}`;
      recordHostProfile('toolchains', 'java+maven', { present: true, buildPassed: true, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `maven run failed: ${err.substring(0, 150)}`, remedy: 'Check maven and JDK installation', skipReason: null };
    }

    recordHostProfile('toolchains', 'java+maven', { present: true, buildPassed: true, testPassed: true, evidence: `${ver}` });
    return { result: 'PASS', evidence: `maven build+test OK: ${ver}`, remedy: null, skipReason: null };
  } catch (e) {
    recordHostProfile('toolchains', 'java+maven', { present: true, buildPassed: false, testPassed: false, evidence: e.message });
    return { result: 'FAIL', evidence: `maven probe error: ${e.message}`.substring(0, 150), remedy: 'Check maven and JDK installation', skipReason: null };
  } finally {
    try { fs.rmSync(dir, { recursive: true, force: true }); } catch (_) { /* ok */ }
  }
});

// --- rust/cargo ---
registerCheck('toolchain-rust-cargo', 'rust/cargo toolchain build+test probe', 'REQUIRED', 'toolchains', async () => {
  if (OPT.fast) {
    const ver = binaryPresent('cargo');
    recordHostProfile('toolchains', 'rust/cargo', { present: !!ver, buildPassed: null, testPassed: null, evidence: ver ? `present (--fast, --version only): ${ver}` : 'not found (--fast)' });
    return { result: 'SKIPPED', evidence: 'Toolchain build probe skipped (--fast)', remedy: null, skipReason: '--fast' };
  }

  const onPath = binaryOnPath('cargo');
  const ver = binaryPresent('cargo');
  if (!onPath) {
    recordHostProfile('toolchains', 'rust/cargo', { present: false, buildPassed: false, testPassed: false, evidence: 'cargo not found' });
    return { result: 'FAIL', evidence: 'cargo not found on PATH', remedy: 'Install rust via https://rustup.rs/', skipReason: null };
  }
  if (!ver) {
    recordHostProfile('toolchains', 'rust/cargo', { present: true, buildPassed: false, testPassed: false, evidence: 'cargo present but --version failed' });
    return { result: 'FAIL', evidence: 'cargo present on PATH but not functional (check arch/emulation)', remedy: 'Ensure rust/cargo is installed for the correct architecture (https://rustup.rs/)', skipReason: null };
  }

  const dir = probeDir('rust-cargo');
  try { fs.rmSync(dir, { recursive: true, force: true }); } catch (_) { /* ok */ }
  fs.mkdirSync(dir, { recursive: true });
  try {
    const init = spawnSync('cargo', ['init', '--name', 'hello'], { cwd: dir, encoding: 'utf-8', timeout: 30000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (init.status !== 0) {
      const err = init.stderr?.trim() || `exit ${init.status}`;
      recordHostProfile('toolchains', 'rust/cargo', { present: true, buildPassed: false, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `cargo init failed: ${err.substring(0, 150)}`, remedy: 'Check rust/cargo installation', skipReason: null };
    }

    // Overwrite main.rs with a simple hello-world that asserts
    fs.mkdirSync(path.join(dir, 'src'), { recursive: true });
    fs.writeFileSync(path.join(dir, 'src', 'main.rs'), `fn greet() -> &'static str { "hello" }
fn main() {
    assert_eq!(greet(), "hello");
    println!("OK");
}
#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn test_greet() { assert_eq!(greet(), "hello"); }
}
`);

    const build = spawnSync('cargo', ['build', '-q'], { cwd: dir, encoding: 'utf-8', timeout: 120000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (build.status !== 0) {
      const err = build.stderr?.trim() || `exit ${build.status}`;
      recordHostProfile('toolchains', 'rust/cargo', { present: true, buildPassed: false, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `cargo build failed: ${err.substring(0, 150)}`, remedy: 'Check rust/cargo installation', skipReason: null };
    }

    const testRun = spawnSync('cargo', ['test', '-q'], { cwd: dir, encoding: 'utf-8', timeout: 120000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (testRun.status !== 0) {
      const err = testRun.stderr?.trim() || `exit ${testRun.status}`;
      recordHostProfile('toolchains', 'rust/cargo', { present: true, buildPassed: true, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `cargo test failed: ${err.substring(0, 150)}`, remedy: 'Check rust/cargo installation', skipReason: null };
    }

    recordHostProfile('toolchains', 'rust/cargo', { present: true, buildPassed: true, testPassed: true, evidence: `${ver}` });
    return { result: 'PASS', evidence: `cargo build+test OK: ${ver}`, remedy: null, skipReason: null };
  } catch (e) {
    recordHostProfile('toolchains', 'rust/cargo', { present: true, buildPassed: false, testPassed: false, evidence: e.message });
    return { result: 'FAIL', evidence: `cargo probe error: ${e.message}`.substring(0, 150), remedy: 'Check rust/cargo installation', skipReason: null };
  } finally {
    try { fs.rmSync(dir, { recursive: true, force: true }); } catch (_) { /* ok */ }
  }
});

// --- go ---
registerCheck('toolchain-go', 'go toolchain build+test probe', 'REQUIRED', 'toolchains', async () => {
  if (OPT.fast) {
    const ver = binaryPresent('go', 'version');
    recordHostProfile('toolchains', 'go', { present: !!ver, buildPassed: null, testPassed: null, evidence: ver ? `present (--fast, --version only): ${ver}` : 'not found (--fast)' });
    return { result: 'SKIPPED', evidence: 'Toolchain build probe skipped (--fast)', remedy: null, skipReason: '--fast' };
  }

  const ver = binaryPresent('go', 'version');
  if (!ver) {
    recordHostProfile('toolchains', 'go', { present: false, buildPassed: false, testPassed: false, evidence: 'go not found' });
    return { result: 'FAIL', evidence: 'go not found on PATH', remedy: 'Install go >= 1.21 (https://go.dev/dl/)', skipReason: null };
  }

  const dir = probeDir('go');
  try { fs.rmSync(dir, { recursive: true, force: true }); } catch (_) { /* ok */ }
  try {
    fs.mkdirSync(dir, { recursive: true });

    const modInit = spawnSync('go', ['mod', 'init', 'hello'], { cwd: dir, encoding: 'utf-8', timeout: 15000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (modInit.status !== 0) {
      const err = modInit.stderr?.trim() || `exit ${modInit.status}`;
      recordHostProfile('toolchains', 'go', { present: true, buildPassed: false, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `go mod init failed: ${err.substring(0, 150)}`, remedy: 'Check go installation', skipReason: null };
    }

    fs.writeFileSync(path.join(dir, 'main.go'), `package main

import "fmt"

func Greet() string { return "hello" }
func main() {
	if Greet() != "hello" { panic("FAIL") }
	fmt.Println("OK")
}
`);
    fs.writeFileSync(path.join(dir, 'main_test.go'), `package main

import "testing"

func TestGreet(t *testing.T) {
	if Greet() != "hello" { t.Fatal("Greet() did not return hello") }
}
`);

    const build = spawnSync('go', ['build', '-o', '/dev/null', '.'], { cwd: dir, encoding: 'utf-8', timeout: 60000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (build.status !== 0) {
      const err = build.stderr?.trim() || `exit ${build.status}`;
      recordHostProfile('toolchains', 'go', { present: true, buildPassed: false, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `go build failed: ${err.substring(0, 150)}`, remedy: 'Check go installation', skipReason: null };
    }

    const testRun = spawnSync('go', ['test', './...'], { cwd: dir, encoding: 'utf-8', timeout: 60000, stdio: ['ignore', 'pipe', 'pipe'] });
    if (testRun.status !== 0) {
      const err = testRun.stderr?.trim() || testRun.stdout?.trim() || `exit ${testRun.status}`;
      recordHostProfile('toolchains', 'go', { present: true, buildPassed: true, testPassed: false, evidence: err.substring(0, 200) });
      return { result: 'FAIL', evidence: `go test failed: ${err.substring(0, 150)}`, remedy: 'Check go installation', skipReason: null };
    }

    recordHostProfile('toolchains', 'go', { present: true, buildPassed: true, testPassed: true, evidence: `${ver}` });
    return { result: 'PASS', evidence: `go build+test OK: ${ver}`, remedy: null, skipReason: null };
  } catch (e) {
    recordHostProfile('toolchains', 'go', { present: true, buildPassed: false, testPassed: false, evidence: e.message });
    return { result: 'FAIL', evidence: `go probe error: ${e.message}`.substring(0, 150), remedy: 'Check go installation', skipReason: null };
  } finally {
    try { fs.rmSync(dir, { recursive: true, force: true }); } catch (_) { /* ok */ }
  }
});

