#!/usr/bin/env node

// tt-verify-environment — W0.0 assumption gate
// Per spec 04-wave-0-preflight.md and 01-environment-and-isolation.md
// Design rules from 12-runner-automation.md:
//   - Mechanical checks only, no prose interpretation
//   - UTC ISO-8601 timestamps
//   - Deterministic, side-effect-free re-runs

import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { execSync, spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

// ── CLI parsing ──────────────────────────────────────────────────────

const args = process.argv.slice(2);
const flags = new Set();

function showHelp() {
  console.log(`Usage: tt-verify-environment [--fast] [--json] [--spend] [--help]

W0.0 assumption gate — mechanical environment verification for the tamandua torture-test suite.

Options:
  --fast     Skip toolchain build+test probes (~30s wave-boundary subset)
  --json     Machine-readable JSON output to stdout (suppresses table)
  --spend    Run live harness auth probes (pi/hermes 1-prompt); dsh presence is
             always recorded (TAMANDUA_DSH_BINARY first, then PATH), never installed
  --help     Print this usage and exit

Output:
  Default: human-readable table: CHECK | RESULT | EVIDENCE [| REMEDY]
  --json:   Single JSON object to stdout with all check results

Exit code:
  0        All REQUIRED checks pass (SKIPPED is not failure)
  non-zero Any REQUIRED check failed
`);
}

for (const arg of args) {
  if (arg === '--help' || arg === '-h') {
    showHelp();
    process.exit(0);
  }
  flags.add(arg);
}

const OPT = {
  fast: flags.has('--fast'),
  json: flags.has('--json'),
  spend: flags.has('--spend'),
  testRequiredFail: flags.has('--test-required-fail'),
};

// ── Paths ─────────────────────────────────────────────────────────────

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const TT_ROOT = path.resolve(__dirname, '..');
const VAR_DIR = path.resolve(TT_ROOT, 'var');
const W0_DIR = path.resolve(VAR_DIR, 'w0');

// Ensure var/w0 exists
fs.mkdirSync(W0_DIR, { recursive: true });

// ── Host profile accumulator ─────────────────────────────────────────
// Accumulates structured data across all checks so US-011 can serialize
// host-profile.json and environment.json. Each check that discovers
// host capability facts records them here.

const hostProfile = {
  platform: null,         // { os, arch, release, label }
  nodeRuntimes: [],        // [{ version, major, sqliteAvailable }]
  npmVersion: null,        // string or null if not found
  containment: null,       // { systemdUserScope: boolean|null } (US-003)
  utilities: null,         // { sqlite3: boolean, curl: boolean, jq: boolean } (US-003)
  git: null,               // { version: string, mergeTreeAvailable: boolean } (US-004)
  ports: null,              // { [port]: 'free' | 'in-use-by-TT' | 'in-use-by-other' } (US-005)
  diskHeadroom: null,        // { availableBytes, available, thresholdBytes, threshold } (US-006)
  toolchains: null,           // { 'java+maven': {...}, 'rust/cargo': {...}, go: {...}, python3: {...}, node: {...} } (US-007)
  harness: null,              // { pi: { authenticated, sessionId?, inputTokens?, outputTokens? }, hermes: {...}, dsh: { present, authenticated, skipReason } } (US-010 + Tier-2 dsh lane)
  capabilities: null,         // { 'node-runtimes-2': boolean } (US-011 — Boolean-leaf capability names per the E2.2 canonical contract)
  // Populated by US-011:
  // spawnSpeedClass: null,
};

function recordHostProfile(section, key, value) {
  if (section === 'platform') {
    hostProfile.platform = hostProfile.platform || {};
    hostProfile.platform[key] = value;
  } else if (section === 'nodeRuntimes') {
    hostProfile.nodeRuntimes.push(value);
  } else if (section === 'npmVersion') {
    hostProfile.npmVersion = value;
  } else if (section === 'containment') {
    hostProfile.containment = hostProfile.containment || {};
    hostProfile.containment[key] = value;
  } else if (section === 'utilities') {
    hostProfile.utilities = hostProfile.utilities || {};
    hostProfile.utilities[key] = value;
  } else if (section === 'git') {
    hostProfile.git = hostProfile.git || {};
    hostProfile.git[key] = value;
  } else if (section === 'ports') {
    hostProfile.ports = hostProfile.ports || {};
    hostProfile.ports[key] = value;
  } else if (section === 'diskHeadroom') {
    hostProfile.diskHeadroom = hostProfile.diskHeadroom || {};
    hostProfile.diskHeadroom[key] = value;
  } else if (section === 'toolchains') {
    hostProfile.toolchains = hostProfile.toolchains || {};
    hostProfile.toolchains[key] = value;
  } else if (section === 'harness') {
    hostProfile.harness = hostProfile.harness || {};
    hostProfile.harness[key] = value;
  } else if (section === 'capabilities') {
    hostProfile.capabilities = hostProfile.capabilities || {};
    hostProfile.capabilities[key] = value;
  } else if (section === 'spawnSpeedClass') {
    hostProfile.spawnSpeedClass = hostProfile.spawnSpeedClass || {};
    hostProfile.spawnSpeedClass[key] = value;
  }
}

// ── Check registry ────────────────────────────────────────────────────

/**
 * @typedef {Object} Check
 * @property {string} id - Unique check identifier
 * @property {string} description - Human-readable description
 * @property {'REQUIRED'|'OPTIONAL'} severity - Check severity
 * @property {string} category - Grouping category
 * @property {function(): Promise<CheckResult>} run - Check function
 */

/**
 * @typedef {Object} CheckResult
 * @property {'PASS'|'FAIL'|'SKIPPED'} result
 * @property {string} evidence - Evidence string
 * @property {string|null} remedy - Remedy on failure (null if not applicable)
 * @property {string|null} skipReason - Reason if SKIPPED
 */

const checks = [];

function registerCheck(id, description, severity, category, runFn) {
  checks.push({ id, description, severity, category, runFn });
}

// ── Check implementations ─────────────────────────────────────────────

// --- Platform ---
registerCheck('platform', 'Host platform detection', 'REQUIRED', 'platform', async () => {
  const platform = os.platform(); // 'linux', 'darwin', etc.
  const arch = os.arch();
  const release = os.release();
  let label;
  if (platform === 'linux') label = 'linux';
  else if (platform === 'darwin') label = 'darwin';
  else label = `other (${platform})`;

  // Record in host profile accumulator (US-002)
  recordHostProfile('platform', 'os', platform);
  recordHostProfile('platform', 'arch', arch);
  recordHostProfile('platform', 'release', release);
  recordHostProfile('platform', 'label', label);

  return {
    result: 'PASS',
    evidence: `platform=${label}; arch=${arch}; release=${release}`,
    remedy: null,
    skipReason: null,
  };
});

// --- Node.js version ---
registerCheck('node-version', 'Node.js >= 22', 'REQUIRED', 'platform', async () => {
  const version = process.version; // e.g. 'v24.18.0'
  const parts = version.replace(/^v/, '').split('.');
  const major = parseInt(parts[0], 10);
  const minor = parseInt(parts[1], 10);
  const patch = parseInt(parts[2], 10);

  // Discover ADDITIONAL node runtimes (volta image dirs / nvm version dirs)
  // and record them FIRST so the CURRENT runtime stays the LAST nodeRuntimes
  // entry (the node-sqlite check below fills the current runtime's
  // sqliteAvailable by index). This is the W4.23 >=2-runtimes predicate
  // source (US-011 section H).
  discoverAdditionalNodeRuntimes(process.execPath);

  // Record in host profile accumulator (US-002) — always record,
  // even on failure, so the profile accurately describes the host
  hostProfile.nodeRuntimes.push({
    version: process.version,
    major,
    minor,
    patch,
    sqliteAvailable: null, // filled in by node-sqlite check below
  });

  // Record the >=2-runtimes capability as a Boolean leaf (E2.2 canonical
  // contract): requires.capabilities ["node-runtimes-2"] resolves against
  // profile.capabilities["node-runtimes-2"] in tt-controller's
  // observedCapability fall-through.
  recordHostProfile('capabilities', 'node-runtimes-2', hostProfile.nodeRuntimes.length >= 2);

  if (major >= 22) {
    return {
      result: 'PASS',
      evidence: `Node.js ${version} (>= 22 required)`,
      remedy: null,
      skipReason: null,
    };
  }
  return {
    result: 'FAIL',
    evidence: `Node.js ${version} (< 22 required)`,
    remedy: 'Install Node.js >= 22 (https://nodejs.org/)',
    skipReason: null,
  };
});

// Discover additional node runtimes the host can run (volta image node dirs,
// nvm version node dirs). The current runtime (process.execPath) is skipped —
// it is recorded by the node-version check itself (its sqliteAvailable is
// filled by the node-sqlite check). Each additional runtime is recorded with
// its own sqlite probe so the profile describes the host truthfully. Zero
// installs, zero mutations — pure discovery (spec 01 W0.0 RECORDS, never
// installs).
function discoverAdditionalNodeRuntimes(currentExecPath) {
  let currentReal = null;
  try {
    currentReal = fs.realpathSync(currentExecPath);
  } catch {
    currentReal = currentExecPath;
  }
  const seen = new Set([currentReal]);
  const candidates = [];
  const addCandidate = (bin) => {
    if (typeof bin !== 'string' || bin.length === 0) return;
    let real;
    try {
      real = fs.realpathSync(bin);
    } catch {
      return; // dangling or inaccessible — not a runnable runtime
    }
    if (seen.has(real)) return;
    seen.add(real);
    candidates.push(real);
  };
  const home = os.homedir();
  // Volta image node dirs: ~/.volta/tools/image/node/<version>/bin/node.
  const voltaHome = process.env.VOLTA_HOME || path.join(home, '.volta');
  try {
    const imageRoot = path.join(voltaHome, 'tools', 'image', 'node');
    for (const entry of fs.readdirSync(imageRoot, { withFileTypes: true })) {
      if (entry.isDirectory()) addCandidate(path.join(imageRoot, entry.name, 'bin', 'node'));
    }
  } catch {
    /* no volta image dir */
  }
  // nvm version dirs: ~/.nvm/versions/node/<version>/bin/node.
  try {
    const nvmRoot = path.join(home, '.nvm', 'versions', 'node');
    for (const entry of fs.readdirSync(nvmRoot, { withFileTypes: true })) {
      if (entry.isDirectory()) addCandidate(path.join(nvmRoot, entry.name, 'bin', 'node'));
    }
  } catch {
    /* no nvm dir */
  }
  for (const bin of candidates) {
    const probe = spawnSync(bin, ['-e', 'process.stdout.write(process.version)'], {
      encoding: 'utf8',
      timeout: 15000,
    });
    if (probe.status !== 0) continue; // not runnable — record nothing
    const runtimeVersion = String(probe.stdout ?? '').trim();
    if (runtimeVersion === process.version) continue; // same version as the current runtime — the current entry covers it
    // Dedupe by version: node-runtimes-2 counts DISTINCT node versions (the
    // W4.23 daemon-cross-runtime corridor is about cross-VERSION drift).
    if (hostProfile.nodeRuntimes.some((runtime) => runtime.version === runtimeVersion)) continue;
    const runtimeParts = runtimeVersion.replace(/^v/, '').split('.');
    const runtimeMajor = parseInt(runtimeParts[0], 10);
    const runtimeMinor = parseInt(runtimeParts[1], 10);
    const runtimePatch = parseInt(runtimeParts[2], 10);
    const sqliteProbe = spawnSync(bin,
      ['-e', 'import("node:sqlite").then(() => process.exit(0)).catch(() => process.exit(1))'],
      { encoding: 'utf8', timeout: 15000 });
    hostProfile.nodeRuntimes.push({
      version: runtimeVersion,
      major: runtimeMajor,
      minor: runtimeMinor,
      patch: runtimePatch,
      sqliteAvailable: sqliteProbe.status === 0,
    });
  }
}

// --- node:sqlite loading ---
registerCheck('node-sqlite', 'node:sqlite loads without error', 'REQUIRED', 'platform', async () => {
  let sqliteAvailable = false;
  try {
    // Dynamic import to verify the built-in module exists and loads
    await import('node:sqlite');
    sqliteAvailable = true;
  } catch (_) {
    sqliteAvailable = false;
  }

  // Update the node runtime entry in the accumulator (US-002)
  if (hostProfile.nodeRuntimes.length > 0) {
    hostProfile.nodeRuntimes[hostProfile.nodeRuntimes.length - 1].sqliteAvailable = sqliteAvailable;
  }

  if (sqliteAvailable) {
    return {
      result: 'PASS',
      evidence: 'node:sqlite loaded successfully',
      remedy: null,
      skipReason: null,
    };
  }
  return {
    result: 'FAIL',
    evidence: 'node:sqlite failed to load (requires Node.js >= 22.5.0)',
    remedy: 'Upgrade to Node.js >= 22.5 (node:sqlite added in v22.5.0)',
    skipReason: null,
  };
});

// --- npm presence ---
registerCheck('npm', 'npm is present', 'REQUIRED', 'platform', async () => {
  try {
    const result = spawnSync('npm', ['--version'], { encoding: 'utf-8', timeout: 30000 });
    if (result.status === 0 && result.stdout.trim()) {
      const npmVer = result.stdout.trim();
      // Record in host profile accumulator (US-002)
      recordHostProfile('npmVersion', null, npmVer);
      return {
        result: 'PASS',
        evidence: `npm ${npmVer}`,
        remedy: null,
        skipReason: null,
      };
    }
    return {
      result: 'FAIL',
      evidence: `npm --version exited ${result.status}: ${result.stderr?.trim() || ''}`,
      remedy: 'Install npm (bundled with Node.js >= 22)',
      skipReason: null,
    };
  } catch (e) {
    return {
      result: 'FAIL',
      evidence: `npm not found: ${e.message}`,
      remedy: 'Install npm (bundled with Node.js >= 22)',
      skipReason: null,
    };
  }
});

