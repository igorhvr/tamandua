  result: 'SKIPPED',
  evidence: 'Not yet implemented — requires TT_COMMIT context',
  remedy: null,
  skipReason: 'not yet implemented',
}));

registerCheck('dist-staleness', 'Distribution freshness (doctor staleness check)', 'REQUIRED', 'system', async () => ({
  result: 'SKIPPED',
  evidence: 'Not yet implemented — requires tamandua doctor integration',
  remedy: null,
  skipReason: 'not yet implemented',
}));

registerCheck('production-quiesced', 'Production runs quiesced + daemon posture decided', 'REQUIRED', 'containment', async () => ({
  result: 'SKIPPED',
  evidence: 'Not yet implemented — requires tamandua daemon inspection',
  remedy: null,
  skipReason: 'not yet implemented',
