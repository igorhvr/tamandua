  if (!ver) {
    recordHostProfile('toolchains', 'python3', { present: false, buildPassed: false, testPassed: false, evidence: 'python3 not found' });
    return { result: 'FAIL', evidence: 'python3 not found on PATH', remedy: 'Install python3 >= 3.9 (https://www.python.org/downloads/)', skipReason: null };
  }

  const dir = probeDir('python3');
  try { fs.rmSync(dir, { recursive: true, force: true }); } catch (_) { /* ok */ }
  try {
    fs.mkdirSync(dir, { recursive: true });

    fs.writeFileSync(path.join(dir, 'test_hello.py'), `import unittest

def greet():
    return "hello"

class TestHello(unittest.TestCase):
    def test_greet(self):
        self.assertEqual(greet(), "hello")

if __name__ == '__main__':
    unittest.main()
`);

    // Build probe: python3 -c imports + runs the function
    const build = spawnSync('python3', ['-c', 'from test_hello import greet; assert greet() == "hello"; print("OK")'], {
      cwd: dir, encoding: 'utf-8', timeout: 15000, stdio: ['ignore', 'pipe', 'pipe'],
    });
    if (build.status !== 0 || !build.stdout?.includes('OK')) {
      const err = build.stderr?.trim() || build.stdout?.trim() || `exit ${build.status}`;
