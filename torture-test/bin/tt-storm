const HERE = import.meta.dirname ?? path.dirname(new URL(import.meta.url).pathname);
const TT_DIR = path.dirname(HERE);
const REPO_ROOT = path.dirname(TT_DIR);
// TT_VAR test seam (mirrors tt-catalog-install / tt-run): override the
// contained var root so hermetic self-tests can run a real prepare under a
// scratch var without touching the repo's shared torture-test/var. All
// containment/ownership is relative to this root, so the override cannot
// widen containment — it only relocates it.
const VAR_ROOT = process.env.TT_VAR ? path.resolve(process.env.TT_VAR) : path.join(TT_DIR, 'var');
const DEFAULT_CATALOG_ROOT = path.join(REPO_ROOT, 'workflows');
const DEFAULT_INSTALLED_CATALOG_ROOT = path.join(VAR_ROOT, 'home', '.tamandua', 'workflows');

// Real binaries: this checkout's own bin/tamandua + the suite operators. The
// suite runs the CANDIDATE CLI (built dist) at the rehearsal; the exec
// context resolves the absolute binary and refuses when absent.
function resolveBinaries() {
  const tamandua = path.join(REPO_ROOT, 'bin', 'tamandua');
  const tamanduaTest = path.join(REPO_ROOT, 'bin', 'tamandua-test');
  const ttChaos = path.join(HERE, 'tt-chaos');
  const daemonControl = path.join(HERE, 'daemon-control');
  const git = resolveGitBinary();
  const binaries = { tamandua, ttChaos, daemonControl };
  if (tamanduaTest) binaries.tamanduaTest = tamanduaTest;
  if (git) binaries.git = git;
  return binaries;
}

function resolveGitBinary() {
  const candidates = (process.env.PATH ?? '').split(path.delimiter)
    .map((d) => path.join(d, 'git'))
    .filter(Boolean);
  try {
    return resolveAbsoluteBinary(candidates, { label: 'git' });
  } catch {
    return null; // git resolved lazily by the engine only when ref snapshots run
  }
}

