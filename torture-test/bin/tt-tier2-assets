#!/usr/bin/env node
// tt-tier2-assets — validates the Tier-2 roster's asset layer (US-015).
//
// Mirrors bin/tt-tier1-assets (task files resolve and stay inside
// torture-test/, probe refs exist, requires keys/shapes valid, manifest under
// cases/) and ADDS the Tier-2 authoring-layer contracts:
//   * every `seed` field exists in the fixture's SEEDS.md catalog (E3.A S2
//     arm — the seed must be real fixture content, never a phantom);
//   * requires.capabilities entries (incl. `dsh`) are well-formed per the
//     canonical host-adaptation contract in cases/case.schema.json
//     (non-empty, <= 128 chars, `^[A-Za-z0-9][A-Za-z0-9._-]*$`).
//
// Confined to torture-test/. Zero tokens (pure file/schema checks).

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const binDir = path.dirname(fileURLToPath(import.meta.url));
const ttRoot = path.resolve(binDir, "..");
const probesRoot = path.join(ttRoot, "probes");
const fixturesSrcRoot = path.join(ttRoot, "fixtures-src");

const ALLOWED_REQUIRES_KEYS = new Set([
  "platform",
  "toolchains",
  "capabilities",
  "containment",
  "node_min",
]);

// Canonical capability pattern from cases/case.schema.json (requires
// capabilities items): a non-empty identifier of letters/digits/dot/underscore/
// hyphen, not starting with a separator.
const CAPABILITY_RE = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;

function fail(message) {
  throw new Error(`Tier-2 assets unavailable: ${message}`);
}

function readManifest(manifestPath) {
  const contents = fs.readFileSync(manifestPath, "utf8");
  const records = [];
  for (const [index, line] of contents.split(/\r?\n/).entries()) {
    if (line.trim() === "") continue;
    try {
      records.push(JSON.parse(line));
    } catch (error) {
      fail(`manifest line ${index + 1} is not JSON: ${error.message}`);
    }
  }
  if (records.length === 0) fail("manifest contains no cases");
  return records;
}

function resolveTaskFile(relative, caseId) {
  if (typeof relative !== "string" || relative.length === 0 || path.isAbsolute(relative)) {
    fail(`${caseId} has an invalid task path`);
  }
  const candidate = path.resolve(ttRoot, relative);
  const ttRealPath = fs.realpathSync(ttRoot);
  if (!candidate.startsWith(`${ttRoot}${path.sep}`)) {
    fail(`${caseId} task path escapes torture-test/`);
  }
  const details = fs.lstatSync(candidate, { throwIfNoEntry: false });
  if (!details?.isFile() || details.isSymbolicLink()) {
    fail(`${caseId} task path is not a regular file: ${relative}`);
  }
  try {
    const realCandidate = fs.realpathSync(candidate);
    if (!realCandidate.startsWith(`${ttRealPath}${path.sep}`) && realCandidate !== ttRealPath) {
      fail(`${caseId} task path resolves outside torture-test/: ${relative}`);
    }
  } catch {
    // realpath failure (dangling symlink, absent path, etc.)
    fail(`${caseId} task path is not a contained regular file: ${relative}`);
  }
  return candidate;
}

function isContainedRegularFile(filePath) {
  const details = fs.lstatSync(filePath, { throwIfNoEntry: false });
  if (!details?.isFile() || details.isSymbolicLink()) return false;
  try {
    const realRoot = fs.realpathSync(probesRoot);
    const realFile = fs.realpathSync(filePath);
    return realFile.startsWith(`${realRoot}${path.sep}`) || realFile === realRoot;
  } catch {
    return false;
  }
}

function resolveProbe(probeId, fixture, caseId) {
  const fixtureDir = path.join(probesRoot, fixture);

  // Standard layout: probes/<fixture>/<probe_id>/probe.sh
  const directProbe = path.join(fixtureDir, probeId, "probe.sh");
  if (isContainedRegularFile(directProbe)) return directProbe;

  // Poly-lite layout: probes/<fixture>/<lang>/<probe_id>/probe.sh
  const fixtureDetails = fs.lstatSync(fixtureDir, { throwIfNoEntry: false });
  if (fixtureDetails?.isDirectory() && !fixtureDetails.isSymbolicLink()) {
    for (const entry of fs.readdirSync(fixtureDir, { withFileTypes: true })) {
      if (!entry.isDirectory() || entry.isSymbolicLink()) continue;
      const polyProbe = path.join(fixtureDir, entry.name, probeId, "probe.sh");
      if (isContainedRegularFile(polyProbe)) return polyProbe;
    }
  }

  fail(`${caseId} probe_id ${JSON.stringify(probeId)} has no probe.sh under probes/${fixture}/`);
}

function validateRequiresPredicates(requires, caseId) {
  for (const key of Object.keys(requires)) {
    if (!ALLOWED_REQUIRES_KEYS.has(key)) {
      fail(`${caseId} requires has invalid key: ${JSON.stringify(key)}`);
    }
  }
  // Validate shape of known keys
  if (Array.isArray(requires.toolchains)) {
    for (const tc of requires.toolchains) {
      if (typeof tc !== "string" || tc.length === 0) {
        fail(`${caseId} requires.toolchains contains a non-string entry`);
      }
    }
  }
  if (Array.isArray(requires.capabilities)) {
    for (const cap of requires.capabilities) {
      // US-015: well-formedness per the canonical contract — includes the
      // harness capabilities pi/hermes/dsh and profile leaves like
      // node-runtimes-2.
      if (typeof cap !== "string" || cap.length === 0 || cap.length > 128) {
        fail(`${caseId} requires.capabilities contains an invalid entry`);
      }
      if (!CAPABILITY_RE.test(cap)) {
        fail(`${caseId} requires.capabilities entry ${JSON.stringify(cap)} is not well-formed (must match ^[A-Za-z0-9][A-Za-z0-9._-]*$)`);
      }
    }
  }
  if (Array.isArray(requires.containment)) {
    for (const c of requires.containment) {
      if (typeof c !== "string" || c.length === 0) {
        fail(`${caseId} requires.containment contains a non-string entry`);
      }
    }
  }
  if (requires.platform !== undefined) {
    const allowedPlatforms = ["linux", "darwin", "other"];
    if (Array.isArray(requires.platform)) {
      for (const p of requires.platform) {
        if (!allowedPlatforms.includes(p)) {
          fail(`${caseId} requires.platform array has invalid value: ${JSON.stringify(p)}`);
        }
      }
    } else if (!allowedPlatforms.includes(requires.platform)) {
      fail(`${caseId} requires.platform has invalid value: ${JSON.stringify(requires.platform)}`);
    }
  }
  if (requires.node_min !== undefined && (!Number.isInteger(requires.node_min) || requires.node_min < 0)) {
    fail(`${caseId} requires.node_min must be a non-negative integer`);
  }
}

function collectProbeIds(caseRecord) {
  const ids = [];
  if (typeof caseRecord.probe_id === "string") ids.push(caseRecord.probe_id);
  if (Array.isArray(caseRecord.probes)) ids.push(...caseRecord.probes);
  return ids;
}

// Collect every seed ID documented in the fixture's SEEDS.md catalog(s).
// A SEEDS.md entry is a `### <ID>` heading; the ID is the first
// identifier-ish token after the heading marker (so `### BUG-T1: ...`,
// `### POLY-BUG-T1 (Archetype ...)` and the composite `### storm roster — ...`
// all yield the stable ID). Sub-catalogs (tt-poly's per-language seeds/) are
// walked recursively.
function seedCatalogIds(fixture) {
  const fixtureDir = path.join(fixturesSrcRoot, fixture);
  const fixtureDetails = fs.lstatSync(fixtureDir, { throwIfNoEntry: false });
  if (!fixtureDetails?.isDirectory() || fixtureDetails.isSymbolicLink()) {
    fail(`fixture ${JSON.stringify(fixture)} has no directory under fixtures-src/ (cannot validate its SEEDS.md catalog)`);
  }
  const seedsRoot = path.join(fixtureDir, "seeds");
  const seedsDetails = fs.lstatSync(seedsRoot, { throwIfNoEntry: false });
  if (!seedsDetails?.isDirectory() || seedsDetails.isSymbolicLink()) {
    fail(`fixture ${JSON.stringify(fixture)} has no seeds/ directory (cannot validate its SEEDS.md catalog)`);
  }
  const ids = new Set();
  const walk = (dir) => {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      const full = path.join(dir, entry.name);
      if (entry.isDirectory() && !entry.isSymbolicLink()) {
        walk(full);
      } else if (entry.isFile() && entry.name === "SEEDS.md") {
        for (const line of fs.readFileSync(full, "utf8").split(/\r?\n/)) {
          const match = /^###\s+([A-Za-z0-9][A-Za-z0-9._-]*)/.exec(line);
          if (match !== null) ids.add(match[1]);
        }
      }
    }
  };
  walk(seedsRoot);
  return ids;
}

// E3.A S2 arm: a bug-fix case's `seed` must be real fixture content —
// documented in the fixture's SEEDS.md catalog. A seed on a fixture-less
// (`none`) row cannot be validated and fails closed.
function validateSeed(record, caseId) {
  if (record.seed === undefined) return;
  if (typeof record.seed !== "string" || record.seed.length === 0) {
    fail(`${caseId} seed must be a non-empty string`);
  }
  if (record.fixture === "none" || typeof record.fixture !== "string") {
    fail(`${caseId} seed ${JSON.stringify(record.seed)} requires a fixture with a SEEDS.md catalog (fixture is ${JSON.stringify(record.fixture)})`);
  }
  const ids = seedCatalogIds(record.fixture);
  if (!ids.has(record.seed)) {
    fail(`${caseId} seed ${JSON.stringify(record.seed)} is not in the ${record.fixture} SEEDS.md catalog (E3.A S2 arm — seed must be real fixture content)`);
  }
}

function validateTier2Assets(manifestPath) {
  const records = readManifest(manifestPath);
  let caseCount = 0;

  for (const record of records) {
    const caseId = typeof record?.id === "string" ? record.id : "<unknown-case>";
    caseCount += 1;

    // (b) Validate task file exists
    resolveTaskFile(record.task, caseId);

    // (c) Validate probes
    const probeIds = collectProbeIds(record);
    for (const probeId of probeIds) {
      resolveProbe(probeId, record.fixture, caseId);
    }

    // (d) Validate requires predicate shape (incl. capabilities well-formedness)
    validateRequiresPredicates(record.requires, caseId);

    // (e) Validate seed vs the fixture's SEEDS.md catalog (E3.A S2 arm)
    validateSeed(record, caseId);
  }

  return caseCount;
}

function main() {
  const args = process.argv.slice(2);
  if (args.length !== 1) {
    process.stderr.write("Usage: tt-tier2-assets <tier2-manifest>\n");
    process.exit(2);
  }
  try {
    const manifestPath = path.resolve(args[0]);
    const casesRoot = path.join(ttRoot, "cases");
    if (!manifestPath.startsWith(`${casesRoot}${path.sep}`)) {
      fail("manifest must be beneath torture-test/cases/");
    }
    const details = fs.lstatSync(manifestPath, { throwIfNoEntry: false });
    if (!details?.isFile() || details.isSymbolicLink()) {
      fail("manifest is not a regular file");
    }
    const count = validateTier2Assets(manifestPath);
    process.stdout.write(`Validated ${count} Tier-2 case asset set(s)\n`);
  } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exit(1);
  }
}

main();
