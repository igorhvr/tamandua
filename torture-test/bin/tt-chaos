// ── Help ──────────────────────────────────────────────────────────────

function showHelp() {
  const actionList = Object.entries(ACTIONS)
    .map(([name, { args, desc }]) => {
      const argStr = args ? ` ${args}` : '';
      return `  ${name}${argStr}\n      ${desc}`;
    })
    .join('\n');

  console.log(`Usage: tt-chaos <action> --run <run-id> [action-args] --when <phase-marker> [--timeout <s>]

Fault-injection operator for the tamandua torture-test suite.
Executes one injection action per invocation, armed on a phase marker.

Actions:
${actionList}

Options:
  --run <run-id>       Target run ID (required)
  --when <marker>      Phase marker expression — step:<role>:<state>,
                       event:<type>, file:<path>, or "now"
  --timeout <s>        Max seconds to wait for the phase marker
                       (default: 120; --when now ignores this). move-branch
                       repeat: also bounds each between-move cadence window
                       (the loop stands down on run-terminal regardless).
  --target-pid <pid>   Explicit recorded harness PID (kill-harness /
                       sigstop_sigcont). Kill targets are NEVER resolved by
                       a /proc cwd/cmdline sweep; an explicit record (these
                       args, a steps-table claim row, or the daemon pidfile)
                       is required or the action refuses with GUARD_MISS.
  --target-pgid <pgid> Recorded harness process-group id — verification
                       metadata for the recorded pid.
  --target-start-time <n>
                       Recorded /proc starttime of the target — ABA-safe
                       identity check; a mismatch refuses the signal.
  --repeat <n>         move-branch only: persistent colleague target-move —
                       move the ref n times (first at the armed marker, then
                       every --interval seconds); the loop stands down as soon
                       as the run is observed terminal so a resume lands on a
                       stable target (US-004 S29 premise redesign).
  --interval <s>       move-branch only: seconds between repeated moves
                       (REQUIRED when --repeat > 1). With --rearm this is a
                       MINIMUM-SPACING FLOOR, never a free-running cadence.
  --rearm              move-branch only (US-007 S36): per-attempt re-arm mode
                       — each FRESH step:<role>:running occurrence (the step
                       transitions waiting->pending->running on every reroute
                       cycle) triggers the next move after a short post-marker
                       hold (--rearm-hold-s), so EVERY finalize attempt
                       observes a moved tip; requires a step: --when marker
                       and --repeat > 1.
  --rearm-hold-s <s>   move-branch only (US-007 S36): the post-marker hold in
                       seconds before each re-armed move — long enough for the
                       merger's tip capture to precede the move (2-5s),
                       REQUIRED when --rearm.
  --help, -h           Print this usage and exit

Phase markers:
  step:<role>:<state>  Wait for step state transition (e.g. step:developer:running)
  event:<type>         Wait for event row appearance (e.g. event:merge.landed)
  file:<path>           Wait for file existence
  now                  Fire immediately (no polling; logged as timed-not-triggered)

Examples:
  tt-chaos kill-harness --run run-abc123 --when now
  tt-chaos pause --run run-abc123 --when step:developer:running
  tt-chaos sigstop_sigcont --run run-abc123 --when step:developer:running --hold-seconds 600
  tt-chaos colleague-commit --repo var/fixture-clone --file README.md \\
      --line "CHAOS MARKER" --run run-abc123 --when event:merge.landed

Injection discipline (spec 08): every action arms on its --when phase
marker (never a bare sleep) and re-verifies its target immediately before
firing; a guard miss aborts with exit 3 and an INVALID chaos.log entry.
sigstop_sigcont is a harness-process injection (not daemon-lifecycle): it
re-verifies the SAME harness PID after the hold and never SIGCONTs a
process that died or was reaped during the hold. Daemon-lifecycle
injections take the wave-lane exclusive window per spec 08 — schedule
this action so it never overlaps another injection on the same harness.
`);
}

// ── Not-yet-implemented handler ──────────────────────────────────────

function notYetImplemented(action) {
  return () => {
    console.error(`Action "${action}" is not yet implemented.`);
    process.exit(1);
  };
}

// ── US-005: Process action handlers ──────────────────────────────────

const VALID_SIGNALS = ['SIGKILL', 'SIGTERM', 'SIGSTOP', 'SIGCONT', 'SIGINT', 'SIGHUP', 'SIGUSR1', 'SIGUSR2'];

/**
 * Resolve signal from --signal arg, defaulting to SIGKILL.
 * Exits with error for invalid signal names.
 */
function resolveSignal(signalArg) {
  const sig = (signalArg || 'SIGKILL').toUpperCase();
  if (!VALID_SIGNALS.includes(sig)) {
    console.error(`Error: Invalid signal "${sig}". Valid: ${VALID_SIGNALS.join(', ')}`);
    process.exit(1);
  }
  return sig;
}

/**
 * kill-harness: Send a signal to the active harness process for --run.
 * The target is resolved from EXPLICIT RECORDED identity only (US-002):
 * --target-pid/--target-pgid/--target-start-time args, else the TT DB steps
 * table's claim_pid/claim_pgid for the run. A missing record or a failed
 * identity/provenance verification is a GUARD_MISS (exit 3) — the target is
 * never resolved by a /proc cwd/cmdline sweep. Default signal: SIGKILL.
 */
function killHarness(opts) {
  const { run: runId, args } = opts;
  const signal = resolveSignal(args.signal);

  const record = resolveTargetRecord('kill-harness', opts);
  if (!record || record.error) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-harness',
      runId,
      outcome: 'target_not_found',
      error: record ? record.error : `No recorded harness target for run ${runId} (explicit --target-* args or steps claim row) — refusing to resolve by scan`,
    };
    logStructured(entry);
    console.error(`GUARD_MISS: ${entry.error}`);
    process.exit(EXIT_GUARD_MISS);
  }

  const verdict = verifyKillTarget(record, runId);
  if (!verdict.ok) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-harness',
      runId,
      target: `pid:${record.pid}`,
      targetRecord: record,
      signal,
      outcome: 'INVALID',
      verification: 'refused',
      error: verdict.reason,
    };
    logStructured(entry);
    console.error(`GUARD_MISS: ${verdict.reason}`);
    process.exit(EXIT_GUARD_MISS);
  }

  const pid = record.pid;
  try {
    process.kill(pid, signal);
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-harness',
      runId,
      target: `pid:${pid}`,
      targetRecord: record,
      signal,
      verification: 'ok',
      // S33 (US-004): record WHICH verification leg accepted the target
      // (strict provenance vs a positive tt-ownership chain proof) so the
      // chaos evidence shows the guard's reasoning, never a silent accept.
      verificationDetail: verdict.reason,
      outcome: 'fired',
    };
    logStructured(entry);
    console.error(`kill-harness: ${signal} sent to harness PID ${pid} (run ${runId}) — ${verdict.reason}`);
    process.exit(0);
  } catch (e) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-harness',
      runId,
      target: `pid:${pid}`,
      targetRecord: record,
      signal,
      outcome: 'fire_failed',
      error: e.message,
    };
    logStructured(entry);
    console.error(`Error: Failed to send ${signal} to PID ${pid}: ${e.message}`);
    process.exit(1);
  }
}

/**
 * kill-daemon: Send a signal to the TT daemon (never the production daemon).
 * The target PID comes from the TT daemon pidfile ONLY (US-002): when the
 * pidfile is absent the action refuses with GUARD_MISS (exit 3) — there is
 * NO fallback to a /proc daemon scan. The pidfile PID is verified (alive,
 * identity, ancestry/group disjointness, pidfile-under-TT_ROOT containment)
 * before any signal. S28 (US-006): the verification does NOT require the
 * daemon's cwd/cmdline to contain TT_ROOT or the run id — the real contained
 * daemon legitimately runs from a different cwd with a cmdline that contains
 * neither (campaign W4.48a `Process ... cwd/cmdline does not contain
 * .../torture-test/var` GUARD_MISS). Default signal: SIGKILL.
 */
function killDaemon(opts) {
  const { run: runId, args } = opts;
  const signal = resolveSignal(args.signal);

  const record = resolveTargetRecord('kill-daemon', opts);
  if (!record || record.error) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-daemon',
      runId,
      outcome: 'target_not_found',
      error: record ? record.error : 'No TT daemon pidfile found — refusing to resolve the daemon by scan',
    };
    logStructured(entry);
    console.error(`GUARD_MISS: ${entry.error}`);
    process.exit(EXIT_GUARD_MISS);
  }

  const verdict = verifyKillTarget(record, runId, 'daemon');
  if (!verdict.ok) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-daemon',
      runId,
      target: `pid:${record.pid}`,
      targetRecord: record,
      signal,
      outcome: 'INVALID',
      verification: 'refused',
      error: verdict.reason,
    };
    logStructured(entry);
    console.error(`GUARD_MISS: ${verdict.reason}`);
    process.exit(EXIT_GUARD_MISS);
  }

  const pid = record.pid;
  try {
    process.kill(pid, signal);
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-daemon',
      runId,
      target: `pid:${pid}`,
      targetRecord: record,
      signal,
      verification: 'ok',
      outcome: 'fired',
    };
    logStructured(entry);
    console.error(`kill-daemon: ${signal} sent to daemon PID ${pid} (run ${runId})`);
    process.exit(0);
  } catch (e) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'kill-daemon',
      runId,
      target: `pid:${pid}`,
      targetRecord: record,
      signal,
      outcome: 'fire_failed',
      error: e.message,
    };
    logStructured(entry);
    console.error(`Error: Failed to send ${signal} to daemon PID ${pid}: ${e.message}`);
    process.exit(1);
  }
}

// ── US-004: sigstop_sigcont — combined SIGSTOP → hold → SIGCONT ──────

/**
 * Check whether a PID is still alive and present in /proc.
 * A process that was killed OR reaped during the hold fails this check;
 * kill(pid, 0) alone is not enough because a zombie answers it.
 */
function isProcessAlive(pid) {
  try {
    // linux-only /proc/<pid> existence check (MACP3 US-003): absent on
    // Darwin, so this degrades to "alive = kill(0) alone" via the catch.
    fs.accessSync(`/proc/${pid}`, fs.constants.F_OK);
  } catch {
    return false;
  }
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

/**
 * Synchronous sleep (same busy-wait primitive phaseWait uses).
 */
function sleepSync(ms) {
  const buf = new Int32Array(new SharedArrayBuffer(4));
  const step = Math.min(POLL_INTERVAL_MS, ms);
  let remaining = ms;
  while (remaining > 0) {
    Atomics.wait(buf, 0, 0, Math.min(step, remaining));
    remaining -= step;
  }
}

/**
 * sigstop_sigcont: SIGSTOP the active harness process for --run, hold
 * for --hold-seconds, then SIGCONT — logging a structured start entry,
 * a hold_complete entry, and a cont entry to chaos.log.
 *
 * Guard semantics (spec 08 injection discipline — never a silent cont):
 * the target is resolved from EXPLICIT RECORDED identity only (US-002:
 * --target-* args, else the steps-table claim row; never a /proc sweep)
 * and verified (alive, startTime ABA, ancestry/group disjointness,
 * provenance) before SIGSTOP. After the hold elapses, the SAME pid must
 * still be alive AND still pass identity verification (a pid reused by
 * another process during the hold fails the startTime check); otherwise
 * the injection aborts with EXIT_GUARD_MISS (3) and an INVALID entry —
 * no SIGCONT is ever sent.
 */
function sigstopSigcont(opts) {
  const { run: runId, args } = opts;

  const holdSecondsRaw = args['hold-seconds'];
  if (holdSecondsRaw === undefined || holdSecondsRaw === '') {
    console.error('Error: --hold-seconds is required for sigstop_sigcont');
    process.exit(1);
  }
  const holdSeconds = Number(holdSecondsRaw);
  if (!Number.isInteger(holdSeconds) || holdSeconds < 0) {
    console.error(`Error: --hold-seconds must be a non-negative integer, got "${holdSecondsRaw}"`);
    process.exit(1);
  }

  const record = resolveTargetRecord('sigstop_sigcont', opts);
  if (!record || record.error) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'sigstop_sigcont',
      runId,
      phase: 'resolve',
      outcome: 'target_not_found',
      error: record ? record.error : `No recorded harness target for run ${runId} (explicit --target-* args or steps claim row) — refusing to resolve by scan`,
    };
    logStructured(entry);
    console.error(`GUARD_MISS: ${entry.error}`);
    process.exit(EXIT_GUARD_MISS);
  }

  const verdict = verifyKillTarget(record, runId);
  if (!verdict.ok) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'sigstop_sigcont',
      runId,
      phase: 'resolve',
      target: `pid:${record.pid}`,
      targetRecord: record,
      outcome: 'INVALID',
      verification: 'refused',
      error: verdict.reason,
    };
    logStructured(entry);
    console.error(`GUARD_MISS: ${verdict.reason}`);
    process.exit(EXIT_GUARD_MISS);
  }

  const pid = record.pid;

  // ── SIGSTOP ──
  try {
    process.kill(pid, 'SIGSTOP');
    const startEntry = {
      ts: new Date().toISOString(),
      action: 'sigstop_sigcont',
      runId,
      phase: 'start',
      target: `pid:${pid}`,
      targetRecord: record,
      signal: 'SIGSTOP',
      holdSeconds,
      verification: 'ok',
      outcome: 'fired',
    };
    logStructured(startEntry);
    console.error(`sigstop_sigcont: SIGSTOP sent to harness PID ${pid} (run ${runId}), holding ${holdSeconds}s`);
  } catch (e) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'sigstop_sigcont',
      runId,
      phase: 'start',
      target: `pid:${pid}`,
      targetRecord: record,
      signal: 'SIGSTOP',
      outcome: 'fire_failed',
      error: e.message,
    };
    logStructured(entry);
    console.error(`Error: Failed to send SIGSTOP to PID ${pid}: ${e.message}`);
    process.exit(1);
  }

  // ── Hold ──
  if (holdSeconds > 0) {
    sleepSync(holdSeconds * 1000);
  }
  logStructured({
    ts: new Date().toISOString(),
    action: 'sigstop_sigcont',
    runId,
    phase: 'hold_complete',
    target: `pid:${pid}`,
    targetRecord: record,
    holdSeconds,
    outcome: 'held',
  });

  // ── Re-verify the SAME pid before any SIGCONT (never a silent cont) ──
  const stillAlive = isProcessAlive(pid);
  const recordNow = resolveTargetRecord('sigstop_sigcont', opts);
  const resolvedNow = recordNow && !recordNow.error ? recordNow.pid : null;
  const reVerdict = recordNow && !recordNow.error
    ? verifyKillTarget(recordNow, runId)
    : { ok: false, reason: 'target record no longer resolvable after the hold' };
  if (!stillAlive || resolvedNow !== pid || !reVerdict.ok) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'sigstop_sigcont',
      runId,
      phase: 'guard',
      target: `pid:${pid}`,
      targetRecord: record,
      holdSeconds,
      outcome: 'INVALID',
      verification: 'refused',
      error: !stillAlive
        ? `Harness PID ${pid} died or was reaped during the ${holdSeconds}s hold`
        : resolvedNow !== pid
          ? `Harness PID changed during hold: expected ${pid}, resolved ${resolvedNow ?? 'none'}`
          : reVerdict.reason,
    };
    logStructured(entry);
    console.error(`GUARD_MISS: ${entry.error} — no SIGCONT sent`);
    process.exit(EXIT_GUARD_MISS);
  }

  // ── SIGCONT ──
  try {
    process.kill(pid, 'SIGCONT');
    const contEntry = {
      ts: new Date().toISOString(),
      action: 'sigstop_sigcont',
      runId,
      phase: 'cont',
      target: `pid:${pid}`,
      targetRecord: record,
      signal: 'SIGCONT',
      holdSeconds,
      verification: 'ok',
      outcome: 'fired',
    };
    logStructured(contEntry);
    console.error(`sigstop_sigcont: SIGCONT sent to harness PID ${pid} (run ${runId})`);
    process.exit(0);
  } catch (e) {
    const entry = {
      ts: new Date().toISOString(),
      action: 'sigstop_sigcont',
      runId,
      phase: 'cont',
      target: `pid:${pid}`,
      targetRecord: record,
      signal: 'SIGCONT',
      outcome: 'fire_failed',
      error: e.message,
    };
    logStructured(entry);
    console.error(`Error: Failed to send SIGCONT to PID ${pid}: ${e.message}`);
    process.exit(1);
  }
}

// ── US-008: DB mutation action handlers ─────────────────────────────

/**
 * Verify the DB path is under TT_ROOT before any mutation.
 * Defense-in-depth check even though guardFire already validates this.
 */
function verifyDbPathForMutation() {
  const dbPath = path.resolve(resolveDbPath());
  if (!dbPath.startsWith(TT_ROOT + path.sep)) {
    console.error(`Error: DB path "${dbPath}" is not under ${TT_ROOT}`);
    process.exit(EXIT_GUARD_MISS);
  }
  return dbPath;
}

/**
 * delete-tstx-row: Delete TSTX evidence rows from the TT DB.
 * --tree <hash>: the tree hash to match for deletion.
 */
function deleteTstxRow(opts) {
  const { run: runId, args } = opts;
  // T2.1 US-010: W4.36 declares the sentinel tree `TESTEDTREE` (the tree is
  // unknowable at manifest authoring). Resolve it at FIRE time to the run's
  // ATTESTED tested tree — the `TESTED_TREE` the verifier emitted, carried in
  // the run context as `tested_tree` (the step-output key parser lowercases).
  // By the delete-tstx-row trigger (finalize pending) the verifier has run, so
  // the attested tree is present; a missing attestation fails loudly (never a
  // silent no-op deletion against the sentinel string).
  //
  // S28 (US-007): the resolution is fail-closed — resolveAttestedTestedTree
  // THROWS a precise one-line reason when the run context lacks a 40-hex
  // tested_tree (or the context row is unreadable). That throw must NEVER
  // escape as an uncaught exception (the campaign's W4.48c
  // `chaos operator 'tt-chaos' exited 1` was exactly that: a bare exit-1 with
  // a stack trace and NO structured chaos.log failure entry). Catch it here,
  // log a structured fire_failed entry, and exit with the precise
  // `delete-tstx-row: <reason> -- refusing` line so the operator/controller
  // sees why the injection could not run.
  let treeHash = args.tree;
  if (treeHash === 'TESTEDTREE') {
    try {
      treeHash = resolveAttestedTestedTree(runId);
    } catch (e) {
      const reason = e instanceof Error ? e.message : String(e);
      logStructured({
        ts: new Date().toISOString(), action: 'delete-tstx-row', runId,
        tree: 'TESTEDTREE', outcome: 'fire_failed', error: reason,
      });
      console.error(`delete-tstx-row: ${reason} -- refusing`);
      process.exit(1);
    }
  }

  if (!treeHash) {
    console.error('Error: --tree is required for delete-tstx-row');
    process.exit(1);
  }

  const dbPath = verifyDbPathForMutation();
  let db = null;
  let deletedCount = 0;

  try {
    db = new DatabaseSync(dbPath, { open: true });
    // T2.1 US-010: the product's suite ledger table is `suite_results` (the
    // tamandua-test shim's rows carry tree_hash/origin_repo/run_id/step_id);
    // the historical `tstx` table name never existed in the product schema,
    // so delete-tstx-row deleted 0 rows against a missing table (and errored
    // on the missing table). Delete the tested tree's suite rows — the
    // "TSTX evidence row" the drain-armed deletion corridor (W4.01/02/36/48c)
    // intends to make MISSING. A legacy `tstx` table is also honored when
    // present.
    const tables = db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name IN ('tstx','suite_results')").all();
    const hasSuiteResults = tables.some((row) => row.name === 'suite_results');
    const hasLegacyTstx = tables.some((row) => row.name === 'tstx');
    if (hasSuiteResults) {
      const result = db.prepare('DELETE FROM suite_results WHERE tree_hash = ?').run(treeHash);
      deletedCount += result.changes;
    }
    if (hasLegacyTstx) {
      const result = db.prepare('DELETE FROM tstx WHERE tree = ?').run(treeHash);
      deletedCount += result.changes;
    }
  } catch (e) {
    const entry = {
      ts: new Date().toISOString(), action: 'delete-tstx-row', runId,
      outcome: 'fire_failed', error: e.message,
    };
    logStructured(entry);
    console.error(`Error: delete-tstx-row failed: ${e.message}`);
    if (db) try { db.close(); } catch { /* ignore */ }
    process.exit(1);
  }

  try { db.close(); } catch { /* ignore */ }

  const entry = {
    ts: new Date().toISOString(), action: 'delete-tstx-row', runId,
    target: `tree:${treeHash}`, deletedCount,
    outcome: 'fired',
  };
  logStructured(entry);
  console.error(`delete-tstx-row: deleted ${deletedCount} row(s) for tree ${treeHash}`);
  process.exit(0);
}

/**
 * Resolve the TESTEDTREE sentinel to the run's attested tested tree.
 *
 * SCHEMA (documented — S28 US-007): the run's attested tested tree lives in
 * the contained TT DB `runs` row's `context` column — a JSON string whose
 * `tested_tree` key carries the 40-hex tree the verifier attested (the
 * step-output key parser lowercases `TESTED_TREE` → `tested_tree`; the
 * product also seeds `tested_tree` at run creation from the origin commit's
 * tree — src/installer/run.ts). The PRODUCT runs table keys on `id` = RAW
 * uuid (no `run-` prefix) while the controller passes `run-<uuid>`; the
 * tt-chaos test fixtures key on `run_id`. Every (column, spelling) candidate
 * is probed tolerantly (queryRunRowTolerant) — a schema mismatch degrades to
 * a precise one-line throw, never a crash.
 *
 * Returns context.tested_tree when it is a 40-hex tree. Throws a precise
 * one-line reason when the run has not attested a tree (or the context row is
 * unreadable / not JSON) — the caller (deleteTstxRow) converts the throw into
 * a structured fire_failed entry + `-- refusing` exit (never an uncaught
 * exception).
 */
function resolveAttestedTestedTree(runId) {
  const dbPath = resolveDbPath();
  const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
  let db = null;
  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
    const row = queryRunRowTolerant(db, runId, shortRunId);
    if (row === undefined || typeof row.context !== 'string') {
      throw new Error(`run ${runId} has no readable context row`);
    }
    let context;
    try {
      context = JSON.parse(row.context);
    } catch (e) {
      throw new Error(`run ${runId} context is not JSON: ${e.message}`);
    }
    const attested = typeof context.tested_tree === 'string'
      && /^[0-9a-f]{40}$/.test(context.tested_tree)
      ? context.tested_tree
      : null;
    if (attested === null) {
      throw new Error(`run ${runId} has no attested tested_tree in context`);
    }
    return attested;
  } finally {
    if (db) try { db.close(); } catch { /* ignore */ }
  }
}

/**
 * write-context: Write/overwrite a context key in the TT DB.
 * --key <k> --value <v>: the key-value pair to write.
 */
function writeContext(opts) {
  const { run: runId, args } = opts;
  const key = args.key;
  const value = args.value;

  if (!key) {
    console.error('Error: --key is required for write-context');
    process.exit(1);
  }
  if (value === undefined) {
    console.error('Error: --value is required for write-context');
    process.exit(1);
  }

  const dbPath = verifyDbPathForMutation();
  let db = null;

  try {
    db = new DatabaseSync(dbPath, { open: true });
    db.exec(`
      CREATE TABLE IF NOT EXISTS run_context (
        run_id TEXT NOT NULL,
        key TEXT NOT NULL,
        value TEXT,
        PRIMARY KEY (run_id, key)
      )
    `);
    db.prepare('INSERT OR REPLACE INTO run_context (run_id, key, value) VALUES (?, ?, ?)').run(runId, key, value);
  } catch (e) {
    const entry = {
      ts: new Date().toISOString(), action: 'write-context', runId,
      outcome: 'fire_failed', error: e.message,
    };
    logStructured(entry);
    console.error(`Error: write-context failed: ${e.message}`);
    if (db) try { db.close(); } catch { /* ignore */ }
    process.exit(1);
  }

  try { db.close(); } catch { /* ignore */ }

  const entry = {
    ts: new Date().toISOString(), action: 'write-context', runId,
    target: `key:${key}`, key, value: value.slice(0, 200),
    outcome: 'fired',
  };
  logStructured(entry);
  console.error(`write-context: wrote key "${key}" = "${value.slice(0, 80)}" for run ${runId}`);
  process.exit(0);
}

// ── US-007: Git mutation action handlers ────────────────────────────

/**
 * colleague-commit: Make a competing commit from a second clone perspective.
 * Uses plain git (git -C <repo>) to modify a file, stage it, and commit.
 */
function colleagueCommit(opts) {
  const { run: runId, args } = opts;
  const repo = args.repo;
  const file = args.file;

  if (!repo) {
    console.error('Error: --repo is required for colleague-commit');
    process.exit(1);
  }
  if (!file) {
    console.error('Error: --file is required for colleague-commit');
    process.exit(1);
  }

  const repoPath = path.resolve(repo);
  const filePath = path.join(repoPath, file);
  const sentinel = args.line || ('CHAOS MARKER ' + new Date().toISOString());

  // Verify the repo path exists
  try { fs.accessSync(repoPath); } catch {
    const entry = { ts: new Date().toISOString(), action: 'colleague-commit', runId, outcome: 'target_not_found', error: `Repo path does not exist: ${repoPath}` };
    logStructured(entry);
    console.error(`Error: Repo path does not exist: ${repoPath}`);
    process.exit(1);
  }

  let commitHash = '';
  try {
    // Append the sentinel line to the file (create if absent)
    fs.appendFileSync(filePath, sentinel + '\n');

    // Stage and commit
    execSync(`git -C "${repoPath}" add -- "${file}"`, { encoding: 'utf-8', timeout: 10000 });
    const result = execSync(
      `git -C "${repoPath}" commit -m "chaos: colleague commit — ${sentinel.slice(0, 72)}"`,
      { encoding: 'utf-8', timeout: 10000, env: { ...process.env, GIT_AUTHOR_NAME: 'Chaos Operator', GIT_AUTHOR_EMAIL: 'chaos@tamandua.test', GIT_COMMITTER_NAME: 'Chaos Operator', GIT_COMMITTER_EMAIL: 'chaos@tamandua.test' } }
    );
    // Extract commit hash from output
    const match = result.match(/\[\S+\s+([a-f0-9]+)\]/);
    if (match) commitHash = match[1];
  } catch (e) {
    const entry = { ts: new Date().toISOString(), action: 'colleague-commit', runId, outcome: 'fire_failed', error: e.message };
    logStructured(entry);
    console.error(`Error: colleague-commit failed: ${e.message}`);
    process.exit(1);
  }

  const entry = {
    ts: new Date().toISOString(), action: 'colleague-commit', runId,
    target: `repo:${repoPath} file:${file}`, sentinel,
    commit: commitHash || undefined, outcome: 'fired',
  };
  logStructured(entry);
  console.error(`colleague-commit: committed "${sentinel.slice(0, 60)}" to ${file} in ${repoPath} (${commitHash || 'unknown hash'})`);
  process.exit(0);
}

/**
 * dirty-tree: Modify a tracked file without committing to create PARK bait.
 * Appends a sentinel line to the first tracked file in the repo.
 */
function dirtyTree(opts) {
  const { run: runId, args } = opts;
  const repo = args.repo;

  if (!repo) {
    console.error('Error: --repo is required for dirty-tree');
    process.exit(1);
  }

  const repoPath = path.resolve(repo);

  try { fs.accessSync(repoPath); } catch {
    const entry = { ts: new Date().toISOString(), action: 'dirty-tree', runId, outcome: 'target_not_found', error: `Repo path does not exist: ${repoPath}` };
    logStructured(entry);
    console.error(`Error: Repo path does not exist: ${repoPath}`);
    process.exit(1);
  }

  let targetFile = '';
  let sentinel = '';
  try {
    // Find a tracked file to dirty
    const tracked = execSync(`git -C "${repoPath}" ls-files`, { encoding: 'utf-8', timeout: 10000 }).trim().split('\n').filter(Boolean);
    if (tracked.length === 0) {
      console.error('Error: No tracked files in repo to dirty');
      process.exit(1);
    }
    targetFile = tracked[0];
    sentinel = 'CHAOS DIRTY ' + new Date().toISOString();

    fs.appendFileSync(path.join(repoPath, targetFile), sentinel + '\n');
  } catch (e) {
    const entry = { ts: new Date().toISOString(), action: 'dirty-tree', runId, outcome: 'fire_failed', error: e.message };
    logStructured(entry);
    console.error(`Error: dirty-tree failed: ${e.message}`);
    process.exit(1);
  }

  const entry = {
    ts: new Date().toISOString(), action: 'dirty-tree', runId,
    target: `repo:${repoPath} file:${targetFile}`, sentinel,
    outcome: 'fired',
  };
  logStructured(entry);
  console.error(`dirty-tree: modified ${targetFile} in ${repoPath}`);
  process.exit(0);
}

/**
 * move-branch: Move a ref in the origin repo (bare OR work clone — the
 * worktree-origin repository a bfmw run merges into is the non-bare work
 * clone) to create rugpull pressure. Moves the ref to its parent commit
 * (ref~1) using plain `git -C` so bare and non-bare repos behave identically.
 *
 * US-004 (S29 premise redesign): --repeat <n> [--interval <s>] performs the
 * PERSISTENT colleague target-move the W4.33d/W4.48b corridors need. First
 * the operator ARMS a move budget: `repeat` EMPTY-DIFF "colleague" commits
 * pushed onto the target ref (commit-tree with the ref's tree — the tree
 * never changes, so downstream merges stay clean; this also gives a
 * single-commit fixture main enough parents to move back through). Then the
 * loop moves the ref back one parent per move: the first move lands at the
 * armed phase marker, each subsequent move lands interval seconds later, and
 * the loop STANDS DOWN (mechanizing the "operator removes the rejection
 * condition" protocol) as soon as the run is observed terminal (status or a
 * run.* terminal event in the append-only event stream), so a `resume` fired
 * on `event:run.failed` re-runs the finalize against a STABLE target. Each
 * move logs its own chaos.log entry (move_index/from/to) — the per-attempt
 * evidence O16/oracle cross-checks.
 */
function moveBranch(opts) {
  const { run: runId, args } = opts;
  // US-007 (S36): the re-arm loop bounds each between-attempt wait with the
  // same --timeout as the initial marker wait (default 120s; the controller
  // passes the manifest wait_timeout_s).
  const timeoutSec = Number.isInteger(opts.timeout) && opts.timeout > 0 ? opts.timeout : DEFAULT_TIMEOUT_S;
  const repo = args.repo;
  const ref = args.ref;

  if (!repo) {
    console.error('Error: --repo is required for move-branch');
    process.exit(1);
  }
  if (!ref) {
    console.error('Error: --ref is required for move-branch');
    process.exit(1);
  }

  const repeatRaw = args.repeat === undefined ? '1' : args.repeat;
  const repeat = Number(repeatRaw);
  if (!Number.isInteger(repeat) || repeat < 1) {
    console.error(`Error: --repeat must be a positive integer, got "${repeatRaw}"`);
    process.exit(1);
  }
  const intervalRaw = args.interval;
  const interval = intervalRaw === undefined ? 0 : Number(intervalRaw);
  if (repeat > 1 && (!Number.isInteger(interval) || interval < 1)) {
    console.error(`Error: --interval must be a positive integer when --repeat > 1, got "${intervalRaw}"`);
    process.exit(1);
  }
  if (repeat === 1 && intervalRaw !== undefined) {
    console.error('Error: --interval requires --repeat > 1 (a single move needs no interval)');
    process.exit(1);
  }

  // US-007 (S36): per-attempt re-arm mode. With --rearm each move is
  // triggered by a FRESH step:<role>:running occurrence in the run's own
  // event stream (the step transitions waiting->pending->running on every
  // reroute cycle) instead of a free-running clock — the redesign that makes
  // EVERY finalize attempt observe a moved tip (the S36 root cause: a
  // free-running 60s cadence never re-armed per attempt). Fail closed on a
  // malformed re-arm declaration.
  const rearm = args.rearm === 'true' || args.rearm === '1';
  const rearmHoldRaw = args['rearm-hold-s'];
  const rearmHoldS = rearmHoldRaw === undefined ? 0 : Number(rearmHoldRaw);
  if (rearm && (rearmHoldRaw === undefined || !Number.isInteger(rearmHoldS) || rearmHoldS < 1)) {
    console.error('Error: --rearm-hold-s must be a positive integer (the post-marker hold before each re-armed move), got "' + rearmHoldRaw + '"');
    process.exit(1);
  }
  if (!rearm && rearmHoldRaw !== undefined) {
    console.error('Error: --rearm-hold-s requires --rearm (the post-marker hold is a re-arm mode parameter)');
    process.exit(1);
  }
  if (rearm && repeat === 1) {
    console.error('Error: --rearm requires --repeat > 1 (the per-attempt re-arm loop needs at least two moves)');
    process.exit(1);
  }

  const repoPath = path.resolve(repo);

  try { fs.accessSync(repoPath); } catch {
    const entry = { ts: new Date().toISOString(), action: 'move-branch', runId, outcome: 'target_not_found', error: `Repo path does not exist: ${repoPath}` };
    logStructured(entry);
    console.error(`Error: Repo path does not exist: ${repoPath}`);
    process.exit(1);
  }

  // Resolve the full ref path once (handles short names like "main" →
  // "refs/heads/main"); fails closed with a precise reason when the ref does
  // not resolve in the repo.
  let resolvedRef = '';
  try {
    resolvedRef = execSync(`git -C "${repoPath}" rev-parse --symbolic-full-name "${ref}"`, {
      encoding: 'utf-8', timeout: 10000,
    }).trim();
    if (resolvedRef === '') throw new Error(`ref "${ref}" does not resolve in ${repoPath}`);
  } catch {
    // If --symbolic-full-name fails, prepend refs/heads/ and verify
    resolvedRef = `refs/heads/${ref}`;
    try {
      execSync(`git -C "${repoPath}" rev-parse --verify "${resolvedRef}^{commit}"`, {
        encoding: 'utf-8', timeout: 10000,
      });
    } catch {
      const entry = {
        ts: new Date().toISOString(), action: 'move-branch', runId,
        target: `repo:${repoPath} ref:${ref}`, outcome: 'fire_failed',
        error: `Ref "${ref}" does not resolve to a commit in ${repoPath}`,
      };
      logStructured(entry);
      console.error(`Error: Ref "${ref}" does not resolve to a commit in ${repoPath}`);
      process.exit(1);
    }
  }

  // US-004: arm the colleague move budget BEFORE the loop. The loop moves the
  // ref back one parent per move; a fixture's target branch may be too shallow
  // for a PERSISTENT (repeat > 1) injection (the tt-ts golden main is a single
  // commit — there are no parents to walk back through). The budget pushes
  // exactly the DEFICIT of EMPTY-DIFF "colleague" commits (git commit-tree
  // with the ref's current tree + parent, so the target's TREE is unchanged —
  // the merges downstream stay clean) so the ref has >= repeat parents. A
  // single move (repeat == 1) never arms a budget — the legacy shallow-ref
  // failure (no parent) is preserved, and a multi-commit ref needs no budget.
  // Fail-closed: a budget that cannot be armed is a fire_failed, never a
  // silent half-injection.
  const armMoveBudget = () => {
    if (repeat <= 1) return true;
    let depth = 0;
    try {
      depth = Number(execSync(`git -C "${repoPath}" rev-list --count "${resolvedRef}"`, {
        encoding: 'utf-8', timeout: 10000,
      }).trim());
    } catch (e) {
      const entry = { ts: new Date().toISOString(), action: 'move-branch', runId, outcome: 'fire_failed', error: `cannot count ${ref} history: ${e.message}` };
      logStructured(entry);
      console.error(`Error: cannot count ${ref} history: ${e.message}`);
      return false;
    }
    const deficit = Math.max(0, repeat - Math.max(0, depth - 1));
    if (deficit === 0) return true;
    const gitEnv = {
      ...process.env,
      GIT_AUTHOR_NAME: 'Chaos Operator',
      GIT_AUTHOR_EMAIL: 'chaos@tamandua.test',
      GIT_COMMITTER_NAME: 'Chaos Operator',
      GIT_COMMITTER_EMAIL: 'chaos@tamandua.test',
    };
    let parentHash = '';
    try {
      parentHash = execSync(`git -C "${repoPath}" rev-parse --verify "${resolvedRef}^{commit}"`, {
        encoding: 'utf-8', timeout: 10000,
      }).trim();
    } catch (e) {
      const entry = { ts: new Date().toISOString(), action: 'move-branch', runId, outcome: 'fire_failed', error: `cannot arm move budget — resolve ${ref}: ${e.message}` };
      logStructured(entry);
      console.error(`Error: cannot arm move budget — resolve ${ref}: ${e.message}`);
      return false;
    }
    const treeHash = execSync(`git -C "${repoPath}" rev-parse --verify "${resolvedRef}^{tree}"`, {
      encoding: 'utf-8', timeout: 10000,
    }).trim();
    for (let i = 1; i <= deficit; i++) {
      try {
        const newHash = execSync(`git -C "${repoPath}" commit-tree "${treeHash}" -p "${parentHash}" -m "chaos: colleague budget ${i}/${deficit}"`, {
          encoding: 'utf-8', timeout: 10000, env: gitEnv,
        }).trim();
        execSync(`git -C "${repoPath}" update-ref "${resolvedRef}" "${newHash}" "${parentHash}"`, {
          encoding: 'utf-8', timeout: 10000,
        });
        parentHash = newHash;
      } catch (e) {
        const entry = { ts: new Date().toISOString(), action: 'move-branch', runId, outcome: 'fire_failed', budget_move: i, error: `cannot arm move budget commit ${i}/${deficit}: ${e.message}` };
        logStructured(entry);
        console.error(`Error: cannot arm move budget commit ${i}/${deficit}: ${e.message}`);
        return false;
      }
    }
    logStructured({
      ts: new Date().toISOString(), action: 'move-branch', runId,
      target: `repo:${repoPath} ref:${ref}`, outcome: 'budget_armed', budget_commits: deficit,
      history_depth: depth,
    });
    return true;
  };

  // One move: ref → ref~1, logged with move_index. Returns the new hash, or
  // null after logging fire_failed (the caller fails closed — no silent
  // partial injection).
  const moveOnce = (moveIndex) => {
    let currentHash = '';
    try {
      currentHash = execSync(`git -C "${repoPath}" rev-parse --verify "${resolvedRef}^{commit}"`, {
        encoding: 'utf-8', timeout: 10000,
      }).trim();
    } catch (e) {
      const entry = { ts: new Date().toISOString(), action: 'move-branch', runId, move_index: moveIndex, target: `repo:${repoPath} ref:${ref}`, outcome: 'fire_failed', error: e.message };
      logStructured(entry);
      console.error(`Error: move-branch failed resolving ${ref}: ${e.message}`);
      return null;
    }
    let parentHash = '';
    try {
      parentHash = execSync(`git -C "${repoPath}" rev-parse --verify "${currentHash}~1"`, {
        encoding: 'utf-8', timeout: 10000,
      }).trim();
    } catch {
      const entry = {
        ts: new Date().toISOString(), action: 'move-branch', runId, move_index: moveIndex,
        target: `repo:${repoPath} ref:${ref}`, outcome: 'fire_failed',
        error: `Ref ${ref} (${currentHash}) has no parent commit to move to`,
      };
      logStructured(entry);
      console.error(`Error: Ref ${ref} (${currentHash}) has no parent commit — cannot move`);
      return null;
    }
    try {
      execSync(`git -C "${repoPath}" update-ref "${resolvedRef}" "${parentHash}"`, {
        encoding: 'utf-8', timeout: 10000,
      });
    } catch (e) {
      const entry = { ts: new Date().toISOString(), action: 'move-branch', runId, move_index: moveIndex, target: `repo:${repoPath} ref:${ref}`, outcome: 'fire_failed', error: e.message };
      logStructured(entry);
      console.error(`Error: move-branch failed: ${e.message}`);
      return null;
    }
    const entry = {
      ts: new Date().toISOString(), action: 'move-branch', runId, move_index: moveIndex,
      target: `repo:${repoPath} ref:${ref}`, from: currentHash, to: parentHash,
      outcome: 'fired',
    };
    logStructured(entry);
    console.error(`move-branch: moved ${ref} from ${currentHash.slice(0, 8)} to ${parentHash.slice(0, 8)} in ${repoPath} (move ${moveIndex}/${repeat})`);
    return parentHash;
  };

  if (!armMoveBudget()) process.exit(1); // fire_failed already logged

  // Stand-down helper (mechanized "operator removes the rejection
  // condition"): once the run is observed terminal, stop the moves so a
  // `resume` fired on event:run.failed re-runs the finalize against a STABLE
  // target. Logged once with the moves executed so far.
  const standDown = (movesExecutedSoFar, reason) => {
    logStructured({
      ts: new Date().toISOString(), action: 'move-branch', runId,
      phaseMarker: opts.when, target: `repo:${repoPath} ref:${ref}`,
      rearm: rearm || undefined,
      outcome: 'stand_down', moves_executed: movesExecutedSoFar,
      error: reason,
    });
    console.error(`move-branch: run ${runId} terminal after ${movesExecutedSoFar} move(s) — standing down the colleague target-moves`);
  };

  let movesExecuted = 0;

  if (rearm) {
    // ── US-007 (S36): per-attempt deterministic re-arm loop ─────────────
    // Each move is triggered by a FRESH step:<role>:running occurrence (the
    // step transitions waiting->pending->running on every reroute cycle) in
    // the run's OWN append-only event stream — never a free-running clock.
    // The main flow's phaseWait already armed on the FIRST occurrence; here
    // we (a) hold a short post-marker window so the merger's tip capture
    // precedes the move, (b) move, then (c) wait for the NEXT occurrence to
    // move again — guaranteeing EVERY finalize attempt observes a moved tip
    // until the reroute budget exhausts (run.failed) or the loop's repeat
    // ceiling is consumed. `interval` becomes a MINIMUM-SPACING floor (never
    // a cadence): moves are never fired more often than interval_s apart.
    const role = opts.when.startsWith('step:')
      ? opts.when.slice('step:'.length).split(':')[0]
      : null;
    const rearmHoldMs = rearmHoldS * 1000;
    // Baseline the attempt count. The current attempt's step.running event
    // may lag the DB status flip phaseWait observed — wait until the stream
    // includes it (>= 1 for the first attempt), standing down on run-terminal
    // and failing closed on a timeout (never a silent half-injection).
    let baseline = countStepRunningEvents(runId, role);
    if (baseline === 0) {
      const flushResult = waitForAttemptCount(runId, role, 0, timeoutSec);
      if (flushResult === 'terminal') {
        standDown(0, `run ${runId} reached terminal before the first step.running event flushed — colleague target-moves stopped`);
        process.exit(0);
      }
      if (flushResult === 'timeout') {
        logStructured({
          ts: new Date().toISOString(), action: 'move-branch', runId,
          phaseMarker: opts.when, target: `repo:${repoPath} ref:${ref}`,
          rearm: true, outcome: 'rearm_timeout', move_index: 1,
          error: `the current attempt's step.running event never flushed within ${timeoutSec}s of the marker — refusing to move blind`,
        });
        console.error(`move-branch: rearm abort — the current attempt's step.running event never flushed within ${timeoutSec}s`);
        process.exit(1);
      }
      baseline = countStepRunningEvents(runId, role);
    }
    let lastMoveAt = null;
    for (let moveIndex = 1; moveIndex <= repeat; moveIndex++) {
      if (moveIndex > 1) {
        // Wait for the NEXT fresh step:<role>:running occurrence (the next
        // finalize attempt after the reroute cycle).
        const waitResult = waitForAttemptCount(runId, role, baseline, timeoutSec);
        if (waitResult === 'terminal') {
          standDown(movesExecuted, `run ${runId} reached terminal while re-arming move ${moveIndex} — colleague target-moves stopped`);
          break;
        }
        if (waitResult === 'timeout') {
          logStructured({
            ts: new Date().toISOString(), action: 'move-branch', runId,
            phaseMarker: opts.when, target: `repo:${repoPath} ref:${ref}`,
            rearm: true, outcome: 'rearm_timeout', move_index: moveIndex,
            baseline_attempts: baseline,
            error: `no fresh step:${role}:running occurrence within ${timeoutSec}s of the previous attempt (baseline ${baseline} attempts) — the run is not re-attempting; failing closed`,
          });
          console.error(`move-branch: rearm timeout — no fresh step:${role}:running occurrence within ${timeoutSec}s (baseline ${baseline} attempts)`);
          process.exit(1);
        }
        logStructured({
          ts: new Date().toISOString(), action: 'move-branch', runId,
          phaseMarker: opts.when, target: `repo:${repoPath} ref:${ref}`,
          rearm: true, outcome: 'rearm_armed', move_index: moveIndex,
          attempt: baseline + 1,
        });
        // interval_s is a MINIMUM-SPACING floor: never fire moves closer
        // together than the declared interval (protects against a
        // pathological marker re-fire racing the previous move).
        if (interval > 0 && lastMoveAt !== null) {
          const remaining = interval * 1000 - (Date.now() - lastMoveAt);
          if (remaining > 0) {
            sleepSync(remaining);
            if (runTerminalObserved(runId)) {
              standDown(movesExecuted, `run ${runId} reached terminal during the interval floor — colleague target-moves stopped`);
              break;
            }
          }
        }
      }
      // Short post-marker hold so the merger's tip capture precedes the move
      // (the move lands INSIDE the attempt's expected-tip window).
      sleepSync(rearmHoldMs);
      if (runTerminalObserved(runId)) {
        standDown(movesExecuted, `run ${runId} reached terminal during the re-arm hold — colleague target-moves stopped`);
        break;
      }
      const newHash = moveOnce(moveIndex);
      if (newHash === null) process.exit(1); // fire_failed already logged
      movesExecuted = moveIndex;
      lastMoveAt = Date.now();
      baseline = countStepRunningEvents(runId, role);
    }
    process.exit(0);
  }

  for (let moveIndex = 1; moveIndex <= repeat; moveIndex++) {
    const newHash = moveOnce(moveIndex);
    if (newHash === null) process.exit(1); // fire_failed already logged
    movesExecuted = moveIndex;
    if (moveIndex < repeat) {
      sleepSync(interval * 1000);
      if (runTerminalObserved(runId)) {
        standDown(movesExecuted, `run ${runId} reached terminal — colleague target-moves stopped (operator stand-down mechanized) so a resume lands on a stable target`);
        break;
      }
    }
  }
  process.exit(0);
}

/**
 * runTerminalObserved: has the run reached a terminal state (status row OR a
 * run.* terminal event in the append-only event stream)? The event-stream
 * latch is the authoritative stop for the persistent-move loop: once
 * run.failed/run.completed/run.canceled is appended it stays appended, so a
 * `workflow resume` that re-activates the run row can never un-stop the
 * injection. Any read failure is EVIDENCE (keep the loop's cadence), never a
 * crash.
 */
function runTerminalObserved(runId) {
  const dbPath = resolveDbPath();
  let db = null;
  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
    const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
    const row = queryRunRowTolerant(db, runId, shortRunId);
    if (row !== undefined && typeof row.status === 'string'
        && TERMINAL_RUN_STATUSES.includes(row.status)) {
      return true;
    }
  } catch {
    // keep polling — a transient DB read is evidence, not a stop
  } finally {
    if (db) try { db.close(); } catch { /* ignore */ }
  }
  return readRunEventStreamLines(runId).some(
    (event) => event.event === 'run.failed' || event.event === 'run.completed' || event.event === 'run.canceled',
  );
}

// ── US-007 (S36): re-arm attempt counting ────────────────────────────
// The per-attempt re-arm loop (move-branch --rearm) triggers each move on a
// FRESH step:<role>:running occurrence. The step's DB status is LEVEL
// (running stays true until the reroute resets it — a fast waiting→pending→
// running cycle can slip between two 500ms polls), so the re-arm signal is
// the run's OWN append-only event stream: every attempt emits a `step.running`
// event (stepId = the workflow step id, agentId = the agent), and on every
// reroute cycle the consumer is reset to waiting and re-pended, emitting a
// fresh `step.running` per attempt. Counting those events is edge-triggered,
// durable and never missed. Mirrors checkStepMarker's dual match (step_id OR
// agent_id LIKE role).
function countStepRunningEvents(runId, role) {
  return readRunEventStreamLines(runId).filter((event) => {
    if (event.event !== 'step.running') return false;
    const stepId = String(event.stepId ?? event.step_id ?? '');
    const agentId = String(event.agentId ?? event.agent_id ?? '');
    return stepId === role || (agentId !== '' && agentId.includes(role));
  }).length;
}

/**
 * Wait until the run's event stream shows MORE step:<role>:running attempts
 * than baselineCount (a fresh finalize attempt has started). Polls the
 * append-only event stream every POLL_INTERVAL_MS, standing down the moment
 * the run is observed terminal (run.failed/run.completed/run.canceled — the
 * next attempt can no longer fire) and failing closed on timeout (the run is
 * not re-attempting — a silent wait would burn the case's wall budget).
 * Returns 'armed' | 'terminal' | 'timeout'.
 */
function waitForAttemptCount(runId, role, baselineCount, timeoutSec) {
  const deadline = Date.now() + timeoutSec * 1000;
  while (Date.now() < deadline) {
    if (runTerminalObserved(runId)) return 'terminal';
    if (countStepRunningEvents(runId, role) > baselineCount) return 'armed';
    // Busy-wait sleep via synchronous spin (sync alternative to setTimeout
    // for CLI scripts)
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, POLL_INTERVAL_MS);
  }
  return 'timeout';
}

// ── S28 (US-005): startup terminal-run guard ──────────────────────────
// A run that is ALREADY terminal when the operator spawns can never fire its
// trigger: waiting on it would linger until the contained daemon's post-run
// leak-guard sweep (sweepRunProcesses — cmdline-contains-runId matcher)
// SIGKILLs the operator, which surfaced as the campaign's `chaos operator
// 'tt-chaos' exited null` (S28). Refuse at startup, BEFORE phaseWait, with a
// precise one-line reason so the operator never lingers to be swept. Returns
// the terminal status string, or null when the run row is absent (test
// fixtures / unknown runs — the guard + phaseWait remain the fail-closed
// layers) or the DB read degrades (transient — proceed; the controller-side
// refusal is the primary gate for manifest-driven invocations).
function startupTerminalStatus(runId) {
  const dbPath = resolveDbPath();
  let db = null;
  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
    const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
    const row = queryRunRowTolerant(db, runId, shortRunId);
    if (row !== undefined && typeof row.status === 'string'
        && TERMINAL_RUN_STATUSES.includes(row.status)) {
      return row.status;
    }
  } catch {
    // degraded DB read — proceed (the run row could not be verified)
  } finally {
    if (db) try { db.close(); } catch { /* ignore */ }
  }
  return null;
}

// ── US-006: Execution control actions (pause, resume, cancel, stop) ───

/**
 * Resolve the tamandua binary path.
 * Priority: TAMANDUA_BINARY env var → <repo-root>/bin/tamandua → tamandua on PATH
 */
function resolveTamanduaBinary() {
  if (process.env.TAMANDUA_BINARY) {
    return process.env.TAMANDUA_BINARY;
  }
  const binPath = path.join(TT_REPO_ROOT, 'bin', 'tamandua');
  try {
    fs.accessSync(binPath, fs.constants.X_OK);
    return binPath;
  } catch {
    // Fallback to PATH
    return 'tamandua';
  }
}

/**
 * Build the environment for spawning the tamandua CLI under the TT env.
 * Uses TT-specific HOME, TAMANDUA_STATE_DIR, and port files so the CLI
 * talks to the TT daemon (43xx ports), never the production one (3334/3338/3339).
 */
function getTTSpawnEnv() {
  const env = { ...process.env };
  const ttHome = process.env.TT_HOME || path.resolve(TT_ROOT, '..', '..');
  env.HOME = ttHome;
  env.TAMANDUA_STATE_DIR = process.env.TAMANDUA_STATE_DIR || path.join(ttHome, '.tamandua');

  // Read port overrides from TT state dir files (if present)
  const stateDir = env.TAMANDUA_STATE_DIR;
  try {
    const port = fs.readFileSync(path.join(stateDir, 'port'), 'utf-8').trim();
    if (port) env.TAMANDUA_PORT = port;
  } catch { /* port file may not exist */ }
  try {
    const controlPort = fs.readFileSync(path.join(stateDir, 'control-port'), 'utf-8').trim();
    if (controlPort) env.TAMANDUA_CONTROL_PORT = controlPort;
  } catch { /* control-port file may not exist */ }
  try {
    const mcpPort = fs.readFileSync(path.join(stateDir, 'mcp-port'), 'utf-8').trim();
    if (mcpPort) env.TAMANDUA_MCP_PORT = mcpPort;
  } catch { /* mcp-port file may not exist */ }

  return env;
}

/**
 * Create an execution control handler for pause/resume/cancel/stop.
 * Each action maps to `tamandua workflow <action> <run-id>` invoked
 * via spawnSync under the TT spawn env.
 */
function makeExecutionControl(action) {
  return function (opts) {
    const { run: runId } = opts;
    const binary = resolveTamanduaBinary();
    const env = getTTSpawnEnv();

    const cliArgs = ['workflow', action, runId];

    try {
      const result = spawnSync(binary, cliArgs, {
        env,
        timeout: 30000,
        stdio: 'pipe',
        encoding: 'utf-8',
      });

      const stdout = (result.stdout || '').slice(0, 500);
      const stderr = (result.stderr || '').slice(0, 500);
      const status = result.status ?? (result.error ? -1 : null);
      const outcome = status === 0 ? 'fired' : 'execution_failed';

      const entry = {
        ts: new Date().toISOString(),
        action,
        runId,
        outcome,
        exitCode: status,
        stdout: stdout || undefined,
        stderr: stderr || undefined,
      };
      logStructured(entry);

      if (status !== 0) {
        console.error(`${action}: workflow ${action} failed for run ${runId} (exit ${status})`);
        if (stderr) console.error(stderr.slice(0, 200));
        process.exit(1);
      }

      console.error(`${action}: workflow ${action} invoked for run ${runId}`);
      process.exit(0);
    } catch (e) {
      const entry = {
        ts: new Date().toISOString(),
        action,
        runId,
        outcome: 'execution_failed',
        error: e.message,
      };
      logStructured(entry);
      console.error(`Error: ${action} failed: ${e.message}`);
      process.exit(1);
    }
  };
}

// ── Action dispatch table ─────────────────────────────────────────────

/** @type {Record<string, (opts: {run: string, when: string, timeout: number, args: Record<string, string>}) => void>} */
const dispatch = {
  'kill-harness': killHarness,
  'kill-daemon': killDaemon,
  'sigstop_sigcont': sigstopSigcont,
  'colleague-commit': colleagueCommit,
  pause: makeExecutionControl('pause'),
  resume: makeExecutionControl('resume'),
  cancel: makeExecutionControl('cancel'),
  stop: makeExecutionControl('stop'),
  'delete-tstx-row': deleteTstxRow,
  'write-context': writeContext,
  'dirty-tree': dirtyTree,
  'move-branch': moveBranch,
};

// ── Helper: resolve TT DB path ──────────────────────────────────────

function resolveDbPath() {
  if (process.env.TAMANDUA_STATE_DIR) {
    return path.resolve(process.env.TAMANDUA_STATE_DIR, 'tamandua.db');
  }
  if (process.env.TT_HOME) {
    return path.resolve(process.env.TT_HOME, '.tamandua', 'tamandua.db');
  }
  // Fallback: TT_HOME is at the parent of TT_ROOT (which is torture-test/var)
  return path.resolve(TT_ROOT, '..', '..', '.tamandua', 'tamandua.db');
}

/**
 * Look up a run row tolerantly across schemas + run-id spellings:
 *   - the contained PRODUCT runs table keys on `id` (RAW uuid, no `run-`
 *     prefix) while the controller passes `run-<uuid>`;
 *   - the tt-chaos test-suite fixture runs table keys on `run_id`.
 * Every candidate query is individually guarded (a missing column throws), so
 * a schema mismatch degrades to "not found", never a guard crash. Returns the
 * matched row or undefined.
 */
function queryRunRowTolerant(db, runId, shortRunId) {
  const candidates = [
    ['id', runId],
    ['id', shortRunId],
    ['run_id', runId],
    ['run_id', shortRunId],
  ];
  for (const [column, value] of candidates) {
    try {
      const row = db.prepare(`SELECT * FROM runs WHERE ${column} = ? LIMIT 1`).get(value);
      if (row !== undefined) return row;
    } catch {
      // Column may not exist in this schema — try the next candidate.
    }
  }
  return undefined;
}

// ── phase_wait: marker polling and timeout engine ────────────────────

/**
 * Poll for a phase marker with timeout.
 *
 * @param {string} marker - The phase marker expression
 * @param {number} timeoutSec - Max seconds to wait
 * @param {string} runId - The run ID for DB-scoped queries
 * @returns {{satisfied: boolean, reason?: string}}
 */
function phaseWait(marker, timeoutSec, runId) {
  // --when now: fire immediately, log as timed-not-triggered
  if (marker === 'now') {
    logStructured({ ts: new Date().toISOString(), action: 'phase_wait', runId, phaseMarker: marker, phaseSatisfied: false, outcome: 'timed_not_triggered' });
    return { satisfied: true };
  }

  let db = null;
  const needsDb = marker.startsWith('step:') || marker.startsWith('event:');

  if (needsDb) {
    const dbPath = resolveDbPath();
    try {
      db = new DatabaseSync(dbPath, { open: true, readOnly: true });
    } catch {
      // DB not available — can't poll step/event markers, fail after timeout
      // (let the poll loop handle it so error is clean)
    }
  }

  const deadline = Date.now() + timeoutSec * 1000;

  while (Date.now() < deadline) {
    const found = checkMarker(marker, db, runId);
    if (found) {
      logStructured({ ts: new Date().toISOString(), action: 'phase_wait', runId, phaseMarker: marker, phaseSatisfied: true, outcome: 'marker_satisfied' });
      if (db) db.close();
      return { satisfied: true };
    }
    // US-004 (S29 premise redesign): never wait out the full timeout against
    // a run that already went terminal — the marker can no longer fire, so
    // the operator fails closed NOW (exit 2 TRIGGER_NEVER) instead of burning
    // the case's wall budget on a silent wait (the S29 defect class).
    if (runTerminalObserved(runId)) {
      logStructured({ ts: new Date().toISOString(), action: 'phase_wait', runId, phaseMarker: marker, phaseSatisfied: false, outcome: 'run_terminal_before_marker' });
      if (db) db.close();
      return { satisfied: false, reason: 'RUN_TERMINAL_BEFORE_MARKER' };
    }
    // Busy-wait sleep via synchronous spin (sync alternative to setTimeout for CLI scripts)
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, POLL_INTERVAL_MS);
  }

  if (db) db.close();

  logStructured({ ts: new Date().toISOString(), action: 'phase_wait', runId, phaseMarker: marker, phaseSatisfied: false, outcome: 'trigger_never_materialized' });
  return { satisfied: false, reason: 'TRIGGER_NEVER_MATERIALIZED' };
}

/**
 * Check if a specific marker is currently satisfied.
 */
function checkMarker(marker, db, runId) {
  if (marker.startsWith('step:')) {
    return checkStepMarker(marker, db, runId);
  }
  if (marker.startsWith('event:')) {
    return checkEventMarker(marker, db, runId);
  }
  if (marker.startsWith('file:')) {
    return checkFileMarker(marker);
  }
  return false;
}

/**
 * Check step:<role>:<state> marker.
 * Format: step:<role>:<state> (exact match on agent_id containing role, status exact match)
 *
 * The contained product DB stores run_id as the RAW UUID (no `run-` prefix),
 * while the controller's probe machinery hands tt-chaos the full `run-<uuid>`
 * spelling — so BOTH spellings are probed (mirrors the controller's
 * probeStepMarkerSatisfied dual-spelling contract; without it the marker can
 * never fire against a real contained instance and the chaos operator exits
 * 2 TRIGGER_NEVER_MATERIALIZED).
 */
function checkStepMarker(marker, db, runId) {
  if (!db) return false;
  const parts = marker.slice('step:'.length).split(':');
  if (parts.length !== 2) return false;
  const [role, state] = parts;
  const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;

  // T2.1 US-010: match the step by STEP ID OR agent role, mirroring the
  // controller's probeStepMarkerSatisfied. Manifest phase markers name the
  // WORKFLOW STEP (`step:finalize_merge:pending` names the finalize_merge
  // step whose agent is `merger`), while `step:developer:running` names the
  // developer AGENT of the implement step — both spellings must arm the
  // chaos trigger or the operator exits 2 TRIGGER_NEVER_MATERIALIZED
  // against a real contained instance.
  try {
    const rows = db.prepare(
      `SELECT 1 FROM steps WHERE run_id = ? AND (step_id = ? OR agent_id LIKE ?) AND status = ? LIMIT 1`
    ).all(runId, role, `%${role}%`, state);
    if (rows.length > 0) return true;
    if (shortRunId !== runId) {
      const shortRows = db.prepare(
        `SELECT 1 FROM steps WHERE run_id = ? AND (step_id = ? OR agent_id LIKE ?) AND status = ? LIMIT 1`
      ).all(shortRunId, role, `%${role}%`, state);
      return shortRows.length > 0;
    }
    return false;
  } catch {
    return false;
  }
}

/**
 * Read the contained event-stream files for a run (both run-id spellings),
 * newest-last, bounded to keep evidence manageable. Returns [] on any
 * read/parse failure — the caller treats that as EVIDENCE, never a crash.
 * Mirrors the controller's readRunEventStream contract (the product keeps
 * events in <state>/events/<uuid>.jsonl + all.jsonl[.N] archives; there is NO
 * events table in the product DB).
 */
function readRunEventStreamLines(runId) {
  const stateDir = process.env.TAMANDUA_STATE_DIR;
  if (!stateDir) return [];
  const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
  const eventsDir = path.resolve(stateDir, 'events');
  const eventPaths = [
    path.join(eventsDir, `${shortRunId}.jsonl`),
    path.join(eventsDir, `${runId}.jsonl`),
    ...[3, 2, 1].map((suffix) => path.join(eventsDir, `all.jsonl.${suffix}`)),
    path.join(eventsDir, 'all.jsonl'),
  ];
  const events = [];
  for (const eventsPath of eventPaths) {
    let source;
    try {
      source = fs.readFileSync(eventsPath, 'utf8');
    } catch {
      continue;
    }
    for (const line of source.split(/\r?\n/)) {
      if (line.trim() === '') continue;
      let event;
      try {
        event = JSON.parse(line);
      } catch {
        continue;
      }
      if (typeof event.event !== 'string') continue;
      const eventRunId = String(event.runId ?? event.run_id ?? '');
      if (eventRunId !== runId && eventRunId !== shortRunId) continue;
      events.push(event);
    }
  }
  return events.slice(-200);
}

/**
 * Check event:<type> marker.
 * Format: event:<type> (substring match on the event name)
 *
 * The product keeps events in the contained EVENT STREAM FILES — there is NO
 * events table in the product DB, so the marker polls the stream files for
 * this run (both run-id spellings), mirroring the controller's
 * readRunEventStream contract. A stream read failure is EVIDENCE (keep
 * polling), never a crash.
 */
function checkEventMarker(marker, db, runId) {
  const eventType = marker.slice('event:'.length);
  return readRunEventStreamLines(runId).some((event) => event.event.includes(eventType));
}

/**
 * Check file:<path> marker.
 * Format: file:<path> (fs.accessSync for existence)
 */
function checkFileMarker(marker) {
  const filePath = marker.slice('file:'.length);
  try {
    fs.accessSync(filePath, fs.constants.F_OK);
    return true;
  } catch {
    return false;
  }
}

/**
 * Validate --when marker format.
 */
function validateMarker(marker) {
  if (marker === 'now') return true;
  if (marker.startsWith('step:') && marker.slice('step:'.length).includes(':')) return true;
  if (marker.startsWith('event:') && marker.slice('event:'.length).length > 0) return true;
  if (marker.startsWith('file:') && marker.slice('file:'.length).length > 0) return true;
  return false;
}

// ── Target guard classification ─────────────────────────────────────

/**
 * Classify whether an action targets a process, filesystem path, or DB.
 * Returns { kind: 'process'|'filesystem'|'db'|'none', path?: string }.
 */
function classifyTarget(action, opts) {
  const processActions = ['kill-harness', 'kill-daemon', 'sigstop_sigcont'];
  const fsActions = ['colleague-commit', 'dirty-tree', 'move-branch'];
  const dbActions = ['delete-tstx-row', 'write-context'];

  if (processActions.includes(action)) {
    return { kind: 'process' };
  }
  if (fsActions.includes(action)) {
    // Resolve the --repo path if present
    const repoPath = opts.args.repo || '';
    return { kind: 'filesystem', path: repoPath ? path.resolve(repoPath) : '' };
  }
  if (dbActions.includes(action)) {
    return { kind: 'db', path: resolveDbPath() };
  }
  return { kind: 'none' };
}

/**
 * Target guard — called immediately before every fire.
 * Checks:
 *   (a) --run id exists in TT DB and is non-terminal (where relevant)
 *   (b) process cwd/cmdline contain torture-test/var (process actions)
 *   (c) repo path is under torture-test/var (filesystem actions)
 *   (d) DB path is under torture-test/var (DB-mutating actions)
 *
 * @returns {{guarded: true} | {guarded: false, reason: string}}
 */
function guardFire(action, runId, opts) {
  const target = classifyTarget(action, opts);

  // (a) Run existence check
  const dbPath = resolveDbPath();
  let db = null;
  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
  } catch {
    return { guarded: false, reason: `Cannot open TT DB at ${dbPath} for guard check` };
  }

  try {
    // The contained product runs table keys on `id` (RAW uuid — no `run-`
    // prefix), while the controller passes the full `run-<uuid>` spelling;
    // both spellings are probed (mirrors the phase-marker dual-spelling
    // contract). The test-suite fixture DB keys on `run_id` — tolerate both
    // column names so the guard works against the real product schema AND
    // the tt-chaos test fixtures. Product terminal statuses use the American
    // spelling ('canceled'), not the legacy 'cancelled'.
    const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
    const row = queryRunRowTolerant(db, runId, shortRunId);
    if (row === undefined) {
      db.close();
      return { guarded: false, reason: `Run ${runId} not found in TT DB` };
    }
    const status = row.status;
    const terminalStatuses = ['completed', 'failed', 'canceled', 'stopped'];
    if (terminalStatuses.includes(status)) {
      db.close();
      return { guarded: false, reason: `Run ${runId} is terminal (${status}) — refusing to fire` };
    }
  } catch (e) {
    db.close();
    return { guarded: false, reason: `DB query failed during guard check: ${e.message}` };
  }
  db.close();

  // (b) Process target check — resolve from EXPLICIT RECORDED identity only
  // (US-002: --target-* args, steps-table claim row, or daemon pidfile —
  // NEVER a /proc cwd/cmdline sweep, which can match the operator's own
  // ancestry) and verify before any signal can fire.
  if (target.kind === 'process') {
    const record = resolveTargetRecord(action, opts);
    if (!record) {
      return { guarded: false, reason: `No recorded kill target for ${action} run ${runId} (explicit --target-* args, steps claim row, or daemon pidfile) — refusing to resolve by scan` };
    }
    if (record.error) {
      return { guarded: false, reason: record.error };
    }
    // S28 (US-006): kill-daemon targets (pidfile-resolved) verify WITHOUT the
    // strict cwd/cmdline provenance requirement (the real contained daemon's
    // cwd/cmdline contains neither TT_ROOT nor the run id); harness targets
    // keep the strict check, falling back to the S33 (US-004) positive
    // tt-ownership evidence chain when the strict check fails (never a
    // weakening — no chain proof still refuses fail-closed).
    const kind = action === 'kill-daemon' ? 'daemon' : 'harness';
    const verdict = verifyKillTarget(record, runId, kind);
    if (!verdict.ok) {
      return { guarded: false, reason: verdict.reason };
    }
  }

  // (c) Filesystem path check
  if (target.kind === 'filesystem') {
    const resolvedPath = target.path;
    if (!resolvedPath || !resolvedPath.startsWith(TT_ROOT + path.sep)) {
      return { guarded: false, reason: `Path "${resolvedPath}" is not under ${TT_ROOT}` };
    }
  }

  // (d) DB path check
  if (target.kind === 'db') {
    const resolvedDbPath = target.path;
    if (!resolvedDbPath || !resolvedDbPath.startsWith(TT_ROOT + path.sep)) {
      return { guarded: false, reason: `DB path "${resolvedDbPath}" is not under ${TT_ROOT}` };
    }
  }

  return { guarded: true };
}

/**
 * Resolve the kill target for a process action from EXPLICIT RECORDED
 * identity ONLY — never a /proc cwd/cmdline sweep (the E3.C.1 root-cause
 * class: a sweep can match a repo-cwd process in the operator's own
 * ancestry whose cmdline carries the runId / 'daemon' token, and SIGKILL
 * the worker/harness that spawned the test).
 *
 * Resolution order (US-002):
 *   1. explicit --target-pid / --target-pgid / --target-start-time args
 *      passed by the caller (the controller records the harness at spawn);
 *   2. the contained TT DB steps table's recorded claim_pid/claim_pgid for
 *      the run (the product's own explicit worker-ownership record);
 *   3. the TT daemon pidfile PID (kill-daemon only — already explicit).
 *
 * Returns a record { pid, pgid?, startTime? }, null when no explicit record
 * exists (the caller must refuse — never fall back to a scan), or
 * { error } for malformed explicit values.
 */
function resolveTargetRecord(action, opts) {
  const args = opts.args || {};
  if (action === 'kill-harness' || action === 'sigstop_sigcont') {
    if (args['target-pid'] !== undefined && args['target-pid'] !== '') {
      const pid = Number(args['target-pid']);
      if (!Number.isInteger(pid) || pid <= 0) {
        return { error: `invalid --target-pid "${args['target-pid']}"` };
      }
      const record = { pid };
      if (args['target-pgid'] !== undefined && args['target-pgid'] !== '') {
        const pgid = Number(args['target-pgid']);
        if (!Number.isInteger(pgid) || pgid <= 0) {
          return { error: `invalid --target-pgid "${args['target-pgid']}"` };
        }
        record.pgid = pgid;
      }
      if (args['target-start-time'] !== undefined && args['target-start-time'] !== '') {
        const raw = String(args['target-start-time']);
        record.startTime = raw.startsWith('proc:') ? raw : `proc:${raw}`;
      }
      return record;
    }
    // Fallback: the product's own explicit record — the steps table's
    // claim_pid/claim_pgid for the run (never a process scan).
    return resolveFromStepsTable(opts.run);
  }
  if (action === 'kill-daemon') {
    return readDaemonPidfile();
  }
  return null;
}

/**
 * Resolve the harness target from the contained TT DB steps table's
 * recorded claim_pid/claim_pgid for the run (the product's explicit
 * worker-ownership record — tt-chaos already reads the steps table).
 * Tolerant of both run-id spellings and of a missing claim_pid column.
 *
 * Product semantics (step-ops C18): claim_pid is the owning DAEMON pid;
 * claim_pgid is the HARNESS process group recorded at claim time — the
 * detached harness is its own group leader, so the harness pid equals the
 * recorded pgid. The kill target is therefore { pid: claim_pgid,
 * pgid: claim_pgid } (the harness), NEVER claim_pid (killing the daemon is
 * kill-daemon's job). When no harness group is recorded the resolution
 * fails closed (null) — no daemon-pid fallback for a harness kill.
 * Returns { pid, pgid } or null when no harness claim row exists.
 */
function resolveFromStepsTable(runId) {
  const dbPath = resolveDbPath();
  let db = null;
  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
  } catch {
    return null;
  }
  try {
    const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
    for (const rid of [runId, shortRunId]) {
      try {
        const row = db.prepare(
          `SELECT claim_pid, claim_pgid FROM steps WHERE run_id = ? AND claim_pid IS NOT NULL AND claim_pid > 0 ORDER BY rowid DESC LIMIT 1`
        ).get(rid);
        if (row && row.claim_pid !== null && row.claim_pid !== undefined && Number(row.claim_pid) > 0) {
          if (row.claim_pgid !== null && row.claim_pgid !== undefined && Number(row.claim_pgid) > 0) {
            // Harness process group leader (pid == pgid for a detached harness).
            const pgid = Number(row.claim_pgid);
            return { pid: pgid, pgid };
          }
          return null; // no recorded harness group — refuse rather than hit the daemon
        }
      } catch {
        // claim_pid column may not exist in this schema — try the next spelling.
      }
    }
  } finally {
    try { db.close(); } catch { /* ignore */ }
  }
  return null;
}

/**
 * Read the TT daemon PID from its pidfile. The contained daemon writes
 * <state-dir>/tamandua.pid (daemon-control / tt-daemon-up); the legacy
 * <TT_HOME>/.tamandua/daemon.pid fixture path is also accepted. Returns
 * { pid, pidfile } or null when no pidfile exists. NEVER falls back to a
 * /proc daemon scan — an absent pidfile is a hard refusal (GUARD_MISS).
 *
 * S28 (US-006): the pidfile ITSELF must live under TT_ROOT — the contained
 * var tree is the daemon trust boundary. An out-of-scope pidfile (e.g.
 * TAMANDUA_STATE_DIR mis-pointed at the real ~/.tamandua) could name the
 * PRODUCTION daemon; resolving it would let kill-daemon signal a daemon
 * outside the torture-test containment. Such a pidfile is refused fail-closed
 * with a precise one-line reason ({ error }) — never a signal, never a
 * silent fallback to a process scan.
 */
function readDaemonPidfile() {
  const candidates = [];
  if (process.env.TAMANDUA_STATE_DIR) {
    candidates.push(path.resolve(process.env.TAMANDUA_STATE_DIR, 'tamandua.pid'));
  }
  const ttHome = process.env.TT_HOME || path.resolve(TT_ROOT, '..', '..');
  candidates.push(path.resolve(ttHome, '.tamandua', 'daemon.pid'));
  for (const pidFile of candidates) {
    try {
      const pidStr = fs.readFileSync(pidFile, 'utf-8').trim();
      const pid = parseInt(pidStr, 10);
      if (pid > 0) {
        if (!pidFile.startsWith(TT_ROOT + path.sep)) {
          return { error: `daemon pidfile ${pidFile} is not under ${TT_ROOT} — refusing to resolve the daemon from an out-of-scope pidfile` };
        }
        return { pid, pidfile: pidFile };
      }
    } catch {
      // pidfile doesn't exist — try the next candidate
    }
  }
  return null;
}

/**
 * Verify a resolved kill target immediately before firing (US-002 guard
 * contract): (a) pid alive; (b) when a recorded startTime exists it must
 * match the CURRENT /proc starttime (ABA-safe, refuse on mismatch); (c) the
 * target must NOT be an ancestor of the tt-chaos process and must not share
 * tt-chaos's own pgid; (d) belt-and-suspenders cwd/cmdline provenance check
 * for recorded pids. Returns { ok, reason }.
 *
 * S28 (US-006) `kind` parameter: harness targets ('harness', the default —
 * kill-harness / sigstop_sigcont) keep the STRICT cwd/cmdline provenance
 * check (step (d)); daemon targets ('daemon' — kill-daemon resolved from the
 * contained daemon pidfile) must NOT require the daemon's cwd/cmdline to
 * contain TT_ROOT or the run id: the REAL contained daemon runs from a
 * different cwd with a cmdline (`node .../dist/cli/cli.js daemon`) that
 * contains neither, so the strict check would GUARD_MISS every legitimate
 * kill (campaign W4.48a: `Process 4080359 cwd/cmdline does not contain
 * .../torture-test/var`). A daemon target's identity is verified by (a)-(c)
 * plus the pidfile-path-under-TT_ROOT containment check — the pidfile inside
 * the contained var tree IS the daemon trust boundary. A daemon target that
 * fails any of those refuses fail-closed with a precise one-line reason
 * (never a silent fallback to a process scan), and a daemon whose process
 * group is UNREADABLE (a /proc-less host) is refused too — group
 * disjointness is part of the identity contract and cannot be waived.
 *
 * S33 (US-004) harness chain: the REAL pi worker's process shape carries no
 * repo path in cwd/cmdline (argv scrubbed to the binary name — the W4.09
 * campaign shape: `Process 2074648 cwd/cmdline does not contain
 * .../torture-test/var` with cmdline `pi`), so the strict step-(d) check
 * alone GUARD_MISSes every legitimate kill-harness. When step (d) fails for
 * a harness target, verifyHarnessIdentityChain accepts a POSITIVE
 * tt-ownership proof built on EXPLICIT RECORDED identity only (steps-table
 * claim_pgid match / parent-chain walk to a TT_ROOT-owned ancestor / open-fd
 * into var) — see below. A harness target with NO positive proof still
 * refuses fail-closed with the precise provenance reason (never weakened).
 */
function verifyKillTarget(record, runId, kind = 'harness') {
  const base = verifyRecordedTarget({ pid: record.pid, pgid: record.pgid, startTime: record.startTime });
  if (!base.ok) return base;
  const pgid = getProcessGroup(record.pid);
  if (kind === 'daemon') {
    // S28 (US-006): daemon identity = (a)-(c) above + pidfile containment.
    // The pidfile path is checked at resolution (readDaemonPidfile) and
    // re-asserted here (belt-and-suspenders — a record that somehow lacks it
    // is not a pidfile-resolved daemon and must never be signalled).
    if (!record.pidfile || !record.pidfile.startsWith(TT_ROOT + path.sep)) {
      return { ok: false, reason: `daemon pidfile ${record.pidfile ?? '(none)'} is not under ${TT_ROOT} — refusing to signal an out-of-scope daemon target` };
    }
    if (pgid === null) {
      return { ok: false, reason: `cannot read the process group of daemon pid ${record.pid} (no /proc) — group disjointness from the caller cannot be verified, refusing to signal` };
    }
    if (pgid === ownProcessGroup()) {
      return { ok: false, reason: `target pid ${record.pid} shares the caller's own pgid ${pgid} — refusing to signal own group` };
    }
    return { ok: true, reason: `recorded daemon pid ${record.pid} verified (alive, identity, group disjointness, pidfile-under-TT_ROOT checks passed)` };
  }
  if (pgid !== null && pgid === ownProcessGroup()) {
    return { ok: false, reason: `target pid ${record.pid} shares the caller's own pgid ${pgid} — refusing to signal own group` };
  }
  if (!verifyProcessProvenance(record.pid, runId)) {
    // S33 (US-004): the strict belt-and-suspenders check failed — try the
    // positive tt-ownership evidence chain (EXPLICIT RECORDED identity only;
    // verifyRecordedTarget already passed above). No positive proof -> the
    // strict refusal stands, annotated with the chain miss.
    const chain = verifyHarnessIdentityChain(record, runId);
    if (!chain.ok) {
      return { ok: false, reason: `Process ${record.pid} cwd/cmdline does not contain ${TT_ROOT} — no positive tt-ownership chain proof (${chain.detail}); refusing to signal` };
    }
    return { ok: true, reason: `recorded target pid ${record.pid} verified (alive, identity, group, strict provenance check failed but positive tt-ownership chain proof: ${chain.detail})` };
  }
  return { ok: true, reason: `recorded target pid ${record.pid} verified (alive, identity, group, provenance checks passed)` };
}

/**
 * Verify a process PID's provenance: its cwd must be under TT_ROOT and its
 * cmdline must carry EITHER the run id (a real harness process is spawned as
 * `node .../runtime-*.mjs ... -q <work prompt>` whose prompt text carries the
 * run id but no var path) OR TT_ROOT itself (fake/test harness processes and
 * the fake daemon use argv[0] = TT_ROOT/tt-harness-<run>). Requiring var in
 * the cmdline unconditionally would reject every real harness process. This
 * check is the belt-and-suspenders re-assertion of the provenance contract
 * at fire time for an ALREADY-RESOLVED recorded pid (US-002) — it is never
 * used to RESOLVE a target.
 */
function verifyProcessProvenance(pid, runId) {
  try {
    // linux-only /proc/<pid>/cwd + cmdline reads (MACP3 US-003): absent on
    // Darwin — the catch degrades to "provenance unproven" (returns false)
    // instead of hard-failing.
    const cwdPath = `/proc/${pid}/cwd`;
    const cmdlinePath = `/proc/${pid}/cmdline`;
    const cwd = fs.readlinkSync(cwdPath);
    const cmdline = fs.readFileSync(cmdlinePath, 'utf-8').replace(/\0/g, ' ');
    return cwd.includes(TT_ROOT) && (cmdline.includes(runId) || cmdline.includes(TT_ROOT));
  } catch {
    return false;
  }
}

/**
 * S33 (US-004): positive tt-ownership evidence chain for a HARNESS target
 * whose strict cwd/cmdline provenance check failed — the REAL pi worker
 * shape (argv scrubbed to the binary name; the W4.09 campaign GUARD_MISS
 * `Process 2074648 cwd/cmdline does not contain .../torture-test/var` with
 * cmdline `pi`). The chain is built on EXPLICIT RECORDED identity ONLY —
 * never a /proc cwd/cmdline sweep (the E3.C.1 root-cause class: a sweep can
 * match a repo-cwd process in the operator's own ancestry):
 *   1. verifyRecordedTarget MUST already have passed (the caller runs it
 *      first — pid alive + recorded --target-start-time ABA match +
 *      ancestry/group disjointness);
 *   2. plus at least ONE positive tt-ownership proof:
 *      (a) the pid equals the steps-table claim_pgid harness group for the
 *          run (resolveFromStepsTable — the product's own explicit
 *          worker-ownership claim record);
 *      (b) the parent-chain walk (getProcessParent ppid walk, isAncestorOf
 *          style) reaches an ancestor whose cwd/cmdline IS under TT_ROOT
 *          (the contained daemon/harness that spawned the worker);
 *      (c) open-fd evidence: /proc/<pid>/fd resolves a descriptor into
 *          TT_ROOT/var (linux-only — MACP3 prose discipline: an unreadable
 *          fd entry degrades to unproven, never to proven).
 * Any record with NO positive proof still refuses fail-closed — the strict
 * provenance reason stands, annotated with the chain miss. kill-daemon
 * daemon-kind targets (S28 US-006) never enter this chain.
 *
 * @returns {{ok: true, detail: string} | {ok: false, detail: string}}
 */
function verifyHarnessIdentityChain(record, runId) {
  const pid = record.pid;
  // (a) steps-table claim row — the product's explicit harness-group record.
  const steps = resolveFromStepsTable(runId);
  if (steps && Number(steps.pid) === Number(pid)) {
    return { ok: true, detail: `steps claim row claim_pgid ${steps.pid} matches target pid ${pid}` };
  }
  // (b) parent-chain walk to a TT_ROOT-owned ancestor.
  const parentProof = parentChainOwnershipProof(pid);
  if (parentProof.ok) {
    return { ok: true, detail: parentProof.detail };
  }
  // (c) open-fd evidence into TT_ROOT/var.
  const fdProof = openFdOwnershipProof(pid);
  if (fdProof.ok) {
    return { ok: true, detail: fdProof.detail };
  }
  const misses = [
    steps ? `steps row pid ${steps.pid} != target ${pid}` : 'no steps claim row for the run',
    parentProof.detail,
    fdProof.detail,
  ];
  return { ok: false, detail: misses.join('; ') };
}

/**
 * S33 (US-004) proof (b): walk the target's ppid chain upward (bounded,
 * isAncestorOf-style — cycles / pid 1 / unreadable ppid terminate the walk
 * as unproven) and return the first ancestor whose cwd OR cmdline contains
 * TT_ROOT (the contained daemon/harness that spawned the worker). The
 * TARGET's own cwd/cmdline is not evidence here — it already failed the
 * strict check, and the chain must prove tt-ownership from the ancestry,
 * never from the target's own (possibly spoofable) cwd. /proc-less hosts
 * degrade to unproven (never proven).
 */
function parentChainOwnershipProof(targetPid) {
  let cur = getProcessParent(targetPid);
  for (let i = 0; i < 1024 && cur !== null && cur > 0; i += 1) {
    try {
      // linux-only /proc/<pid>/cwd + cmdline reads (MACP3 US-003): absent on
      // Darwin — the catch degrades to "ancestor unproven" (never proven).
      const ancestorCwd = fs.readlinkSync(`/proc/${cur}/cwd`);
      const ancestorCmdline = fs.readFileSync(`/proc/${cur}/cmdline`, 'utf-8').replace(/\0/g, ' ');
      if (ancestorCwd.includes(TT_ROOT) || ancestorCmdline.includes(TT_ROOT)) {
        return { ok: true, detail: `ancestor pid ${cur} cwd/cmdline is under ${TT_ROOT}` };
      }
    } catch {
      // unreadable ancestor — the walk cannot prove this ancestor; continue
    }
    const parent = getProcessParent(cur);
    if (parent === null || parent === cur || parent <= 0) break; // unreadable / cycle / init
    cur = parent;
  }
  return { ok: false, detail: 'no ancestor with cwd/cmdline under TT_ROOT' };
}

/**
 * S33 (US-004) proof (c): open-fd evidence — /proc/<pid>/fd resolves a
 * descriptor into TT_ROOT/var (linux-only, MACP3 prose discipline: an
 * unreadable fd entry or an unreadable fd dir degrades to unproven, never
 * to proven). A worker holding an fd into the contained var tree is
 * positively tt-owned.
 */
function openFdOwnershipProof(targetPid) {
  try {
    // linux-only /proc/<pid>/fd (MACP3 US-003): absent on Darwin — the
    // catch degrades to "unproven" (never proven).
    const fdDir = `/proc/${targetPid}/fd`;
    const entries = fs.readdirSync(fdDir);
    for (const entry of entries) {
      try {
        const resolved = fs.realpathSync(path.join(fdDir, entry));
        if (resolved.startsWith(TT_ROOT + path.sep)) {
          return { ok: true, detail: `open fd ${entry} resolves to ${resolved} under ${TT_ROOT}` };
        }
      } catch {
        // unreadable / racy fd entry — unproven for THIS fd, keep scanning
      }
    }
  } catch {
    // /proc-less host or unreadable fd dir — unproven
  }
  return { ok: false, detail: 'no open fd resolves under TT_ROOT' };
}

// ── Evidence capture before destruction ─────────────────────────────

/**
 * Capture pre-fire evidence snapshot.
 *
 * For destructive actions: full snapshot (DB rows, process tree, git status, daemon log).
 * For non-destructive actions: lighter capture (DB rows only).
 *
 * The evidence directory is created before any mutation.
 * Failed evidence capture does not block the injection — logs a warning and continues.
 *
 * @param {string} action - The action name
 * @param {string} runId - The run ID
 * @param {object} opts - The parsed CLI options
 * @param {object|null} targetInfo - classifyTarget result (pre-computed)
 * @returns {{path: string}|null} - Evidence directory path, or null if skipped
 */
function captureEvidence(action, runId, opts, targetInfo) {
  const ts = new Date().toISOString().replace(/[:.]/g, '-');
  const evidenceDir = path.resolve(CHAOS_DIR, `${ts}-${action}`);

  try {
    fs.mkdirSync(evidenceDir, { recursive: true });
  } catch (e) {
    console.error(`Warning: Cannot create evidence directory ${evidenceDir}: ${e.message}`);
    return null;
  }

  const writeFile = (name, content) => {
    try {
      fs.writeFileSync(path.join(evidenceDir, name), content);
    } catch (e) {
      console.error(`Warning: Evidence capture failed for ${name}: ${e.message}`);
    }
  };

  // 1. Capture DB data (runs, steps, events) — always attempted if DB accessible
  captureDbEvidence(runId, writeFile, action, opts);

  // 2. Capture pre-mutation DB state for DB-targeting actions
  if (targetInfo && targetInfo.kind === 'db') {
    captureDbMutationEvidence(action, runId, opts, writeFile);
  }

  // 3. Capture process tree for process-targeting actions
  if (targetInfo && targetInfo.kind === 'process') {
    captureProcessEvidence(action, runId, writeFile, opts);
  }

  // 4. Capture git status for filesystem-targeting actions and destructive actions
  if (targetInfo && (targetInfo.kind === 'filesystem' || isDestructive(action))) {
    captureWorktreeEvidence(runId, opts, writeFile);
  }

  // 5. Capture daemon log tail for destructive actions
  if (isDestructive(action)) {
    captureDaemonLogEvidence(writeFile);
  }

  return { path: evidenceDir };
}

/**
 * Capture run, steps, and events data from the TT DB.
 */
function captureDbEvidence(runId, writeFile, _action, _opts) {
  const dbPath = resolveDbPath();
  let db = null;

  // Open read-only for evidence capture
  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
  } catch {
    writeFile('db_error.txt', `Cannot open TT DB at ${dbPath}\n`);
    return;
  }

  try {
    // The contained product runs table keys on `id` (RAW uuid), while the
    // controller passes `run-<uuid>` and the test fixture keys on `run_id` —
    // queryRunRowTolerant probes every (column, spelling) candidate.
    const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
    const runRow = queryRunRowTolerant(db, runId, shortRunId);
    if (runRow !== undefined) {
      writeFile('run.json', JSON.stringify(runRow, null, 2));
    } else {
      writeFile('run.json', JSON.stringify({ error: `run_id ${runId} not found` }, null, 2));
    }

    // Capture steps for this run
    const stepRows = db.prepare('SELECT * FROM steps WHERE run_id = ?').all(runId);
    writeFile('steps.json', JSON.stringify(stepRows, null, 2));

    // Capture events for this run from the EVENT STREAM FILES (the product
    // keeps events in <state>/events/*.jsonl — there is NO events table).
    const eventRows = readRunEventStreamLines(runId);
    writeFile('events.json', JSON.stringify(eventRows, null, 2));
  } catch (e) {
    writeFile('db_error.txt', `DB query failed: ${e.message}\n`);
  } finally {
    try { db.close(); } catch { /* ignore */ }
  }
}

/**
 * Capture target process tree information.
 */
function captureProcessEvidence(action, runId, writeFile, opts) {
  const record = resolveTargetRecord(action, { run: runId, args: opts ? opts.args : {} });
  const pid = record && !record.error ? record.pid : null;
  let output = '';

  if (pid) {
    output += `Target PID: ${pid}\n`;
    output += `Target record: ${JSON.stringify(record)}\n`;
    // S28 (US-006): evidence verification mirrors the fire-time guard kind —
    // a kill-daemon record (pidfile-resolved) is verified without the strict
    // cwd/cmdline provenance requirement, so the evidence verdict matches
    // what the guard would decide.
    const kind = action === 'kill-daemon' ? 'daemon' : 'harness';
    const verdict = verifyKillTarget(record, runId, kind);
    output += `Verification: ${verdict.ok ? 'ok' : 'refused'} — ${verdict.reason}\n`;
    output += captureProcInfo(pid);

    // Capture child processes (pgid)
    try {
      // linux-only /proc/<pid>/status read (MACP3 US-003): guarded for
      // Darwin by this try/catch — on a /proc-less host we emit
      // "(could not read process tree)" evidence instead of aborting.
      const statusStr = fs.readFileSync(`/proc/${pid}/status`, 'utf-8');
      const ppidMatch = statusStr.match(/PPid:\s*(\d+)/);
      const pgid = pid; // approximate
      output += `\nProcess tree (children of ${pid}):\n`;
      output += captureChildrenProcs(pid);
    } catch {
      output += '(could not read process tree)\n';
    }
  } else {
    output += 'Target process not found (may have already exited)\n';

    // Provide a broader /proc snapshot for context
    output += '\nActive processes under ' + TT_ROOT + ':\n';
    output += captureProcScan();
  }

  writeFile('process_tree.txt', output);
}

/**
 * Capture /proc info for a single PID.
 */
function captureProcInfo(pid) {
  let info = '';
  // linux-only /proc/... reads below (MACP3 US-003): every individual read
  // is wrapped and falls back to an "(unreadable)" note — on a /proc-less
  // Darwin host this produces "(could not read process tree)" evidence
  // rather than aborting the chaos injection.
  try {
    info += `  Cmdline: ${fs.readFileSync(`/proc/${pid}/cmdline`, 'utf-8').replace(/\0/g, ' ')}\n`;
  } catch { info += `  Cmdline: (unreadable)\n`; }
  try {
    info += `  CWD: ${fs.readlinkSync(`/proc/${pid}/cwd`)}\n`;
  } catch { info += `  CWD: (unreadable)\n`; }
  try {
    const statusStr = fs.readFileSync(`/proc/${pid}/status`, 'utf-8');
    for (const key of ['Name', 'State', 'Pid', 'PPid', 'Tgid', 'Threads', 'VmSize', 'VmRSS', 'voluntary_ctxt_switches', 'nonvoluntary_ctxt_switches']) {
      const match = statusStr.match(new RegExp(`^${key}:\\s*(.+)$`, 'm'));
      if (match) info += `  ${key}: ${match[1].trim()}\n`;
    }
  } catch { info += `  Status: (unreadable)\n`; }
  return info;
}

/**
 * Capture child processes of a given PID.
 */
function captureChildrenProcs(parentPid) {
  let output = '';
  // linux-only /proc scan (MACP3 US-003): guarded for Darwin by the outer
  // try/catch — on a /proc-less host readdirSync('/proc') throws and we fall
  // back to "(no children found)".
  try {
    const procDirs = fs.readdirSync('/proc').filter(d => /^\d+$/.test(d));
    for (const d of procDirs) {
      try {
        const statusStr = fs.readFileSync(`/proc/${d}/status`, 'utf-8');
        const ppidMatch = statusStr.match(/PPid:\s*(\d+)/);
        if (ppidMatch && parseInt(ppidMatch[1], 10) === parentPid) {
          output += `  └─ PID ${d}`;
          try {
            const cmdline = fs.readFileSync(`/proc/${d}/cmdline`, 'utf-8').replace(/\0/g, ' ');
            output += ` ${cmdline}`;
          } catch { /* ignore */ }
          output += `\n`;
        }
      } catch { /* skip unreadable */ }
    }
  } catch { /* /proc unreadable */ }
  if (!output) output = '  (no children found)\n';
  return output;
}

/**
 * Scan /proc for processes running under TT_ROOT (broad context).
 */
function captureProcScan() {
  let output = '';
  // linux-only /proc scan (MACP3 US-003): guarded for Darwin by the outer
  // try/catch — on a /proc-less host we fall back to "(no processes found)".
  try {
    const procDirs = fs.readdirSync('/proc').filter(d => /^\d+$/.test(d));
    for (const d of procDirs) {
      try {
        const cwd = fs.readlinkSync(`/proc/${d}/cwd`);
        if (cwd.includes(TT_ROOT)) {
          const cmdline = fs.readFileSync(`/proc/${d}/cmdline`, 'utf-8').replace(/\0/g, ' ');
          output += `  PID ${d}: ${cmdline}\n`;
          output += `    CWD: ${cwd}\n`;
        }
      } catch { /* skip */ }
    }
  } catch { /* /proc unreadable */ }
  if (!output) output = '(no processes found under ' + TT_ROOT + ')\n';
  return output;
}

/**
 * Capture worktree git status and HEAD for filesystem-targeting actions.
 */
function captureWorktreeEvidence(runId, opts, writeFile) {
  // Try to find the worktree path from DB (if accessible)
  const dbPath = resolveDbPath();
  let worktreePath = null;

  try {
    const db = new DatabaseSync(dbPath, { open: true, readOnly: true });
    try {
      // Product schema: run_worktrees (worktree_path); run_id is the RAW
      // uuid — probe both spellings (the controller passes run-<uuid>).
      const shortRunId = runId.startsWith('run-') ? runId.slice(4) : runId;
      const rows = db.prepare(
        `SELECT worktree_path FROM run_worktrees WHERE run_id = ? LIMIT 1`
      ).all(runId);
      const row = rows.length > 0 ? rows[0] : db.prepare(
        `SELECT worktree_path FROM run_worktrees WHERE run_id = ? LIMIT 1`
      ).get(shortRunId);
      if (row && row.worktree_path) {
        worktreePath = row.worktree_path;
      }
    } catch { /* table may not exist */ }
    db.close();
  } catch { /* DB not accessible */ }

  // Fallback: use the --repo path from opts
  if (!worktreePath && opts.args.repo) {
    worktreePath = path.resolve(opts.args.repo);
  }

  if (worktreePath) {
    captureGitStatus(worktreePath, writeFile);
  } else {
    writeFile('git_status.txt', '(worktree path unknown)\n');
  }
}

/**
 * Capture git status and HEAD for a given repository path.
 */
function captureGitStatus(repoPath, writeFile) {
  let output = `Repo: ${repoPath}\n\n`;

  const runGit = (args, label) => {
    try {
      const stdout = execSync(['git', ...args].join(' '), {
        cwd: repoPath,
        encoding: 'utf-8',
        timeout: 5000,
      });
      return `${label}:\n${stdout}\n`;
    } catch (e) {
      return `${label}: (error: ${e.message})\n`;
    }
  };

  output += runGit(['-C', repoPath, 'rev-parse', 'HEAD'], 'HEAD');
  output += runGit(['-C', repoPath, 'status', '--porcelain', '--branch'], 'Status');
  output += runGit(['-C', repoPath, 'log', '--oneline', '-5'], 'Recent log');

  writeFile('git_status.txt', output);
}

/**
 * Capture daemon log tail (last 200 lines).
 */
function captureDaemonLogEvidence(writeFile) {
  const logPaths = [];

  // TT daemon log path: $TAMANDUA_STATE_DIR/tamandua.log or $TT_HOME/.tamandua/tamandua.log
  if (process.env.TAMANDUA_STATE_DIR) {
    logPaths.push(path.resolve(process.env.TAMANDUA_STATE_DIR, 'tamandua.log'));
  }
  if (process.env.TT_HOME) {
    logPaths.push(path.resolve(process.env.TT_HOME, '.tamandua', 'tamandua.log'));
  }
  // Fallback: default TT state dir
  logPaths.push(path.resolve(TT_ROOT, '..', '..', '.tamandua', 'tamandua.log'));

  let captured = false;
  for (const logPath of logPaths) {
    try {
      if (!fs.existsSync(logPath)) continue;
      const content = fs.readFileSync(logPath, 'utf-8');
      // Last 200 lines
      const lines = content.split('\n');
      const tail = lines.slice(Math.max(0, lines.length - 200)).join('\n');
      writeFile('daemon_log_tail.txt', `Source: ${logPath}\n\n${tail}`);
      captured = true;
      break;
    } catch { /* continue to next candidate */ }
  }

  if (!captured) {
    writeFile('daemon_log_tail.txt', '(daemon log not found)\n');
  }
}

/**
 * Capture pre-mutation DB state for DB-targeting actions.
 * Snapshot the rows that will be affected by delete-tstx-row or write-context.
 */
function captureDbMutationEvidence(action, runId, opts, writeFile) {
  const dbPath = resolveDbPath();
  let db = null;

  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
  } catch {
    writeFile('db_mutation_no_db.txt', `Cannot open TT DB at ${dbPath} for pre-mutation evidence\n`);
    return;
  }

  try {
    if (action === 'delete-tstx-row' && opts.args.tree) {
      // S28 (US-007): snapshot the rows the mutation will delete. The
      // product's suite ledger table is `suite_results` (tree_hash column);
      // the historical `tstx` table name never existed in the product schema
      // (the campaign's W4.48c evidence dir shows `Pre-mutation DB capture
      // failed: no such table: tstx`). Mirror the mutation's table handling
      // — capture suite_results rows AND legacy tstx rows when present, so
      // the pre-mutation evidence is honest against the real contained DB.
      const tables = db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name IN ('tstx','suite_results')").all();
      const hasSuiteResults = tables.some((row) => row.name === 'suite_results');
      const hasLegacyTstx = tables.some((row) => row.name === 'tstx');
      const captured = { suite_results: [], tstx: [] };
      if (hasSuiteResults) {
        captured.suite_results = db.prepare('SELECT * FROM suite_results WHERE tree_hash = ?').all(opts.args.tree);
      }
      if (hasLegacyTstx) {
        captured.tstx = db.prepare('SELECT * FROM tstx WHERE tree = ?').all(opts.args.tree);
      }
      writeFile('pre_mutation_tstx.json', JSON.stringify(captured, null, 2));
    } else if (action === 'write-context' && opts.args.key) {
      // Check if run_context table exists first
      try {
        const rows = db.prepare('SELECT * FROM run_context WHERE run_id = ? AND key = ?').all(runId, opts.args.key);
        writeFile('pre_mutation_run_context.json', JSON.stringify(rows, null, 2));
      } catch {
        // Table may not exist yet
        writeFile('pre_mutation_run_context.json', JSON.stringify([], null, 2));
      }
    }
  } catch (e) {
    writeFile('db_mutation_error.txt', `Pre-mutation DB capture failed: ${e.message}\n`);
  } finally {
    try { db.close(); } catch { /* ignore */ }
  }
}

// ── Chaos log (atomic append) ────────────────────────────────────────

/**
 * Append a structured JSON entry to the chaos log atomically.
 * Uses temp-file + rename for atomicity — no partial lines.
 */
function logStructured(entry) {
  try {
    const line = JSON.stringify(entry) + '\n';
    // Read existing log, append, write to temp, rename
    let existing = '';
    try {
      existing = fs.readFileSync(CHAOS_LOG, 'utf-8');
    } catch {
      // Log doesn't exist yet — start fresh
    }
    const tmpLog = `${CHAOS_LOG}.tmp.${process.pid}.${Date.now()}`;
    fs.writeFileSync(tmpLog, existing + line);
    fs.renameSync(tmpLog, CHAOS_LOG);
  } catch {
    // Best-effort logging; don't fail on log write errors
  }
}

// ── CLI parsing ───────────────────────────────────────────────────────

const args = process.argv.slice(2);

// Check for --help/-h before anything else
const helpIdx = args.findIndex(a => a === '--help' || a === '-h');
if (helpIdx !== -1) {
  showHelp();
  process.exit(0);
}

// First positional arg is the action
if (args.length === 0) {
  console.error('Error: Missing action. Use --help for usage.');
  process.exit(1);
}

const action = args[0];

// Validate action
const actionNames = Object.keys(ACTIONS);
if (!actionNames.includes(action)) {
  console.error(`Error: Unknown action "${action}". Valid actions: ${actionNames.join(', ')}`);
  process.exit(1);
}

// Parse remaining args: --run, --when, --timeout, and action-specific args
const opts = {
  run: null,
  when: null,
  timeout: 120,
  args: /** @type {Record<string, string>} */ ({}),
};

let i = 1;
while (i < args.length) {
  const arg = args[i];

  if (arg === '--run') {
    if (i + 1 >= args.length) {
      console.error('Error: --run requires a value.');
      process.exit(1);
    }
    opts.run = args[++i];
  } else if (arg === '--when') {
    if (i + 1 >= args.length) {
      console.error('Error: --when requires a value.');
      process.exit(1);
    }
    opts.when = args[++i];
  } else if (arg === '--timeout') {
    if (i + 1 >= args.length) {
      console.error('Error: --timeout requires a value.');
      process.exit(1);
    }
    const t = parseInt(args[++i], 10);
    if (isNaN(t) || t <= 0) {
      console.error(`Error: --timeout must be a positive integer, got "${args[i]}".`);
      process.exit(1);
    }
    opts.timeout = t;
  } else if (arg === '--rearm') {
    // US-007 (S36): boolean action flag (no value) — per-attempt re-arm
    // mode for move-branch.
    opts.args.rearm = 'true';
  } else if (arg.startsWith('--')) {
    // Action-specific flag argument (--flag value)
    const flagName = arg.slice(2);
    if (i + 1 >= args.length || args[i + 1].startsWith('--')) {
      console.error(`Error: Flag "${arg}" requires a value.`);
      process.exit(1);
    }
    opts.args[flagName] = args[++i];
  } else {
    // Unrecognized positional arg (shouldn't happen after action)
    console.error(`Error: Unexpected argument "${arg}". Use --help for usage.`);
    process.exit(1);
  }
  i++;
}

// Validate --run is required
if (!opts.run) {
  console.error('Error: --run is required. Use --help for usage.');
  process.exit(1);
}

// Validate --when is required
if (!opts.when) {
  console.error('Error: --when is required. Use --help for usage.');
  process.exit(1);
}

// Validate marker format
if (!validateMarker(opts.when)) {
  console.error(`Error: Invalid --when marker format "${opts.when}".`);
  console.error('  Must be one of: now, step:<role>:<state>, event:<type>, file:<path>');
  process.exit(EXIT_INVALID_MARKER);
}

// ── S29 (US-003): fail-closed trigger-vocabulary validation ─────────────
// Mirrors the controller's validateProbeSequence / validateChaosBlock
// preflight (tt-trigger-vocabulary.mjs): a step:/event: marker naming a
// role/event that is NOT in the run's workflow vocabulary can NEVER fire —
// waiting on it is exactly the silent chaos-invocation-failed defect. When
// the run's workflow id resolves (the contained runs row) AND its workflow
// spec is found, an unknown marker fails closed with a DISTINCT one-line
// reason + EXIT_INVALID_MARKER instead of polling. When the workflow cannot
// be resolved (test fixtures, unknown workflow ids) the format check above
// is the only gate — the controller's preflight remains the authoritative
// fail-closed layer for manifest-driven invocations.
function validateMarkerVocabulary(marker) {
  if (typeof marker !== 'string') return null;
  if (!marker.startsWith('step:') && !marker.startsWith('event:')) return null;
  // Resolve the workflow id from the contained runs row (both run-id
  // spellings), tolerantly — a missing row / column degrades to null.
  let workflowId = null;
  const dbPath = resolveDbPath();
  let db = null;
  try {
    db = new DatabaseSync(dbPath, { open: true, readOnly: true });
    const shortRunId = opts.run.startsWith('run-') ? opts.run.slice(4) : opts.run;
    const row = queryRunRowTolerant(db, opts.run, shortRunId);
    if (row !== undefined && typeof row.workflow_id === 'string' && row.workflow_id !== '') {
      workflowId = row.workflow_id;
    }
  } catch {
    workflowId = null;
  } finally {
    if (db) db.close();
  }
  if (workflowId === null) return null;
  const vocab = workflowVocabularyFor(workflowId);
  if (vocab.missing) return null;
  return stringMarkerVocabularyError(marker, workflowId, vocab, 'chaos');
}

const markerVocabularyError = validateMarkerVocabulary(opts.when);
if (markerVocabularyError !== null) {
  console.error(markerVocabularyError);
  console.error('  (fail-closed: an unknown marker can never fire — refusing to wait on it)');
  process.exit(EXIT_INVALID_MARKER);
}

// ── S28 (US-005): startup terminal-run fast-fail ─────────────────────
// A run that is ALREADY terminal can never fire the trigger: refuse BEFORE
// phaseWait with a precise one-line reason (exit EXIT_RUN_TERMINAL) so the
// operator never lingers to be SIGKILLed by the contained daemon's post-run
// leak-guard sweep (the campaign's `chaos operator 'tt-chaos' exited null`).
// The run row must exist AND carry a terminal status — a missing row (test
// fixtures) or degraded DB read proceeds (the guard + phaseWait remain the
// fail-closed layers).
const startupTerminal = startupTerminalStatus(opts.run);
if (startupTerminal !== null) {
  logStructured({
    ts: new Date().toISOString(),
    action,
    runId: opts.run,
    phaseMarker: opts.when,
    outcome: 'run_terminal_at_startup',
    error: `run ${opts.run} already terminal (${startupTerminal}) before trigger ${opts.when} — refusing to wait`,
  });
  console.error(`chaos-refused: run ${opts.run} already terminal (${startupTerminal}) before trigger ${opts.when} (${action}) — refusing to wait`);
  process.exit(EXIT_RUN_TERMINAL);
}

// ── Action-specific argument validation (fail fast, before phase_wait) ──

// sigstop_sigcont: --hold-seconds must be a non-negative integer. Validated
// here (pre-guard) so a bad invocation never masquerades as a GUARD_MISS or
// waits on a phase marker before failing.
if (action === 'sigstop_sigcont') {
  const holdSecondsRaw = opts.args['hold-seconds'];
  if (holdSecondsRaw === undefined || holdSecondsRaw === '') {
    console.error('Error: --hold-seconds is required for sigstop_sigcont');
    process.exit(1);
  }
  const holdSeconds = Number(holdSecondsRaw);
  if (!Number.isInteger(holdSeconds) || holdSeconds < 0) {
    console.error(`Error: --hold-seconds must be a non-negative integer, got "${holdSecondsRaw}"`);
    process.exit(1);
  }
}

// US-007 (S36): move-branch --rearm (per-attempt re-arm mode) — validated
// BEFORE phaseWait (never wait on a marker for a malformed invocation). The
// re-arm loop re-arms on each FRESH step:<role>:running occurrence in the
// run's own event stream (append-only, durable), which only exists for step
// markers; it needs at least two moves (repeat > 1); and it needs a positive
// --rearm-hold-s (the post-marker hold so the merger's tip capture precedes
// the move). Fail closed on every malformed shape with a precise one-line
// reason. --rearm-hold-s without --rearm is likewise a scenario error (never
// a silently-ignored param).
if (action === 'move-branch') {
  const rearm = opts.args.rearm !== undefined;
  const rearmHoldRaw = opts.args['rearm-hold-s'];
  const rearmHoldS = rearmHoldRaw === undefined ? 0 : Number(rearmHoldRaw);
  if (rearm) {
    if (!opts.when.startsWith('step:')) {
      console.error('Error: --rearm requires a step:<role>:<state> --when marker (the re-arm loop re-arms on each step:<role>:running occurrence)');
      process.exit(1);
    }
    const repeatRaw = opts.args.repeat === undefined ? '1' : opts.args.repeat;
    const repeat = Number(repeatRaw);
    if (!Number.isInteger(repeat) || repeat < 2) {
      console.error('Error: --rearm requires --repeat > 1 (the per-attempt re-arm loop needs at least two moves)');
      process.exit(1);
    }
    if (rearmHoldRaw === undefined || !Number.isInteger(rearmHoldS) || rearmHoldS < 1) {
      console.error(`Error: --rearm-hold-s must be a positive integer (the post-marker hold before each re-armed move), got "${rearmHoldRaw}"`);
      process.exit(1);
    }
  } else if (rearmHoldRaw !== undefined) {
    console.error('Error: --rearm-hold-s requires --rearm (the post-marker hold is a re-arm mode parameter)');
    process.exit(1);
  }
}

// ── Phase wait ───────────────────────────────────────────────────────

const phaseResult = phaseWait(opts.when, opts.timeout, opts.run);
if (!phaseResult.satisfied) {
  // S28 (US-005): a run-terminal stop must say precisely why in one line —
  // `TRIGGER_NEVER_MATERIALIZED` alone conflates it with a plain timeout and
  // hides that the run died before the marker could ever fire.
  if (phaseResult.reason === 'RUN_TERMINAL_BEFORE_MARKER') {
    console.error(`chaos-refused: run ${opts.run} reached terminal before trigger ${opts.when} (${action}) — refusing to wait`);
  } else {
    console.error(`TRIGGER_NEVER_MATERIALIZED: Marker "${opts.when}" did not materialize within ${opts.timeout}s.`);
  }
  process.exit(EXIT_TRIGGER_NEVER);
}

// ── Evidence capture before destruction ──────────────────────────────

// Capture evidence BEFORE the target guard so we have a pre-state snapshot
// even on guard failure (captures what triggered the guard).
// Classify target first so captureEvidence knows what to capture.
const targetInfo = classifyTarget(action, opts);
const evidenceResult = captureEvidence(action, opts.run, opts, targetInfo);

// ── Target guard ─────────────────────────────────────────────────────

const guardResult = guardFire(action, opts.run, opts);
if (!guardResult.guarded) {
  const logEntry = {
    ts: new Date().toISOString(),
    action,
    runId: opts.run,
    phaseMarker: opts.when,
    phaseSatisfied: true,
    target: targetInfo.kind,
    outcome: 'guard_miss',
    error: guardResult.reason,
    evidence: evidenceResult ? evidenceResult.path : null,
  };
  logStructured(logEntry);
  console.error(`GUARD_MISS: ${guardResult.reason}`);
  process.exit(EXIT_GUARD_MISS);
}

// ── Dispatch ──────────────────────────────────────────────────────────

// Log the successful fire with evidence path
const fireLogEntry = {
  ts: new Date().toISOString(),
  action,
  runId: opts.run,
  phaseMarker: opts.when,
  phaseSatisfied: true,
  target: targetInfo.kind,
  outcome: 'firing',
  evidence: evidenceResult ? evidenceResult.path : null,
};
logStructured(fireLogEntry);

const handler = dispatch[action];
handler({ run: opts.run, when: opts.when, timeout: opts.timeout, args: opts.args });
