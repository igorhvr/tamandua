  'sigstop_sigcont': {
    args: '--hold-seconds <n> [--target-pid <pid>] [--target-pgid <pgid>] [--target-start-time <n>]',
    desc: 'SIGSTOP the active harness process for --run, hold, then SIGCONT (3 chaos.log entries)',
  },
  'colleague-commit': {
    args: '--repo <fixture-clone> --file <f> [--line <sentinel>]',
