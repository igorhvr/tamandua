#!/usr/bin/env node

// tt-chaos — fault-injection operator for the tamandua torture-test suite
// Per spec 08-wave-4-fault-injection.md, 11-schedule-budget-abort.md,
// and 12-runner-automation.md (§tt-chaos)

import fs from 'node:fs';
import path from 'node:path';
