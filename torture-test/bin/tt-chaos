  stringMarkerVocabularyError,
  workflowVocabularyFor,
} from './tt-trigger-vocabulary.mjs';

// ── Phase wait constants ─────────────────────────────────────────────

const POLL_INTERVAL_MS = 500;
const DEFAULT_TIMEOUT_S = 120;

// ── Exit codes ───────────────────────────────────────────────────────

const EXIT_TRIGGER_NEVER = 2;
const EXIT_GUARD_MISS = 3;
const EXIT_INVALID_MARKER = 1;
// S28 (US-005): spawned against a run that is ALREADY terminal — the
// injection can never fire. Numerically equal to EXIT_TRIGGER_NEVER (the
// phaseWait run-terminal early-exit code) but named distinctly: the message
// (chaos-refused: ...) is what distinguishes the two in the evidence.
const EXIT_RUN_TERMINAL = 2;

// ── Run terminal statuses (S28 US-005) ───────────────────────────────
// Union of the controller's TERMINAL_RUN_STATUSES (completed|done|failed|
// canceled) and the phaseWait/guard terminal list (completed|failed|
// canceled|stopped): any of these means the trigger can no longer fire.
const TERMINAL_RUN_STATUSES = ['completed', 'done', 'failed', 'canceled', 'stopped'];

// ── Paths ─────────────────────────────────────────────────────────────

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const TT_DIR = path.resolve(__dirname, '..');
const TT_ROOT = process.env.TT_ROOT ? path.resolve(process.env.TT_ROOT) : path.resolve(TT_DIR, 'var');
const TT_REPO_ROOT = path.resolve(TT_DIR, '..');
const CHAOS_DIR = path.resolve(TT_ROOT, 'chaos');
const CHAOS_LOG = path.resolve(CHAOS_DIR, 'chaos.log');

// Ensure var/chaos exists
fs.mkdirSync(CHAOS_DIR, { recursive: true });

// ── Destructive vs non-destructive classification ───────────────────

const DESTRUCTIVE_ACTIONS = new Set([
  'kill-harness',
  'kill-daemon',
  'delete-tstx-row',
  'dirty-tree',
  'move-branch',
]);

function isDestructive(action) {
  return DESTRUCTIVE_ACTIONS.has(action);
}

