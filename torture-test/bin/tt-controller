// E3.C.1 US-003: per-run harness target records (var/targets/<runId>.json).
// The controller records the launched run process identity at spawn AND the
// steps-table claim row (the real harness group) once the run's steps are
// claimed, then hands tt-chaos invocations the explicit --target-* args —
// never a /proc cwd/cmdline sweep (the E3.C.1 root-cause class).
const TARGETS_DIR = path.join(VAR_ROOT, 'targets');
