const __filename = fileURLToPath(import.meta.url);
const BIN_DIR = path.dirname(__filename);
const TT_ROOT = path.resolve(BIN_DIR, '..');
const SCHEMA_PATH = path.join(TT_ROOT, 'cases', 'case.schema.json');
const VAR_ROOT = path.join(TT_ROOT, 'var');
const RESULTS_ROOT = path.join(VAR_ROOT, 'results');
const HOST_PROFILE_PATH = path.join(VAR_ROOT, 'w0', 'host-profile.json');
const REAL_ENV_PATH = path.join(TT_ROOT, 'env', 'tt-env.sh');
const SCRIPTED_ENV_PATH = path.join(TT_ROOT, 'env', 'tt-env-scripted.sh');
const DAEMON_CONTROL_PATH = process.env.TT_CONTROLLER_DAEMON_CONTROL_PATH === undefined
  ? path.join(TT_ROOT, 'bin', 'daemon-control')
  : path.resolve(process.env.TT_CONTROLLER_DAEMON_CONTROL_PATH);
const HOOK_RUNNER_PATH = path.join(TT_ROOT, 'bin', 'tt-hook-runner');
const O9_TARGETED_PROBES_PATH = path.join(TT_ROOT, 'bin', 'o9-targeted-probes.mjs');
const DEFAULT_ORACLES_ROOT = path.join(TT_ROOT, 'oracles');
const ORACLES_ROOT = resolveOraclesRoot();
const ORACLE_CONTRACT_VERSION = 1;
const STATE_VERSION = 1;
const DEFAULT_CONCURRENCY = 1;
const DEFAULT_STAGGER_MS = 0;
const DEFAULT_TOKEN_POLL_INTERVAL_MS = 5 * 60_000;
const DEFAULT_CAP_CHECK_INTERVAL_MS = 15_000;
const DEFAULT_PROVIDER_RETRY_BACKOFF_MS = 60_000;
const EVIDENCE_LIMIT_BYTES = 16 * 1024 * 1024;
const TERMINAL_RUN_STATUSES = new Set(['completed', 'done', 'failed', 'canceled']);
// Zero-token dry-run hook for the real-launch path (US-006): when
// TT_DRY_RUN_REAL_LAUNCH is set, the controller records the full launch argv
// it WOULD hand to `tamandua` for each real (pi/hermes) case and marks the
// case PASS without ever spawning the model-backed tamandua run. The variable's
// value is the JSONL file to append records to (empty => default under var/).
// Unset => exact prior behavior (no behavioral change).
const DRY_RUN_REAL_LAUNCH_ENV = 'TT_DRY_RUN_REAL_LAUNCH';
const DEFAULT_DRY_RUN_ARGV_PATH = path.join(VAR_ROOT, 'dry-run', 'launch-argv.jsonl');

function dryRunRealLaunchOutPath() {
  const value = process.env[DRY_RUN_REAL_LAUNCH_ENV];
  if (value === undefined) return null;
  return value === '' ? DEFAULT_DRY_RUN_ARGV_PATH : path.resolve(value);
}

// Record the launch argv a real case WOULD hand to `tamandua`. This hook is a
// proof, not just a stub: E2.3's argv-recording stub never lstats the path, so
// it could not surface the ENOENT lstat every real launch hit. To close that
// blind spot (US-007), this hook lstats the PROVISIONED work clone at
// argv-capture time and embeds the existence evidence in-band (work_clone).
// A real case has already run the mandatory provisioning stage, so on a
// healthy host the clone MUST exist here; if it does not, the record carries
// existed:false + the lstat error, surfacing E2.3's ENOENT even in the
// zero-token proof. Evidence is recorded (never swallowed) so downstream
// tests/consumers can assert the clone physically existed when the argv was
// captured.
function recordDryRunRealLaunch(caseRecord, argv, workClonePath, extraFields = {}) {
  const outPath = dryRunRealLaunchOutPath();
  if (outPath === null) return null;
  fs.mkdirSync(path.dirname(outPath), { recursive: true, mode: 0o700 });
  let cloneStat = null;
  let lstatError = null;
  if (typeof workClonePath === 'string' && workClonePath !== '') {
    try {
      const st = fs.lstatSync(workClonePath);
      cloneStat = { exists: true, is_directory: st.isDirectory(), size: st.size };
    } catch (error) {
      lstatError = error.message;
    }
  } else {
    lstatError = 'work-clone-path-not-provided';
  }
  const record = {
    recorded_at: utcTimestamp(),
    case_id: caseRecord.id,
    harness: caseRecord.harness,
    workflow: caseRecord.workflow,
    // US-008: for the W2.24 local sentinel the MANIFEST workflow stays `local`
    // but the constructed argv names tt-docs-drift — record the resolved id
    // so consumers can bind argv to the adapter resolution (null = the
    // manifest workflow id was used verbatim).
    resolved_workflow: resolveLocalSentinel(caseRecord).sentinel
      ? LOCAL_SENTINEL_WORKFLOW_ID
      : null,
    fixture: caseRecord.fixture,
    task: caseRecord.task,
    executable: 'tamandua',
    argv,
    // US-010 (S12 controller): token-saver paired-launch records carry
    // launch_role ('flagged' | 'control') + the token_saver_case marker so
    // consumers can bind each of the two recorded argvs to its role. Other
    // cases never carry these fields.
    ...extraFields,
    work_clone: {
      path: workClonePath ?? null,
      existed: cloneStat !== null,
      is_directory: cloneStat === null ? null : cloneStat.is_directory,
      size: cloneStat === null ? null : cloneStat.size,
      lstat_error: lstatError,
    },
  };
  fs.appendFileSync(outPath, `${JSON.stringify(record)}\n`, { mode: 0o600 });
  return outPath;
}

function resolveOraclesRoot() {
  const override = process.env.TT_CONTROLLER_SELF_TEST_ORACLES_ROOT;
  if (override === undefined) return DEFAULT_ORACLES_ROOT;
  if (process.env.TT_CONTROLLER_SELF_TEST !== '1') {
    throw new Error('TT_CONTROLLER_SELF_TEST_ORACLES_ROOT requires TT_CONTROLLER_SELF_TEST=1');
  }
  const candidate = path.resolve(override);
  const details = fs.lstatSync(candidate);
  const realVarRoot = fs.realpathSync(VAR_ROOT);
  const realCandidate = fs.realpathSync(candidate);
  if (!details.isDirectory() || details.isSymbolicLink() || !pathIsWithin(realVarRoot, realCandidate)) {
    throw new Error('self-test oracle root must be a contained regular directory beneath torture-test/var');
  }
  return realCandidate;
}

function usage() {
  console.log(`Usage: tt-controller --manifest <path> [options]
       tt-controller --resume <campaign-id> [--manifest <path>] [options]

Validate and execute a Tamandua torture-test case manifest.

Options:
  --manifest <path>       JSONL case manifest beneath torture-test/
  --resume <campaign-id>  Resume an existing campaign without relaunching it
  --validate-only         Validate every manifest record without creating a campaign
  --case <id>             Run/validate exactly ONE manifest case id (focused rerun)
  --scripted-only         Execute scripted/local cases and report real cases pending-real
  --concurrency <count>   Maximum active cases; integer >= 1 (default: 1)
  --stagger <duration>    Delay between launches (default: 0s)
  --help, -h              Print this help

Duration examples: 250ms, 5s, 2m, 1h
`);
}

function parseDuration(value) {
  const match = /^(0|[1-9]\d*)(ms|s|m|h)$/.exec(value);
  if (match === null) {
    throw new Error('--stagger must be a duration such as 250ms, 5s, 2m, or 1h');
  }
  const multipliers = { ms: 1, s: 1_000, m: 60_000, h: 3_600_000 };
  const duration = Number(match[1]) * multipliers[match[2]];
  if (!Number.isSafeInteger(duration)) throw new Error('--stagger duration is too large');
  return duration;
}

function readOptionValue(argv, index, option) {
  const nextIndex = index + 1;
  if (nextIndex >= argv.length || argv[nextIndex].startsWith('--')) {
    throw new Error(`${option} requires a value`);
  }
  return { value: argv[nextIndex], nextIndex };
}

function parseArgs(argv) {
  const options = {
    help: false,
    manifest: null,
    resume: null,
    concurrency: DEFAULT_CONCURRENCY,
    staggerMs: DEFAULT_STAGGER_MS,
    concurrencySpecified: false,
    staggerSpecified: false,
    validateOnly: false,
    scriptedOnly: false,
    scriptedOnlySpecified: false,
    caseId: null,
    caseSpecified: false,
  };
  const seen = new Set();
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--help' || arg === '-h') return { ...options, help: true };
    if (arg === '--manifest') {
      if (seen.has(arg)) throw new Error('--manifest may be specified only once');
      seen.add(arg);
      const parsed = readOptionValue(argv, index, arg);
      options.manifest = parsed.value;
      index = parsed.nextIndex;
      continue;
    }
    if (arg === '--resume') {
      if (seen.has(arg)) throw new Error('--resume may be specified only once');
      seen.add(arg);
      const parsed = readOptionValue(argv, index, arg);
      if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(parsed.value)) {
        throw new Error('--resume requires a contained campaign ID');
      }
      options.resume = parsed.value;
      index = parsed.nextIndex;
      continue;
    }
    if (arg === '--validate-only') {
      if (seen.has(arg)) throw new Error('--validate-only may be specified only once');
      seen.add(arg);
      options.validateOnly = true;
      continue;
    }
    if (arg === '--scripted-only') {
      if (seen.has(arg)) throw new Error('--scripted-only may be specified only once');
      seen.add(arg);
      options.scriptedOnly = true;
      options.scriptedOnlySpecified = true;
      continue;
    }
    if (arg === '--case') {
      if (seen.has(arg)) throw new Error('--case may be specified only once');
      seen.add(arg);
      const parsed = readOptionValue(argv, index, arg);
      if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(parsed.value)) {
        throw new Error('--case requires a contained case id');
      }
      options.caseId = parsed.value;
      options.caseSpecified = true;
      index = parsed.nextIndex;
      continue;
    }
    if (arg === '--concurrency') {
      if (seen.has(arg)) throw new Error('--concurrency may be specified only once');
      seen.add(arg);
      const parsed = readOptionValue(argv, index, arg);
      if (!/^[1-9]\d*$/.test(parsed.value) || !Number.isSafeInteger(Number(parsed.value))) {
        throw new Error('--concurrency must be an integer >= 1');
      }
      options.concurrency = Number(parsed.value);
      options.concurrencySpecified = true;
      index = parsed.nextIndex;
      continue;
    }
    if (arg === '--stagger') {
      if (seen.has(arg)) throw new Error('--stagger may be specified only once');
      seen.add(arg);
      const parsed = readOptionValue(argv, index, arg);
      options.staggerMs = parseDuration(parsed.value);
      options.staggerSpecified = true;
      index = parsed.nextIndex;
      continue;
    }
    throw new Error(`unknown argument: ${arg}`);
  }
  if (options.manifest === null && options.resume === null) {
    throw new Error('--manifest is required for a new campaign');
  }
  if (options.validateOnly && options.resume !== null) {
    throw new Error('--validate-only cannot be combined with --resume');
  }
  if (options.validateOnly && options.scriptedOnly) {
    throw new Error('--validate-only cannot be combined with --scripted-only');
  }
  if (options.validateOnly && (options.concurrencySpecified || options.staggerSpecified)) {
    throw new Error('--validate-only cannot be combined with scheduler options');
  }
  return options;
}

function isObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

function valueType(value) {
  if (value === null) return 'null';
  if (Array.isArray(value)) return 'array';
  if (Number.isInteger(value)) return 'integer';
  return typeof value;
}

function typeMatches(value, expected) {
  switch (expected) {
    case 'null': return value === null;
    case 'array': return Array.isArray(value);
    case 'object': return isObject(value);
    case 'integer': return Number.isInteger(value);
    case 'number': return typeof value === 'number' && Number.isFinite(value);
    case 'string': return typeof value === 'string';
    case 'boolean': return typeof value === 'boolean';
    default: return false;
  }
}

function displayValue(value) {
  return JSON.stringify(value);
}

function resolveReference(rootSchema, reference) {
  if (!reference.startsWith('#/')) throw new Error(`unsupported schema reference: ${reference}`);
  return reference.slice(2).split('/').reduce((current, token) => {
    const key = token.replaceAll('~1', '/').replaceAll('~0', '~');
    if (!isObject(current) || !(key in current)) {
      throw new Error(`unresolved schema reference: ${reference}`);
    }
    return current[key];
  }, rootSchema);
}

function validateSchema(value, schema, location, rootSchema) {
  if (schema.$ref !== undefined) {
    return validateSchema(value, resolveReference(rootSchema, schema.$ref), location, rootSchema);
  }

  if (Array.isArray(schema.anyOf)) {
    const alternatives = schema.anyOf.map((alternative) =>
      validateSchema(value, alternative, location, rootSchema));
    if (alternatives.some((errors) => errors.length === 0)) return [];
    const details = alternatives
      .map((errors) => errors[0])
      .filter(Boolean)
      .join('; ');
    return [`${location}: does not match any allowed schema${details ? ` (${details})` : ''}`];
  }

  const errors = [];
  if (schema.type !== undefined && !typeMatches(value, schema.type)) {
    return [`${location}: expected ${schema.type}, got ${valueType(value)}`];
  }

  if (Array.isArray(schema.enum) && !schema.enum.some((item) =>
    JSON.stringify(item) === JSON.stringify(value))) {
    errors.push(`${location}: must be one of ${schema.enum.map(displayValue).join(', ')}`);
    return errors;
  }

  if (typeof value === 'string') {
    if (schema.minLength !== undefined && value.length < schema.minLength) {
      errors.push(`${location}: must contain at least ${schema.minLength} character(s)`);
    }
    if (schema.maxLength !== undefined && value.length > schema.maxLength) {
      errors.push(`${location}: must contain at most ${schema.maxLength} character(s)`);
    }
    if (schema.pattern !== undefined && !(new RegExp(schema.pattern)).test(value)) {
      errors.push(`${location}: does not match required pattern ${schema.pattern}`);
    }
  }

  if (typeof value === 'number') {
    if (!Number.isFinite(value)) errors.push(`${location}: must be finite`);
    if (schema.minimum !== undefined && value < schema.minimum) {
      errors.push(`${location}: must be >= ${schema.minimum}`);
    }
    if (schema.exclusiveMinimum !== undefined && value <= schema.exclusiveMinimum) {
      errors.push(`${location}: must be > ${schema.exclusiveMinimum}`);
    }
  }

  if (Array.isArray(value)) {
    if (schema.minItems !== undefined && value.length < schema.minItems) {
      errors.push(`${location}: must contain at least ${schema.minItems} item(s)`);
    }
    if (schema.maxItems !== undefined && value.length > schema.maxItems) {
      errors.push(`${location}: must contain at most ${schema.maxItems} item(s)`);
    }
    if (schema.uniqueItems === true) {
      const seen = new Set();
      value.forEach((item, index) => {
        const key = JSON.stringify(item);
        if (seen.has(key)) errors.push(`${location}[${index}]: duplicate array item`);
        seen.add(key);
      });
    }
    if (schema.items !== undefined) {
      value.forEach((item, index) => {
        errors.push(...validateSchema(item, schema.items, `${location}[${index}]`, rootSchema));
      });
    }
  }

  if (isObject(value)) {
    if (Array.isArray(schema.required)) {
      for (const key of schema.required) {
        if (!Object.hasOwn(value, key)) {
          errors.push(`${location}: missing required property ${JSON.stringify(key)}`);
        }
      }
    }
    const properties = schema.properties ?? {};
    for (const [key, item] of Object.entries(value)) {
      if (Object.hasOwn(properties, key)) {
        errors.push(...validateSchema(item, properties[key], `${location}.${key}`, rootSchema));
      } else if (schema.additionalProperties === false) {
        errors.push(`${location}: unknown property ${JSON.stringify(key)}`);
      }
    }
  }

  return errors;
}

function pathIsWithin(root, candidate) {
  const relative = path.relative(root, candidate);
  return relative === '' || (!relative.startsWith(`..${path.sep}`) && relative !== '..' && !path.isAbsolute(relative));
}

function existingPrefixIsContained(candidate) {
  const rootRealPath = fs.realpathSync(TT_ROOT);
  const relative = path.relative(TT_ROOT, candidate);
  let current = TT_ROOT;

  for (const segment of relative.split(path.sep).filter(Boolean)) {
    current = path.join(current, segment);
    try {
      fs.lstatSync(current);
    } catch (error) {
      if (error.code === 'ENOENT') return true;
      return false;
    }

    try {
      if (!pathIsWithin(rootRealPath, fs.realpathSync(current))) return false;
    } catch {
      // lstat succeeded but realpath failed: this is a dangling symlink or
      // another path that cannot be safely dereferenced.
      return false;
    }
  }
  return true;
}

function isSafeRelativePath(candidate, { executable = false } = {}) {
  if (typeof candidate !== 'string' || candidate.length === 0 || candidate.includes('\0')) return false;
  if (executable && !candidate.includes('/') && !candidate.includes('\\') && candidate !== '..' && candidate !== '.') {
    return true;
  }

  const portable = candidate.replaceAll('\\', '/');
  if (portable.startsWith('/') || /^[A-Za-z]:\//.test(portable)) return false;
  if (portable.split('/').includes('..')) return false;

  const resolved = path.resolve(TT_ROOT, portable);
  if (!pathIsWithin(TT_ROOT, resolved)) return false;

  return existingPrefixIsContained(resolved);
}

function validateSafePaths(caseRecord) {
  const errors = [];
  const check = (value, location, options) => {
    if (!isSafeRelativePath(value, options)) {
      errors.push(`${location}: path escapes torture-test/`);
    }
  };

  check(caseRecord.task, '$.task');
  for (const [index, value] of caseRecord.boundary_files.entries()) {
    check(value, `$.boundary_files[${index}]`);
  }
  for (const [index, value] of caseRecord.forbidden.entries()) {
    check(value, `$.forbidden[${index}]`);
  }
  for (const hookName of ['reset', 'command']) {
    const hook = caseRecord[hookName];
    if (!isObject(hook)) continue;
    check(hook.executable, `$.${hookName}.executable`, { executable: true });
    check(hook.cwd, `$.${hookName}.cwd`);
    hook.args.forEach((argument, index) => {
      if (argument.includes('\0')) errors.push(`$.${hookName}.args[${index}]: must not contain NUL`);
    });
  }
  return errors;
}

function loadSchema() {
  try {
    return JSON.parse(fs.readFileSync(SCHEMA_PATH, 'utf8'));
  } catch (error) {
    throw new Error(`cannot load case schema ${SCHEMA_PATH}: ${error.message}`);
  }
}

function loadManifest(manifestPath, schema) {
  let source;
  try {
    source = fs.readFileSync(manifestPath, 'utf8');
  } catch (error) {
    throw new Error(`cannot read manifest ${manifestPath}: ${error.message}`);
  }

  const records = [];
  const errors = [];
  const ids = new Map();
  source.split(/\r?\n/).forEach((line, index) => {
    const lineNumber = index + 1;
    if (line.trim() === '') return;

    let record;
    try {
      record = JSON.parse(line);
    } catch (error) {
      errors.push(`line ${lineNumber}: invalid JSON: ${error.message}`);
      return;
    }

    const schemaErrors = validateSchema(record, schema, '$', schema);
    for (const error of schemaErrors) errors.push(`line ${lineNumber}: ${error}`);
    if (schemaErrors.length > 0) return;

    if (ids.has(record.id)) {
      errors.push(`line ${lineNumber}: duplicate id ${JSON.stringify(record.id)} (first declared on line ${ids.get(record.id)})`);
    } else {
      ids.set(record.id, lineNumber);
    }

    for (const error of validateSafePaths(record)) errors.push(`line ${lineNumber}: ${error}`);
    records.push(record);
  });

  if (records.length === 0 && errors.length === 0) errors.push('manifest contains no cases');
  if (errors.length > 0) {
    const error = new Error(`Manifest validation failed:\n${errors.map((item) => `- ${item}`).join('\n')}`);
    error.validationFailure = true;
    throw error;
  }
  return { cases: records, source };
}

// Apply the --case single-case filter. Selcets exactly the matching case id;
// an unknown id fails fast with a clear message listing available ids. Returns
// a NEW manifest object so downstream callers (state creation, execution,
// reports) operate only on the focused case. Never mutates the loaded source.
function applyCaseFilter(manifest, caseId) {
  if (caseId === null) return manifest;
  const matches = manifest.cases.filter((record) => record.id === caseId);
  if (matches.length === 0) {
    const ids = manifest.cases.map((record) => record.id);
    const shown = ids.length > 12
      ? `${ids.slice(0, 12).join(', ')}, ... (${ids.length} total)`
      : ids.join(', ');
    throw new Error(`unknown --case id '${caseId}': not present in manifest (available ids: ${shown})`);
  }
  return { cases: matches, source: manifest.source };
}

function hasRequirements(caseRecord) {
  return Object.keys(caseRecord.requires).length > 0;
}

function validateHostProfile(profile) {
  if (!isObject(profile)) return ['profile must be a JSON object'];
  const errors = [];
  const objectSections = ['platform', 'containment', 'toolchains', 'capabilities', 'spawnSpeedClass', 'harness'];
  for (const section of objectSections) {
    if (profile[section] !== undefined && profile[section] !== null && !isObject(profile[section])) {
      errors.push(`${section} must be an object or null`);
    }
  }
  if (profile.nodeRuntimes !== undefined && profile.nodeRuntimes !== null) {
    if (!Array.isArray(profile.nodeRuntimes)) {
      errors.push('nodeRuntimes must be an array or null');
    } else if (profile.nodeRuntimes.some((runtime) => !isObject(runtime))) {
      errors.push('nodeRuntimes entries must be objects');
    }
  }
  return errors;
}

function loadRequiredHostProfile(cases) {
  if (!cases.some(hasRequirements)) return null;
  let profile;
  try {
    const details = fs.lstatSync(HOST_PROFILE_PATH);
    if (!details.isFile() || details.isSymbolicLink()) {
      throw new Error('host-profile.json is not a contained regular file');
    }
    if (!pathIsWithin(fs.realpathSync(VAR_ROOT), fs.realpathSync(HOST_PROFILE_PATH))) {
      throw new Error('host-profile.json escapes torture-test/var');
    }
    profile = JSON.parse(fs.readFileSync(HOST_PROFILE_PATH, 'utf8'));
  } catch (error) {
    throw new Error(`cannot load required host profile ${HOST_PROFILE_PATH}: ${error.message}`);
  }
  const errors = validateHostProfile(profile);
  if (errors.length > 0) {
    throw new Error(`cannot load required host profile ${HOST_PROFILE_PATH}: ${errors.join('; ')}`);
  }
  return profile;
}

function observedPlatform(profile) {
  const label = profile.platform?.label;
  if (label === 'linux' || label === 'darwin' || label === 'other') return label;
  const os = profile.platform?.os;
  if (os === 'linux' || os === 'darwin') return os;
  if (typeof os === 'string' && os.length > 0) return 'other';
  return null;
}

function observedToolchain(profile, name) {
  const toolchain = profile.toolchains?.[name];
  if (!isObject(toolchain)) return toolchain === undefined ? null : toolchain;
  return {
    present: toolchain.present ?? null,
    buildPassed: toolchain.buildPassed ?? null,
    testPassed: toolchain.testPassed ?? null,
  };
}

// Canonical boolean-leaf contract (E2.2/US-002): a toolchain predicate is
// satisfied iff the host profile records toolchains.<name>.present === true.
// buildPassed/testPassed are NOT required for satisfaction (W0.0's --fast
// probes leave them null). See case.schema.json predicates and spec 01.
function toolchainSatisfied(observed) {
  return isObject(observed) && observed.present === true;
}

function observedContainment(profile, name) {
  if (name === 'systemd-user-scope') return profile.containment?.systemdUserScope ?? null;
  if (name === 'procfs') {
    return profile.containment?.procfs ?? profile.capabilities?.procfs ?? null;
  }
  return null;
}

function observedNodeMajor(profile) {
  if (!Array.isArray(profile.nodeRuntimes)) return null;
  const majors = profile.nodeRuntimes
    .map((runtime) => runtime.major)
    .filter((major) => Number.isSafeInteger(major) && major >= 0);
  return majors.length === 0 ? null : Math.max(...majors);
}

// Harness presence per the canonical contract: a `pi`/`hermes` capability is
// satisfied iff the profile records harness.<name>.present === true (W0.0
// records mechanical presence; the live --spend probes additionally record
// `authenticated`). For backward compatibility with pre-contract profiles we
// also accept an explicitly-recorded `authenticated` boolean (true => present,
// false => honestly absent). An unrecorded harness is honestly absent (null).
function observedHarnessPresence(profile, name) {
  const harness = profile.harness?.[name];
  if (!isObject(harness)) return null;
  if (typeof harness.present === 'boolean') return harness.present;
  if (typeof harness.authenticated === 'boolean') return harness.authenticated;
  return null;
}

function observedCapability(profile, name) {
  if (name === 'procfs') return observedContainment(profile, 'procfs');
  if (name === 'systemd-user-scope') return observedContainment(profile, name);
  if (name === 'node-sqlite') {
    if (!Array.isArray(profile.nodeRuntimes)) return null;
    const observations = profile.nodeRuntimes
      .map((runtime) => runtime.sqliteAvailable)
      .filter((available) => typeof available === 'boolean');
    return observations.length === 0 ? null : observations.some(Boolean);
  }
  if (name === 'hermes') return observedHarnessPresence(profile, 'hermes');
  if (name === 'pi') return observedHarnessPresence(profile, 'pi');
  if (Object.hasOwn(profile.capabilities ?? {}, name)) return profile.capabilities[name];
  const spawnClass = profile.spawnSpeedClass?.class;
  if (typeof spawnClass === 'string' && name === `spawn-${spawnClass}`) return true;
  return null;
}

function evaluateRequirements(requires, profile) {
  const failures = [];
  const fail = (predicate, expected, observed) => {
    failures.push({ predicate, expected, observed });
  };

  if (requires.platform !== undefined) {
    const expected = requires.platform;
    const allowed = Array.isArray(expected) ? expected : [expected];
    const observed = observedPlatform(profile);
    if (!allowed.includes(observed)) fail('platform', expected, observed);
  }
  for (const name of requires.toolchains ?? []) {
    const observed = observedToolchain(profile, name);
    if (!toolchainSatisfied(observed)) fail(`toolchains.${name}`, true, observed);
  }
  for (const name of requires.containment ?? []) {
    const observed = observedContainment(profile, name);
    if (observed !== true) fail(`containment.${name}`, true, observed);
  }
  if (requires.node_min !== undefined) {
    const observed = observedNodeMajor(profile);
    if (observed === null || observed < requires.node_min) fail('node_min', requires.node_min, observed);
  }
  for (const name of requires.capabilities ?? []) {
    const observed = observedCapability(profile, name);
    if (observed !== true) fail(`capabilities.${name}`, true, observed);
  }
  return failures;
}

function applyHostRequirements(manifest, state, profile) {
  if (profile === null) return;
  let terminalTimestamp = null;
  for (let index = 0; index < manifest.cases.length; index += 1) {
    const record = manifest.cases[index];
    if (state.cases[index].phase === 'terminal') continue;
    if (!hasRequirements(record)) continue;
    const evidence = evaluateRequirements(record.requires, profile);
    if (evidence.length === 0) continue;
    terminalTimestamp ??= utcTimestamp();
    Object.assign(state.cases[index], {
      phase: 'terminal',
      outcome: 'NOT_RUN',
      terminal_at: terminalTimestamp,
      reason: {
        category: 'predicate',
        evidence,
      },
    });
  }
  if (terminalTimestamp !== null) state.updated_at = terminalTimestamp;
}

function applyExecutionSelection(manifest, state) {
  if ((state.options.execution_selection ?? 'all') !== 'scripted-only') return;
  let terminalTimestamp = null;
  for (let index = 0; index < manifest.cases.length; index += 1) {
    const record = manifest.cases[index];
    const caseState = state.cases[index];
    if (caseUsesScriptedEnvironment(record) || caseState.phase !== 'pending') continue;
    terminalTimestamp ??= utcTimestamp();
    Object.assign(caseState, {
      phase: 'terminal',
      outcome: 'NOT_RUN',
      terminal_at: terminalTimestamp,
      reason: { category: 'pending-real' },
    });
  }
  if (terminalTimestamp !== null) state.updated_at = terminalTimestamp;
}

function resolveManifestPath(input) {
  const manifestPath = path.resolve(process.cwd(), input);
  if (!pathIsWithin(TT_ROOT, manifestPath)) {
    throw new Error(`manifest path escapes torture-test/: ${input}`);
  }
  try {
    if (!pathIsWithin(fs.realpathSync(TT_ROOT), fs.realpathSync(manifestPath))) {
      throw new Error(`manifest path escapes torture-test/: ${input}`);
    }
  } catch (error) {
    if (error.code !== 'ENOENT') throw error;
  }
  return manifestPath;
}

function sha256(value) {
  return createHash('sha256').update(value).digest('hex');
}

function toPortableRelativePath(absolutePath) {
  return path.relative(TT_ROOT, absolutePath).split(path.sep).join('/');
}

function utcTimestamp() {
  return new Date().toISOString();
}

function configuredTokenPollIntervalMs() {
  const configured = process.env.TT_CONTROLLER_POLL_INTERVAL_MS;
  if (configured === undefined) return DEFAULT_TOKEN_POLL_INTERVAL_MS;
  if (!/^[1-9]\d*$/.test(configured) || !Number.isSafeInteger(Number(configured))) {
    throw new Error('TT_CONTROLLER_POLL_INTERVAL_MS must be a positive integer');
  }
  return Number(configured);
}

function configuredCapCheckIntervalMs() {
  const configured = process.env.TT_CONTROLLER_CAP_CHECK_INTERVAL_MS;
  if (configured === undefined) return DEFAULT_CAP_CHECK_INTERVAL_MS;
  if (!/^[1-9]\d*$/.test(configured) || !Number.isSafeInteger(Number(configured))) {
    throw new Error('TT_CONTROLLER_CAP_CHECK_INTERVAL_MS must be a positive integer');
  }
  return Number(configured);
}

function configuredProviderRetryBackoffMs() {
  const configured = process.env.TT_CONTROLLER_PROVIDER_RETRY_BACKOFF_MS;
  if (configured === undefined) return DEFAULT_PROVIDER_RETRY_BACKOFF_MS;
  if (!/^\d+$/.test(configured) || !Number.isSafeInteger(Number(configured))) {
    throw new Error('TT_CONTROLLER_PROVIDER_RETRY_BACKOFF_MS must be a nonnegative integer');
  }
  return Number(configured);
}

function ensureResultsRoot() {
  const ttRealPath = fs.realpathSync(TT_ROOT);
  if (fs.existsSync(VAR_ROOT)) {
    const varDetails = fs.lstatSync(VAR_ROOT);
    if (!varDetails.isDirectory() || varDetails.isSymbolicLink()) {
      throw new Error('torture-test/var is not a contained directory');
    }
  } else {
    fs.mkdirSync(VAR_ROOT, { mode: 0o700 });
  }
  const varRealPath = fs.realpathSync(VAR_ROOT);
  if (!pathIsWithin(ttRealPath, varRealPath)) {
    throw new Error('results directory escapes torture-test/var');
  }
  if (fs.existsSync(RESULTS_ROOT)) {
    const resultsDetails = fs.lstatSync(RESULTS_ROOT);
    if (!resultsDetails.isDirectory() || resultsDetails.isSymbolicLink()) {
      throw new Error('results directory is not a contained directory');
    }
  } else {
    fs.mkdirSync(RESULTS_ROOT, { mode: 0o700 });
  }
  if (!pathIsWithin(varRealPath, fs.realpathSync(RESULTS_ROOT))) {
    throw new Error('results directory escapes torture-test/var');
  }
}

function generateCampaignId() {
  const compactTimestamp = utcTimestamp().replaceAll(/[-:.]/g, '');
  return `campaign-${compactTimestamp}-${randomUUID()}`;
}

function createCampaignDirectory() {
  ensureResultsRoot();
  for (let attempt = 0; attempt < 10; attempt += 1) {
    const campaignId = generateCampaignId();
    const campaignDir = path.join(RESULTS_ROOT, campaignId);
    try {
      fs.mkdirSync(campaignDir, { mode: 0o700 });
      return { campaignId, campaignDir };
    } catch (error) {
      if (error.code !== 'EEXIST') throw error;
    }
  }
  throw new Error('could not allocate a unique campaign ID');
}

function atomicWriteState(campaignDir, state) {
  const statePath = path.join(campaignDir, 'state.json');
  const tempPath = path.join(campaignDir, `.state.json.${process.pid}.${randomUUID()}.tmp`);
  let descriptor;
  try {
    descriptor = fs.openSync(tempPath, 'wx', 0o600);
    fs.writeFileSync(descriptor, `${JSON.stringify(state, null, 2)}\n`, 'utf8');
    fs.fsyncSync(descriptor);
    fs.closeSync(descriptor);
    descriptor = undefined;
    fs.renameSync(tempPath, statePath);
    const directoryDescriptor = fs.openSync(campaignDir, 'r');
    try {
      fs.fsyncSync(directoryDescriptor);
    } finally {
      fs.closeSync(directoryDescriptor);
    }
  } catch (error) {
    if (descriptor !== undefined) fs.closeSync(descriptor);
    try {
      fs.rmSync(tempPath, { force: true });
    } catch {
      // Preserve the original persistence failure.
    }
    throw new Error(`cannot persist campaign state: ${error.message}`);
  }
}

function processIsAlive(pid) {
  try {
    process.kill(pid, 0);
    try {
      const stat = fs.readFileSync(`/proc/${pid}/stat`, 'utf8');
      const closingParenthesis = stat.lastIndexOf(')');
      if (closingParenthesis >= 0 && stat.slice(closingParenthesis + 2).startsWith('Z ')) return false;
    } catch {
      // procfs is Linux-specific; kill(0) remains the portable fallback.
    }
    return true;
  } catch (error) {
    return error.code === 'EPERM';
  }
}

function processIdentity(pid) {
  try {
    const stat = fs.readFileSync(`/proc/${pid}/stat`, 'utf8');
    const closingParenthesis = stat.lastIndexOf(')');
    if (closingParenthesis < 0) return null;
    const fields = stat.slice(closingParenthesis + 2).trim().split(/\s+/);
    if (fields[0] === 'Z' || fields[19] === undefined) return null;
    return `linux-proc-start-${fields[19]}`;
  } catch {
    return null;
  }
}

function processMatchesIdentity(pid, identity) {
  return typeof identity === 'string' && processIsAlive(pid) && processIdentity(pid) === identity;
}

function acquireCampaignLock(campaignDir) {
  const lockPath = path.join(campaignDir, '.controller.lock');
  for (let attempt = 0; attempt < 3; attempt += 1) {
    const owner = { pid: process.pid, token: randomUUID(), acquired_at: utcTimestamp() };
    try {
      const descriptor = fs.openSync(lockPath, 'wx', 0o600);
      try {
        fs.writeFileSync(descriptor, `${JSON.stringify(owner)}\n`, 'utf8');
        fs.fsyncSync(descriptor);
      } finally {
        fs.closeSync(descriptor);
      }
      return () => {
        try {
          const current = JSON.parse(fs.readFileSync(lockPath, 'utf8'));
          if (current.token === owner.token) fs.unlinkSync(lockPath);
        } catch (error) {
          if (error.code !== 'ENOENT') throw error;
        }
      };
    } catch (error) {
      if (error.code !== 'EEXIST') throw new Error(`cannot acquire campaign ownership: ${error.message}`);
      let existing;
      try {
        const details = fs.lstatSync(lockPath);
        if (!details.isFile() || details.isSymbolicLink()) throw new Error('lock is not a regular file');
        existing = JSON.parse(fs.readFileSync(lockPath, 'utf8'));
        if (!Number.isSafeInteger(existing.pid) || existing.pid <= 0 || typeof existing.token !== 'string') {
          throw new Error('lock owner is invalid');
        }
      } catch (lockError) {
        throw new Error(`cannot acquire campaign ownership: ${lockError.message}`);
      }
      if (processIsAlive(existing.pid)) {
        throw new Error(`campaign is already controlled by process ${existing.pid}`);
      }
      try {
        fs.unlinkSync(lockPath);
      } catch (unlinkError) {
        if (unlinkError.code !== 'ENOENT') {
          throw new Error(`cannot replace stale campaign ownership: ${unlinkError.message}`);
        }
      }
    }
  }
  throw new Error('cannot acquire campaign ownership after replacing a stale lock');
}

function operatorEnvironmentWithoutRuntimeRouting() {
  const environment = {};
  for (const [key, value] of Object.entries(process.env)) {
    if (key === 'HOME' || key.startsWith('TT_') || key.startsWith('TAMANDUA_') || key.startsWith('HERMES_')) {
      continue;
    }
    environment[key] = value;
  }
  return environment;
}

function parsePrintedEnvironment(output, scriptPath) {
  const parsed = {};
  for (const line of output.split(/\r?\n/)) {
    if (line === '') continue;
    const separator = line.indexOf('=');
    if (separator < 1) throw new Error(`${scriptPath} print emitted an invalid environment line`);
    const key = line.slice(0, separator);
    const value = line.slice(separator + 1);
    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key) || Object.hasOwn(parsed, key) || value.includes('\0')) {
      throw new Error(`${scriptPath} print emitted an invalid environment entry`);
    }
    parsed[key] = value;
  }
  if (typeof parsed.HOME !== 'string' || typeof parsed.TAMANDUA_STATE_DIR !== 'string') {
    throw new Error(`${scriptPath} print omitted HOME or TAMANDUA_STATE_DIR`);
  }
  return parsed;
}

function loadSpawnEnvironment(scripted) {
  const scriptPath = scripted ? SCRIPTED_ENV_PATH : REAL_ENV_PATH;
  const operatorBaseEnv = operatorEnvironmentWithoutRuntimeRouting();
  const result = spawnSync('bash', [scriptPath, 'print'], {
    cwd: TT_ROOT,
    env: operatorBaseEnv,
    encoding: 'utf8',
    maxBuffer: 1024 * 1024,
    shell: false,
  });
  if (result.error !== undefined || result.status !== 0) {
    const detail = result.error?.message ?? result.stderr?.trim() ?? `exit ${result.status}`;
    throw new Error(`cannot load spawn environment from ${scriptPath}: ${detail}`);
  }
  const merged = { ...operatorBaseEnv, ...parsePrintedEnvironment(result.stdout, scriptPath) };
  // FIX10 US-003: fail closed — the resolved HOME must be strictly inside
  // torture-test/var (realpath). A misconfigured env script (or one that
  // prints an escaping HOME) throws here, and the existing callers convert
  // the failure to TEST_INFRA_FAIL with category spawn-environment. Never
  // fall through to the real operator HOME.
  assertContainedHome(merged.HOME, VAR_ROOT, 'spawn environment HOME');
  return merged;
}

// FIX10 US-003: single fail-closed choke-point for EVERY spawned child in
// tt-controller. Every spawn — reset/command/launch/stop/oracle hooks,
// durable commands, targeted O9 probes, token-ledger and status queries —
// passes through this assertion: childEnv.HOME must resolve strictly inside
// torture-test/var. A violation throws (error.code = TT_CONTAINMENT_VIOLATION)
// and executeEligibleCases aborts the case as TEST_INFRA_FAIL with category
// 'containment-violation' — never a silent fall-through to the real HOME.
function assertContainedSpawnEnv(childEnv) {
  assertContainedHome(childEnv?.HOME, VAR_ROOT, 'spawn environment HOME');
}

function caseUsesScriptedEnvironment(caseRecord) {
  return caseRecord.harness === 'scripted-pi'
    || caseRecord.harness === 'scripted-hermes'
    || caseRecord.context.execution_mode === 'scripted';
}

function daemonControlAvailable() {
  try {
    const details = fs.lstatSync(DAEMON_CONTROL_PATH);
    fs.accessSync(DAEMON_CONTROL_PATH, fs.constants.X_OK);
    return details.isFile() && !details.isSymbolicLink()
      && pathIsWithin(fs.realpathSync(TT_ROOT), fs.realpathSync(DAEMON_CONTROL_PATH));
  } catch {
    return false;
  }
}

function evidenceRelativePath(campaignDir, absolutePath) {
  return path.relative(campaignDir, absolutePath).split(path.sep).join('/');
}

function resolvePinnedHookExecutable(executable) {
  if (!executable.includes('/') && !executable.includes('\\')) return executable;
  const unresolved = path.resolve(TT_ROOT, executable);
  const details = fs.lstatSync(unresolved);
  if (!details.isFile() || details.isSymbolicLink()) {
    throw new Error(`hook executable is not a contained regular file: ${executable}`);
  }
  const pinned = fs.realpathSync(unresolved);
  if (!pathIsWithin(fs.realpathSync(TT_ROOT), pinned)) {
    throw new Error(`hook executable escapes torture-test/: ${executable}`);
  }
  fs.accessSync(pinned, fs.constants.X_OK);
  return pinned;
}

function resolvePinnedHookCwd(cwd) {
  const unresolved = path.resolve(TT_ROOT, cwd);
  const details = fs.lstatSync(unresolved);
  if (!details.isDirectory() || details.isSymbolicLink()) {
    throw new Error(`hook cwd is not a contained directory: ${cwd}`);
  }
  const pinned = fs.realpathSync(unresolved);
  if (!pathIsWithin(fs.realpathSync(TT_ROOT), pinned)) {
    throw new Error(`hook cwd escapes torture-test/: ${cwd}`);
  }
  return pinned;
}

function runHook(hookName, hook, childEnv, campaignDir, state, attempt, {
  enforceWall = true,
  timeoutMs,
  onChunk,
} = {}) {
  // FIX10 US-003 choke-point: never spawn a case/hook child with an
  // uncontained HOME (fails closed as TEST_INFRA_FAIL 'containment-violation'
  // via executeEligibleCases).
  assertContainedSpawnEnv(childEnv);
  const evidenceDir = path.join(campaignDir, 'evidence', attempt.case_id, attempt.id);
  fs.mkdirSync(evidenceDir, { recursive: true, mode: 0o700 });
  const stdoutPath = path.join(evidenceDir, `${hookName}.stdout`);
  const stderrPath = path.join(evidenceDir, `${hookName}.stderr`);
  const hookState = {
    argv: [hook.executable, ...hook.args],
    cwd: hook.cwd,
    intent_at: utcTimestamp(),
    started_at: utcTimestamp(),
    finished_at: null,
    exit_code: null,
    signal: null,
    stdout: evidenceRelativePath(campaignDir, stdoutPath),
    stderr: evidenceRelativePath(campaignDir, stderrPath),
  };
  attempt[hookName] = hookState;
  state.updated_at = hookState.started_at;
  atomicWriteState(campaignDir, state);

  let executable;
  let cwd;
  try {
    executable = resolvePinnedHookExecutable(hook.executable);
    cwd = resolvePinnedHookCwd(hook.cwd);
  } catch (error) {
    fs.writeFileSync(stdoutPath, Buffer.alloc(0), { mode: 0o600 });
    fs.writeFileSync(stderrPath, Buffer.alloc(0), { mode: 0o600 });
    hookState.finished_at = utcTimestamp();
    hookState.error = error.message;
    state.updated_at = hookState.finished_at;
    atomicWriteState(campaignDir, state);
    return Promise.resolve(hookState);
  }

  const stdoutDescriptor = fs.openSync(stdoutPath, 'wx', 0o600);
  let stderrDescriptor;
  try {
    stderrDescriptor = fs.openSync(stderrPath, 'wx', 0o600);
  } catch (error) {
    fs.closeSync(stdoutDescriptor);
    throw error;
  }
  return new Promise((resolve) => {
    let child;
    let launchError;
    let settled = false;
    let wallTimer;
    let forceKillTimer;
    const evidenceBytes = { stdout: 0, stderr: 0 };
    const stopChild = (message) => {
      launchError ??= new Error(message);
      if (child !== undefined && child.exitCode === null && child.signalCode === null) {
        child.kill('SIGTERM');
        forceKillTimer ??= setTimeout(() => child.kill('SIGKILL'), 1_000);
      }
    };
    const capture = (streamName, descriptor, chunk) => {
      const remaining = EVIDENCE_LIMIT_BYTES - evidenceBytes[streamName];
      if (remaining > 0) {
        const captured = chunk.subarray(0, remaining);
        try {
          fs.writeSync(descriptor, captured);
          evidenceBytes[streamName] += captured.length;
        } catch (error) {
          stopChild(`${streamName} evidence write failed: ${error.message}`);
          return;
        }
      }
      if (chunk.length > remaining) {
        stopChild(`${streamName} evidence limit of ${EVIDENCE_LIMIT_BYTES} bytes exceeded`);
      }
      if (onChunk !== undefined) {
        try {
          onChunk(streamName, chunk);
        } catch (error) {
          stopChild(`${hookName} stream processing failed: ${error.message}`);
        }
      }
    };
    const finish = (exitCode, signal) => {
      if (settled) return;
      settled = true;
      clearTimeout(wallTimer);
      clearTimeout(forceKillTimer);
      fs.closeSync(stdoutDescriptor);
      fs.closeSync(stderrDescriptor);
      hookState.finished_at = utcTimestamp();
      hookState.exit_code = exitCode;
      hookState.signal = signal;
      if (launchError !== undefined) hookState.error = launchError.message;
      state.updated_at = hookState.finished_at;
      atomicWriteState(campaignDir, state);
      resolve(hookState);
    };
    try {
      child = spawn(executable, hook.args, {
        cwd,
        env: childEnv,
        stdio: ['ignore', 'pipe', 'pipe'],
        shell: false,
      });
      child.stdout.on('data', (chunk) => capture('stdout', stdoutDescriptor, chunk));
      child.stderr.on('data', (chunk) => capture('stderr', stderrDescriptor, chunk));
      hookState.pid = child.pid ?? null;
      state.updated_at = utcTimestamp();
      atomicWriteState(campaignDir, state);
      if (enforceWall || timeoutMs !== undefined) {
        const remainingWallMs = enforceWall
          ? new Date(attempt.deadline_at).valueOf() - Date.now()
          : Number.POSITIVE_INFINITY;
        const hookTimeoutMs = timeoutMs ?? Number.POSITIVE_INFINITY;
        wallTimer = setTimeout(() => {
          stopChild(`${enforceWall ? 'case wall limit' : 'hook runtime limit'} reached while running ${hookName}`);
        }, Math.max(0, Math.min(remainingWallMs, hookTimeoutMs)));
      }
      child.once('error', (error) => {
        launchError = error;
      });
      child.once('close', finish);
    } catch (error) {
      launchError = error;
      finish(null, null);
    }
  });
}

function durableResultPath(campaignDir, hookState) {
  const absolutePath = path.resolve(campaignDir, hookState.result);
  if (!pathIsWithin(fs.realpathSync(campaignDir), absolutePath)) {
    throw new Error('durable hook result path escapes campaign directory');
  }
  return absolutePath;
}

function readDurableHookResult(campaignDir, hookState) {
  const resultPath = durableResultPath(campaignDir, hookState);
  const details = fs.lstatSync(resultPath);
  if (!details.isFile() || details.isSymbolicLink()) throw new Error('durable hook result is not a regular file');
  const result = JSON.parse(fs.readFileSync(resultPath, 'utf8'));
  if (!isObject(result) || result.version !== 1
      || !Number.isSafeInteger(result.runner_pid) || result.runner_pid <= 0
      || !isUtcTimestamp(result.started_at) || !isUtcTimestamp(result.finished_at)
      || (result.exit_code !== null && !Number.isInteger(result.exit_code))
      || (result.signal !== null && typeof result.signal !== 'string')
      || (result.error !== undefined && typeof result.error !== 'string')) {
    throw new Error('durable hook result is invalid');
  }
  if (hookState.runner_pid !== result.runner_pid) throw new Error('durable hook result runner PID does not match');
  return result;
}

function applyDurableHookResult(hookState, result) {
  hookState.started_at = result.started_at;
  hookState.finished_at = result.finished_at;
  hookState.exit_code = result.exit_code;
  hookState.signal = result.signal;
  hookState.child_pid = result.child_pid;
  if (result.error !== undefined) hookState.error = result.error;
}

function runDurableLocalCommand(hook, childEnv, campaignDir, state, attempt) {
  // FIX10 US-003 choke-point: the durable runner (tt-hook-runner) inherits
  // childEnv, so refuse to launch it with an uncontained HOME (fails closed
  // as TEST_INFRA_FAIL 'containment-violation').
  assertContainedSpawnEnv(childEnv);
  const evidenceDir = path.join(campaignDir, 'evidence', attempt.case_id, attempt.id);
  fs.mkdirSync(evidenceDir, { recursive: true, mode: 0o700 });
  const stdoutPath = path.join(evidenceDir, 'command.stdout');
  const stderrPath = path.join(evidenceDir, 'command.stderr');
  const resultPath = path.join(evidenceDir, 'command.result.json');
  const configPath = path.join(evidenceDir, 'command.runner.json');
  const hookState = {
    argv: [hook.executable, ...hook.args],
    cwd: hook.cwd,
    intent_at: utcTimestamp(),
    started_at: utcTimestamp(),
    finished_at: null,
    exit_code: null,
    signal: null,
    stdout: evidenceRelativePath(campaignDir, stdoutPath),
    stderr: evidenceRelativePath(campaignDir, stderrPath),
    result: evidenceRelativePath(campaignDir, resultPath),
  };
  attempt.command = hookState;
  state.updated_at = hookState.started_at;
  atomicWriteState(campaignDir, state);

  let executable;
  let cwd;
  try {
    executable = resolvePinnedHookExecutable(hook.executable);
    cwd = resolvePinnedHookCwd(hook.cwd);
  } catch (error) {
    fs.writeFileSync(stdoutPath, Buffer.alloc(0), { mode: 0o600 });
    fs.writeFileSync(stderrPath, Buffer.alloc(0), { mode: 0o600 });
    hookState.finished_at = utcTimestamp();
    hookState.error = error.message;
    state.updated_at = hookState.finished_at;
    atomicWriteState(campaignDir, state);
    return Promise.resolve(hookState);
  }

  fs.writeFileSync(configPath, `${JSON.stringify({
    executable,
    args: hook.args,
    cwd,
    stdout_path: stdoutPath,
    stderr_path: stderrPath,
    result_path: resultPath,
    deadline_at: attempt.deadline_at,
    evidence_limit_bytes: EVIDENCE_LIMIT_BYTES,
  }, null, 2)}\n`, { encoding: 'utf8', mode: 0o600, flag: 'wx' });

  return new Promise((resolve) => {
    let launchError;
    const finish = () => {
      if (launchError !== undefined) {
        hookState.finished_at = utcTimestamp();
        hookState.error = launchError.message;
      } else {
        try {
          applyDurableHookResult(hookState, readDurableHookResult(campaignDir, hookState));
        } catch (error) {
          hookState.finished_at = utcTimestamp();
          hookState.error = `durable command result unavailable: ${error.message}`;
        }
      }
      state.updated_at = hookState.finished_at;
      atomicWriteState(campaignDir, state);
      resolve(hookState);
    };
    try {
      const runner = spawn(process.execPath, [HOOK_RUNNER_PATH, configPath], {
        cwd: fs.realpathSync(TT_ROOT),
        env: childEnv,
        detached: true,
        stdio: 'ignore',
        shell: false,
      });
      hookState.runner_pid = runner.pid ?? null;
      hookState.runner_identity = hookState.runner_pid === null ? null : processIdentity(hookState.runner_pid);
      state.updated_at = utcTimestamp();
      atomicWriteState(campaignDir, state);
      runner.once('error', (error) => { launchError = error; });
      runner.once('close', finish);
    } catch (error) {
      launchError = error;
      finish();
    }
  });
}

// Find the provisioned working-clone path a case actually created, if any. A
// case has one only if a REAL (non-scripted, non-dry-run-stub) provisioning run
// succeeded (US-004 records it as attempt.fixture_work_clone). NOT_RUN /
// pending-real / predicate-excluded cases and provision-FAILED cases never
// record one, so teardown never touches a clone they never created.
function provisionedWorkClonePath(caseState) {
  for (const attempt of caseState.attempts ?? []) {
    if (typeof attempt.fixture_work_clone === 'string' && attempt.fixture_work_clone !== '') {
      return attempt.fixture_work_clone;
    }
  }
  return null;
}

// US-005: apply the DECLARED teardown policy at terminalization. This is the
// single choke point every case passes through exactly once when it becomes
// terminal (and AFTER oracle harvest — the oracles have already run and their
// evidence is recorded before markTerminal is reached). Per the declared policy
// (tt-teardown.mjs DECLARED_TEARDOWN_POLICY), a PASSED case's harvested clone is
// pruned to keep var/fixtures/work bounded, while a FAILED case's clone is kept
// as failure-state evidence. Only clones a case actually provisioned are ever
// touched; the decision (case id, outcome, kept/pruned, timestamp) is recorded
// on the case and persisted to results/state.json. Provider-retry scheduling
// returns before markTerminal, so teardown only ever runs on the FINAL,
// genuinely-terminal outcome of a case.
//
// O9 special-exit exemption: a chaos.o9_special_exits case's RESTORED working
// tree is itself the evidence the battery produces (exit-88 tracked-dirty
// refusal, tracked-byte restoration, junk-probe removal). Pruning a PASS would
// destroy exactly what O9 verified, so those cases keep their clone with a
// recorded keep_reason.
// US-005 (S9 controller): replay-pair clone persistence. A case named as
// another case's `context.replay_of` is the shared-origin PAIRE: its harvested
// clone is the replay attempt's input (same origin_repo, same tree), so even a
// PASSED pair KEEPS its clone (policy outcome REPLAY_PAIR_KEEP) with the
// recorded keep_reason. Conversely, a REPLAY case's own teardown is a no-op:
// its attempt.fixture_work_clone points at the pair's clone, which is governed
// by the pair's decision — the replay must never prune/keep a clone it did not
// provision.
function applyCaseTeardown(state, caseState, outcome) {
  const workClonePath = provisionedWorkClonePath(caseState);
  if (workClonePath === null) return;
  const replayAttempt = (caseState.attempts ?? [])
    .some((attempt) => attempt.replay_provenance !== undefined);
  if (replayAttempt) return;
  const replayPairKeep = (state.cases ?? [])
    .some((item) => item.replay_of === caseState.id);
  if (replayPairKeep) {
    const result = applyTeardownPolicy({
      caseId: caseState.id,
      outcome: 'REPLAY_PAIR_KEEP',
      workClonePath,
    });
    if (result.ok) {
      caseState.teardown = { ...result.record, keep_reason: 'replay-pair-clone-shared' };
    }
    return;
  }
  const o9Keep = (caseState.attempts ?? [])
    .some((attempt) => attempt.o9_special_exit_evidence === true);
  const result = applyTeardownPolicy({
    caseId: caseState.id,
    outcome: o9Keep ? 'O9_SPECIAL_EXIT_KEEP' : outcome,
    workClonePath,
  });
  if (result.ok) {
    caseState.teardown = o9Keep
      ? { ...result.record, keep_reason: 'o9-special-exit-restored-tree-evidence' }
      : result.record;
  }
}

function markTerminal(state, caseState, campaignDir, outcome, reason) {
  const timestamp = utcTimestamp();
  Object.assign(caseState, {
    phase: 'terminal',
    outcome,
    terminal_at: timestamp,
    ...(reason === undefined ? {} : { reason }),
  });
  applyCaseTeardown(state, caseState, outcome);
  state.updated_at = timestamp;
  atomicWriteState(campaignDir, state);
}

function oracleExecutable(oracleId) {
  const candidate = path.join(ORACLES_ROOT, oracleId);
  try {
    const details = fs.lstatSync(candidate);
    if (!details.isFile() || details.isSymbolicLink()) return null;
    const pinned = fs.realpathSync(candidate);
    if (!pathIsWithin(fs.realpathSync(ORACLES_ROOT), pinned)) return null;
    fs.accessSync(pinned, fs.constants.X_OK);
    return pinned;
  } catch {
    return null;
  }
}

function caseNeedsGatingEvidence(caseRecord) {
  return caseRecord.oracles.some((oracleId) =>
    GATING_ORACLE_IDS.includes(oracleId) && oracleExecutable(oracleId) !== null);
}

function oracleSnapshotInput(caseRecord, caseState, attempt, state, campaignDir, childEnv) {
  const stateDir = childEnv.TAMANDUA_STATE_DIR;
  const databasePath = resolveChildDatabasePath(childEnv);
  if (typeof stateDir !== 'string' || !path.isAbsolute(stateDir) || databasePath === null) {
    throw new Error('controller-provided TT state is unavailable for oracle snapshot');
  }
  // US-006 (S9 controller): a REPLAY attempt's snapshot must bind to the
  // PAIR's provisioned clone (attempt.fixture_work_clone) — same origin_repo
  // / tree identity as the pair's run (TSTX origin-scoped contract). The
  // replay's own clone path is never provisioned, so binding to it would
  // ENOENT at snapshot capture. Non-replay real attempts have
  // fixture_work_clone set to their own provisioned clone (identical path).
  const repositoryPath = typeof attempt.fixture_work_clone === 'string' && attempt.fixture_work_clone !== ''
    ? attempt.fixture_work_clone
    : path.join(VAR_ROOT, 'fixtures', 'work', caseRecord.id, caseRecord.fixture);
  // US-010 (S12 controller): the oracle snapshot's launch-intent binds to the
  // FLAGGED (primary) launch argv of a token-saver paired-launch attempt —
  // that is the run exercising the token-saver plumbing. The pair's argvs are
  // pre-declared on attempt.token_saver before the snapshot begins.
  const tokenSaverFlagged = attempt.token_saver?.launches
    ?.find((entry) => entry.role === 'flagged');
  const launchArgv = tokenSaverFlagged !== undefined && Array.isArray(tokenSaverFlagged.argv)
    ? tokenSaverFlagged.argv
    : ['tamandua', ...workflowRunArgs(caseRecord, attempt.fixture_work_clone)];
  return {
    ttRoot: TT_ROOT,
    campaignDir,
    stateDir: path.resolve(stateDir),
    databasePath,
    repositoryPath,
    caseRecord,
    attempt,
    launchArgv,
    discoveredRuns: (state.discovered_runs ?? []).filter((run) => run.root_case_id === caseState.id),
  };
}

function beginCaseOracleSnapshot(caseRecord, caseState, attempt, state, campaignDir, childEnv) {
  if (!caseNeedsGatingEvidence(caseRecord)) return;
  attempt.oracle_evidence = {
    schema_version: ORACLE_CONTRACT_VERSION,
    status: 'RUNNING',
    ledger_path: `snapshots/${caseRecord.id}/${attempt.id}/snapshot.json`,
    references: {},
  };
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
  attempt.oracle_evidence = {
    schema_version: ORACLE_CONTRACT_VERSION,
    ...beginOracleEvidenceSnapshot(
      oracleSnapshotInput(caseRecord, caseState, attempt, state, campaignDir, childEnv),
    ),
  };
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
}

function runCaseO9TargetedProbes(caseRecord, attempt, state, campaignDir, childEnv) {
  // FIX10 US-003 choke-point: the probe child must run with the contained HOME.
  assertContainedSpawnEnv(childEnv);
  if (!caseRecord.oracles.includes('O9') || caseRecord.chaos?.o9_special_exits !== true) return;
  if (attempt.o9_targeted_probes?.status === 'COMPLETE') return;
  if (attempt.o9_targeted_probes?.status === 'RUNNING') {
    throw new Error('controller stopped while targeted O9 probes were in flight; classified TEST_INFRA');
  }
  const repositoryPath = path.join(VAR_ROOT, 'fixtures', 'work', caseRecord.id, caseRecord.fixture);
  attempt.o9_targeted_probes = { status: 'RUNNING', started_at: utcTimestamp() };
  state.updated_at = attempt.o9_targeted_probes.started_at;
  atomicWriteState(campaignDir, state);
  const result = spawnSync(process.execPath, [
    O9_TARGETED_PROBES_PATH,
    '--repo', repositoryPath,
    '--run', attempt.run_id,
    '--step-prefix', `${caseRecord.id}-o9`,
    '--shim', path.join(TT_ROOT, '..', 'bin', 'tamandua-test'),
  ], {
    cwd: TT_ROOT,
    env: { ...childEnv, TAMANDUA_TSTX_JUNK_PROBE: '.git/tamandua-o9-junk-probe' },
    encoding: 'utf8', timeout: 30_000, maxBuffer: 1024 * 1024, shell: false,
  });
  if (result.error !== undefined || result.status !== 0 || result.signal !== null) {
    throw new Error(`targeted O9 probes failed: ${result.error?.message ?? result.stderr?.trim() ?? result.signal ?? `exit ${result.status}`}`);
  }
  let evidence;
  try {
    evidence = JSON.parse(result.stdout.trim());
  } catch (error) {
    throw new Error(`targeted O9 probes emitted invalid evidence: ${error.message}`);
  }
  if (JSON.stringify(evidence.exits) !== JSON.stringify([86, 87, 88])
      || evidence.junk_probe_tracked !== false) {
    throw new Error('targeted O9 probes omitted required 86/87/88 or junk-probe evidence');
  }
  attempt.o9_targeted_probes = { status: 'COMPLETE', finished_at: utcTimestamp(), evidence };
  state.updated_at = attempt.o9_targeted_probes.finished_at;
  atomicWriteState(campaignDir, state);
}

function completeCaseOracleSnapshot(caseRecord, caseState, attempt, state, campaignDir, childEnv) {
  if (!caseNeedsGatingEvidence(caseRecord)) return;
  if (attempt.oracle_evidence?.status === 'COMPLETE') return;
  if (attempt.oracle_evidence?.status !== 'BASELINE_CAPTURED') {
    throw new Error('oracle evidence snapshot was interrupted or is partial; classified TEST_INFRA');
  }
  runCaseO9TargetedProbes(caseRecord, attempt, state, campaignDir, childEnv);
  attempt.oracle_evidence = completeOracleEvidenceSnapshot(
    oracleSnapshotInput(caseRecord, caseState, attempt, state, campaignDir, childEnv),
    attempt.oracle_evidence,
  );
  if (attempt.o9_targeted_probes?.status === 'COMPLETE') {
    const repositoryPath = oracleSnapshotInput(
      caseRecord, caseState, attempt, state, campaignDir, childEnv,
    ).repositoryPath;
    fs.rmSync(path.join(repositoryPath, attempt.o9_targeted_probes.evidence.junk_probe_path), { force: true });
  }
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
}

function validateOracleResponse(response, oracleId, exitCode, evidenceDir) {
  const errors = [];
  if (!isObject(response)) return ['response must be one JSON object'];
  if (response.contract_version !== ORACLE_CONTRACT_VERSION) errors.push('contract_version must be 1');
  if (response.oracle_id !== oracleId) errors.push('oracle_id does not match the invoked oracle');
  if (!['PASS', 'FAIL', 'ERROR'].includes(response.result)) errors.push('result must be PASS, FAIL, or ERROR');
  if (!isUtcTimestamp(response.started_at)) errors.push('started_at must be a UTC ISO-8601 timestamp');
  if (!isUtcTimestamp(response.finished_at)) errors.push('finished_at must be a UTC ISO-8601 timestamp');
  if (isUtcTimestamp(response.started_at) && isUtcTimestamp(response.finished_at)
      && new Date(response.finished_at) < new Date(response.started_at)) {
    errors.push('finished_at must not precede started_at');
  }
  if (!Array.isArray(response.findings)) {
    errors.push('findings must be an array');
  } else {
    response.findings.forEach((finding, index) => {
      if (!isObject(finding) || typeof finding.id !== 'string' || finding.id.length === 0
          || typeof finding.summary !== 'string' || finding.summary.length === 0) {
        errors.push(`findings[${index}] must contain nonempty id and summary strings`);
      }
    });
    if (response.result === 'PASS' && response.findings.length !== 0) errors.push('PASS must not contain findings');
    if (response.result === 'FAIL' && response.findings.length === 0) errors.push('FAIL must contain a finding');
  }
  if (!Array.isArray(response.evidence)) {
    errors.push('evidence must be an array');
  } else {
    response.evidence.forEach((reference, index) => {
      if (!isObject(reference) || typeof reference.path !== 'string' || reference.path.length === 0
          || path.isAbsolute(reference.path) || typeof reference.kind !== 'string' || reference.kind.length === 0) {
        errors.push(`evidence[${index}] must contain a relative path and nonempty kind`);
        return;
      }
      const candidate = path.resolve(evidenceDir, reference.path);
      try {
        const details = fs.lstatSync(candidate);
        if (!details.isFile() || details.isSymbolicLink()
            || !pathIsWithin(fs.realpathSync(evidenceDir), fs.realpathSync(candidate))) {
          errors.push(`evidence[${index}].path is not a contained regular file`);
        }
      } catch {
        errors.push(`evidence[${index}].path does not exist`);
      }
    });
  }
  if (response.classification !== undefined) {
    const classification = response.classification;
    if (!isObject(classification)) {
      errors.push('classification must be an object');
    } else {
      const allowed = new Set([
        'manipulation_checks', 'provider_failure', 'expectation_met',
        'agent_task_succeeded', 'ambiguous',
      ]);
      for (const key of Object.keys(classification)) {
        if (!allowed.has(key)) errors.push(`classification contains unknown property ${key}`);
      }
      if (classification.manipulation_checks !== undefined
          && (!Array.isArray(classification.manipulation_checks)
            || classification.manipulation_checks.some((check) => !isObject(check)
              || typeof check.id !== 'string' || check.id.length === 0
              || typeof check.engaged !== 'boolean'
              || (check.required !== undefined && typeof check.required !== 'boolean')))) {
        errors.push('classification.manipulation_checks must contain structured checks');
      }
      if (classification.provider_failure !== undefined
          && (!isObject(classification.provider_failure)
            || classification.provider_failure.identified !== true
            || typeof classification.provider_failure.injected !== 'boolean'
            || typeof classification.provider_failure.kind !== 'string'
            || classification.provider_failure.kind.length === 0)) {
        errors.push('classification.provider_failure must identify a structured provider failure');
      }
      for (const key of ['expectation_met', 'agent_task_succeeded']) {
        if (classification[key] !== undefined && typeof classification[key] !== 'boolean') {
          errors.push(`classification.${key} must be boolean`);
        }
      }
      if (classification.ambiguous !== undefined
          && (!isObject(classification.ambiguous)
            || typeof classification.ambiguous.category !== 'string'
            || classification.ambiguous.category.length === 0)) {
        errors.push('classification.ambiguous must contain a category');
      }
    }
  }
  const expectedExit = { PASS: 0, FAIL: 1, ERROR: 2 }[response.result];
  if (expectedExit !== undefined && exitCode !== expectedExit) {
    errors.push(`exit code ${exitCode} contradicts result ${response.result} (expected ${expectedExit})`);
  }
  return errors;
}

function runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv) {
  // FIX10 US-003 choke-point: oracle executables must run with the contained HOME.
  assertContainedSpawnEnv(childEnv);
  caseState.oracle_results ??= [];
  const attempt = caseState.attempts.at(-1);
  const attemptId = attempt?.id ?? 'case-without-attempt';
  if (attempt !== undefined) {
    completeCaseOracleSnapshot(caseRecord, caseState, attempt, state, campaignDir, childEnv);
  }
  for (const oracleId of caseRecord.oracles) {
    const prior = caseState.oracle_results.find((result) => result.oracle_id === oracleId
      && (result.attempt_id ?? 'attempt-1') === attemptId);
    if (prior !== undefined) {
      if (prior.status === 'RUNNING') {
        prior.status = 'TEST_INFRA';
        prior.finished_at = utcTimestamp();
        prior.errors = ['controller stopped while oracle invocation was in flight; hook was not relaunched'];
        state.updated_at = prior.finished_at;
        atomicWriteState(campaignDir, state);
      }
      continue;
    }
    const executable = oracleExecutable(oracleId);
    if (executable === null) {
      const timestamp = utcTimestamp();
      caseState.oracle_results.push({
        oracle_id: oracleId,
        attempt_id: attemptId,
        status: 'ORACLE_MISSING',
        executable: `oracles/${oracleId}`,
        started_at: timestamp,
        finished_at: timestamp,
      });
      state.updated_at = timestamp;
      atomicWriteState(campaignDir, state);
      continue;
    }

    const evidenceDir = path.join(campaignDir, 'evidence', caseRecord.id, attemptId, 'oracles', oracleId);
    fs.mkdirSync(evidenceDir, { recursive: true, mode: 0o700 });
    const contextPath = path.join(evidenceDir, 'context.json');
    const stdoutPath = path.join(evidenceDir, 'stdout.json');
    const stderrPath = path.join(evidenceDir, 'stderr.txt');
    const input = createOracleContext({ caseRecord, caseState, state, oracleId });
    const contextErrors = validateOracleContext(input, campaignDir, {
      requireOracleEvidence: GATING_ORACLE_IDS.includes(oracleId),
    });
    fs.writeFileSync(contextPath, `${JSON.stringify(input, null, 2)}\n`,
      { encoding: 'utf8', mode: 0o400, flag: 'wx' });
    const startedAt = utcTimestamp();
    const record = {
      oracle_id: oracleId,
      attempt_id: attemptId,
      status: 'RUNNING',
      executable: `oracles/${oracleId}`,
      argv: [`oracles/${oracleId}`, '--contract-version', '1', '--context', evidenceRelativePath(campaignDir, contextPath)],
      context: evidenceRelativePath(campaignDir, contextPath),
      context_sha256: sha256(fs.readFileSync(contextPath)),
      started_at: startedAt,
    };
    caseState.oracle_results.push(record);
    state.updated_at = startedAt;
    atomicWriteState(campaignDir, state);

    if (contextErrors.length > 0) {
      record.status = 'TEST_INFRA';
      record.finished_at = utcTimestamp();
      record.errors = contextErrors;
      state.updated_at = record.finished_at;
      atomicWriteState(campaignDir, state);
      continue;
    }

    const result = spawnSync(executable, ['--contract-version', '1', '--context', contextPath], {
      cwd: evidenceDir,
      env: {
        ...childEnv,
        TT_ORACLE_CONTRACT_VERSION: '1',
        TT_ORACLE_ID: oracleId,
        TT_ORACLE_CONTEXT: contextPath,
        TT_ORACLE_EVIDENCE_DIR: evidenceDir,
        TT_CASE_ID: caseRecord.id,
        TT_CAMPAIGN_ID: state.campaign_id,
        ...(input.run_id === null ? {} : { TT_RUN_ID: input.run_id }),
      },
      encoding: null,
      maxBuffer: EVIDENCE_LIMIT_BYTES,
      timeout: 5 * 60_000,
      shell: false,
    });
    const stdout = Buffer.isBuffer(result.stdout) ? result.stdout : Buffer.from(result.stdout ?? '');
    const stderr = Buffer.isBuffer(result.stderr) ? result.stderr : Buffer.from(result.stderr ?? '');
    fs.writeFileSync(stdoutPath, stdout, { mode: 0o400, flag: 'wx' });
    fs.writeFileSync(stderrPath, stderr, { mode: 0o400, flag: 'wx' });
    Object.assign(record, {
      finished_at: utcTimestamp(),
      exit_code: result.status,
      signal: result.signal,
      stdout: evidenceRelativePath(campaignDir, stdoutPath),
      stderr: evidenceRelativePath(campaignDir, stderrPath),
      stdout_sha256: sha256(stdout),
      stderr_sha256: sha256(stderr),
    });
    let response;
    const errors = [];
    if (result.error !== undefined) errors.push(`oracle execution failed: ${result.error.message}`);
    if (result.signal !== null) errors.push(`oracle terminated by signal ${result.signal}`);
    try {
      response = JSON.parse(stdout.toString('utf8').trim());
    } catch (error) {
      errors.push(`stdout is not one JSON object: ${error.message}`);
    }
    if (response !== undefined) errors.push(...validateOracleResponse(response, oracleId, result.status, evidenceDir));
    if (errors.length === 0) {
      record.status = 'VALID';
      record.response = response;
      for (const reference of response.evidence) {
        const evidencePath = path.resolve(evidenceDir, reference.path);
        reference.sha256 = sha256(fs.readFileSync(evidencePath));
        try { fs.chmodSync(evidencePath, 0o400); } catch { /* the hash still pins the content */ }
      }
    } else {
      record.status = 'TEST_INFRA';
      record.errors = errors;
    }
    state.updated_at = record.finished_at;
    atomicWriteState(campaignDir, state);
  }
  return caseState.oracle_results.filter((result) => result.oracle_id !== undefined
    && (result.attempt_id ?? 'attempt-1') === attemptId);
}

function parseLocalCommandSummary(campaignDir, attempt) {
  const stdout = readHookStdout(campaignDir, attempt.command);
  for (const line of stdout.split(/\r?\n/).reverse()) {
    if (line.trim() === '') continue;
    try {
      const parsed = JSON.parse(line);
      if (isObject(parsed)) return parsed;
    } catch { /* preflight hooks may emit TAP or human-readable output */ }
  }
  return null;
}

function collectTokenValues(value, prefix = '', output = []) {
  if (Array.isArray(value)) {
    value.forEach((item, index) => collectTokenValues(item, `${prefix}[${index}]`, output));
  } else if (isObject(value)) {
    for (const [key, item] of Object.entries(value)) {
      const location = prefix === '' ? key : `${prefix}.${key}`;
      if (/tokens?(?:_spent|_observed)?$|system_tokens_spent/i.test(key)
          && Number.isSafeInteger(item) && item >= 0) output.push({ path: location, value: item });
      collectTokenValues(item, location, output);
    }
  }
  return output;
}

function localDatabaseTokenEvidence(childEnv) {
  const databasePath = resolveChildDatabasePath(childEnv);
  if (databasePath === null || !fs.existsSync(databasePath)) return { present: false, runs: [], system_tokens: [] };
  const database = new DatabaseSync(databasePath, { readOnly: true });
  try {
    const tables = new Set(database.prepare("SELECT name FROM sqlite_master WHERE type='table'").all().map((row) => row.name));
    const runs = tables.has('runs')
      ? database.prepare('SELECT id, status, tokens_spent FROM runs ORDER BY id').all()
        .map((row) => ({ run_id: normalizedStoredRunId(row.id), status: row.status, tokens_spent: row.tokens_spent }))
      : [];
    const systemTokens = tables.has('tamandua_stats')
      ? database.prepare('SELECT system_tokens_spent FROM tamandua_stats ORDER BY rowid').all().map((row) => row.system_tokens_spent)
      : [];
    return { present: true, runs, system_tokens: systemTokens };
  } finally { database.close(); }
}

function initializeLocalTokenLedger(childEnv) {
  // FIX10 US-003 choke-point: the tamandua ledger query must run with the contained HOME.
  assertContainedSpawnEnv(childEnv);
  const executable = path.join(TT_ROOT, '..', 'bin', 'tamandua');
  const result = spawnSync(executable, ['workflow', 'runs', '--json'], {
    cwd: TT_ROOT, env: childEnv, encoding: 'utf8', timeout: 30_000,
    maxBuffer: EVIDENCE_LIMIT_BYTES, shell: false,
  });
  if (result.error !== undefined || result.status !== 0 || result.signal !== null) {
    throw new Error(`cannot initialize contained token ledger: ${result.error?.message ?? result.stderr?.trim() ?? result.signal ?? `exit ${result.status}`}`);
  }
  const evidence = localDatabaseTokenEvidence(childEnv);
  if (!evidence.present || evidence.system_tokens.length === 0
      || evidence.system_tokens.some((value) => !Number.isSafeInteger(value) || value < 0)) {
    throw new Error('contained token ledger did not expose the absolute system-token counter');
  }
  return evidence;
}

function runLocalCaseOracles(caseRecord, caseState, state, campaignDir, childEnv) {
  const attempt = caseState.attempts.at(-1);
  if (attempt === undefined) throw new Error('local oracle evaluation requires a durable attempt');
  caseState.oracle_results ??= [];
  const summary = parseLocalCommandSummary(campaignDir, attempt);
  let scenario = null;
  if (typeof caseRecord.context.scenario_path === 'string') {
    scenario = JSON.parse(fs.readFileSync(path.join(TT_ROOT, caseRecord.context.scenario_path, 'scenario.json'), 'utf8'));
    if (scenario.id !== caseRecord.context.scenario_id || !Array.isArray(scenario.oracles)) {
      throw new Error('local scenario metadata changed after manifest validation');
    }
  }
  const commandPassed = hookSucceeded(attempt.command);
  const scenarioPassed = scenario === null || summary?.result === 'PASS';
  const tokenValues = collectTokenValues(summary);
  const baselineTokens = attempt.local_token_baseline;
  const databaseTokens = localDatabaseTokenEvidence(childEnv);
  const summarySystemTokens = tokenValues
    .filter((item) => item.path === 'system_tokens_spent' || item.path.endsWith('.system_tokens_spent'))
    .map((item) => item.value);
  const baselinePresent = isObject(baselineTokens) && baselineTokens.present === true
    && Array.isArray(baselineTokens.system_tokens) && baselineTokens.system_tokens.length > 0;
  const terminalSystemTokens = databaseTokens.system_tokens.length > 0
    ? databaseTokens.system_tokens
    : summarySystemTokens;
  const terminalLedgerPresent = databaseTokens.present === true || summarySystemTokens.length > 0;
  const systemCounterPresent = terminalSystemTokens.length > 0;
  const tokenGatePassed = baselinePresent && terminalLedgerPresent && systemCounterPresent
    && baselineTokens.system_tokens.every((value) => value === 0)
    && tokenValues.every((item) => item.value === 0)
    && databaseTokens.runs.every((run) => run.tokens_spent === 0)
    && terminalSystemTokens.every((value) => value === 0);
  const snapshotDir = path.join(campaignDir, 'snapshots', caseRecord.id, attempt.id);
  fs.mkdirSync(snapshotDir, { recursive: true, mode: 0o700 });
  const capturedAt = utcTimestamp();
  const systemBefore = baselinePresent
    ? baselineTokens.system_tokens.reduce((total, value) => total + value, 0)
    : null;
  const systemTotal = terminalSystemTokens.reduce((total, value) => total + value, 0);
  const proofPath = path.join(snapshotDir, 'local-case-proof.json');
  fs.writeFileSync(proofPath, `${JSON.stringify({
    schema_version: 1, profile: 'local-case', captured_at: capturedAt, case_id: caseRecord.id,
    command_result: { exit_code: attempt.command.exit_code, signal: attempt.command.signal },
    scenario_id: scenario?.id ?? null, declared_oracles: scenario?.oracles ?? caseRecord.oracles,
    scenario_result: summary?.result ?? (commandPassed ? 'PASS' : 'FAIL'), summary,
    token_values: tokenValues, runs: databaseTokens.runs,
    system_tokens: { before: systemBefore, after: systemTotal, terminal_database: systemTotal },
    checks: {
      command_passed: commandPassed, scenario_passed: scenarioPassed,
      baseline_present: baselinePresent, terminal_ledger_present: terminalLedgerPresent,
      system_counter_present: systemCounterPresent, token_gate_passed: tokenGatePassed,
    },
  }, null, 2)}\n`, { flag: 'wx', mode: 0o400 });
  const proofReference = {
    path: path.relative(campaignDir, proofPath).split(path.sep).join('/'),
    sha256: sha256(fs.readFileSync(proofPath)), captured_at: capturedAt,
    source: 'controller-local-case',
  };
  const requiredReferenceKeys = new Set(caseRecord.oracles.flatMap((oracleId) => REQUIRED_ORACLE_EVIDENCE[oracleId] ?? []));
  const references = Object.fromEntries(ORACLE_EVIDENCE_KEYS
    .map((key) => [key, requiredReferenceKeys.has(key) ? proofReference : null]));
  attempt.oracle_evidence = {
    schema_version: ORACLE_CONTRACT_VERSION, status: 'COMPLETE',
    ledger_path: path.relative(campaignDir, path.join(snapshotDir, 'snapshot.json')).split(path.sep).join('/'),
    references,
  };
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
  runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv);
  const ledgerPath = path.join(snapshotDir, 'snapshot.json');
  fs.writeFileSync(ledgerPath, `${JSON.stringify({
    schema_version: ORACLE_CONTRACT_VERSION, status: 'COMPLETE', case_id: caseRecord.id,
    attempt_id: attempt.id, completed_at: utcTimestamp(), files: references,
  }, null, 2)}\n`, { flag: 'wx', mode: 0o400 });
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
  return caseState.oracle_results.filter((result) => result.attempt_id === attempt.id);
}

function outcomeWithOracleEvidence(caseRecord, baseOutcome, baseReason, oracleResults) {
  const evidence = { caseClass: caseRecord.class, oracle_results: oracleResults };
  if (baseOutcome === 'PASS') evidence.expectation_met = true;
  else if (baseOutcome === 'PRODUCT_FAIL') evidence.expectation_met = false;
  else if (baseOutcome === 'AGENT_FLAKE') evidence.agent_task_succeeded = false;
  else if (baseOutcome === 'PROVIDER_FAIL') evidence.provider_failure = baseReason;
  else if (baseOutcome === 'TEST_INFRA_FAIL') evidence.infrastructure_failure = baseReason;
  else if (baseOutcome === 'INVALID') evidence.manipulation_checks = baseReason?.checks ?? [];
  else if (baseOutcome === 'NOT_RUN') evidence.not_run = baseReason;
  else if (baseReason?.category === 'runaway-cap-enforced') evidence.cap_evidence = baseReason;
  else evidence.ambiguous = baseReason ?? { category: 'unclassified-terminal-state' };
  return classifyAttempt(evidence);
}

function persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict) {
  attempt.outcome = verdict.outcome;
  attempt.counts_toward_gate = verdict.outcome === 'PASS' || verdict.outcome === 'PRODUCT_FAIL';
  if (verdict.reason !== undefined) attempt.classification_reason = verdict.reason;
  const retry = providerRetryDecision({
    outcome: verdict.outcome,
    attempts: caseState.attempts,
    backoffMs: state.options.provider_retry_backoff_ms ?? DEFAULT_PROVIDER_RETRY_BACKOFF_MS,
  });
  if (retry.retry) {
    caseState.phase = 'pending';
    caseState.provider_retry = {
      status: 'scheduled',
      scheduled_at: utcTimestamp(),
      ...retry,
    };
    state.updated_at = caseState.provider_retry.scheduled_at;
    atomicWriteState(campaignDir, state);
    return;
  }
  caseState.counts_toward_gate = attempt.counts_toward_gate;
  if (caseState.provider_retry !== undefined) {
    caseState.provider_retry.status = 'completed';
    caseState.provider_retry.final_attempt_id = attempt.id;
    caseState.provider_retry.final_outcome = verdict.outcome;
  }
  markTerminal(state, caseState, campaignDir, verdict.outcome, verdict.reason);
}

function persistMechanicalOutcome(caseState, attempt, state, campaignDir, outcome, reason) {
  persistClassifiedAttempt(caseState, attempt, state, campaignDir, { outcome, reason });
}

function retryAttemptMetadata(caseState) {
  if (caseState.provider_retry?.status !== 'scheduled') return {};
  caseState.provider_retry.status = 'launched';
  return {
    retry_of: caseState.provider_retry.retry_of,
    retry_number: caseState.provider_retry.retry_number,
    retry_scheduled_at: caseState.provider_retry.scheduled_at,
  };
}

function hookSucceeded(result) {
  return result.error === undefined && result.exit_code === 0 && result.signal === null;
}

function hasAssociatedNonterminalRun(caseState) {
  return caseState.attempts.some((attempt) => attempt.outcome === undefined);
}

async function executeLocalCase(caseRecord, caseState, state, campaignDir) {
  if (hasAssociatedNonterminalRun(caseState)) return;
  const launchIntentTimestamp = utcTimestamp();
  const attempt = {
    id: `attempt-${caseState.attempts.length + 1}`,
    case_id: caseRecord.id,
    kind: 'local',
    phase: 'launch-intent',
    execution_mode: caseUsesScriptedEnvironment(caseRecord) ? 'scripted' : 'real',
    launch_intent_at: launchIntentTimestamp,
    started_at: launchIntentTimestamp,
    deadline_at: new Date(Date.now() + (caseRecord.caps.wall_min * 60_000)).toISOString(),
    ...retryAttemptMetadata(caseState),
  };
  caseState.phase = 'running';
  caseState.attempts.push(attempt);
  state.updated_at = attempt.started_at;
  atomicWriteState(campaignDir, state);

  let childEnv;
  try {
    childEnv = loadSpawnEnvironment(attempt.execution_mode === 'scripted');
  } catch (error) {
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'spawn-environment',
      message: error.message,
    });
    return;
  }

  try {
    attempt.local_token_baseline = initializeLocalTokenLedger(childEnv);
    state.updated_at = utcTimestamp();
    atomicWriteState(campaignDir, state);
  } catch (error) {
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'token-ledger-baseline',
      message: error.message,
    });
    return;
  }

  if (caseRecord.reset !== null && caseRecord.reset !== undefined) {
    attempt.phase = 'resetting';
    const resetResult = await runHook('reset', caseRecord.reset, childEnv, campaignDir, state, attempt);
    if (!hookSucceeded(resetResult)) {
      attempt.phase = 'terminal';
      attempt.terminal_at = utcTimestamp();
      persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
        category: 'reset-failed',
        exit_code: resetResult.exit_code,
        signal: resetResult.signal,
        error: resetResult.error ?? null,
      });
      return;
    }
  }

  if (caseRecord.command === null || caseRecord.command === undefined) {
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'local-command-missing',
    });
    return;
  }

  attempt.phase = 'running';
  const commandResult = await runDurableLocalCommand(caseRecord.command, childEnv, campaignDir, state, attempt);
  attempt.phase = 'terminal';
  attempt.terminal_at = utcTimestamp();
  attempt.terminal_status = hookSucceeded(commandResult) ? 'completed' : 'failed';
  const baseOutcome = hookSucceeded(commandResult)
    ? 'PASS'
    : (commandResult.error === undefined ? 'PRODUCT_FAIL' : 'TEST_INFRA_FAIL');
  const baseReason = hookSucceeded(commandResult) ? undefined : {
        category: commandResult.error === undefined ? 'local-command-failed' : 'local-command-launch-failed',
        exit_code: commandResult.exit_code,
        signal: commandResult.signal,
        error: commandResult.error ?? null,
      };
  const verdict = outcomeWithOracleEvidence(
    caseRecord, baseOutcome, baseReason,
    attempt.execution_mode === 'scripted'
      ? runLocalCaseOracles(caseRecord, caseState, state, campaignDir, childEnv)
      : runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv),
  );
  persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict);
}

// US-005 (S9 controller): REPLAY same-origin provisioning + sequencing guard.
// A replay case's `context.replay_of` names its paired probe case. The replay
// attempt MUST reuse the pair's work clone (same origin_repo, same committed
// tree — TSTX's origin-scoped contract: a fresh clone/provision would
// normalize to a different origin identity and the cache HIT would be
// unreachable) and MUST never launch before the pair is terminal (the pair's
// post-harvest state — clone, ledger — is the replay's input). The pair's
// clone therefore persists unchanged from the pair's terminalization into the
// replay attempt (see applyCaseTeardown's replay-pair keep exemption), and the
// replay attempt performs NO wipe/re-clone/provision of its own.
//
// `replay_of` is controller-internal wiring: it is excluded from the product
// `--context` passthrough (like `execution_mode`) and is never seen by the
// workflow.
function replayPairOf(caseRecord) {
  const replayOf = caseRecord.context?.replay_of;
  return typeof replayOf === 'string' && replayOf !== '' ? replayOf : null;
}

// The pair's provisioned clone path: var/fixtures/work/<pair-id>/<fixture>
// (tt-fixture-provision.mjs names clones <work-dir>/<case-id>/<fixture>).
function replayPairClonePath(pairId, fixture) {
  return path.join(VAR_ROOT, 'fixtures', 'work', pairId, fixture);
}

// Sequencing wait bound. When the replay case executes while its pair is
// still active (concurrency > 1), the controller WAITS — bounded by the
// campaign scheduler — for the pair to reach terminal before launching. The
// bound is the pair's own wall deadline plus a settle margin (the pair's cap
// enforcement guarantees terminalization near its deadline), or the pair's
// scheduled provider-retry retry_not_before plus the same margin; a pair with
// neither bound falls back to a conservative fixed wait. Tests shrink the
// bound via TT_CONTROLLER_REPLAY_PAIR_WAIT_MS (ms).
const REPLAY_PAIR_WAIT_POLL_MS = 500;
const REPLAY_PAIR_SETTLE_MARGIN_MS = 60_000;
const REPLAY_PAIR_FALLBACK_WAIT_MS = 60_000;

function replayPairWaitDeadline(pairState) {
  const override = process.env.TT_CONTROLLER_REPLAY_PAIR_WAIT_MS;
  if (override !== undefined) {
    const parsed = Number(override);
    if (!Number.isFinite(parsed) || parsed < 0) {
      throw new Error(`TT_CONTROLLER_REPLAY_PAIR_WAIT_MS must be a non-negative number, received ${JSON.stringify(override)}`);
    }
    return Date.now() + parsed;
  }
  const attempt = (pairState?.attempts ?? []).at(-1);
  if (attempt?.deadline_at !== undefined) {
    return new Date(attempt.deadline_at).valueOf() + REPLAY_PAIR_SETTLE_MARGIN_MS;
  }
  if (pairState?.provider_retry?.status === 'scheduled'
      && pairState.provider_retry.retry_not_before !== undefined) {
    return new Date(pairState.provider_retry.retry_not_before).valueOf() + REPLAY_PAIR_SETTLE_MARGIN_MS;
  }
  return Date.now() + REPLAY_PAIR_FALLBACK_WAIT_MS;
}

async function waitForReplayPairTerminal(pairState) {
  const deadline = replayPairWaitDeadline(pairState);
  while (pairState.phase !== 'terminal' && Date.now() < deadline) {
    await delay(Math.min(REPLAY_PAIR_WAIT_POLL_MS, Math.max(0, deadline - Date.now())));
  }
  return pairState.phase === 'terminal';
}

// Resolve the replay pair's campaign state and shared clone, fail-closed with
// a DISTINCT category per failure mode — never a silent half-launch:
//   replay-pair-missing         the pair id is absent from campaign state
//                               (e.g. a filtered/partial manifest)
//   replay-pair-fixture-mismatch the pair case uses a different fixture — its
//                               clone could never carry the replay's origin
//   replay-pair-not-terminal    the pair did not reach terminal within the
//                               campaign-scheduler-bounded wait
//   replay-pair-clone-missing   the pair is terminal but its shared work clone
//                               does not exist (nothing to replay against)
// Returns { ok:true, pairState, clonePath } or { ok:false, reason }.
async function resolveReplayPairContext(replayOf, caseRecord, state) {
  const pairState = state.cases.find((item) => item.id === replayOf);
  if (pairState === undefined) {
    return { ok: false, reason: {
      category: 'replay-pair-missing',
      message: `replay pair '${replayOf}' is not present in campaign state; a replay cannot launch without its pair`,
      replay_of: replayOf,
    } };
  }
  if (pairState.fixture !== caseRecord.fixture) {
    return { ok: false, reason: {
      category: 'replay-pair-fixture-mismatch',
      message: `replay pair '${replayOf}' uses fixture '${pairState.fixture}', but the replay case requires '${caseRecord.fixture}'; the pair's clone could never carry the replay's origin identity`,
      replay_of: replayOf,
      fixture: caseRecord.fixture,
      pair_fixture: pairState.fixture,
    } };
  }
  await waitForReplayPairTerminal(pairState);
  if (pairState.phase !== 'terminal') {
    return { ok: false, reason: {
      category: 'replay-pair-not-terminal',
      message: `replay pair '${replayOf}' is still '${pairState.phase}' after the campaign-scheduler-bounded wait; the replay must not launch before its pair is terminal`,
      replay_of: replayOf,
      pair_phase: pairState.phase,
    } };
  }
  const clonePath = replayPairClonePath(replayOf, caseRecord.fixture);
  let cloneExists = false;
  try {
    cloneExists = fs.lstatSync(clonePath).isDirectory();
  } catch {
    cloneExists = false;
  }
  if (!cloneExists) {
    return { ok: false, reason: {
      category: 'replay-pair-clone-missing',
      message: `replay pair '${replayOf}' is terminal but its shared work clone does not exist at '${clonePath}'`,
      replay_of: replayOf,
      pair_clone_path: clonePath,
    } };
  }
  return { ok: true, pairState, clonePath };
}

// ── E3.D US-008 (S11 controller): local-sentinel launch adapter ───────────
// A REAL case whose `workflow` is `local` (W2.24-docs-drift) is the docs-drift
// sentinel: there is no `local` workflow in any catalog, so the literal argv
// `workflow run local` must NEVER be constructed or executed — it would fail
// with a misleading run-identification error instead of exercising the
// documented example. The adapter (US-008):
//   - resolves the sentinel profile. The supported W2.24 shape is
//     workflow `local` + harness `pi`: it resolves to the shipped TT-custom
//     spec tt-docs-drift (US-007) — the docs/creating-workflows.md Complete
//     Example extracted verbatim under torture-test/workflows/tt-docs-drift.
//   - Any OTHER sentinel profile on the workflow-launch path (workflow
//     `local` with a harness other than pi) FAILS CLOSED with the distinct
//     reason `local-sentinel-unsupported`, recorded on a launch-intent
//     attempt as TEST_INFRA_FAIL evidence (executeWorkflowCase).
//   - Before the real launch, ensures tt-docs-drift is installed in the
//     contained TT home by re-running the tt-catalog-install /
//     tt-required-workflows seam (idempotent, stamp-aware); a missing spec
//     fails closed with the distinct `catalog-missing: tt-docs-drift` reason.
//   - Records adapter evidence (sentinel profile, resolved workflow id,
//     install outcome) on the attempt as attempt.sentinel_adapter.
// Scripted cases (harness `local`) never reach the workflow-launch path, so
// their `local` workflow values never surface here (US-007's harness filter).
const LOCAL_SENTINEL_MARKER = 'local';
const LOCAL_SENTINEL_WORKFLOW_ID = 'tt-docs-drift';

// Result contract (never throws):
//   { sentinel: false }                          not a sentinel case
//   { sentinel: true, ok: true, workflow_id, profile }      supported W2.24 shape
//   { sentinel: true, ok: false, reason, profile }          unsupported profile
function resolveLocalSentinel(caseRecord) {
  if (caseRecord.workflow !== LOCAL_SENTINEL_MARKER) return { sentinel: false };
  const profile = {
    workflow: caseRecord.workflow,
    harness: caseRecord.harness,
    case_id: caseRecord.id,
  };
  if (caseRecord.harness === 'pi') {
    return { sentinel: true, ok: true, workflow_id: LOCAL_SENTINEL_WORKFLOW_ID, profile };
  }
  return {
    sentinel: true,
    ok: false,
    profile,
    reason: {
      category: 'local-sentinel-unsupported',
      message: `workflow 'local' sentinel with harness '${caseRecord.harness}' is not the supported W2.24 shape (workflow local + harness pi); refusing to construct 'workflow run local'`,
      profile,
    },
  };
}

// US-008 install leg: re-run the tt-catalog-install / tt-required-workflows
// seam under the CONTAINED spawn env (spawnPreflightLeg — the same
// containment choke-point the campaign preflight uses). The helper enumerates
// the manifests, resolves the W2.24 workflow-'local' sentinel to
// tt-docs-drift (US-007), and installs/verifies the spec in the contained TT
// home; it is idempotent (stamp-aware, zero churn when current). Result
// contract (never throws): { ok, helper, exit_code, ... } with the distinct
// machine-parseable reason (e.g. `catalog-missing: tt-docs-drift`) on failure.
function runLocalSentinelCatalogInstall(childEnv) {
  const result = spawnPreflightLeg(PREFLIGHT_CATALOG_PATH, [], childEnv);
  const reason = result.ok ? null : readPreflightReason(result.stderr) ?? 'catalog-missing';
  return {
    ok: result.ok,
    helper: 'tt-catalog-install',
    ...(result.exit_code !== undefined ? { exit_code: result.exit_code } : {}),
    ...(result.error !== undefined ? { error: result.error } : {}),
    ...(reason !== null ? { reason } : {}),
    ...(result.ok ? {} : { stderr_tail: (result.stderr ?? '').trim().slice(-500) }),
  };
}

function workflowRunArgs(caseRecord, resolvedClonePath, extraArgs = []) {
  // US-008: the sentinel resolution keeps the 'never `workflow run local`'
  // invariant at EVERY call site (dry-run recording, oracle snapshot input,
  // the real launch hook). Unsupported profiles throw as a defensive
  // backstop — executeWorkflowCase fails them closed before any call site is
  // reached.
  const sentinel = resolveLocalSentinel(caseRecord);
  if (sentinel.sentinel && !sentinel.ok) {
    throw new Error(`${sentinel.reason.category}: ${sentinel.reason.message}`);
  }
  const workflowId = sentinel.sentinel ? sentinel.workflow_id : caseRecord.workflow;
  const args = ['workflow', 'run', workflowId, '--task-file', caseRecord.task];
  for (const [key, value] of Object.entries(caseRecord.context)) {
    // US-010 (S12 controller): token_saver_control is controller-internal
    // wiring for the paired-launch adapter — never a product --context flag
    // (like execution_mode / replay_of).
    if (key === 'execution_mode' || key === 'replay_of' || key === 'token_saver_control') continue;
    args.push('--context', `${key}=${typeof value === 'string' ? value : JSON.stringify(value)}`);
  }
  if (caseRecord.harness === 'pi' || caseRecord.harness === 'scripted-pi') {
    args.push('--pi-as-harness');
  } else {
    args.push('--hermes-as-harness');
  }
  // A replay case launches against its PAIR's provisioned clone (resolved by
  // resolveReplayPairContext and passed in); every other case uses its own.
  const fixturePath = typeof resolvedClonePath === 'string' && resolvedClonePath !== ''
    ? resolvedClonePath
    : path.join(VAR_ROOT, 'fixtures', 'work', caseRecord.id, caseRecord.fixture);
  if (caseRecord.workflow.includes('worktree')) {
    args.push('--worktree-origin-repository', fixturePath);
  } else {
    args.push('--working-directory-for-harness', fixturePath);
  }
  // US-010: the token-saver adapter passes the no-hurry flag ONLY for the
  // flagged launch of a token-saver case; every other call site keeps the
  // extraArgs default ([]), so the flag can never leak into other argv.
  if (extraArgs.length > 0) args.push(...extraArgs);
  args.push('--wait', '--json');
  return args;
}

// ── E3.D US-010 (S12 controller): token-saver paired launch adapter ────────
// W3.23-token-saver (context.token_saver_control === true) is the token-saver
// lifecycle probe: the controller executes the case as TWO do-now launches
// against the SAME provisioned clone —
//   run A (flagged): the managed pi-token-saver stub (bin/tt-token-saver-stub,
//     US-009) is installed into var/adapters-bin (the dir tt-daemon-up
//     ensure-up prepends to the contained daemon PATH) and
//     --no-hurry-please-save-tokens-mode is appended to the launch argv; the
//     product scheduler then prefers the stub for every work spawn of the
//     no-hurry run and each invocation appends one JSON record to the
//     attempt's evidence log before exec'ing the real pi;
//   run B (control): the stub is removed first, and the run launches WITHOUT
//     the flag — a healthy control produces zero new stub records.
// Evidence: attempt.token_saver carries per run the exact argv, the resolved
// run id, the token-ledger observations attributed to that run, and the stub
// record count observed in that run's window (the attempt-level token ledger
// still aggregates both runs for the per-case token cap). The contract is
// mechanical:
//   violated  the flagged run has zero stub records, OR the control run has
//             any → caseState finding type `token-saver-contract` and the
//             case is INCONCLUSIVE — never a silent PASS;
//   ok        flagged >= 1 record and control 0 → the pair is classified by
//             the run terminal statuses + oracles exactly like a single run.
// token_saver_control is controller-internal wiring: it is excluded from the
// --context passthrough, and the flag is appended ONLY for the flagged
// launch of a token-saver case. A scripted case carrying the signal fails
// closed with a distinct reason (the probe is a REAL-case behavior).
const TOKEN_SAVER_FLAG = '--no-hurry-please-save-tokens-mode';
const TOKEN_SAVER_STUB_HELPER_PATH = path.join(TT_ROOT, 'bin', 'tt-token-saver-stub');
const TOKEN_SAVER_STUB_TARGET_PATH = path.join(VAR_ROOT, 'adapters-bin', 'pi-token-saver');

function tokenSaverControl(caseRecord) {
  return caseRecord.context?.token_saver_control === true;
}

// Install/remove the managed pi-token-saver stub via bin/tt-token-saver-stub
// (US-009). The helper is fail-closed (foreign files are never touched) and
// the controller additionally VERIFIES the managed stub's presence/absence
// at the canonical target after the action: the stub must exist on the
// daemon PATH only during the flagged launch window. Result contract (never
// throws): { action, ok, helper, exit_code, ..., stub_present } with the
// helper's distinct REASON surfaced on failure.
function manageTokenSaverStub(action, evidenceLogPath, childEnv) {
  assertContainedSpawnEnv(childEnv);
  const args = action === 'install'
    ? ['install', '--evidence-log', evidenceLogPath]
    : ['remove'];
  const result = spawnSync(TOKEN_SAVER_STUB_HELPER_PATH, args, {
    cwd: TT_ROOT,
    env: childEnv,
    encoding: 'utf8',
    maxBuffer: 1024 * 1024,
    shell: false,
  });
  let stubPresent = false;
  try {
    stubPresent = fs.lstatSync(TOKEN_SAVER_STUB_TARGET_PATH).isFile();
  } catch {
    stubPresent = false;
  }
  const stdout = String(result.stdout ?? '').trim();
  const stderr = String(result.stderr ?? '').trim();
  const reason = /^REASON:\s*(.+)$/m.exec(stderr)?.[1] ?? null;
  const ok = result.error === undefined && result.status === 0;
  return {
    action,
    ok,
    helper: 'tt-token-saver-stub',
    exit_code: result.status,
    stub_present: stubPresent,
    ...(result.error !== undefined ? { error: result.error.message } : {}),
    ...(reason !== null ? { reason } : {}),
    ...(ok ? {} : { stderr_tail: stderr.slice(-500) }),
    stdout_tail: stdout.slice(-500),
  };
}

function tokenSaverEvidenceRecordCount(evidenceLogPath) {
  try {
    const content = fs.readFileSync(evidenceLogPath, 'utf8');
    return content.split(/\r?\n/).filter((line) => line.trim() !== '').length;
  } catch (error) {
    if (error.code === 'ENOENT') return 0;
    throw error;
  }
}

// The raw stub records appended during a run's window (bounded so state stays
// small); the count is the contract evidence, the lines are corroboration.
function tokenSaverEvidenceWindowLines(evidenceLogPath, fromIndex) {
  try {
    const lines = fs.readFileSync(evidenceLogPath, 'utf8')
      .split(/\r?\n/)
      .filter((line) => line.trim() !== '');
    return lines.slice(fromIndex).slice(-10_000);
  } catch (error) {
    if (error.code === 'ENOENT') return [];
    throw error;
  }
}

// The mechanical token-saver contract (US-010): the flagged run must record
// >= 1 stub work-spawn record, and the control run must record ZERO. Any
// violation yields the distinct `token-saver-contract` finding — a silent
// PASS would otherwise bury a broken flag-routing/isolated-stub setup.
function assessTokenSaverContract(launches) {
  const flagged = launches.find((entry) => entry.role === 'flagged');
  const control = launches.find((entry) => entry.role === 'control');
  const flaggedRecords = Number.isSafeInteger(flagged?.stub_records) ? flagged.stub_records : 0;
  const controlRecords = Number.isSafeInteger(control?.stub_records) ? control.stub_records : 0;
  const violated = flaggedRecords === 0 || controlRecords > 0;
  const finding = violated ? {
    type: 'token-saver-contract',
    message: flaggedRecords === 0
      ? 'token-saver contract violated: the flagged run recorded zero stub work-spawn records (expected >= 1)'
      : `token-saver contract violated: the control run recorded ${controlRecords} stub record(s) (expected 0)`,
    flagged_stub_records: flaggedRecords,
    control_stub_records: controlRecords,
  } : undefined;
  return {
    ok: !violated,
    violated,
    flagged_stub_records: flaggedRecords,
    control_stub_records: controlRecords,
    ...(finding === undefined ? {} : { finding }),
  };
}

// Execute the token-saver paired launch (real cases only — the scripted
// guard in executeWorkflowCase fails closed before this runs). Mirrors the
// single-launch flow (runHook launch + run-id capture + monitor + discovered-
// run convergence + terminal harvest) for EACH of the two runs, toggling the
// managed stub around the pair so it exists on the daemon PATH only during
// the flagged window. Fail-closed at every step with a DISTINCT reason
// category; never a silent half-pair.
async function executeTokenSaverPairedLaunch(caseRecord, caseState, state, campaignDir, attempt, childEnv) {
  // Every spawn below is a choke-pointed helper (manageTokenSaverStub,
  // runHook, monitorWorkflowRun, harvestWorkflowAttempt, runCaseOracles —
  // each asserts the contained spawn env itself).
  const evidenceLogPath = path.join(
    campaignDir, 'evidence', caseRecord.id, attempt.id, 'token-saver-evidence.jsonl',
  );
  attempt.token_saver.evidence_log = evidenceRelativePath(campaignDir, evidenceLogPath);
  attempt.token_saver.status = 'running';
  attempt.phase = 'running';
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);

  const plans = [
    { role: 'flagged', stubAction: 'install', flag: true, hookName: 'launch' },
    { role: 'control', stubAction: 'remove', flag: false, hookName: 'launch_control' },
  ];
  let fatal = null;
  let capStop = null;

  for (const plan of plans) {
    if (fatal !== null || capStop !== null) break;
    const entry = attempt.token_saver.launches.find((item) => item.role === plan.role);
    entry.started_at = utcTimestamp();
    state.updated_at = entry.started_at;
    atomicWriteState(campaignDir, state);

    // Stub window management: install (flagged) / remove (control). The
    // helper is fail-closed and the controller verifies the canonical
    // target's presence — the stub must exist ONLY during the flagged
    // launch window (AC2).
    const stub = manageTokenSaverStub(plan.stubAction, evidenceLogPath, childEnv);
    entry.stub = { ...(entry.stub ?? {}), ...stub };
    entry.stub_records_before = tokenSaverEvidenceRecordCount(evidenceLogPath);
    state.updated_at = utcTimestamp();
    atomicWriteState(campaignDir, state);
    const stubExpected = plan.stubAction === 'install';
    if (!stub.ok) {
      entry.terminal_at = utcTimestamp();
      state.updated_at = entry.terminal_at;
      atomicWriteState(campaignDir, state);
      fatal = {
        outcome: 'TEST_INFRA_FAIL',
        reason: {
          category: `token-saver-stub-${plan.stubAction}-failed`,
          message: `tt-token-saver-stub ${plan.stubAction} failed for the ${plan.role} launch`
            + `${stub.reason !== undefined ? `: ${stub.reason}` : ''}`
            + `${stub.error !== undefined ? `: ${stub.error}` : ''}`
            + `${stub.stderr_tail !== undefined ? ` (${stub.stderr_tail})` : ''}`,
          role: plan.role,
          stub,
        },
      };
      break;
    }
    if (stub.stub_present !== stubExpected) {
      entry.terminal_at = utcTimestamp();
      state.updated_at = entry.terminal_at;
      atomicWriteState(campaignDir, state);
      fatal = {
        outcome: 'TEST_INFRA_FAIL',
        reason: {
          category: stubExpected
            ? 'token-saver-stub-missing-after-install'
            : 'token-saver-stub-present-after-remove',
          message: stubExpected
            ? `the managed pi-token-saver stub is absent at '${TOKEN_SAVER_STUB_TARGET_PATH}' after a successful install — the flagged launch window cannot hold the stub`
            : `the managed pi-token-saver stub is still present at '${TOKEN_SAVER_STUB_TARGET_PATH}' after a successful remove — the control launch window must be stub-free`,
          role: plan.role,
          stub,
        },
      };
      break;
    }

    // Launch + run-id capture + monitor (identical mechanics to the
    // single-launch flow; the control launch uses a distinct hook name so
    // its durably-captured stdout/stderr evidence never overwrites the
    // flagged launch's).
    let signalLaunchEnded;
    const launchEndedPromise = new Promise((resolve) => { signalLaunchEnded = resolve; });
    let monitorPromise;
    const captureRunIdentifier = createRunIdentifierCapture(attempt, state, campaignDir, childEnv, () => {
      monitorPromise ??= monitorWorkflowRun(
        caseRecord, caseState, attempt, childEnv, state, campaignDir, launchEndedPromise,
      );
    });
    let launchResult;
    let monitorResult;
    try {
      launchResult = await runHook(plan.hookName, {
        executable: 'tamandua',
        args: entry.argv.slice(1),
        cwd: '.',
      }, childEnv, campaignDir, state, attempt, {
        enforceWall: false,
        onChunk: captureRunIdentifier,
      });
      signalLaunchEnded();
      monitorResult = monitorPromise === undefined ? { stopped: false } : await monitorPromise;
      if (attempt.run_id !== undefined && attempt.run_id_error === undefined) {
        await convergeDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir);
      }
    } catch (error) {
      entry.terminal_at = utcTimestamp();
      state.updated_at = entry.terminal_at;
      atomicWriteState(campaignDir, state);
      fatal = {
        outcome: 'TEST_INFRA_FAIL',
        reason: {
          category: 'token-saver-launch-monitor-failed',
          message: `the ${plan.role} launch/monitor failed: ${error.message}`,
          role: plan.role,
          launch_exit_code: launchResult?.exit_code ?? null,
          launch_signal: launchResult?.signal ?? null,
        },
      };
      break;
    }

    if (attempt.run_id_error !== undefined || attempt.run_id === undefined) {
      const infra = classifyInfraLaunchFailure(readLaunchEvidenceStderr(campaignDir, launchResult));
      entry.run_id_error = attempt.run_id_error ?? null;
      entry.terminal_at = utcTimestamp();
      state.updated_at = entry.terminal_at;
      atomicWriteState(campaignDir, state);
      fatal = {
        outcome: 'TEST_INFRA_FAIL',
        reason: infra !== null
          ? { category: infra.category, message: infra.message, signature: infra.signature, role: plan.role }
          : {
              category: 'workflow-run-identification',
              role: plan.role,
              error: attempt.run_id_error ?? {
                category: 'missing-run-identifier',
                resolution_errors: attempt.run_id_resolution_errors ?? [],
              },
            },
      };
      break;
    }

    let terminalEvidence = null;
    try {
      terminalEvidence = await harvestWorkflowAttempt(
        caseState, attempt,
        monitorResult.stopped ? attempt.terminal_wait : launchResult,
        childEnv, state, campaignDir,
      );
    } catch (error) {
      entry.terminal_at = utcTimestamp();
      state.updated_at = entry.terminal_at;
      atomicWriteState(campaignDir, state);
      fatal = {
        outcome: 'TEST_INFRA_FAIL',
        reason: {
          category: 'token-saver-harvest-failed',
          message: `terminal harvest failed for the ${plan.role} run: ${error.message}`,
          role: plan.role,
        },
      };
      break;
    }

    // Stash the per-run evidence on the entry (attempt-level fields are
    // shared between the two runs and are reset for the control capture).
    entry.run_id = attempt.run_id ?? null;
    entry.run_id_source = attempt.run_id_source ?? null;
    entry.run_id_observations = [...(attempt.run_id_observations ?? [])];
    entry.run_id_resolution_errors = [...(attempt.run_id_resolution_errors ?? [])];
    entry.token_ledger = {
      tokens_observed: attempt.tokens_observed ?? 0,
      observations: (attempt.token_observations ?? [])
        .filter((observation) => observation.run_id === entry.run_id),
    };
    entry.terminal_status = attempt.terminal_status ?? terminalEvidence?.status ?? null;
    entry.wait_exit_code = attempt.wait_exit_code ?? null;
    entry.wait_json = attempt.wait_json ?? null;
    entry.terminal_evidence = attempt.terminal_evidence ?? null;
    entry.stub_records_after = tokenSaverEvidenceRecordCount(evidenceLogPath);
    entry.stub_records = entry.stub_records_after - entry.stub_records_before;
    entry.stub_record_lines = tokenSaverEvidenceWindowLines(evidenceLogPath, entry.stub_records_before);
    entry.terminal_at = utcTimestamp();
    state.updated_at = entry.terminal_at;
    atomicWriteState(campaignDir, state);

    if (monitorResult.stopped) {
      // Cap enforcement stops the pair: the control run never launches (the
      // cap is the ceiling for the whole probe, sized for both launches in
      // US-003). Classify INCONCLUSIVE like the single-run cap path.
      capStop = {
        breach: monitorResult.breach,
        terminal_status: monitorResult.terminal_status,
        role: plan.role,
      };
      break;
    }
    if (terminalEvidence === null) {
      entry.terminal_at = utcTimestamp();
      state.updated_at = entry.terminal_at;
      atomicWriteState(campaignDir, state);
      fatal = {
        outcome: 'TEST_INFRA_FAIL',
        reason: {
          category: 'token-saver-run-nonterminal',
          message: `the ${plan.role} run did not reach a terminal status; the paired launch cannot continue`,
          role: plan.role,
        },
      };
      break;
    }

    // Prepare the attempt-level run-id state for the control launch's
    // capture (the capture errors on a differing persisted run id, and the
    // attempt-level ledger fields are re-populated per run).
    delete attempt.run_id;
    delete attempt.run_id_source;
    delete attempt.run_id_persisted_at;
    delete attempt.run_id_error;
    delete attempt.run_id_resolution_errors;
    attempt.run_id_observations = [];
  }

  // Final classification. The pair is terminal (or fail-closed above).
  attempt.phase = 'terminal';
  attempt.terminal_at = utcTimestamp();
  attempt.token_saver.status = 'terminal';
  attempt.token_saver.finished_at = attempt.terminal_at;
  if (fatal !== null) {
    persistMechanicalOutcome(caseState, attempt, state, campaignDir, fatal.outcome, fatal.reason);
    return;
  }
  if (capStop !== null) {
    const baseReason = {
      category: 'runaway-cap-enforced',
      ...capStop.breach,
      terminal_status: capStop.terminal_status,
      token_saver_role: capStop.role,
    };
    const verdict = outcomeWithOracleEvidence(
      caseRecord, 'INCONCLUSIVE', baseReason,
      runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv),
    );
    persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict);
    return;
  }
  const launches = attempt.token_saver.launches;
  const contract = assessTokenSaverContract(launches);
  attempt.token_saver.contract = contract;
  const allCompleted = launches.length === 2
    && launches.every((entry) => entry.terminal_status !== null
      && canonicalTerminalStatus(entry.terminal_status) === 'completed');
  let verdict = outcomeWithOracleEvidence(
    caseRecord,
    allCompleted ? 'PASS' : 'INCONCLUSIVE',
    allCompleted ? undefined : {
      category: 'workflow-terminal',
      terminal_statuses: launches.map((entry) => ({
        role: entry.role, run_id: entry.run_id, terminal_status: entry.terminal_status,
      })),
    },
    runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv),
  );
  // US-010 contract gate (mirrors applyReplayCacheHitGate): a violated
  // contract must never PASS — a broken flag routing or a stub leak on the
  // control run is a mechanical probe failure, surfaced as the distinct
  // token-saver-contract finding. Oracle verdicts that already failed
  // (PRODUCT_FAIL / TEST_INFRA) are preserved.
  if (contract.violated === true) {
    caseState.findings.push({ ...contract.finding, detected_at: utcTimestamp() });
    if (verdict.outcome === 'PASS') {
      verdict = {
        outcome: 'INCONCLUSIVE',
        reason: { category: 'token-saver-contract-violated', ...contract.finding },
      };
    }
  }
  persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict);
}

// US-006 (S9 controller): REPLAY cache-HIT gate.
//
// After terminal harvest, a replay case's oracle-evidence snapshot MUST show
// a cache-hit shim observation for THIS attempt's run — a suite observation
// with a cache-hit/replay phase bound to the pair's origin_repo/tree/cmd key
// (the launch-intent gate key captured over the pair's clone, plus the
// pair's committed tree resolved from that clone). Without the gate, a
// replay that executed/recorded instead of replaying would silently PASS;
// the tier1-traceability.md replay_of contract promises the assertion is a
// mechanical gate, never a hope.
//
// Snapshot source: in production the gate reads the snapshot the controller
// collected under the campaign directory (attempt.oracle_evidence.ledger_path
// written by beginCaseOracleSnapshot). The self-test seam
// (TT_CONTROLLER_REPLAY_SNAPSHOT_FIXTURE_DIR + TT_CONTROLLER_SELF_TEST=1)
// redirects the read to a caller-seeded snapshot tree beneath torture-test/
// var so controller tests can seed hit/miss/malformed fixtures without
// launching real runs.
function replaySnapshotRoot(campaignDir) {
  const override = process.env.TT_CONTROLLER_REPLAY_SNAPSHOT_FIXTURE_DIR;
  if (override === undefined) return campaignDir;
  if (process.env.TT_CONTROLLER_SELF_TEST !== '1') {
    throw new Error('TT_CONTROLLER_REPLAY_SNAPSHOT_FIXTURE_DIR requires TT_CONTROLLER_SELF_TEST=1');
  }
  const candidate = path.resolve(override);
  let details;
  try {
    details = fs.lstatSync(candidate);
  } catch (error) {
    throw new Error(`self-test replay snapshot root is not readable: ${error.message}`);
  }
  const realVarRoot = fs.realpathSync(VAR_ROOT);
  let realCandidate;
  try {
    realCandidate = fs.realpathSync(candidate);
  } catch {
    throw new Error('self-test replay snapshot root does not exist');
  }
  if (!details.isDirectory() || details.isSymbolicLink() || !pathIsWithin(realVarRoot, realCandidate)) {
    throw new Error('self-test replay snapshot root must be a contained regular directory beneath torture-test/var');
  }
  return realCandidate;
}

function readReplaySnapshotFile(root, relativePath) {
  if (typeof relativePath !== 'string' || relativePath.length === 0 || path.isAbsolute(relativePath)) {
    throw new Error(`snapshot reference path is invalid: ${JSON.stringify(relativePath)}`);
  }
  const candidate = path.resolve(root, relativePath.split('/').join(path.sep));
  if (!pathIsWithin(fs.realpathSync(root), fs.realpathSync(candidate))) {
    throw new Error(`snapshot reference escapes the snapshot root: ${relativePath}`);
  }
  return JSON.parse(fs.readFileSync(candidate, 'utf8'));
}

// Result contract (never throws):
//   { ok: true, evidence }                       hit proven — record evidence
//   { ok: false, kind: 'replay-cache-miss', finding }
//        no cache-hit/replay observation for this run — NOT PASS
//   { ok: false, kind: 'replay-cache-infra', reason }
//        malformed/missing/unreadable snapshot — fail closed TEST_INFRA
function assessReplayCacheHit(caseRecord, caseState, attempt, state, campaignDir, childEnv) {
  const replayOf = replayPairOf(caseRecord);
  const infra = (category, message) => ({
    ok: false,
    kind: 'replay-cache-infra',
    reason: { category, message, replay_of: replayOf, attempt_id: attempt.id },
  });
  try {
    const root = replaySnapshotRoot(campaignDir);
    let ledgerRelative = null;
    if (typeof attempt.oracle_evidence?.ledger_path === 'string'
        && attempt.oracle_evidence.ledger_path.length > 0) {
      ledgerRelative = attempt.oracle_evidence.ledger_path;
    } else if (root !== campaignDir) {
      ledgerRelative = `snapshots/${caseRecord.id}/${attempt.id}/snapshot.json`;
    }
    if (ledgerRelative === null) {
      return infra('replay-snapshot-missing',
        'replay attempt has no oracle-evidence snapshot ledger; the cache-hit assertion cannot run');
    }
    const ledger = readReplaySnapshotFile(root, ledgerRelative);
    if (!isObject(ledger)) throw new Error('snapshot ledger is not a JSON object');
    if (ledger.status !== 'COMPLETE') {
      return infra('replay-snapshot-incomplete',
        `snapshot ledger status is ${JSON.stringify(ledger.status)}, not COMPLETE`);
    }
    if (!isObject(ledger.files) || !isObject(ledger.files.suite_observations)
        || !isObject(ledger.files.launch_intent)) {
      throw new Error('snapshot ledger lacks suite_observations/launch_intent references');
    }
    const suiteObservations = readReplaySnapshotFile(root, ledger.files.suite_observations.path);
    if (!isObject(suiteObservations) || !Array.isArray(suiteObservations.rows)) {
      throw new Error('suite observations lacks a rows array');
    }
    const launchIntent = readReplaySnapshotFile(root, ledger.files.launch_intent.path);
    const gateKey = launchIntent?.gate_key;
    if (!isObject(gateKey) || typeof gateKey.origin_repo !== 'string' || gateKey.origin_repo.length === 0
        || typeof gateKey.cmd_hash !== 'string' || gateKey.cmd_hash.length === 0) {
      throw new Error('launch intent lacks an origin/cmd gate key');
    }
    // The pair's committed tree, resolved from the shared work clone at
    // assertion time. The replay task forbids tree modifications, so the
    // clone's committed HEAD tree IS the pair's tree; a replay that
    // committed a change binds the suite to a different key and correctly
    // fails the pair-key binding below.
    const clonePath = attempt.fixture_work_clone;
    if (typeof clonePath !== 'string' || clonePath.length === 0) {
      return infra('replay-clone-missing',
        'replay attempt has no resolved work clone; the pair tree binding cannot run');
    }
    const gitResult = resolveReplayPairCommittedTree(clonePath, childEnv);
    const pairTree = String(gitResult.stdout ?? '').trim();
    if (gitResult.error !== undefined || gitResult.status !== 0 || !/^[0-9a-f]{40,64}$/.test(pairTree)) {
      return infra('replay-tree-unresolvable',
        `cannot resolve the replay pair's committed tree: ${gitResult.error?.message ?? String(gitResult.stderr ?? '').trim() ?? `git exit ${gitResult.status}`}`);
    }
    const runRows = suiteObservations.rows.filter((row) => isObject(row) && row.run_id === attempt.run_id);
    const hitRows = runRows.filter((row) => row.phase === 'replay'
      && row.origin_repo === gateKey.origin_repo
      && row.cmd_hash === gateKey.cmd_hash
      && typeof row.tree_hash === 'string' && row.tree_hash === pairTree);
    const observedPhases = [...new Set(runRows.map((row) => row.phase).filter((phase) => typeof phase === 'string'))];
    if (hitRows.length > 0) {
      return {
        ok: true,
        evidence: {
          status: 'replay-cache-hit',
          replay_of: replayOf,
          run_id: attempt.run_id,
          hit_observation: hitRows[0],
          observed_phases: observedPhases,
          key: { origin_repo: gateKey.origin_repo, cmd_hash: gateKey.cmd_hash, tree_hash: pairTree },
        },
      };
    }
    return {
      ok: false,
      kind: 'replay-cache-miss',
      finding: {
        replay_of: replayOf,
        run_id: attempt.run_id,
        observed_phases: observedPhases,
        expected_key: { origin_repo: gateKey.origin_repo, cmd_hash: gateKey.cmd_hash, tree_hash: pairTree },
        observed_rows: runRows,
      },
    };
  } catch (error) {
    return infra('replay-snapshot-unreadable',
      `replay cache-hit assertion could not read the oracle-evidence snapshot: ${error.message}`);
  }
}

// Read-only git plumbing over the replay's shared work clone. Like every
// spawn site in the controller, it passes the containment choke-point first
// and runs with the contained child environment.
function resolveReplayPairCommittedTree(clonePath, childEnv) {
  assertContainedSpawnEnv(childEnv);
  return spawnSync('git', ['-C', clonePath, 'rev-parse', '--verify', 'HEAD^{tree}'], {
    cwd: fs.realpathSync(TT_ROOT),
    env: childEnv,
    encoding: 'utf8',
    shell: false,
    timeout: 15_000,
  });
}

// Apply the gate to a terminal-harvest verdict:
//   hit   -> verdict unchanged; PASS carries the assertion evidence
//   miss  -> never PASS: REPLAY_CACHE_MISS finding on the case +
//            replay-cache-miss classification reason (a non-PASS verdict
//            keeps its own classification and additionally carries the finding)
//   infra -> fail closed as TEST_INFRA_FAIL, never PASS
// The gate result is always recorded on the attempt (replay_cache_assertion)
// so both hits and failures leave durable evidence.
function applyReplayCacheHitGate(caseRecord, caseState, attempt, state, campaignDir, verdict, childEnv) {
  if (replayPairOf(caseRecord) === null) return verdict;
  const gate = assessReplayCacheHit(caseRecord, caseState, attempt, state, campaignDir, childEnv);
  attempt.replay_cache_assertion = gate;
  if (gate.ok) return verdict;
  if (gate.kind === 'replay-cache-infra') {
    return { outcome: 'TEST_INFRA_FAIL', reason: gate.reason };
  }
  caseState.findings.push({ type: 'REPLAY_CACHE_MISS', ...gate.finding, detected_at: utcTimestamp() });
  if (verdict.outcome === 'PASS') {
    return {
      outcome: 'INCONCLUSIVE',
      reason: { category: 'replay-cache-miss', ...gate.finding },
    };
  }
  return verdict;
}

const FULL_RUN_ID_PATTERN = /(?:^|\r?\n)Run:\s+(run-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\b/gim;
const EARLY_SHORT_RUN_ID_PATTERN = /\brun\s+#\d+\s+\(([0-9a-f]{8})\)\s+created\b/gi;

function parseSingleJsonObject(output) {
  const lines = output.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
  if (lines.length !== 1) throw new Error(`expected one JSON line, received ${lines.length}`);
  const parsed = JSON.parse(lines[0]);
  if (!isObject(parsed)) throw new Error('JSON response is not an object');
  return parsed;
}

function resolveShortRunId(shortId, childEnv) {
  // FIX10 US-003 choke-point: the status query must run with the contained HOME.
  assertContainedSpawnEnv(childEnv);
  const result = spawnSync('tamandua', ['workflow', 'status', `run-${shortId}`, '--json'], {
    cwd: fs.realpathSync(TT_ROOT),
    env: childEnv,
    encoding: 'utf8',
    maxBuffer: 1024 * 1024,
    shell: false,
  });
  if (result.error !== undefined) throw result.error;
  if (result.status !== 0) {
    const detail = String(result.stderr ?? '').trim();
    throw new Error(`workflow status exited ${result.status}${detail ? `: ${detail}` : ''}`);
  }
  const status = parseSingleJsonObject(String(result.stdout ?? ''));
  const runIdMatch = /^run-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.exec(status.runId);
  if (runIdMatch === null || !runIdMatch[1].toLowerCase().startsWith(shortId.toLowerCase())) {
    throw new Error(`workflow status returned a non-matching runId: ${displayValue(status.runId)}`);
  }
  return `run-${runIdMatch[1].toLowerCase()}`;
}

function createRunIdentifierCapture(attempt, state, campaignDir, childEnv, onResolvedRunId) {
  const buffers = { stdout: '', stderr: '' };
  const observed = { stdout: new Set(), stderr: new Set() };
  attempt.run_id_observations = [];

  const persist = () => {
    state.updated_at = utcTimestamp();
    atomicWriteState(campaignDir, state);
  };
  const recordError = (category, details) => {
    attempt.run_id_error ??= { category, ...details, observed_at: utcTimestamp() };
    persist();
  };
  const recordResolvedId = (runId, source, observation) => {
    if (attempt.run_id === undefined) {
      attempt.run_id = runId;
      attempt.run_id_source = source;
      attempt.run_id_persisted_at = utcTimestamp();
      onResolvedRunId(runId);
    } else if (attempt.run_id !== runId) {
      recordError('conflicting-run-identifiers', {
        persisted_run_id: attempt.run_id,
        conflicting_run_id: runId,
        conflicting_source: source,
      });
    }
    attempt.run_id_observations.push({ ...observation, resolved_run_id: runId, observed_at: utcTimestamp() });
    persist();
  };

  return (streamName, chunk) => {
    buffers[streamName] = `${buffers[streamName]}${chunk.toString('utf8')}`.slice(-16 * 1024);
    if (streamName === 'stdout') {
      for (const match of buffers.stdout.matchAll(FULL_RUN_ID_PATTERN)) {
        const runId = match[1].toLowerCase();
        if (observed.stdout.has(runId)) continue;
        observed.stdout.add(runId);
        recordResolvedId(runId, 'stdout-full', { stream: 'stdout', identifier: runId });
      }
      return;
    }

    for (const match of buffers.stderr.matchAll(EARLY_SHORT_RUN_ID_PATTERN)) {
      const shortId = match[1].toLowerCase();
      if (observed.stderr.has(shortId)) continue;
      observed.stderr.add(shortId);
      attempt.run_id_observations.push({ stream: 'stderr', identifier: shortId, observed_at: utcTimestamp() });
      persist();
      try {
        recordResolvedId(resolveShortRunId(shortId, childEnv), 'stderr-short-status', {
          stream: 'stderr', identifier: shortId,
        });
      } catch (error) {
        attempt.run_id_resolution_errors ??= [];
        attempt.run_id_resolution_errors.push({
          category: 'unresolved-short-run-identifier',
          short_id: shortId,
          message: error.message,
          observed_at: utcTimestamp(),
        });
        persist();
      }
    }
  };
}

function queryWorkflowStatus(runId, childEnv) {
  // FIX10 US-003 choke-point: the status query must run with the contained HOME.
  assertContainedSpawnEnv(childEnv);
  const result = spawnSync('tamandua', ['workflow', 'status', runId, '--json'], {
    cwd: fs.realpathSync(TT_ROOT),
    env: childEnv,
    encoding: 'utf8',
    maxBuffer: 1024 * 1024,
    shell: false,
  });
  if (result.error !== undefined) throw result.error;
  if (result.status !== 0) {
    const detail = String(result.stderr ?? '').trim();
    throw new Error(`workflow status exited ${result.status}${detail ? `: ${detail}` : ''}`);
  }
  const status = parseSingleJsonObject(String(result.stdout ?? ''));
  if (status.runId !== runId || typeof status.status !== 'string'
      || !Number.isSafeInteger(status.tokensSpent) || status.tokensSpent < 0) {
    throw new Error(`workflow status returned invalid monitoring data for ${runId}`);
  }
  return status;
}

function readHookStdout(campaignDir, hookState) {
  if (hookState === undefined || typeof hookState.stdout !== 'string') return '';
  const absolutePath = path.resolve(campaignDir, hookState.stdout);
  const campaignRoot = fs.realpathSync(campaignDir);
  if (!pathIsWithin(campaignRoot, absolutePath)) {
    throw new Error('workflow waiter stdout path escapes campaign directory');
  }
  const details = fs.lstatSync(absolutePath);
  if (!details.isFile() || details.isSymbolicLink()
      || !pathIsWithin(campaignRoot, fs.realpathSync(absolutePath))) {
    throw new Error('workflow waiter stdout is not a contained regular file');
  }
  return fs.readFileSync(absolutePath, 'utf8');
}

function parseWaitJson(output, runId) {
  let waitJson = null;
  for (const line of output.split(/\r?\n/)) {
    if (line.trim() === '') continue;
    try {
      const parsed = JSON.parse(line);
      if (!isObject(parsed)) continue;
      if (Array.isArray(parsed.runs)) {
        if (parsed.runs.some((run) => normalizedRunId(run?.runId) === runId)) waitJson = parsed;
      } else if (typeof parsed.status === 'string') {
        waitJson = parsed;
      }
    } catch {
      // The early "Run:" line and any human progress lines are not waiter JSON.
    }
  }
  return waitJson;
}

function queryWorkflowDatabaseEvidence(runId, childEnv) {
  // FIX10 US-003 choke-point: the sqlite3 evidence query must run with the contained HOME.
  assertContainedSpawnEnv(childEnv);
  const selectedHome = childEnv.HOME;
  if (typeof selectedHome !== 'string' || !path.isAbsolute(selectedHome)) {
    throw new Error('selected TT HOME is unavailable');
  }
  const databasePath = path.join(path.resolve(selectedHome), '.tamandua', 'tamandua.db');
  if (!pathIsWithin(fs.realpathSync(TT_ROOT), databasePath)) {
    throw new Error('selected TT HOME database path escapes torture-test state');
  }
  let details;
  try {
    details = fs.lstatSync(databasePath);
  } catch (error) {
    throw new Error(`cannot inspect TT workflow database: ${error.message}`);
  }
  if (!details.isFile() || details.isSymbolicLink()
      || !pathIsWithin(fs.realpathSync(TT_ROOT), fs.realpathSync(databasePath))) {
    throw new Error('TT workflow database is not a contained regular file');
  }
  const storedRunId = runId.slice(4);
  const invoke = (sql) => {
    const result = spawnSync('sqlite3', ['-readonly', '-json', databasePath, sql], {
      cwd: fs.realpathSync(TT_ROOT), env: childEnv, encoding: 'utf8',
      maxBuffer: 16 * 1024 * 1024, shell: false,
    });
    if (result.error !== undefined) throw result.error;
    if (result.status !== 0) {
      const detail = String(result.stderr ?? '').trim();
      throw new Error(`sqlite3 -readonly exited ${result.status}${detail ? `: ${detail}` : ''}`);
    }
    const parsed = JSON.parse(String(result.stdout ?? '[]') || '[]');
    if (!Array.isArray(parsed)) throw new Error('sqlite3 -readonly did not emit a JSON array');
    return parsed;
  };
  const quotedRunId = `'${storedRunId.replaceAll("'", "''")}'`;
  const runs = invoke(`SELECT id, status, tokens_spent AS tokensSpent, created_at AS createdAt, updated_at AS updatedAt FROM runs WHERE id = ${quotedRunId} OR id = 'run-' || ${quotedRunId}`);
  if (runs.length !== 1 || typeof runs[0].status !== 'string'
      || !Number.isSafeInteger(runs[0].tokensSpent) || runs[0].tokensSpent < 0) {
    throw new Error(`sqlite3 -readonly returned invalid run evidence for ${runId}`);
  }
  const steps = invoke(`SELECT step_id, agent_id, step_index, status, type, current_story_id, retry_count, abandoned_count, reroute_count, claim_pid, claim_updated_at, updated_at FROM steps WHERE run_id = ${quotedRunId} OR run_id = 'run-' || ${quotedRunId} ORDER BY step_index ASC`);
  return {
    runId,
    status: runs[0].status,
    tokensSpent: runs[0].tokensSpent,
    steps,
    evidenceSource: {
      source: 'sqlite-readonly',
      database: toPortableRelativePath(databasePath),
      mode: '-readonly',
      command: ['sqlite3', '-readonly', '-json', toPortableRelativePath(databasePath)],
    },
  };
}

function queryWorkflowTerminalEvidence(runId, childEnv) {
  try {
    const status = queryWorkflowStatus(runId, childEnv);
    if (!Array.isArray(status.steps)) throw new Error('workflow status omitted the complete steps array');
    return {
      ...status,
      evidenceSource: { source: 'workflow-status-json', command: ['workflow', 'status', runId, '--json'] },
    };
  } catch (statusError) {
    try {
      return queryWorkflowDatabaseEvidence(runId, childEnv);
    } catch (databaseError) {
      throw new Error(`terminal evidence unavailable from status (${statusError.message}) and readonly DB (${databaseError.message})`);
    }
  }
}

function waitJsonStatus(waitJson, runId) {
  if (waitJson === null) return null;
  if (Array.isArray(waitJson.runs)) {
    const run = waitJson.runs.find((entry) => normalizedRunId(entry?.runId) === runId);
    return typeof run?.status === 'string' ? run.status : null;
  }
  return typeof waitJson.status === 'string' ? waitJson.status : null;
}

function canonicalTerminalStatus(status) {
  return status === 'done' ? 'completed' : status;
}

function expectedWaitExitCode(status) {
  const canonical = canonicalTerminalStatus(status);
  if (canonical === 'completed') return 0;
  if (canonical === 'failed') return 1;
  if (canonical === 'canceled') return 3;
  return null;
}

function configuredTruthRecheckMs() {
  const configured = Number(process.env.TT_CONTROLLER_TRUTH_RECHECK_MS ?? 30_000);
  return Number.isSafeInteger(configured) && configured >= 1 ? configured : 30_000;
}

function configuredTokenSettleMs() {
  // Bounded window the controller waits for tamandua to finalize a real run's
  // token spend after the run reaches a terminal status. tamandua attributes
  // token usage ASYNCHRONOUSLY (its scheduler finalizes each work round's usage
  // in a separate bookkeeping step), so runs.tokens_spent can read 0 in the
  // moments after the run flips to 'completed'. A consumer (this controller and
  // the terminal oracle snapshot) that samples at that instant would record a
  // false zero. Settling for this window lets the ledger reach its real value.
  const configured = Number(process.env.TT_CONTROLLER_TOKEN_SETTLE_MS ?? 20_000);
  return Number.isSafeInteger(configured) && configured >= 1 ? configured : 20_000;
}

const TOKEN_SETTLE_POLL_MS = 2_000;
const TOKEN_SETTLE_MIN_STABLE_POLLS = 3;

// Wait for tamandua's asynchronous token-finalization to land for a terminal
// REAL run, then persist the settled spend so the campaign ledger (and the
// terminal oracle snapshot captured afterwards) reflect the run's true spend.
// Fail-closed: never blocks unboundedly; bounded by TT_CONTROLLER_TOKEN_SETTLE_MS.
async function settleTerminalTokenSpend(caseState, attempt, childEnv, state, campaignDir) {
  if (attempt.execution_mode !== 'real') return; // scripted runs are zero-token
  let settled = attempt.tokens_observed ?? 0;
  const startedAt = Date.now();
  const settleWindowMs = configuredTokenSettleMs();
  let stableStreak = 0;
  while (Date.now() - startedAt < settleWindowMs) {
    await delay(Math.min(TOKEN_SETTLE_POLL_MS, Math.max(1, startedAt + settleWindowMs - Date.now())));
    let next;
    try {
      next = queryWorkflowTerminalEvidence(attempt.run_id, childEnv);
    } catch (error) {
      // Token settle is best-effort evidence collection: if status reading
      // transiently fails, stop settling without corrupting the terminal state.
      break;
    }
    persistTokenObservation(next, attempt, caseState, state, campaignDir);
    if (next.tokensSpent > settled) {
      settled = next.tokensSpent;
      stableStreak = 0;
    } else {
      stableStreak += 1;
    }
    // Stop once spend is positive and has been stable across enough consecutive
    // polls (tail-attribution is done), never later than the settle window.
    if (settled > 0 && stableStreak >= TOKEN_SETTLE_MIN_STABLE_POLLS) break;
  }
}

function waitEvidenceDisagrees(status, waitHook, waitExitCode, observedWaitStatus) {
  return waitHook !== undefined
    && (expectedWaitExitCode(status) !== waitExitCode
      || (observedWaitStatus !== null
        && canonicalTerminalStatus(observedWaitStatus) !== canonicalTerminalStatus(status)));
}

async function harvestWorkflowAttempt(caseState, attempt, waitHook, childEnv, state, campaignDir) {
  let evidence = queryWorkflowTerminalEvidence(attempt.run_id, childEnv);
  persistTokenObservation(evidence, attempt, caseState, state, campaignDir);
  if (!TERMINAL_RUN_STATUSES.has(evidence.status)) return null;

  const waitJson = parseWaitJson(readHookStdout(campaignDir, waitHook), attempt.run_id);
  const waitExitCode = waitHook?.exit_code ?? null;
  const observedWaitStatus = waitJsonStatus(waitJson, attempt.run_id);
  const disagrees = waitEvidenceDisagrees(
    evidence.status, waitHook, waitExitCode, observedWaitStatus,
  );
  let persistentDisagreement = false;
  if (disagrees) {
    await delay(configuredTruthRecheckMs());
    const resampled = queryWorkflowTerminalEvidence(attempt.run_id, childEnv);
    persistTokenObservation(resampled, attempt, caseState, state, campaignDir);
    persistentDisagreement = TERMINAL_RUN_STATUSES.has(resampled.status)
      && waitEvidenceDisagrees(resampled.status, waitHook, waitExitCode, observedWaitStatus);
    evidence = resampled;
  }

  // US-008: tamandua finalizes token spend asynchronously after terminal, so
  // settle before capturing terminal evidence (attempt tokens AND, critically,
  // the terminal oracle snapshot taken later by completeCaseOracleSnapshot).
  await settleTerminalTokenSpend(caseState, attempt, childEnv, state, campaignDir);

  attempt.terminal_status = evidence.status;
  attempt.wait_exit_code = waitExitCode;
  attempt.wait_json = waitJson;
  attempt.steps_snapshot = {
    source: evidence.evidenceSource.source,
    captured_at: utcTimestamp(),
    provenance: evidence.evidenceSource,
    steps: evidence.steps,
  };
  attempt.terminal_evidence = {
    source: evidence.evidenceSource.source,
    observed_at: attempt.steps_snapshot.captured_at,
    status: evidence.status,
    tokens: evidence.tokensSpent,
  };
  if (persistentDisagreement) {
    caseState.findings.push({
      type: 'O13_TRUTHFULNESS',
      oracle: 'O13',
      run_id: attempt.run_id,
      detected_at: utcTimestamp(),
      terminal_status: evidence.status,
      terminal_source: evidence.evidenceSource.source,
      wait_exit_code: waitExitCode,
      expected_wait_exit_code: expectedWaitExitCode(evidence.status),
      wait_json_status: observedWaitStatus,
      recheck_ms: configuredTruthRecheckMs(),
    });
  }
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
  return evidence;
}

function resolveChildDatabasePath(childEnv) {
  const explicit = childEnv.TAMANDUA_DB_PATH;
  const home = childEnv.HOME;
  const candidate = typeof explicit === 'string' && explicit.trim() !== ''
    ? path.resolve(explicit)
    : typeof home === 'string' && path.isAbsolute(home)
      ? path.join(home, '.tamandua', 'tamandua.db')
      : null;
  if (candidate === null || !pathIsWithin(fs.realpathSync(TT_ROOT), candidate)) return null;
  return candidate;
}

function queryWorkflowRunsDatabase(childEnv) {
  const databasePath = resolveChildDatabasePath(childEnv);
  if (databasePath === null) return null;
  for (const candidate of [databasePath, `${databasePath}-wal`, `${databasePath}-shm`]) {
    let details;
    try {
      details = fs.lstatSync(candidate);
    } catch (error) {
      if (error.code === 'ENOENT' && candidate === databasePath) return null;
      if (error.code === 'ENOENT') continue;
      throw new Error(`cannot inspect TT run database: ${error.message}`);
    }
    if (!details.isFile() || details.isSymbolicLink()
        || !pathIsWithin(fs.realpathSync(TT_ROOT), fs.realpathSync(candidate))) {
      throw new Error(`TT run database file ${path.basename(candidate)} is not a contained regular file`);
    }
  }

  let database;
  try {
    database = new DatabaseSync(databasePath, { readOnly: true });
    const rows = database.prepare(`
      SELECT id, workflow_id, task, status, context, tokens_spent, created_at, updated_at
      FROM runs
      ORDER BY created_at DESC
    `).all();
    return rows.map((row) => {
      let context = {};
      try {
        const parsed = JSON.parse(row.context);
        if (isObject(parsed)) context = parsed;
      } catch {
        // Relationship fields in malformed context are ignored; the durable
        // run inventory remains usable and status harvesting will expose DB drift.
      }
      return {
        runId: normalizedStoredRunId(row.id) ?? row.id,
        workflowId: row.workflow_id,
        task: row.task,
        status: row.status,
        context,
        tokensSpent: row.tokens_spent,
        createdAt: row.created_at,
        updatedAt: row.updated_at,
      };
    });
  } catch (error) {
    throw new Error(`cannot query complete TT run inventory: ${error.message}`);
  } finally {
    database?.close();
  }
}

function queryWorkflowRuns(childEnv) {
  const runs = queryWorkflowRunsDatabase(childEnv);
  if (runs === null) {
    throw new Error('complete TT run inventory is unavailable: contained database does not exist');
  }
  const relationships = readRunRelationships(childEnv);
  return runs.map((run) => {
    const runId = normalizedRunId(run?.runId ?? run?.id);
    const parentRunId = runId === null ? undefined : relationships.get(runId);
    return parentRunId === undefined || linkedParentRunId(run) !== null
      ? run
      : { ...run, parentRunId };
  });
}

function normalizedRunId(value) {
  if (typeof value !== 'string') return null;
  const match = /^run-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.exec(value);
  return match === null ? null : `run-${match[1].toLowerCase()}`;
}

function normalizedStoredRunId(value) {
  const external = normalizedRunId(value);
  if (external !== null) return external;
  if (typeof value !== 'string'
      || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)) {
    return null;
  }
  return `run-${value.toLowerCase()}`;
}

function linkedParentRunId(run) {
  if (!isObject(run)) return null;
  const context = isObject(run.context) ? run.context : {};
  for (const value of [
    run.parentRunId, run.parent_run_id,
    run.replacementForRunId, run.replacement_for_run_id,
    run.replacesRunId, run.replaces_run_id,
    context.parentRunId, context.parent_run_id,
    context.replacementForRunId, context.replacement_for_run_id,
  ]) {
    const runId = normalizedStoredRunId(value);
    if (runId !== null) return runId;
  }
  return null;
}

function runStartedAt(run) {
  for (const value of [run.createdAt, run.created_at, run.startedAt, run.started_at]) {
    if (isUtcTimestamp(value)) return value;
  }
  return null;
}

function readRunRelationships(childEnv) {
  const relationships = new Map();
  const stateDirectory = childEnv.TAMANDUA_STATE_DIR;
  if (typeof stateDirectory !== 'string' || !path.isAbsolute(stateDirectory)) return relationships;
  const resolvedStateDirectory = path.resolve(stateDirectory);
  if (!pathIsWithin(fs.realpathSync(TT_ROOT), resolvedStateDirectory)) return relationships;
  const liveEventsPath = path.join(resolvedStateDirectory, 'events', 'all.jsonl');
  // Tamandua retains three numbered global-event archives. Read oldest to
  // newest so a newer relationship observation wins deterministically.
  const eventPaths = [3, 2, 1].map((suffix) => `${liveEventsPath}.${suffix}`)
    .concat(liveEventsPath);
  for (const eventsPath of eventPaths) {
    let source;
    try {
      const details = fs.lstatSync(eventsPath);
      if (!details.isFile() || details.isSymbolicLink()
          || !pathIsWithin(fs.realpathSync(TT_ROOT), fs.realpathSync(eventsPath))) {
        throw new Error(`${path.basename(eventsPath)} is not a contained regular file`);
      }
      source = fs.readFileSync(eventsPath, 'utf8');
    } catch (error) {
      if (error.code === 'ENOENT') continue;
      throw new Error(`cannot read TT run relationships: ${error.message}`);
    }
    for (const line of source.split(/\r?\n/)) {
      if (line.trim() === '') continue;
      let event;
      try {
        event = JSON.parse(line);
      } catch {
        continue;
      }
      const parentRunId = normalizedStoredRunId(event.parentRunId ?? event.parent_run_id ?? event.runId);
      let childRunId = normalizedStoredRunId(event.childRunId ?? event.child_run_id
        ?? event.replacementRunId ?? event.replacement_run_id);
      if (childRunId === null && event.event === 'run.rugpull_relaunched') {
        const match = /Rugpull replacement run launched:\s+((?:run-)?[0-9a-f-]{36})\b/i.exec(String(event.detail ?? ''));
        childRunId = normalizedStoredRunId(match?.[1]);
      }
      if (parentRunId !== null && childRunId !== null && parentRunId !== childRunId) {
        relationships.set(childRunId, parentRunId);
      }
    }
  }
  return relationships;
}

function persistTokenObservation(status, attempt, caseState, state, campaignDir) {
  const observedAt = utcTimestamp();
  const previous = attempt.tokens_observed ?? 0;
  const tokensObserved = Math.max(previous, status.tokensSpent);
  const attributedDelta = tokensObserved - previous;
  const observation = {
    observed_at: observedAt,
    run_id: attempt.run_id,
    status: status.status,
    tokens_observed: status.tokensSpent,
    attributed_delta: attributedDelta,
  };
  attempt.tokens_observed = tokensObserved;
  attempt.token_observations ??= [];
  attempt.token_observations.push(observation);
  caseState.spend.tokens_observed += attributedDelta;
  caseState.spend.observations.push({ attempt_id: attempt.id, ...observation });
  state.spend.tokens_observed += attributedDelta;
  state.spend.observations.push({ case_id: caseState.id, attempt_id: attempt.id, ...observation });
  state.updated_at = observedAt;
  atomicWriteState(campaignDir, state);
}

function rootRunAttribution(state) {
  const attribution = new Map();
  for (const caseState of state.cases) {
    for (const attempt of caseState.attempts) {
      const runId = normalizedRunId(attempt.run_id);
      if (runId !== null) attribution.set(runId, caseState.id);
    }
  }
  for (const run of state.discovered_runs ?? []) {
    attribution.set(run.run_id, run.root_case_id);
  }
  return attribution;
}

function discoveredRunRecord(run, runId, parentRunId, caseRecord, rootCaseId, executionMode) {
  const startedAt = runStartedAt(run);
  if (startedAt === null) {
    throw new Error(`linked run ${runId} has no valid created/start timestamp`);
  }
  if (!['real', 'scripted'].includes(executionMode)) {
    throw new Error(`linked run ${runId} has no mechanically identified execution mode`);
  }
  return {
    id: `discovered-${runId.slice(4)}`,
    case_id: rootCaseId,
    kind: 'discovered-workflow',
    phase: 'attached',
    execution_mode: executionMode,
    run_id: runId,
    parent_run_id: parentRunId,
    root_case_id: rootCaseId,
    discovered_at: utcTimestamp(),
    started_at: startedAt,
    deadline_at: new Date(new Date(startedAt).valueOf()
      + (caseRecord.caps.wall_min * 60_000)).toISOString(),
    tokens_observed: 0,
    token_observations: [],
  };
}

function inferJustDoItParentRunId(listed, caseRecord, caseState, rootTask) {
  if (caseRecord.workflow !== 'just-do-it' || typeof rootTask !== 'string'
      || typeof listed?.task !== 'string') return null;
  const rootAttempt = caseState.attempts.find((attempt) =>
    attempt.kind === 'workflow' && normalizedRunId(attempt.run_id) !== null);
  const listedRunId = normalizedRunId(listed.runId ?? listed.id);
  const startedAt = runStartedAt(listed);
  if (rootAttempt === undefined || listedRunId === null || startedAt === null
      || listedRunId === rootAttempt.run_id
      || new Date(startedAt).valueOf() < new Date(rootAttempt.started_at).valueOf()) return null;
  const listedTask = listed.task;
  if (listedTask !== rootTask && listedTask !== rootTask.slice(0, 120)) return null;
  return rootAttempt.run_id;
}

function reconcileDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir) {
  state.discovered_runs ??= [];
  const listedRuns = queryWorkflowRuns(childEnv);
  const attribution = rootRunAttribution(state);
  const launchedRunIds = new Set(state.cases.flatMap((item) => item.attempts)
    .map((attempt) => normalizedRunId(attempt.run_id)).filter(Boolean));
  const discoveredById = new Map(state.discovered_runs.map((run) => [run.run_id, run]));
  const rootAttempt = caseState.attempts.find((attempt) =>
    attempt.kind === 'workflow' && normalizedRunId(attempt.run_id) !== null);
  const rootTask = caseRecord.workflow === 'just-do-it' && rootAttempt !== undefined
    ? queryWorkflowStatus(rootAttempt.run_id, childEnv).task
    : null;
  let added = 0;
  let changed = true;
  while (changed) {
    changed = false;
    for (const listed of listedRuns) {
      const runId = normalizedRunId(listed?.runId ?? listed?.id);
      const parentRunId = linkedParentRunId(listed)
        ?? inferJustDoItParentRunId(listed, caseRecord, caseState, rootTask);
      if (runId === null || parentRunId === null || launchedRunIds.has(runId)
          || discoveredById.has(runId)) continue;
      const rootCaseId = attribution.get(parentRunId);
      if (rootCaseId !== caseState.id) continue;
      const record = discoveredRunRecord(
        listed, runId, parentRunId, caseRecord, rootCaseId, rootAttempt?.execution_mode,
      );
      state.discovered_runs.push(record);
      discoveredById.set(runId, record);
      attribution.set(runId, rootCaseId);
      added += 1;
      changed = true;
      state.updated_at = record.discovered_at;
      atomicWriteState(campaignDir, state);
    }
  }

  for (const run of state.discovered_runs.filter((item) =>
    item.root_case_id === caseState.id && item.phase !== 'terminal')) {
    const status = queryWorkflowStatus(run.run_id, childEnv);
    persistTokenObservation(status, run, caseState, state, campaignDir);
    run.last_status = status.status;
    run.status_observed_at = utcTimestamp();
    state.updated_at = run.status_observed_at;
    atomicWriteState(campaignDir, state);
  }
  return added;
}

function discoveredRunBreach(caseRecord, caseState, run) {
  if (caseState.spend.tokens_observed >= caseRecord.caps.tokens) {
    return { cap: 'tokens', threshold: caseRecord.caps.tokens, observed: caseState.spend.tokens_observed };
  }
  if (Date.now() >= new Date(run.deadline_at).valueOf()) {
    const elapsed = (Date.now() - new Date(run.started_at).valueOf()) / 60_000;
    return { cap: 'wall_min', threshold: caseRecord.caps.wall_min, observed: elapsed };
  }
  return null;
}

function captureStragglerPreStop(run, status, breach, capturedAt) {
  run.straggler_capture = {
    captured_at: capturedAt,
    stop_intent_at: capturedAt,
    reason: {
      cap: breach.cap,
      threshold: breach.threshold,
      observed: breach.observed,
      ...(breach.enforcement_latency === undefined
        ? {}
        : { enforcement_latency: breach.enforcement_latency }),
    },
    steps_snapshot: {
      source: 'workflow-status-json',
      captured_at: capturedAt,
      steps: Array.isArray(status.steps) ? status.steps : [],
    },
  };
}

async function stopDiscoveredRun(caseState, run, breach, childEnv, state, campaignDir, observedStatus) {
  if (run.stop_intent_at !== undefined) return;
  run.stop_intent_at = utcTimestamp();
  run.stop_reason = breach;
  const status = observedStatus ?? queryWorkflowStatus(run.run_id, childEnv);
  captureStragglerPreStop(run, status, breach, run.stop_intent_at);
  caseState.findings.push({
    type: 'RUNAWAY', ...breach, run_id: run.run_id, discovered: true,
    detected_at: run.stop_intent_at,
  });
  state.updated_at = run.stop_intent_at;
  atomicWriteState(campaignDir, state);
  const stopResult = await runHook(`discovered_stop_${run.id}`, {
    executable: 'tamandua', args: ['workflow', 'stop', run.run_id], cwd: '.',
  }, childEnv, campaignDir, state, run, { enforceWall: false });
  if (!hookSucceeded(stopResult)) throw new Error(`workflow stop failed for ${run.run_id}`);
}

// S8a (US-002): discovered-run cap-breach evaluation runs on the same
// dedicated cap-check cadence as primary attempts, decoupled from the token
// poll — so a child run of a multi-run case is stopped near its wall
// deadline (or its token threshold) even when the token poll interval is
// much larger than the cap window. The breach record carries both
// `observed` and `enforcement_latency` (seconds from threshold/deadline
// crossing to detection) in stop_reason, the RUNAWAY finding, and
// straggler_capture.reason. The stop -> bounded-wait -> terminal-harvest
// path (including the cleanupWaitTimeoutMs bound) is unchanged.
async function awaitDiscoveredRun(caseRecord, caseState, run, childEnv, state, campaignDir) {
  const cleanupWaitTimeoutMs = Math.min(state.options.token_poll_interval_ms, 60_000);
  const initialBreach = discoveredRunBreach(caseRecord, caseState, run);
  if (initialBreach !== null) {
    const detectedAt = utcTimestamp();
    initialBreach.enforcement_latency = capEnforcementLatencySeconds(
      caseState, run, initialBreach, detectedAt,
    );
    await stopDiscoveredRun(caseState, run, initialBreach, childEnv, state, campaignDir);
  }

  run.reattach_count = (run.reattach_count ?? 0) + 1;
  let waitSettled = false;
  // The wait hook is NOT wall-limited here: the cap-check loop below is the
  // sole wall enforcement for the pre-stop phase (a wall-limited wait would
  // race the cap-check stop at the deadline and poison the harvested wait
  // evidence with a SIGTERM kill). The wait settles either on natural
  // termination or when the cap-check stop lands; the post-stop wait keeps
  // its existing bounded cleanup timeout.
  const waitPromise = runHook(`discovered_wait_${run.reattach_count}`, {
    executable: 'tamandua', args: ['workflow', 'wait', run.run_id, '--json'], cwd: '.',
  }, childEnv, campaignDir, state, run, {
    enforceWall: false,
    timeoutMs: run.stop_intent_at === undefined ? undefined : cleanupWaitTimeoutMs,
  })
    .then((result) => {
      waitSettled = true;
      return result;
    });

  // Dual-cadence wait loop (mirrors monitorWorkflowRun): status observation
  // stays on the token-poll cadence; the cap-breach evaluation ticks on the
  // cap-check cadence. Each loop wake is driven by whichever is due next.
  const tokenPollMs = state.options.token_poll_interval_ms;
  const capCheckMs = state.options.cap_check_interval_ms;
  let nextTokenPollAt = Date.now() + tokenPollMs;
  let nextCapCheckAt = Date.now() + capCheckMs;
  while (!waitSettled) {
    const waitMs = Math.max(1, Math.min(nextTokenPollAt, nextCapCheckAt) - Date.now());
    await new Promise((resolve) => {
      const timer = setTimeout(resolve, waitMs);
      waitPromise.then(() => {
        clearTimeout(timer);
        resolve();
      });
    });
    if (waitSettled) break;

    const now = Date.now();
    const tokenPollDue = now >= nextTokenPollAt;
    const capCheckDue = now >= nextCapCheckAt;
    if (tokenPollDue) nextTokenPollAt = now + tokenPollMs;
    if (capCheckDue) nextCapCheckAt = now + capCheckMs;

    if (tokenPollDue) {
      const status = queryWorkflowStatus(run.run_id, childEnv);
      persistTokenObservation(status, run, caseState, state, campaignDir);
      if (TERMINAL_RUN_STATUSES.has(status.status)) continue;
    }

    if (!capCheckDue) continue;
    const breach = discoveredRunBreach(caseRecord, caseState, run);
    if (breach === null) continue;
    const detectedAt = utcTimestamp();
    breach.enforcement_latency = capEnforcementLatencySeconds(caseState, run, breach, detectedAt);
    await stopDiscoveredRun(caseState, run, breach, childEnv, state, campaignDir);
    break;
  }

  let waitResult = await waitPromise;
  let status = queryWorkflowStatus(run.run_id, childEnv);
  persistTokenObservation(status, run, caseState, state, campaignDir);
  if (!TERMINAL_RUN_STATUSES.has(status.status)) {
    const breach = discoveredRunBreach(caseRecord, caseState, run);
    if (breach === null) {
      throw new Error(`discovered run remained ${status.status} after workflow wait: ${run.run_id}`);
    }
    const detectedAt = utcTimestamp();
    breach.enforcement_latency = capEnforcementLatencySeconds(caseState, run, breach, detectedAt);
    await stopDiscoveredRun(caseState, run, breach, childEnv, state, campaignDir, status);
    const terminalWait = await runHook(`discovered_terminal_wait_${run.reattach_count}`, {
      executable: 'tamandua', args: ['workflow', 'wait', run.run_id, '--json'], cwd: '.',
    }, childEnv, campaignDir, state, run, {
      enforceWall: false, timeoutMs: cleanupWaitTimeoutMs,
    });
    status = queryWorkflowStatus(run.run_id, childEnv);
    persistTokenObservation(status, run, caseState, state, campaignDir);
    waitResult = terminalWait;
    if (!TERMINAL_RUN_STATUSES.has(status.status)
        && (terminalWait.error !== undefined || terminalWait.signal !== null || terminalWait.exit_code === 2)) {
      throw new Error(`terminal wait failed for discovered run ${run.run_id}`);
    }
  }
  if (!TERMINAL_RUN_STATUSES.has(status.status)) {
    throw new Error(`discovered run remained ${status.status} after terminal cleanup: ${run.run_id}`);
  }
  const terminalEvidence = await harvestWorkflowAttempt(
    caseState, run, waitResult, childEnv, state, campaignDir,
  );
  run.phase = 'terminal';
  run.terminal_status = terminalEvidence.status;
  run.terminal_at = utcTimestamp();
  state.updated_at = run.terminal_at;
  atomicWriteState(campaignDir, state);
}

async function convergeDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir) {
  while (true) {
    const added = reconcileDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir);
    const active = (state.discovered_runs ?? []).filter((run) =>
      run.root_case_id === caseState.id && run.phase !== 'terminal');
    if (active.length === 0) {
      if (added === 0) return;
      continue;
    }

    for (const run of active) {
      await awaitDiscoveredRun(caseRecord, caseState, run, childEnv, state, campaignDir);
    }
  }
}

// S8a (US-001): cap-breach checks run on their own cadence (cap_check_interval_ms),
// decoupled from the token poll, so a short wall cap fires near its deadline
// instead of waiting for the next (potentially 5-minute) token poll. The breach
// record carries both `observed` and `enforcement_latency` — seconds from the
// deadline/threshold crossing to detection.
function capEnforcementLatencySeconds(caseState, attempt, breach, detectedAt) {
  const detectedAtMs = new Date(detectedAt).valueOf();
  if (breach.cap === 'wall_min') {
    const crossingMs = new Date(attempt.started_at).valueOf() + breach.threshold * 60_000;
    return Math.max(0, (detectedAtMs - crossingMs) / 1000);
  }
  if (breach.cap === 'tokens') {
    const crossing = (caseState.spend.observations ?? [])
      .find((observation) => observation.tokens_observed >= breach.threshold);
    if (crossing === undefined) return 0;
    return Math.max(0, (detectedAtMs - new Date(crossing.observed_at).valueOf()) / 1000);
  }
  return 0;
}

function workflowRunBreach(caseRecord, caseState, attempt) {
  if (caseState.spend.tokens_observed >= caseRecord.caps.tokens) {
    return {
      cap: 'tokens', threshold: caseRecord.caps.tokens, observed: caseState.spend.tokens_observed,
    };
  }
  const elapsedWallMin = (Date.now() - new Date(attempt.started_at).valueOf()) / 60_000;
  if (elapsedWallMin >= caseRecord.caps.wall_min) {
    return { cap: 'wall_min', threshold: caseRecord.caps.wall_min, observed: elapsedWallMin };
  }
  return undefined;
}

async function monitorWorkflowRun(caseRecord, caseState, attempt, childEnv, state, campaignDir, launchEndedPromise) {
  // Token observation persistence and discovered-run reconciliation stay on the
  // token-poll cadence; only the cap-breach evaluation ticks faster. Each loop
  // wake is driven by whichever cadence is due next.
  const tokenPollMs = state.options.token_poll_interval_ms;
  const capCheckMs = state.options.cap_check_interval_ms;
  let nextTokenPollAt = Date.now() + tokenPollMs;
  let nextCapCheckAt = Date.now() + capCheckMs;
  while (true) {
    const waitMs = Math.max(1, Math.min(nextTokenPollAt, nextCapCheckAt) - Date.now());
    const launchEnded = await new Promise((resolve) => {
      const timer = setTimeout(() => resolve(false), waitMs);
      launchEndedPromise.then(() => {
        clearTimeout(timer);
        resolve(true);
      });
    });
    if (launchEnded && attempt.stop_intent_at === undefined) return { stopped: false };

    const now = Date.now();
    const tokenPollDue = now >= nextTokenPollAt;
    const capCheckDue = now >= nextCapCheckAt;
    if (tokenPollDue) nextTokenPollAt = now + tokenPollMs;
    if (capCheckDue) nextCapCheckAt = now + capCheckMs;

    if (tokenPollDue) {
      const status = queryWorkflowStatus(attempt.run_id, childEnv);
      persistTokenObservation(status, attempt, caseState, state, campaignDir);
      reconcileDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir);
      if (TERMINAL_RUN_STATUSES.has(status.status)) return { stopped: false, terminal_status: status.status };
    }

    if (!capCheckDue) continue;
    const breach = workflowRunBreach(caseRecord, caseState, attempt);
    if (breach === undefined) continue;

    const detectedAt = utcTimestamp();
    breach.enforcement_latency = capEnforcementLatencySeconds(caseState, attempt, breach, detectedAt);
    attempt.stop_intent_at = detectedAt;
    attempt.stop_reason = breach;
    const status = queryWorkflowStatus(attempt.run_id, childEnv);
    captureStragglerPreStop(attempt, status, breach, detectedAt);
    caseState.findings.push({ type: 'RUNAWAY', ...breach, run_id: attempt.run_id, detected_at: detectedAt });
    state.updated_at = detectedAt;
    atomicWriteState(campaignDir, state);

    const stopResult = await runHook('stop', {
      executable: 'tamandua', args: ['workflow', 'stop', attempt.run_id], cwd: '.',
    }, childEnv, campaignDir, state, attempt, { enforceWall: false });
    if (!hookSucceeded(stopResult)) throw new Error(`workflow stop failed for ${attempt.run_id}`);

    const waitResult = await runHook('terminal_wait', {
      executable: 'tamandua', args: ['workflow', 'wait', attempt.run_id, '--json'], cwd: '.',
    }, childEnv, campaignDir, state, attempt, { enforceWall: false });
    if (waitResult.error !== undefined || waitResult.signal !== null || waitResult.exit_code === 2) {
      throw new Error(`workflow wait failed after stopping ${attempt.run_id}`);
    }
    const terminalStatus = queryWorkflowStatus(attempt.run_id, childEnv);
    persistTokenObservation(terminalStatus, attempt, caseState, state, campaignDir);
    if (!TERMINAL_RUN_STATUSES.has(terminalStatus.status)) {
      throw new Error(`workflow remained ${terminalStatus.status} after stop and wait: ${attempt.run_id}`);
    }
    return { stopped: true, terminal_status: terminalStatus.status, breach };
  }
}

// US-005: Definite infrastructure launch-error classification. A real-case
// launch whose stderr exposes a DEFINITE infrastructure failure (missing
// workflow spec, ENOENT on the workflow/catalog dir, missing catalog, or a
// daemon/control-plane error) must be reported with THAT reason, never the
// generic workflow-run-identification / missing-run-identifier — otherwise
// the real defect is buried. Only a genuinely ambiguous case (run started but
// no captured run id and no infra signature) keeps the legacy classification.
// The classifier reads the launch-stderr evidence file that runHook durably
// captures; it is pure/defensive (never throws) so classification always
// falls back to the legacy category on any read/scan failure or empty input.
const INFRA_LAUNCH_SIGNATURES = [
  // precedence-ordered: more specific infra signatures first.
  { re: /No workflow\.yml found/i, category: 'workflow-spec-missing' },
  { re: /ENOENT[^\n]{0,120}(?:workflow|catalog)[^\n]{0,120}/i, category: 'workflow-dir-enoent' },
  { re: /(?:catalog|workflow)[^\n]{0,80}not (?:found|installed|provisioned)[^\n]{0,80}/i, category: 'catalog-missing' },
  { re: /daemon[^\n]{0,80}(?:down|unreachable|refused to connect|connect\s+refused|ECONNREFUSED|not running)/i, category: 'daemon-unreachable' },
  { re: /control[ -]plane[^\n]{0,80}(?:down|unreachable|refused|fail|error)/i, category: 'daemon-unreachable' },
  { re: /ECONNREFUSED[^\n]{0,80}(?:port|daemon|control|433[0-9]|333[0-9])/i, category: 'daemon-unreachable' },
];

// Returns a reason fragment { category, message, signature } when the launch
// stderr contains a definite infrastructure-failure signature, else null.
function classifyInfraLaunchFailure(launchStderr) {
  if (typeof launchStderr !== 'string' || launchStderr.trim().length === 0) return null;
  for (const signature of INFRA_LAUNCH_SIGNATURES) {
    const match = signature.re.exec(launchStderr);
    if (match === null) continue;
    // Surface the exact error message near the matched signature as evidence.
    const start = Math.max(0, match.index - 160);
    const end = Math.min(launchStderr.length, match.index + match[0].length + 240);
    const snippet = launchStderr.slice(start, end);
    const message = snippet.split(/\r?\n/).map((line) => line.trim()).filter(Boolean).slice(0, 4).join(' | ');
    return { category: signature.category, message, signature: match[0] };
  }
  return null;
}

// Read the launch-stderr evidence file a runHook produced; never throws.
function readLaunchEvidenceStderr(campaignDir, launchResult) {
  try {
    const relative = launchResult?.stderr;
    if (typeof relative !== 'string' || relative.length === 0) return '';
    return fs.readFileSync(path.join(campaignDir, relative.split('/').join(path.sep)), 'utf8');
  } catch {
    return '';
  }
}

async function executeWorkflowCase(caseRecord, caseState, state, campaignDir) {
  if (hasAssociatedNonterminalRun(caseState)) return;

  // US-005 (S9 controller): REPLAY same-origin provisioning + sequencing
  // guard. Resolve the pair BEFORE creating the launch attempt so an
  // interrupted bounded wait leaves the case 'pending' (clean resume) rather
  // than a half-recorded attempt. Fail-closed categories are distinct and
  // recorded on a launch-intent attempt as TEST_INFRA_FAIL evidence.
  const replayOf = replayPairOf(caseRecord);
  let replayContext = null;
  if (replayOf !== null) {
    const resolved = await resolveReplayPairContext(replayOf, caseRecord, state);
    if (!resolved.ok) {
      const guardTimestamp = utcTimestamp();
      const guardAttempt = {
        id: `attempt-${caseState.attempts.length + 1}`,
        case_id: caseRecord.id,
        kind: 'workflow',
        phase: 'launch-intent',
        execution_mode: caseUsesScriptedEnvironment(caseRecord) ? 'scripted' : 'real',
        launch_intent_at: guardTimestamp,
        started_at: guardTimestamp,
        deadline_at: new Date(Date.now() + (caseRecord.caps.wall_min * 60_000)).toISOString(),
        ...retryAttemptMetadata(caseState),
      };
      caseState.phase = 'running';
      caseState.attempts.push(guardAttempt);
      state.updated_at = guardTimestamp;
      atomicWriteState(campaignDir, state);
      guardAttempt.phase = 'terminal';
      guardAttempt.terminal_at = utcTimestamp();
      persistMechanicalOutcome(caseState, guardAttempt, state, campaignDir, 'TEST_INFRA_FAIL', resolved.reason);
      return;
    }
    replayContext = resolved;
  }

  // US-008 (S11 controller): local-sentinel launch adapter guard. Resolve the
  // sentinel BEFORE the launch attempt is created so an unsupported profile
  // (workflow `local` + any harness other than pi) fails closed on a
  // launch-intent attempt with the distinct `local-sentinel-unsupported`
  // reason — the literal argv `workflow run local` is never constructed or
  // executed (workflowRunArgs enforces the same invariant at every call
  // site). The supported W2.24 shape (local + pi) resolves to tt-docs-drift
  // and records adapter evidence on the attempt.
  const sentinel = resolveLocalSentinel(caseRecord);
  if (sentinel.sentinel && !sentinel.ok) {
    const guardTimestamp = utcTimestamp();
    const guardAttempt = {
      id: `attempt-${caseState.attempts.length + 1}`,
      case_id: caseRecord.id,
      kind: 'workflow',
      phase: 'launch-intent',
      execution_mode: caseUsesScriptedEnvironment(caseRecord) ? 'scripted' : 'real',
      launch_intent_at: guardTimestamp,
      started_at: guardTimestamp,
      deadline_at: new Date(Date.now() + (caseRecord.caps.wall_min * 60_000)).toISOString(),
      ...retryAttemptMetadata(caseState),
      sentinel_adapter: {
        profile: sentinel.profile,
        workflow_id: null,
        resolution: 'local-sentinel-unsupported',
        install: { outcome: 'not-attempted' },
      },
    };
    caseState.phase = 'running';
    caseState.attempts.push(guardAttempt);
    state.updated_at = guardTimestamp;
    atomicWriteState(campaignDir, state);
    guardAttempt.phase = 'terminal';
    guardAttempt.terminal_at = utcTimestamp();
    persistMechanicalOutcome(caseState, guardAttempt, state, campaignDir, 'TEST_INFRA_FAIL', sentinel.reason);
    return;
  }

  // US-010 (S12 controller): token-saver paired-launch guard. The adapter is
  // a REAL-case behavior (the W3.23 probe runs two do-now launches against
  // the contained daemon's PATH). A scripted case carrying the signal fails
  // closed with a distinct reason BEFORE any launch attempt is created.
  const tokenSaverCase = tokenSaverControl(caseRecord);
  if (tokenSaverCase && caseUsesScriptedEnvironment(caseRecord)) {
    const guardTimestamp = utcTimestamp();
    const guardAttempt = {
      id: `attempt-${caseState.attempts.length + 1}`,
      case_id: caseRecord.id,
      kind: 'workflow',
      phase: 'launch-intent',
      execution_mode: 'scripted',
      launch_intent_at: guardTimestamp,
      started_at: guardTimestamp,
      deadline_at: new Date(Date.now() + (caseRecord.caps.wall_min * 60_000)).toISOString(),
      ...retryAttemptMetadata(caseState),
      token_saver_adapter: {
        profile: {
          workflow: caseRecord.workflow,
          harness: caseRecord.harness,
          execution_mode: caseRecord.context?.execution_mode ?? null,
          case_id: caseRecord.id,
        },
        resolution: 'token-saver-scripted-unsupported',
      },
    };
    caseState.phase = 'running';
    caseState.attempts.push(guardAttempt);
    state.updated_at = guardTimestamp;
    atomicWriteState(campaignDir, state);
    guardAttempt.phase = 'terminal';
    guardAttempt.terminal_at = utcTimestamp();
    persistMechanicalOutcome(caseState, guardAttempt, state, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'token-saver-scripted-unsupported',
      message: 'the token-saver paired-launch adapter is a real-case behavior; a scripted case carrying context.token_saver_control is not the supported W3.23 shape',
      profile: guardAttempt.token_saver_adapter.profile,
    });
    return;
  }

  const launchIntentTimestamp = utcTimestamp();
  const attempt = {
    id: `attempt-${caseState.attempts.length + 1}`,
    case_id: caseRecord.id,
    kind: 'workflow',
    phase: 'launch-intent',
    execution_mode: caseUsesScriptedEnvironment(caseRecord) ? 'scripted' : 'real',
    launch_intent_at: launchIntentTimestamp,
    started_at: launchIntentTimestamp,
    deadline_at: new Date(Date.now() + (caseRecord.caps.wall_min * 60_000)).toISOString(),
    ...retryAttemptMetadata(caseState),
    // US-008 adapter evidence: recorded at attempt creation so EVERY
    // downstream path (dry-run, install failure, launch) persists it.
    ...(sentinel.sentinel ? {
      sentinel_adapter: {
        profile: sentinel.profile,
        workflow_id: sentinel.workflow_id,
        resolution: 'local-sentinel',
        install: { outcome: 'pending' },
      },
    } : {}),
  };
  caseState.phase = 'running';
  caseState.attempts.push(attempt);
  state.updated_at = launchIntentTimestamp;
  atomicWriteState(campaignDir, state);

  // Fixture work-clone provisioning (US-004): for REAL (non-scripted) cases,
  // provision the working clone from the golden BEFORE the launch builds
  // workflowRunArgs, so the path handed to --worktree-origin-repository /
  // --working-directory-for-harness ALWAYS exists (E2.3's ENOENT lstat root
  // cause). This runs on EVERY attempt: provisionWorkClone wipes any prior
  // clone first and clones fresh, so attempt N+1 (retry/rugpull replacement)
  // is a CLEAN re-provision and never inherits a dirtied tree. A provision
  // failure persists TEST_INFRA_FAIL with a precise category/reason
  // (fail-closed); on a healthy host it must never be reached. Breakage is
  // never a silent half-launch.
  //
  // US-005 (S9 controller): a REPLAY attempt is the one exception — it NEVER
  // provisions its own clone (no wipe/re-clone). It reuses the pair's clone
  // resolved above, so the pair's tree persists unchanged into the replay and
  // the origin_repo identity matches the pair's exactly (TSTX origin-scoped
  // contract). The resolved provenance is recorded as attempt evidence.
  if (attempt.execution_mode === 'real') {
    if (replayContext !== null) {
      attempt.fixture_work_clone = replayContext.clonePath;
      attempt.replay_provenance = {
        replay_of: replayOf,
        pair_clone_path: replayContext.clonePath,
        pair_terminal: true,
        pair_terminal_at: replayContext.pairState.terminal_at ?? null,
        pair_outcome: replayContext.pairState.outcome ?? null,
        provision_skipped: true,
      };
    } else {
    const provision = provisionWorkClone({
      fixture: caseRecord.fixture,
      caseId: caseRecord.id,
      seed: caseRecord.seed ?? null,
    });
    if (!provision.ok) {
      attempt.phase = 'terminal';
      attempt.terminal_at = utcTimestamp();
      const reason = provision.reason ?? {};
      persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
        category: reason.category ?? 'fixture-provision-failed',
        message: reason.message ?? 'fixture work-clone provisioning failed before launch',
        ...reason,
      });
      return;
    }
    attempt.fixture_work_clone = provision.workClonePath;
    attempt.fixture_provision_record = {
      fixture: provision.fixture,
      case_id: provision.caseId,
      work_clone_path: provision.workClonePath,
      golden_bare: provision.goldenBare,
      target_kind: provision.target?.kind ?? null,
      seed: provision.target?.seed ?? null,
      arming: provision.arming,
      venv_bootstrapped: provision.venvBootstrapped,
      operator_notes_planted: provision.operatorNotesPlanted,
      junk_verified: provision.junkVerified,
      prepared_at: provision.prepared_at,
    };
    }
  }

  // US-010 (S12 controller): token-saver paired-launch evidence. Pre-declare
  // the pair's launch argvs on the attempt BEFORE any consumer reads them —
  // the dry-run recorder and the oracle snapshot's launch-intent both bind
  // to the FLAGGED run's argv as the primary. The real launch leg fills in
  // run ids, token ledgers, and stub-record counts.
  if (tokenSaverCase) {
    attempt.token_saver = {
      adapter: 'token-saver-paired-launch',
      status: 'pending',
      launches: [
        {
          role: 'flagged',
          argv: ['tamandua', ...workflowRunArgs(caseRecord, attempt.fixture_work_clone, [TOKEN_SAVER_FLAG])],
          flag_present: true,
          stub: { expectation: 'install' },
        },
        {
          role: 'control',
          argv: ['tamandua', ...workflowRunArgs(caseRecord, attempt.fixture_work_clone)],
          flag_present: false,
          stub: { expectation: 'remove' },
        },
      ],
    };
    state.updated_at = utcTimestamp();
    atomicWriteState(campaignDir, state);
  }

  // Zero-token dry-run hook (US-006): when TT_DRY_RUN_REAL_LAUNCH is set,
  // record the exact launch argv the scheduler would pass to `tamandua` for
  // each real (non-scripted) case, then mark it PASS without spawning the
  // model-backed run. Walled off: unset => previous behavior entirely.
  if (attempt.execution_mode === 'real' && dryRunRealLaunchOutPath() !== null) {
    if (tokenSaverCase) {
      // US-010: a token-saver dry run records BOTH launches — the flagged
      // argv carries --no-hurry-please-save-tokens-mode, the control argv
      // does not — and no stub is installed/removed (nothing spawns).
      let outPath = null;
      for (const entry of attempt.token_saver.launches) {
        entry.stub.outcome = 'dry-run-skipped';
        entry.stub.note = 'zero-token dry run — no stub install/remove performed';
        outPath = recordDryRunRealLaunch(caseRecord, entry.argv, attempt.fixture_work_clone, {
          launch_role: entry.role,
          token_saver_case: true,
        });
      }
      attempt.token_saver.status = 'dry-run-complete';
      attempt.phase = 'terminal';
      attempt.terminal_at = utcTimestamp();
      attempt.terminal_status = 'completed';
      attempt.dry_run_launch = true;
      attempt.dry_run_argv = attempt.token_saver.launches.map((entry) => entry.argv);
      attempt.dry_run_argv_path = outPath;
      persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'PASS');
      return;
    }
    const launchArgv = ['tamandua', ...workflowRunArgs(caseRecord, attempt.fixture_work_clone)];
    // US-008: the zero-token dry run never spawns the catalog helper, but the
    // adapter evidence is still recorded so the dry-run argv proof carries
    // the resolved sentinel (workflow_id tt-docs-drift, never `local`).
    if (sentinel.sentinel) {
      attempt.sentinel_adapter.install = {
        outcome: 'dry-run-skipped',
        note: 'zero-token dry run — no catalog install performed; the resolved launch argv names tt-docs-drift',
      };
    }
    // US-007: pass the provisioned clone path so the argv record embeds the
    // E2.3-proof lstat at capture time (existed + dir + size). Provisioning
    // ran as a mandatory stage above, so attempt.fixture_work_clone is set.
    const outPath = recordDryRunRealLaunch(caseRecord, launchArgv, attempt.fixture_work_clone);
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    attempt.terminal_status = 'completed';
    attempt.dry_run_launch = true;
    attempt.dry_run_argv = launchArgv;
    attempt.dry_run_argv_path = outPath;
    persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'PASS');
    return;
  }

  let childEnv;
  try {
    childEnv = loadSpawnEnvironment(attempt.execution_mode === 'scripted');
  } catch (error) {
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'spawn-environment',
      message: error.message,
    });
    return;
  }

  // US-008 (S11 controller): local-sentinel catalog install leg. Re-runs the
  // tt-catalog-install / tt-required-workflows seam under the CONTAINED spawn
  // env so the sentinel launch is self-sufficient (idempotent, stamp-aware —
  // a no-op when the preflight already installed a current catalog). A
  // missing tt-docs-drift spec fails closed with the DISTINCT reason
  // `catalog-missing: tt-docs-drift` — never a `workflow run local` fallback
  // and never a half-launch into an absent workflow spec.
  if (sentinel.sentinel) {
    const installOutcome = runLocalSentinelCatalogInstall(childEnv);
    attempt.sentinel_adapter.install = installOutcome;
    state.updated_at = utcTimestamp();
    atomicWriteState(campaignDir, state);
    if (!installOutcome.ok) {
      attempt.phase = 'terminal';
      attempt.terminal_at = utcTimestamp();
      persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
        category: installOutcome.reason ?? 'catalog-missing',
        message: `local-sentinel adapter could not ensure '${sentinel.workflow_id}' is installed in the contained TT home${installOutcome.stderr_tail !== undefined ? `: ${installOutcome.stderr_tail}` : ''}`,
        sentinel_profile: sentinel.profile,
        install_outcome: installOutcome,
      });
      return;
    }
  }

  if (caseRecord.reset !== null && caseRecord.reset !== undefined) {
    attempt.phase = 'resetting';
    const resetResult = await runHook('reset', caseRecord.reset, childEnv, campaignDir, state, attempt);
    if (!hookSucceeded(resetResult)) {
      attempt.phase = 'terminal';
      attempt.terminal_at = utcTimestamp();
      persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
        category: 'reset-failed',
        exit_code: resetResult.exit_code,
        signal: resetResult.signal,
        error: resetResult.error ?? null,
      });
      return;
    }
  }

  beginCaseOracleSnapshot(caseRecord, caseState, attempt, state, campaignDir, childEnv);

  // O9 special-exit battery (chaos.o9_special_exits): the RESTORED working
  // tree is the evidence the battery produces (tracked-byte restoration and
  // junk-probe removal are verified against it), so teardown must keep the
  // clone for post-campaign inspection instead of pruning it on PASS.
  if (caseRecord.chaos?.o9_special_exits === true) {
    attempt.o9_special_exit_evidence = true;
  }

  // US-010 (S12 controller): the token-saver paired launch replaces the
  // single-launch sequence below for a case with context.token_saver_control.
  // The adapter reuses every mechanic (runHook launch + run-id capture +
  // monitor + discovered-run convergence + terminal harvest) for each of the
  // two runs and persists the pair's evidence + contract finding.
  if (tokenSaverCase) {
    await executeTokenSaverPairedLaunch(caseRecord, caseState, state, campaignDir, attempt, childEnv);
    return;
  }

  attempt.phase = 'running';
  let signalLaunchEnded;
  const launchEndedPromise = new Promise((resolve) => { signalLaunchEnded = resolve; });
  let monitorPromise;
  const captureRunIdentifier = createRunIdentifierCapture(attempt, state, campaignDir, childEnv, () => {
    monitorPromise ??= monitorWorkflowRun(
      caseRecord, caseState, attempt, childEnv, state, campaignDir, launchEndedPromise,
    );
  });
  const launchResult = await runHook('launch', {
    executable: 'tamandua',
    args: workflowRunArgs(caseRecord, attempt.fixture_work_clone),
    cwd: '.',
  }, childEnv, campaignDir, state, attempt, {
    enforceWall: false,
    onChunk: captureRunIdentifier,
  });
  signalLaunchEnded();
  const monitorResult = monitorPromise === undefined ? { stopped: false } : await monitorPromise;
  if (attempt.run_id !== undefined && attempt.run_id_error === undefined) {
    await convergeDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir);
  }
  let terminalEvidence = null;
  if (attempt.run_id !== undefined && attempt.run_id_error === undefined) {
    terminalEvidence = await harvestWorkflowAttempt(
      caseState,
      attempt,
      monitorResult.stopped ? attempt.terminal_wait : launchResult,
      childEnv,
      state,
      campaignDir,
    );
  }
  if (attempt.run_id_error !== undefined || attempt.run_id === undefined) {
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    // US-005: surface a DEFINITE launch infra failure by its actual reason
    // (reading the launch-stderr evidence runHook produced), not the generic
    // missing-run-identifier. Only a genuinely ambiguous case (no captured run
    // id AND no infra signature) keeps the legacy classification.
    const infra = classifyInfraLaunchFailure(readLaunchEvidenceStderr(campaignDir, launchResult));
    persistMechanicalOutcome(caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', {
      category: infra !== null ? infra.category : 'workflow-run-identification',
      ...(infra !== null
        ? { message: infra.message, signature: infra.signature }
        : { error: attempt.run_id_error ?? {
            category: 'missing-run-identifier',
            resolution_errors: attempt.run_id_resolution_errors ?? [],
          } }),
      exit_code: launchResult.exit_code,
      signal: launchResult.signal,
    });
  } else if (monitorResult.stopped) {
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    const baseReason = {
      category: 'runaway-cap-enforced',
      ...monitorResult.breach,
      terminal_status: monitorResult.terminal_status,
    };
    const verdict = outcomeWithOracleEvidence(
      caseRecord, 'INCONCLUSIVE', baseReason,
      runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv),
    );
    persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict);
  } else if (terminalEvidence !== null) {
    attempt.phase = 'terminal';
    attempt.terminal_at = utcTimestamp();
    const passed = canonicalTerminalStatus(terminalEvidence.status) === 'completed';
    const baseReason = passed ? undefined : {
        category: 'workflow-terminal',
        terminal_status: terminalEvidence.status,
        wait_exit_code: attempt.wait_exit_code,
      };
    const oracleResults = runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv);
    let verdict = outcomeWithOracleEvidence(
      caseRecord, passed ? 'PASS' : 'INCONCLUSIVE', baseReason, oracleResults,
    );
    // US-006 (S9 controller): REPLAY cache-HIT gate. The oracle snapshot
    // completed inside runCaseOracles, so the gate reads the terminal
    // snapshot (suite observations for this attempt's run). A cap-enforced
    // branch above never reaches PASS, so it is deliberately not gated.
    verdict = applyReplayCacheHitGate(caseRecord, caseState, attempt, state, campaignDir, verdict, childEnv);
    persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict);
  } else {
    attempt.phase = 'attached';
    attempt.wait_ended_at = utcTimestamp();
    state.updated_at = attempt.wait_ended_at;
    atomicWriteState(campaignDir, state);
  }
}

function delay(milliseconds) {
  if (milliseconds <= 0) return Promise.resolve();
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

function latestLaunchIntentTime(state) {
  let latest = null;
  for (const attempt of state.cases.flatMap((caseState) => caseState.attempts)) {
    if (attempt.launch_intent_at === undefined) continue;
    const timestamp = new Date(attempt.launch_intent_at).valueOf();
    if (latest === null || timestamp > latest) latest = timestamp;
  }
  return latest;
}

function finishRecoveredAttempt(state, caseState, attempt, campaignDir, outcome, reason) {
  attempt.phase = 'terminal';
  attempt.terminal_at = utcTimestamp();
  attempt.recovery = {
    ...(attempt.recovery ?? {}),
    status: 'reconciled',
    finished_at: attempt.terminal_at,
  };
  persistMechanicalOutcome(caseState, attempt, state, campaignDir, outcome, reason);
}

function harvestRecoveredLocalAttempt(caseRecord, state, caseState, attempt, campaignDir, commandResult) {
  const succeeded = hookSucceeded(commandResult);
  const baseOutcome = succeeded
    ? 'PASS'
    : (commandResult.error === undefined ? 'PRODUCT_FAIL' : 'TEST_INFRA_FAIL');
  const baseReason = succeeded ? undefined : {
    category: commandResult.error === undefined ? 'local-command-failed' : 'local-command-launch-failed',
    exit_code: commandResult.exit_code,
    signal: commandResult.signal,
    error: commandResult.error ?? null,
    recovered: true,
  };
  const childEnv = loadSpawnEnvironment(attempt.execution_mode === 'scripted');
  const verdict = outcomeWithOracleEvidence(
    caseRecord, baseOutcome, baseReason,
    runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv),
  );
  attempt.phase = 'terminal';
  attempt.terminal_at = utcTimestamp();
  attempt.recovery = {
    ...(attempt.recovery ?? {}), status: 'reconciled', finished_at: attempt.terminal_at,
  };
  persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict);
}

async function recoverLocalAttempt(caseRecord, state, caseState, attempt, campaignDir) {
  const commandState = attempt.command;
  if (commandState?.result !== undefined) {
    let resultExists = false;
    try {
      resultExists = fs.existsSync(durableResultPath(campaignDir, commandState));
      if (resultExists) {
        applyDurableHookResult(commandState, readDurableHookResult(campaignDir, commandState));
        attempt.recovery = {
          strategy: 'local-result', status: 'harvested', started_at: utcTimestamp(),
        };
        state.updated_at = attempt.recovery.started_at;
        atomicWriteState(campaignDir, state);
        harvestRecoveredLocalAttempt(caseRecord, state, caseState, attempt, campaignDir, commandState);
        return;
      }
    } catch (error) {
      finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
        category: 'invalid-local-result-evidence', message: error.message,
      });
      return;
    }

    if (Number.isSafeInteger(commandState.runner_pid)
        && processMatchesIdentity(commandState.runner_pid, commandState.runner_identity)) {
      attempt.recovery = {
        strategy: 'local-process', status: 'observing', started_at: utcTimestamp(),
        runner_pid: commandState.runner_pid, runner_identity: commandState.runner_identity,
      };
      state.updated_at = attempt.recovery.started_at;
      atomicWriteState(campaignDir, state);
      while (processMatchesIdentity(commandState.runner_pid, commandState.runner_identity)) {
        await delay(50);
        if (fs.existsSync(durableResultPath(campaignDir, commandState))) break;
      }
      try {
        applyDurableHookResult(commandState, readDurableHookResult(campaignDir, commandState));
        harvestRecoveredLocalAttempt(caseRecord, state, caseState, attempt, campaignDir, commandState);
      } catch (error) {
        finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
          category: 'local-process-lost', message: error.message,
          runner_pid: commandState.runner_pid,
        });
      }
      return;
    }
  }

  if (commandState?.finished_at !== null && commandState?.finished_at !== undefined) {
    attempt.recovery = { strategy: 'persisted-hook-state', status: 'harvested', started_at: utcTimestamp() };
    state.updated_at = attempt.recovery.started_at;
    atomicWriteState(campaignDir, state);
    harvestRecoveredLocalAttempt(caseRecord, state, caseState, attempt, campaignDir, commandState);
    return;
  }

  finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
    category: 'unidentified-launch-intent',
    kind: 'local',
    message: 'local launch intent has neither durable result evidence nor a matching live process',
  });
}

async function recoverWorkflowAttempt(caseRecord, state, caseState, attempt, campaignDir) {
  // US-010 (S12 controller): a token-saver paired-launch attempt can never be
  // reattached mid-pair safely (the pair's flagged/control windows and stub
  // toggling are controller-driven state). Fail closed with a distinct
  // reason — rerun the case to re-drive both launches.
  if (attempt.token_saver !== undefined) {
    finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'token-saver-recovery-unsupported',
      kind: 'workflow',
      message: 'the token-saver paired-launch attempt cannot be reattached mid-pair; rerun the case to re-drive both launches',
    });
    return;
  }
  if (typeof attempt.run_id !== 'string') {
    finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'unidentified-launch-intent',
      kind: 'workflow',
      message: 'workflow launch intent has no durable run ID',
    });
    return;
  }

  let childEnv;
  try {
    childEnv = loadSpawnEnvironment(attempt.execution_mode === 'scripted');
  } catch (error) {
    finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'spawn-environment', message: error.message,
    });
    return;
  }

  const recoveryStartedAt = utcTimestamp();
  attempt.recovery = { strategy: 'workflow-wait', status: 'reattaching', started_at: recoveryStartedAt };
  state.updated_at = recoveryStartedAt;
  atomicWriteState(campaignDir, state);
  const waitHookName = `recovery_wait_${state.resume_count}`;
  const waitResult = await runHook(waitHookName, {
    executable: 'tamandua', args: ['workflow', 'wait', attempt.run_id, '--json'], cwd: '.',
  }, childEnv, campaignDir, state, attempt, { enforceWall: false });

  let status;
  try {
    status = await harvestWorkflowAttempt(caseState, attempt, waitResult, childEnv, state, campaignDir);
  } catch (error) {
    finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'workflow-reattachment-failed', message: error.message,
      wait_exit_code: waitResult.exit_code, wait_signal: waitResult.signal,
    });
    return;
  }
  if (status === null || !TERMINAL_RUN_STATUSES.has(status.status)) {
    finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'workflow-wait-nonterminal', terminal_status: status?.status ?? null,
      wait_exit_code: waitResult.exit_code,
    });
    return;
  }
  try {
    await convergeDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir);
  } catch (error) {
    finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'discovered-run-reconciliation-failed', message: error.message,
    });
    return;
  }
  const passed = status.status === 'completed' || status.status === 'done';
  const baseReason = passed ? undefined : {
      category: 'recovered-workflow-terminal', terminal_status: status.status,
      wait_exit_code: waitResult.exit_code,
    };
  let verdict;
  try {
    verdict = outcomeWithOracleEvidence(
      caseRecord, passed ? 'PASS' : 'INCONCLUSIVE', baseReason,
      runCaseOracles(caseRecord, caseState, state, campaignDir, childEnv),
    );
  } catch (error) {
    finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
      category: 'oracle-evidence-snapshot', message: error.message,
    });
    return;
  }
  // US-006 (S9 controller): a resumed replay attempt must clear the same
  // cache-HIT gate as a fresh harvest — recovery can never bypass it.
  verdict = applyReplayCacheHitGate(caseRecord, caseState, attempt, state, campaignDir, verdict, childEnv);
  attempt.phase = 'terminal';
  attempt.terminal_at = utcTimestamp();
  attempt.recovery = {
    ...(attempt.recovery ?? {}), status: 'reconciled', finished_at: attempt.terminal_at,
  };
  persistClassifiedAttempt(caseState, attempt, state, campaignDir, verdict);
}

async function reconcileInterruptedAttempts(manifest, state, campaignDir) {
  for (let index = 0; index < state.cases.length; index += 1) {
    const caseState = state.cases[index];
    if (caseState.phase !== 'running') continue;
    const nonterminalAttempts = caseState.attempts.filter((attempt) => attempt.outcome === undefined);
    if (nonterminalAttempts.length !== 1) {
      const attempt = nonterminalAttempts[0] ?? caseState.attempts.at(-1);
      if (attempt !== undefined) {
        finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
          category: 'ambiguous-attempt-ledger', nonterminal_attempt_count: nonterminalAttempts.length,
        });
      } else {
        markTerminal(state, caseState, campaignDir, 'TEST_INFRA_FAIL', {
          category: 'missing-attempt-ledger',
        });
      }
      continue;
    }
    const attempt = nonterminalAttempts[0];
    if (attempt.kind === 'workflow') {
      await recoverWorkflowAttempt(manifest.cases[index], state, caseState, attempt, campaignDir);
    } else if (attempt.kind === 'local') {
      await recoverLocalAttempt(manifest.cases[index], state, caseState, attempt, campaignDir);
    } else {
      finishRecoveredAttempt(state, caseState, attempt, campaignDir, 'TEST_INFRA_FAIL', {
        category: 'unidentified-launch-intent', kind: attempt.kind ?? null,
      });
    }
  }
}

async function reconcilePersistedDiscoveredRuns(manifest, state, campaignDir) {
  const rootCaseIds = new Set((state.discovered_runs ?? [])
    .filter((run) => run.phase !== 'terminal').map((run) => run.root_case_id));
  for (const rootCaseId of rootCaseIds) {
    const index = state.cases.findIndex((caseState) => caseState.id === rootCaseId);
    if (index < 0) throw new Error(`discovered run refers to missing root case ${rootCaseId}`);
    const caseState = state.cases[index];
    const caseRecord = manifest.cases[index];
    const rootAttempt = caseState.attempts.find((attempt) => attempt.kind === 'workflow');
    if (rootAttempt === undefined) {
      throw new Error(`discovered run root case ${rootCaseId} has no workflow attempt`);
    }
    const childEnv = loadSpawnEnvironment(rootAttempt.execution_mode === 'scripted');
    const persistedActive = state.discovered_runs.filter((run) =>
      run.root_case_id === rootCaseId && run.phase !== 'terminal');
    for (const run of persistedActive) {
      await awaitDiscoveredRun(caseRecord, caseState, run, childEnv, state, campaignDir);
    }
    await convergeDiscoveredRuns(caseRecord, caseState, childEnv, state, campaignDir);
  }
}

async function executeCaseWithProviderRetry(caseRecord, caseState, state, campaignDir) {
  const executeCase = caseRecord.harness === 'local' ? executeLocalCase : executeWorkflowCase;
  while (caseState.phase === 'pending') {
    const retryNotBefore = caseState.provider_retry?.status === 'scheduled'
      ? new Date(caseState.provider_retry.retry_not_before).valueOf()
      : null;
    while (retryNotBefore !== null && Date.now() < retryNotBefore) {
      await delay(retryNotBefore - Date.now());
    }
    await executeCase(caseRecord, caseState, state, campaignDir);
    if (caseState.provider_retry?.status !== 'scheduled') return;
  }
}

async function executeEligibleCases(manifest, state, campaignDir) {
  // Pending work is never started while an interrupted attempt remains
  // unreconciled; resumeCampaign performs reconciliation before scheduling.
  if (state.cases.some((caseState) => caseState.phase === 'running')) return;

  const eligible = [];
  for (let index = 0; index < manifest.cases.length; index += 1) {
    const caseRecord = manifest.cases[index];
    const caseState = state.cases[index];
    if (caseState.phase === 'terminal') continue;
    if (caseRecord.harness === 'local') {
      if (caseState.phase === 'pending') eligible.push({ caseRecord, caseState });
      continue;
    }
    if (!daemonControlAvailable()) {
      markTerminal(state, caseState, campaignDir, 'NOT_RUN', {
        category: 'daemon-control-unavailable',
        executable: toPortableRelativePath(DAEMON_CONTROL_PATH),
      });
    } else if (caseState.phase === 'pending') {
      eligible.push({ caseRecord, caseState });
    }
  }

  const active = new Set();
  for (const item of eligible) {
    if (active.size >= state.options.concurrency) await Promise.race(active);
    const lastLaunchAt = latestLaunchIntentTime(state);
    if (lastLaunchAt !== null) {
      await delay(Math.max(0, state.options.stagger_ms - (Date.now() - lastLaunchAt)));
    }
    let execution;
    execution = executeCaseWithProviderRetry(
      item.caseRecord, item.caseState, state, campaignDir,
    )
      .catch((error) => {
        const attempt = item.caseState.attempts.at(-1);
        if (attempt !== undefined && attempt.terminal_at === undefined) {
          attempt.phase = 'terminal';
          attempt.terminal_at = utcTimestamp();
        }
        if (item.caseState.phase !== 'terminal') {
          // FIX10 US-003: a HOME-containment violation (error.code
          // TT_CONTAINMENT_VIOLATION) is aborted with the precise
          // 'containment-violation' category — never a generic
          // scheduler failure, and never a silent fall-through.
          const reason = {
            category: isContainmentViolation(error) ? 'containment-violation' : 'scheduler-execution-failed',
            message: error.message,
          };
          if (attempt === undefined) {
            markTerminal(state, item.caseState, campaignDir, 'TEST_INFRA_FAIL', reason);
          } else {
            persistMechanicalOutcome(
              item.caseState, attempt, state, campaignDir, 'TEST_INFRA_FAIL', reason,
            );
          }
        }
      })
      .finally(() => active.delete(execution));
    active.add(execution);
  }
  await Promise.all(active);
}

function isUtcTimestamp(value) {
  if (typeof value !== 'string' || !value.endsWith('Z')) return false;
  const date = new Date(value);
  return !Number.isNaN(date.valueOf()) && date.toISOString() === value;
}

function isValidAttemptState(attempt) {
  if (!isObject(attempt)
      || typeof attempt.id !== 'string'
      || typeof attempt.case_id !== 'string'
      || typeof attempt.phase !== 'string'
      || !isUtcTimestamp(attempt.started_at)) return false;
  if (attempt.launch_intent_at !== undefined && !isUtcTimestamp(attempt.launch_intent_at)) return false;
  if (attempt.deadline_at !== undefined && !isUtcTimestamp(attempt.deadline_at)) return false;
  if (attempt.terminal_at !== undefined && !isUtcTimestamp(attempt.terminal_at)) return false;
  for (const hookName of ['reset', 'command', 'launch', 'stop', 'terminal_wait']) {
    const hook = attempt[hookName];
    if (hook === undefined) continue;
    if (!isObject(hook)
        || !Array.isArray(hook.argv) || hook.argv.some((value) => typeof value !== 'string')
        || typeof hook.cwd !== 'string'
        || (hook.intent_at !== undefined && !isUtcTimestamp(hook.intent_at))
        || !isUtcTimestamp(hook.started_at)
        || (hook.finished_at !== null && !isUtcTimestamp(hook.finished_at))
        || (hook.exit_code !== null && !Number.isInteger(hook.exit_code))
        || (hook.signal !== null && typeof hook.signal !== 'string')
        || (hook.pid !== undefined && hook.pid !== null && (!Number.isSafeInteger(hook.pid) || hook.pid <= 0))
        || typeof hook.stdout !== 'string'
        || typeof hook.stderr !== 'string') return false;
  }
  return true;
}

function isValidDiscoveredRun(run) {
  return isValidAttemptState(run)
    && run.kind === 'discovered-workflow'
    && normalizedRunId(run.run_id) === run.run_id
    && normalizedRunId(run.parent_run_id) === run.parent_run_id
    && typeof run.root_case_id === 'string'
    && run.case_id === run.root_case_id
    && isUtcTimestamp(run.discovered_at)
    && Number.isSafeInteger(run.tokens_observed) && run.tokens_observed >= 0
    && Array.isArray(run.token_observations)
    && ['attached', 'terminal'].includes(run.phase)
    && (run.phase !== 'terminal'
      || (isUtcTimestamp(run.terminal_at) && TERMINAL_RUN_STATUSES.has(run.terminal_status)));
}

function isValidCaseState(item) {
  const commonValid = isObject(item)
    && typeof item.id === 'string'
    && Number.isInteger(item.wave) && item.wave >= 0
    && typeof item.workflow === 'string'
    && typeof item.fixture === 'string'
    && ['pi', 'hermes', 'scripted-pi', 'scripted-hermes', 'local'].includes(item.harness)
    && ['verification', 'characterization', 'exploratory'].includes(item.class)
    && (item.production_duration_floor_ms === null
      || (Number.isSafeInteger(item.production_duration_floor_ms) && item.production_duration_floor_ms > 0))
    && typeof item.expected_fast_failure === 'boolean'
    && Array.isArray(item.findings)
    && (item.oracle_results === undefined || (Array.isArray(item.oracle_results)
      && item.oracle_results.every((result) => isObject(result)
        && typeof result.oracle_id === 'string'
        && ['RUNNING', 'VALID', 'ORACLE_MISSING', 'TEST_INFRA'].includes(result.status)
        && isUtcTimestamp(result.started_at)
        && (result.finished_at === undefined || isUtcTimestamp(result.finished_at)))))
    && isObject(item.spend)
    && Number.isSafeInteger(item.spend.tokens_observed) && item.spend.tokens_observed >= 0
    && Array.isArray(item.spend.observations)
    && Array.isArray(item.attempts)
    && item.attempts.every(isValidAttemptState)
    && new Set(item.attempts.map((attempt) => attempt.id)).size === item.attempts.length;
  if (!commonValid) return false;
  if (item.phase === 'pending') {
    return item.outcome === undefined && item.terminal_at === undefined && item.reason === undefined;
  }
  if (item.phase === 'running') {
    return item.outcome === undefined && item.terminal_at === undefined && item.reason === undefined;
  }
  if (item.phase !== 'terminal'
      || !OUTCOMES.includes(item.outcome)
      || !isUtcTimestamp(item.terminal_at)) return false;
  if (item.outcome === 'PASS') {
    return item.reason === undefined || item.reason?.category === 'characterization-observed';
  }
  if (item.reason?.category === 'predicate') {
    return item.outcome === 'NOT_RUN'
      && Array.isArray(item.reason.evidence)
      && item.reason.evidence.length > 0
      && item.reason.evidence.every((entry) => isObject(entry)
        && typeof entry.predicate === 'string'
        && Object.hasOwn(entry, 'expected')
        && Object.hasOwn(entry, 'observed'));
  }
  if (item.outcome === 'NOT_RUN') {
    return ['daemon-control-unavailable', 'pending-real'].includes(item.reason?.category);
  }
  return typeof item.reason?.category === 'string';
}

function validateLoadedState(state, campaignId) {
  const errors = [];
  if (!isObject(state)) return ['state must be a JSON object'];
  if (state.version !== STATE_VERSION) errors.push(`unsupported state version ${displayValue(state.version)}`);
  if (state.campaign_id !== campaignId) errors.push('campaign ID does not match its directory');
  if (!isUtcTimestamp(state.created_at)) errors.push('created_at is not a UTC ISO-8601 timestamp');
  if (!isUtcTimestamp(state.updated_at)) errors.push('updated_at is not a UTC ISO-8601 timestamp');
  if (state.phase !== 'ready') errors.push(`unsupported campaign phase ${displayValue(state.phase)}`);
  if (!isObject(state.options)
      || !Number.isSafeInteger(state.options.concurrency) || state.options.concurrency < 1
      || !Number.isSafeInteger(state.options.stagger_ms) || state.options.stagger_ms < 0
      || !Number.isSafeInteger(state.options.token_poll_interval_ms)
      || state.options.token_poll_interval_ms < 1
      || !Number.isSafeInteger(state.options.cap_check_interval_ms)
      || state.options.cap_check_interval_ms < 1
      || (state.options.execution_selection !== undefined
        && !['all', 'scripted-only'].includes(state.options.execution_selection))
      || (state.options.provider_retry_backoff_ms !== undefined
        && (!Number.isSafeInteger(state.options.provider_retry_backoff_ms)
          || state.options.provider_retry_backoff_ms < 0))) {
    errors.push('campaign options are missing or invalid');
  }
  if (!isObject(state.spend)
      || !Number.isSafeInteger(state.spend.tokens_observed) || state.spend.tokens_observed < 0
      || !Array.isArray(state.spend.observations)) {
    errors.push('campaign spend ledger is missing or invalid');
  }
  if (!isObject(state.manifest)
      || typeof state.manifest.path !== 'string'
      || !/^[a-f0-9]{64}$/.test(state.manifest.sha256 ?? '')
      || !Number.isSafeInteger(state.manifest.case_count)
      || !Array.isArray(state.manifest.case_ids)
      || state.manifest.case_ids.some((id) => typeof id !== 'string')) {
    errors.push('immutable manifest metadata is missing or invalid');
  }
  if (!Array.isArray(state.cases) || state.cases.some((item) => !isValidCaseState(item))) {
    errors.push('case state is missing or invalid');
  }
  if (state.discovered_runs !== undefined
      && (!Array.isArray(state.discovered_runs)
        || state.discovered_runs.some((run) => !isValidDiscoveredRun(run))
        || new Set(state.discovered_runs.map((run) => run.run_id)).size !== state.discovered_runs.length)) {
    errors.push('discovered run ledger is invalid');
  }
  if (isObject(state.manifest)
      && Number.isSafeInteger(state.manifest.case_count)
      && Array.isArray(state.manifest.case_ids)
      && Array.isArray(state.cases)) {
    const caseIds = state.cases.map((item) => item?.id);
    const uniqueCaseIds = new Set(caseIds);
    if (state.cases.length !== state.manifest.case_count
        || uniqueCaseIds.size !== caseIds.length
        || JSON.stringify(caseIds) !== JSON.stringify(state.manifest.case_ids)) {
      errors.push('case ledger does not match immutable manifest metadata');
    }
  }
  if (state.resume_count !== undefined
      && (!Number.isSafeInteger(state.resume_count) || state.resume_count < 0)) {
    errors.push('resume_count is invalid');
  }
  if (state.resumed_at !== undefined
      && (!Array.isArray(state.resumed_at) || state.resumed_at.some((value) => !isUtcTimestamp(value)))) {
    errors.push('resumed_at contains a non-UTC timestamp');
  }
  if (state.hygiene_canary !== undefined
      && (!isObject(state.hygiene_canary)
        || (state.hygiene_canary.home !== null && typeof state.hygiene_canary.home !== 'string')
        || !Array.isArray(state.hygiene_canary.before)
        || !Array.isArray(state.hygiene_canary.diffs)
        || (state.hygiene_canary.armed_at !== undefined && !isUtcTimestamp(state.hygiene_canary.armed_at))
        || (state.hygiene_canary.verified_at !== undefined && !isUtcTimestamp(state.hygiene_canary.verified_at)))) {
    errors.push('hygiene canary state is invalid');
  }
  return errors;
}

function resolveCampaignDirectory(campaignId) {
  ensureResultsRoot();
  const campaignDir = path.join(RESULTS_ROOT, campaignId);
  let details;
  try {
    details = fs.lstatSync(campaignDir);
  } catch (error) {
    throw new Error(`cannot load campaign state for ${campaignId}: ${error.message}`);
  }
  if (!details.isDirectory() || details.isSymbolicLink()) {
    throw new Error(`cannot load campaign state for ${campaignId}: campaign path is not a contained directory`);
  }
  if (!pathIsWithin(fs.realpathSync(RESULTS_ROOT), fs.realpathSync(campaignDir))) {
    throw new Error(`cannot load campaign state for ${campaignId}: campaign path escapes results`);
  }
  return campaignDir;
}

function loadCampaignState(campaignId) {
  const campaignDir = resolveCampaignDirectory(campaignId);
  const statePath = path.join(campaignDir, 'state.json');
  let state;
  try {
    const stateDetails = fs.lstatSync(statePath);
    if (!stateDetails.isFile() || stateDetails.isSymbolicLink()) {
      throw new Error('state.json is not a contained regular file');
    }
    state = JSON.parse(fs.readFileSync(statePath, 'utf8'));
  } catch (error) {
    throw new Error(`cannot load campaign state for ${campaignId}: ${error.message}`);
  }
  const errors = validateLoadedState(state, campaignId);
  if (errors.length > 0) {
    throw new Error(`cannot load campaign state for ${campaignId}: ${errors.join('; ')}`);
  }
  return { campaignDir, state };
}

function createInitialState(campaignId, manifestPath, manifest, options) {
  const timestamp = utcTimestamp();
  return {
    version: STATE_VERSION,
    campaign_id: campaignId,
    phase: 'ready',
    created_at: timestamp,
    updated_at: timestamp,
    resume_count: 0,
    resumed_at: [],
    // E2.5 US-004: populated only when the campaign runs the real-case
    // preflight (real selection, not scripted-only, not dry-run). null
    // otherwise. Records the preflight legs and, at teardown, the daemon-stop
    // outcome so a failure is attributable to a DISTINCT reason (US-004 AC2).
    real_preflight: null,
    options: {
      concurrency: options.concurrency,
      stagger_ms: options.staggerMs,
      token_poll_interval_ms: configuredTokenPollIntervalMs(),
      cap_check_interval_ms: configuredCapCheckIntervalMs(),
      provider_retry_backoff_ms: configuredProviderRetryBackoffMs(),
      execution_selection: options.scriptedOnly ? 'scripted-only' : 'all',
    },
    spend: {
      tokens_observed: 0,
      observations: [],
    },
    discovered_runs: [],
    manifest: {
      path: toPortableRelativePath(manifestPath),
      sha256: sha256(manifest.source),
      case_count: manifest.cases.length,
      case_ids: manifest.cases.map((record) => record.id),
    },
    cases: manifest.cases.map((record) => ({
      id: record.id,
      wave: record.wave,
      workflow: record.workflow,
      fixture: record.fixture,
      harness: record.harness,
      class: record.class,
      // US-005 (S9 controller): replay pairing is persisted on the case state
      // so terminalization teardown can keep a replay PAIR's clone (and every
      // other consumer can resolve the pair relationship without the manifest).
      replay_of: typeof record.context?.replay_of === 'string' && record.context.replay_of !== ''
        ? record.context.replay_of
        : null,
      production_duration_floor_ms: record.production_duration_floor_ms ?? null,
      expected_fast_failure: record.expected_fast_failure ?? false,
      phase: 'pending',
      attempts: [],
      findings: [],
      oracle_results: [],
      spend: {
        tokens_observed: 0,
        observations: [],
      },
    })),
  };
}

function manifestMatchesState(manifestPath, manifest, state) {
  return toPortableRelativePath(manifestPath) === state.manifest.path
    && sha256(manifest.source) === state.manifest.sha256
    && manifest.cases.length === state.manifest.case_count
    && JSON.stringify(manifest.cases.map((record) => record.id)) === JSON.stringify(state.manifest.case_ids)
    && manifest.cases.every((record, index) => {
      const persisted = state.cases[index];
      return persisted.id === record.id
        && persisted.wave === record.wave
        && persisted.workflow === record.workflow
        && persisted.fixture === record.fixture
        && persisted.harness === record.harness
        && persisted.class === record.class
        && persisted.production_duration_floor_ms === (record.production_duration_floor_ms ?? null)
        && persisted.expected_fast_failure === (record.expected_fast_failure ?? false);
    });
}

function executionSelectionStateErrors(manifest, state) {
  const errors = [];
  const policy = state.options.execution_selection ?? 'all';
  for (let index = 0; index < manifest.cases.length; index += 1) {
    const record = manifest.cases[index];
    const caseState = state.cases[index];
    const isReal = !caseUsesScriptedEnvironment(record);
    const isPendingReal = caseState.phase === 'terminal'
      && caseState.outcome === 'NOT_RUN'
      && caseState.reason?.category === 'pending-real';
    const isUnselectedPendingReal = caseState.phase === 'pending'
      && caseState.outcome === undefined
      && caseState.reason === undefined
      && caseState.terminal_at === undefined;

    if (isPendingReal
        && (policy !== 'scripted-only' || !isReal || caseState.attempts.length !== 0)) {
      errors.push(`${caseState.id}: pending-real is inconsistent with campaign policy, case mode, or attempt history`);
    }
    if (policy === 'scripted-only' && isReal
        && !isPendingReal && !(isUnselectedPendingReal && caseState.attempts.length === 0)) {
      errors.push(`${caseState.id}: real case is not safely excluded by scripted-only policy`);
    }
  }
  return errors;
}

// FIX10 US-005: O18-style operator-identity hygiene canary. Before case
// execution the campaign snapshots sha256 hashes of the operator's real
// identity files (~/.gitconfig required; ~/.ssh/config and crontab when
// present) into state.hygiene_canary.before. Once every case is terminal the
// hashes are recomputed and compared; any diff is recorded as a campaign-level
// FINDING (state.hygiene_canary.diffs with HYGIENE_* types) and forces
// verdictExitCode to FINDINGS (exit 1) — never silent. Only hashes are ever
// stored; file contents never leave tt-hygiene-canary.mjs. A resume keeps the
// original before-baseline (the canary covers the whole campaign lifetime); a
// campaign that somehow reaches terminal verify without a baseline fails
// closed with a HYGIENE_CANARY_NOT_ARMED finding rather than a silent pass.
function ensureHygieneCanaryBefore(state) {
  if (state.hygiene_canary !== undefined
      && isObject(state.hygiene_canary)
      && Array.isArray(state.hygiene_canary.before)) {
    return; // already armed — a resumed campaign keeps its original baseline
  }
  const snapshot = snapshotHygieneCanary();
  state.hygiene_canary = {
    home: snapshot.home,
    before: snapshot.files,
    diffs: [],
    armed_at: utcTimestamp(),
  };
  state.updated_at = utcTimestamp();
}

function verifyHygieneCanaryAtTerminal(campaignDir, state) {
  if (state.hygiene_canary === undefined
      || !isObject(state.hygiene_canary)
      || !Array.isArray(state.hygiene_canary.before)) {
    // Fail closed: without a before baseline we cannot prove the operator
    // identity survived the campaign — surface a loud FINDING instead of a
    // silent pass.
    state.hygiene_canary = {
      home: null,
      before: [],
      diffs: [{
        type: 'HYGIENE_CANARY_NOT_ARMED',
        file: '(no before snapshot recorded)',
        before: null,
        after: null,
      }],
    };
  } else {
    const after = snapshotHygieneCanary();
    const result = verifyHygieneCanary(state.hygiene_canary.before, after.files);
    state.hygiene_canary.after = after.files;
    state.hygiene_canary.statuses = result.statuses;
    state.hygiene_canary.diffs = result.diffs;
    state.hygiene_canary.home = after.home;
  }
  state.hygiene_canary.verified_at = utcTimestamp();
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
}

function writeTerminalCampaignReports(campaignDir, state) {
  if (state.cases.some((item) => item.phase !== 'terminal')
      || (state.discovered_runs ?? []).some((run) => run.phase !== 'terminal')) {
    return 0;
  }
  // FIX10 US-005: recompute the operator-identity hashes and compare against
  // the pre-campaign baseline before the reports are built (the verdict and
  // the HYGIENE CANARY section both read state.hygiene_canary).
  verifyHygieneCanaryAtTerminal(campaignDir, state);
  return writeCampaignReports(campaignDir, state).exit_code;
}

// ── E2.5 US-004: real-case campaign preflight wiring ─────────────────────
// Before any real case executes, tt-controller must ensure the CONTAINED real
// TT home is provisioned (US-001), the bundled workflow catalog is installed
// (US-002), and the real TT daemon is up on the 43xx ports (US-003) —
// otherwise a real launch lands in an unprovisioned home and fails with a
// misleading run-identification error. Each leg delegates to its dedicated
// helper under the CONTAINED spawn env and FAILS CLOSED with a DISTINCT
// machine-parseable reason (tt-home-unprovisioned / catalog-missing /
// tt-daemon-down). The daemon is stopped at campaign end (and on resume) for
// hygiene. Scripted-only selections and TT_DRY_RUN_REAL_LAUNCH dry runs never
// require or start the real daemon (US-004 AC4). The operator's ~/.tamandua
// and 33xx daemon are never touched (all helpers run under env/tt-env.sh).
const PREFLIGHT_PROVISION_PATH = process.env.TT_CONTROLLER_PREFLIGHT_PROVISION === undefined
  ? path.join(BIN_DIR, 'tt-provision-home')
  : path.resolve(process.env.TT_CONTROLLER_PREFLIGHT_PROVISION);
const PREFLIGHT_CATALOG_PATH = process.env.TT_CONTROLLER_PREFLIGHT_CATALOG === undefined
  ? path.join(BIN_DIR, 'tt-catalog-install')
  : path.resolve(process.env.TT_CONTROLLER_PREFLIGHT_CATALOG);
const PREFLIGHT_DAEMON_PATH = process.env.TT_CONTROLLER_PREFLIGHT_DAEMON === undefined
  ? path.join(BIN_DIR, 'tt-daemon-up')
  : path.resolve(process.env.TT_CONTROLLER_PREFLIGHT_DAEMON);
const PREFLIGHT_AUTH_PATH = process.env.TT_CONTROLLER_PREFLIGHT_AUTH === undefined
  ? path.join(BIN_DIR, 'tt-harness-auth-probe')
  : path.resolve(process.env.TT_CONTROLLER_PREFLIGHT_AUTH);

// Preflight engages ONLY for a real arm: the selection includes a real
// (non-scripted) case, is not scripted-only, and is not a zero-token dry-run.
// TT_CONTROLLER_PREFLIGHT_DISABLED=1 is an explicit escape hatch for
// unit-style controller regression tests that simulate real launches with a
// stub `tamandua` (tight timing windows, no contained real daemon set up);
// real deployments leave it unset so the preflight runs automatically.
const PREFLIGHT_DISABLED_ENV = 'TT_CONTROLLER_PREFLIGHT_DISABLED';

function realPreflightRequired(manifest, state) {
  if (process.env[PREFLIGHT_DISABLED_ENV] === '1') return false;
  if (dryRunRealLaunchOutPath() !== null) return false;
  if ((state.options.execution_selection ?? 'all') === 'scripted-only') return false;
  return manifest.cases.some((caseRecord) => !caseUsesScriptedEnvironment(caseRecord));
}

// Extract the DISTINCT machine-parseable reason from a helper's stderr.
function readPreflightReason(stderr) {
  const line = (stderr || '').split(/\r?\n/).find((l) => /^REASON:\s*/.test(l));
  return line === undefined ? null : line.replace(/^REASON:\s*/, '').trim();
}

function spawnPreflightLeg(script, args, env) {
  // Every spawn site must pass through the containment choke-point (FIX10
  // US-003 grep-proof). loadSpawnEnvironment already asserts the merged HOME,
  // but the preflight leg re-asserts at its own spawn so a future env-source
  // change cannot bypass containment.
  assertContainedSpawnEnv(env);
  const result = spawnSync('bash', [script, ...args], {
    cwd: TT_ROOT,
    env,
    encoding: 'utf8',
    maxBuffer: 16 * 1024 * 1024,
    timeout: 5 * 60_000,
    shell: false,
  });
  if (result.error !== undefined) {
    return { ok: false, error: result.error.message, stderr: result.stderr ?? '' };
  }
  return { ok: result.status === 0, exit_code: result.status, stdout: result.stdout ?? '', stderr: result.stderr ?? '' };
}

function persistPreflightState(campaignDir, state, preflight) {
  state.real_preflight = preflight;
  state.updated_at = utcTimestamp();
  atomicWriteState(campaignDir, state);
}

// Distinct real-case harnesses required by the CURRENT (filtered) selection.
// Only pi/hermes are probed — scripted and local cases require no harness auth
// (US-006). The controller resolves this from the filtered manifest (not the
// probe's own full-tier enumeration) so a --case focused pi-only selection
// probes pi and never hermes.
function requiredHarnessesFor(manifest) {
  const harnesses = new Set();
  for (const caseRecord of manifest.cases) {
    if (caseUsesScriptedEnvironment(caseRecord)) continue;
    if (caseRecord.harness === 'pi' || caseRecord.harness === 'hermes') {
      harnesses.add(caseRecord.harness);
    }
  }
  return Array.from(harnesses).sort();
}

// Runs the preflight legs in order under the CONTAINED real spawn env.
// On any leg failure it FAILS CLOSED: persists the DISTINCT reason and throws
// so the campaign aborts non-zero (US-004 AC2). Never touches the operator's
// ~/.tamandua or 33xx daemon. The harness-auth leg (US-006) runs only when the
// current selection requires a real pi/hermes harness, and is ordered after
// home-provision (which surfaces credentials) and before catalog/daemon-up.
function runRealPreflight(campaignDir, state, manifest) {
  let env;
  try {
    env = loadSpawnEnvironment(false);
  } catch (error) {
    persistPreflightState(campaignDir, state, {
      engaged: true,
      ok: false,
      leg: 'spawn-environment',
      reason: 'spawn-environment',
      message: error.message,
      stopped_at: null,
    });
    throw new Error(`real-case preflight FAILED at spawn-environment: ${error.message}`);
  }
  const legs = [
    { label: 'home-provision', script: PREFLIGHT_PROVISION_PATH, args: ['--fail-closed'], reason: 'tt-home-unprovisioned' },
  ];
  const requiredHarnesses = requiredHarnessesFor(manifest);
  if (requiredHarnesses.length > 0) {
    legs.push({ label: 'harness-auth', script: PREFLIGHT_AUTH_PATH, args: requiredHarnesses, reason: 'harness-auth-missing' });
  }
  legs.push(
    { label: 'catalog-install', script: PREFLIGHT_CATALOG_PATH, args: [], reason: 'catalog-missing' },
    { label: 'daemon-up', script: PREFLIGHT_DAEMON_PATH, args: ['ensure-up'], reason: 'tt-daemon-down' },
  );
  const outcomes = [];
  for (const leg of legs) {
    const result = spawnPreflightLeg(leg.script, leg.args, env);
    outcomes.push({
      leg: leg.label,
      ok: result.ok,
      exit_code: result.exit_code ?? null,
      ...(result.stderr ? { stderr_tail: result.stderr.trim().slice(-500) } : {}),
    });
    if (!result.ok) {
      const detected = readPreflightReason(result.stderr) ?? leg.reason;
      persistPreflightState(campaignDir, state, {
        engaged: true,
        ok: false,
        leg: leg.label,
        reason: detected,
        message: result.error ?? `preflight ${leg.label} leg exited ${result.exit_code ?? 'non-zero'}`,
        legs: outcomes,
        stopped_at: null,
      });
      throw new Error(`real-case preflight FAILED at ${leg.label}: ${detected}`);
    }
  }
  persistPreflightState(campaignDir, state, { engaged: true, ok: true, legs: outcomes, started_at: utcTimestamp(), stopped_at: null });
  for (const o of outcomes) console.log(`Real-case preflight ${o.leg}: ${o.ok ? 'OK' : 'FAILED'}`);
}

// Campaign-end (and resume) hygiene: stop the contained real daemon so ports
// 43xx are free and no process leaks (US-004 AC3). Delegates to tt-daemon-up
// stop, which is idempotent and fails closed. Best-effort: never throws.
function stopRealDaemon(campaignDir, state) {
  let env;
  try {
    env = loadSpawnEnvironment(false);
  } catch {
    return;
  }
  const result = spawnPreflightLeg(PREFLIGHT_DAEMON_PATH, ['stop'], env);
  if (state) {
    if (!state.real_preflight) state.real_preflight = { engaged: true };
    state.real_preflight.stopped_at = utcTimestamp();
    state.real_preflight.stop_ok = result.ok;
    if (!result.ok) {
      state.real_preflight.stop_message = result.error ?? `daemon stop exited ${result.exit_code ?? 'non-zero'}`;
    }
    state.updated_at = utcTimestamp();
    atomicWriteState(campaignDir, state);
  }
  if (!result.ok) console.error(`Real-case daemon stop hygiene FAILED: ${result.error ?? ''}`);
}

async function startCampaign(options, schema) {
  const manifestPath = resolveManifestPath(options.manifest);
  const manifest = applyCaseFilter(loadManifest(manifestPath, schema), options.caseId);
  const selectedCases = options.scriptedOnly
    ? manifest.cases.filter(caseUsesScriptedEnvironment)
    : manifest.cases;
  const hostProfile = loadRequiredHostProfile(selectedCases);
  const { campaignId, campaignDir } = createCampaignDirectory();
  const releaseCampaignLock = acquireCampaignLock(campaignDir);
  let teardownState = null;
  try {
    try {
      const state = createInitialState(campaignId, manifestPath, manifest, options);
      applyExecutionSelection(manifest, state);
      applyHostRequirements(manifest, state, hostProfile);
      atomicWriteState(campaignDir, state);
    } catch (error) {
      try {
        fs.rmSync(campaignDir, { recursive: true, force: true });
      } catch {
        // Preserve the original state persistence failure.
      }
      throw error;
    }
    const { state } = loadCampaignState(campaignId);
    // FIX10 US-005: arm the operator-identity hygiene canary BEFORE any case
    // execution; a snapshot failure fails the campaign closed (infra error).
    ensureHygieneCanaryBefore(state);
    atomicWriteState(campaignDir, state);
    // E2.5 US-004: run the real-case preflight before executeEligibleCases so
    // real cases never launch into an unprovisioned home. A failing leg aborts
    // the campaign closed with a DISTINCT reason. The daemon is stopped in the
    // finally/teardown path (both on success and on any preflight/exec error).
    if (realPreflightRequired(manifest, state)) {
      teardownState = state;
      runRealPreflight(campaignDir, state, manifest);
    }
    await executeEligibleCases(manifest, state, campaignDir);
    const exitCode = writeTerminalCampaignReports(campaignDir, state);
    console.log(`Validated ${manifest.cases.length} case(s) from ${path.relative(TT_ROOT, manifestPath)}`);
    console.log(`Campaign: ${campaignId}`);
    return exitCode;
  } finally {
    if (teardownState !== null) stopRealDaemon(campaignDir, teardownState);
    releaseCampaignLock();
  }
}

async function resumeCampaign(options, schema) {
  const campaignDir = resolveCampaignDirectory(options.resume);
  const releaseCampaignLock = acquireCampaignLock(campaignDir);
  let teardownState = null;
  try {
    const { state } = loadCampaignState(options.resume);
    const persistedManifestPath = resolveManifestPath(path.join(TT_ROOT, state.manifest.path));
    const manifestPath = options.manifest === null
      ? persistedManifestPath
      : resolveManifestPath(options.manifest);
    const manifest = applyCaseFilter(loadManifest(manifestPath, schema), options.caseId);
    if (!manifestMatchesState(manifestPath, manifest, state)) {
      throw new Error('manifest does not match campaign state');
    }
    const selectionErrors = executionSelectionStateErrors(manifest, state);
    if (selectionErrors.length > 0) {
      throw new Error(`execution selection state is invalid: ${selectionErrors.join('; ')}`);
    }
    if (options.concurrencySpecified && options.concurrency !== state.options.concurrency) {
      throw new Error('concurrency does not match campaign state');
    }
    if (options.staggerSpecified && options.staggerMs !== state.options.stagger_ms) {
      throw new Error('stagger does not match campaign state');
    }
    const persistedSelection = state.options.execution_selection ?? 'all';
    if (options.scriptedOnlySpecified
        && (options.scriptedOnly ? 'scripted-only' : 'all') !== persistedSelection) {
      throw new Error('execution selection does not match campaign state');
    }

    const timestamp = utcTimestamp();
    state.resume_count = (state.resume_count ?? 0) + 1;
    state.resumed_at = [...(state.resumed_at ?? []), timestamp];
    state.updated_at = timestamp;
    applyExecutionSelection(manifest, state);
    atomicWriteState(campaignDir, state);
    state.discovered_runs ??= [];
    // FIX10 US-005: a resumed campaign arms the canary before further case
    // execution when it is not already armed (resume of a pre-US-005 campaign);
    // an already-armed campaign keeps its original baseline. The verify still
    // happens at terminal-report time inside writeTerminalCampaignReports.
    ensureHygieneCanaryBefore(state);
    atomicWriteState(campaignDir, state);
    await reconcileInterruptedAttempts(manifest, state, campaignDir);
    await reconcilePersistedDiscoveredRuns(manifest, state, campaignDir);
    // E2.5 US-004: on resume we verify the real-case preflight again before
    // further real-case execution, and stop the daemon in teardown for hygiene.
    if (realPreflightRequired(manifest, state)) {
      teardownState = state;
      runRealPreflight(campaignDir, state, manifest);
    }
    await executeEligibleCases(manifest, state, campaignDir);
    const exitCode = writeTerminalCampaignReports(campaignDir, state);
    console.log(`Validated ${manifest.cases.length} case(s) from ${path.relative(TT_ROOT, manifestPath)}`);
    console.log(`Resumed campaign: ${state.campaign_id}`);
    console.log(`Campaign: ${state.campaign_id}`);
    return exitCode;
  } finally {
    if (teardownState !== null) stopRealDaemon(campaignDir, teardownState);
    releaseCampaignLock();
  }
}

async function main() {
  let options;
  try {
    options = parseArgs(process.argv.slice(2));
  } catch (error) {
    console.error(`tt-controller: ${error.message}`);
    usage();
    return 4;
  }

  if (options.help) {
    usage();
    return 0;
  }

  try {
    const schema = loadSchema();
    if (options.validateOnly) {
      const manifestPath = resolveManifestPath(options.manifest);
      const manifest = applyCaseFilter(loadManifest(manifestPath, schema), options.caseId);
      console.log(`Validated ${manifest.cases.length} case(s) from ${path.relative(TT_ROOT, manifestPath)}`);
      return 0;
    }
    if (options.resume === null) return await startCampaign(options, schema);
    return await resumeCampaign(options, schema);
  } catch (error) {
    console.error(`tt-controller: ${error.message}`);
    return 2;
  }
}

process.exitCode = await main();
