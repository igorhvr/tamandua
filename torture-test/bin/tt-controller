const ORACLE_CONTRACT_VERSION = 1;
const STATE_VERSION = 1;
const DEFAULT_CONCURRENCY = 1;
const DEFAULT_STAGGER_MS = 0;
const DEFAULT_TOKEN_POLL_INTERVAL_MS = 5 * 60_000;
// S16 (US-003): bounded status-query retry budget. A degraded contained
// daemon or a skew (stale dist / unmigrated DB — campaign #8) must never
// crash the controller with a raw SyntaxError: queryWorkflowStatus retries a
// bounded number of times with a short backoff, then throws a structured
// WorkflowStatusQueryError that consumers record as evidence and fail the
// CASE closed (never the controller process).
const STATUS_QUERY_MAX_ATTEMPTS = 3;
const STATUS_QUERY_RETRY_BACKOFF_MS = 500;
// Bounded raw-evidence budget captured on a structured status-query failure
// (the LAST 4 KiB of stdout/stderr), so evidence stays bounded on noisy output.
const STATUS_QUERY_RAW_EVIDENCE_BYTES = 4 * 1024;
const DEFAULT_CAP_CHECK_INTERVAL_MS = 15_000;
const DEFAULT_PROVIDER_RETRY_BACKOFF_MS = 60_000;
// US-005: independent deadline-expiry sweep cadence. A case whose attempt
// deadline_at expired is terminally recorded (TEST_INFRA_FAIL
// 'deadline-expired') by a sweep that runs on ITS OWN cadence, decoupled from
// any per-case monitor's status-poll health — so a degraded monitor or a
// crashed controller mid-campaign can never leave a case phase=running past
// its deadline (campaign #8 attempt-2: W1.L3-python left phase=running 3.5h
// past its 20-min deadline). Tests drive it with a tiny env interval.
const DEFAULT_DEADLINE_SWEEP_INTERVAL_MS = 30_000;
const EVIDENCE_LIMIT_BYTES = 16 * 1024 * 1024;
const TERMINAL_RUN_STATUSES = new Set(['completed', 'done', 'failed', 'canceled']);
// E3.C US-005: fail-closed semantic probe_sequence contract. PROBE_OPS mirrors
// the case.schema.json probeAction op enum and PROBE_WHEN_PATTERN mirrors its
// `when` phase-marker pattern. The semantic validator (validateProbeSequence)
// is defense-in-depth BELOW the JSON schema: the schema already rejects unknown
// ops / malformed whens / empty actions, while the semantic layer catches the
// violations the schema cannot express (pause without hold_seconds,
// non-contiguous run ordinals, probe_sequence on local-command cases) and
// re-checks the schema-level rules so a future schema relaxation can never
// silently degrade a malformed probe declaration into the old
// launch->wait->snapshot behavior (campaign #7 S3/S4).
const PROBE_OPS = new Set([
  'pause', 'pause_drain', 'resume', 'cancel', 'fail_force', 'restart_daemon', 'sigstop_sigcont',
]);
const PROBE_WHEN_PATTERN = /^(now|step:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+|event:[A-Za-z0-9._-]+)$/;
// S18b (US-003): the probe trigger vocabulary gains AWAITED object triggers —
// {"status":S,"timeout_s":T} (await the contained run status) and
// {"event":E,"timeout_s":T} (await an event type in the contained event
// stream). Defense-in-depth BELOW the schema: a valid object `when` is a plain
// object with timeout_s > 0 and exactly ONE of status (nonempty string) /
// event (nonempty string); both-at-once, neither, unknown keys, or a
// non-positive timeout are all invalid (the distinct 'missing or invalid when'
// reason keeps its shape). String `when`s must still match PROBE_WHEN_PATTERN.
function probeWhenValid(when) {
  if (typeof when === 'string') return PROBE_WHEN_PATTERN.test(when);
  if (!isObject(when)) return false;
  if (!(typeof when.timeout_s === 'number' && Number.isFinite(when.timeout_s) && when.timeout_s > 0)) return false;
  const hasStatus = typeof when.status === 'string' && when.status.length > 0;
  const hasEvent = typeof when.event === 'string' && when.event.length > 0;
  if (hasStatus === hasEvent) return false;
  return Object.keys(when).every((key) => key === 'status' || key === 'event' || key === 'timeout_s');
}
// Hold-capable probe ops that REQUIRE hold_seconds > 0. pause_drain is
// deliberately excluded: drain is self-terminating (the in-flight run finishes,
// then dispatch parks), so W3.19's pause_drain carries no hold_seconds.
// sigstop_sigcont requires it because bin/tt-chaos (US-004) refuses a missing
// --hold-seconds — a manifest declaring it without a hold would always fail at
// execution time, so it fails closed at validation instead.
const PROBE_HOLD_REQUIRED_OPS = new Set(['pause', 'sigstop_sigcont']);
// E3.C US-006: probe execution engine tuning. PROBE_POLL_INTERVAL_MS is the
// phase-marker polling cadence (mirrors tt-chaos's POLL_INTERVAL_MS);
// PROBE_EVENTS_EXCERPT_MAX / _MAX_BYTES bound the observed-effect event-stream
// excerpt so attempt evidence stays bounded on busy contained instances.
// PROBE_OUTPUT_TAIL_MAX_BYTES bounds the per-action stdout/stderr capture
// (8KB each) so a chatty CLI can never blow up the evidence, while the
// truncated tails still carry the CLI's real refusal messages for diagnosis.
const PROBE_POLL_INTERVAL_MS = 500;
const PROBE_EVENTS_EXCERPT_MAX = 200;
const PROBE_EVENTS_EXCERPT_MAX_BYTES = 256 * 1024;
const PROBE_OUTPUT_TAIL_MAX_BYTES = 8 * 1024;
// E3.C US-007: multi-launch probe orchestration. PROBE_DISPATCH_INTERVAL_MS
// mirrors the product scheduler's DISPATCH_INTERVAL_MS (15s) — the recovery
// window O16 judges from a restart_daemon probe is
// expect.recovery_within_dispatch_intervals * this constant.
const PROBE_DISPATCH_INTERVAL_MS = 15_000;
// Zero-token dry-run hook for the real-launch path (US-006): when
// TT_DRY_RUN_REAL_LAUNCH is set, the controller records the full launch argv
// it WOULD hand to `tamandua` for each real (pi/hermes/dsh) case and marks the
// case PASS without ever spawning the model-backed tamandua run. The variable's
// value is the JSONL file to append records to (empty => default under var/).
// Unset => exact prior behavior (no behavioral change).
const DRY_RUN_REAL_LAUNCH_ENV = 'TT_DRY_RUN_REAL_LAUNCH';
const DEFAULT_DRY_RUN_ARGV_PATH = path.join(VAR_ROOT, 'dry-run', 'launch-argv.jsonl');

function dryRunRealLaunchOutPath() {
  const value = process.env[DRY_RUN_REAL_LAUNCH_ENV];
  if (value === undefined) return null;
  return value === '' ? DEFAULT_DRY_RUN_ARGV_PATH : path.resolve(value);
}

// Record the launch argv a real case WOULD hand to `tamandua`. This hook is a
// proof, not just a stub: E2.3's argv-recording stub never lstats the path, so
// it could not surface the ENOENT lstat every real launch hit. To close that
// blind spot (US-007), this hook lstats the PROVISIONED work clone at
// argv-capture time and embeds the existence evidence in-band (work_clone).
// A real case has already run the mandatory provisioning stage, so on a
// healthy host the clone MUST exist here; if it does not, the record carries
// existed:false + the lstat error, surfacing E2.3's ENOENT even in the
// zero-token proof. Evidence is recorded (never swallowed) so downstream
// tests/consumers can assert the clone physically existed when the argv was
// captured.
function recordDryRunRealLaunch(caseRecord, argv, workClonePath, extraFields = {}) {
  const outPath = dryRunRealLaunchOutPath();
  if (outPath === null) return null;
  fs.mkdirSync(path.dirname(outPath), { recursive: true, mode: 0o700 });
  let cloneStat = null;
  let lstatError = null;
  if (typeof workClonePath === 'string' && workClonePath !== '') {
    try {
      const st = fs.lstatSync(workClonePath);
      cloneStat = { exists: true, is_directory: st.isDirectory(), size: st.size };
    } catch (error) {
      lstatError = error.message;
    }
  } else {
    lstatError = 'work-clone-path-not-provided';
  }
  const record = {
    recorded_at: utcTimestamp(),
    case_id: caseRecord.id,
    harness: caseRecord.harness,
    workflow: caseRecord.workflow,
    // US-008: for the W2.24 local sentinel the MANIFEST workflow stays `local`
    // but the constructed argv names tt-docs-drift — record the resolved id
    // so consumers can bind argv to the adapter resolution (null = the
    // manifest workflow id was used verbatim).
    resolved_workflow: resolveLocalSentinel(caseRecord).sentinel
      ? LOCAL_SENTINEL_WORKFLOW_ID
      : null,
    fixture: caseRecord.fixture,
    task: caseRecord.task,
    executable: 'tamandua',
    argv,
    // US-010 (S12 controller): token-saver paired-launch records carry
    // launch_role ('flagged' | 'control') + the token_saver_case marker so
    // consumers can bind each of the two recorded argvs to its role. Other
    // cases never carry these fields.
    ...extraFields,
    work_clone: {
      path: workClonePath ?? null,
      existed: cloneStat !== null,
      is_directory: cloneStat === null ? null : cloneStat.is_directory,
      size: cloneStat === null ? null : cloneStat.size,
      lstat_error: lstatError,
    },
  };
  fs.appendFileSync(outPath, `${JSON.stringify(record)}\n`, { mode: 0o600 });
  return outPath;
}

function resolveOraclesRoot() {
  const override = process.env.TT_CONTROLLER_SELF_TEST_ORACLES_ROOT;
  if (override === undefined) return DEFAULT_ORACLES_ROOT;
  if (process.env.TT_CONTROLLER_SELF_TEST !== '1') {
    throw new Error('TT_CONTROLLER_SELF_TEST_ORACLES_ROOT requires TT_CONTROLLER_SELF_TEST=1');
  }
  const candidate = path.resolve(override);
  const details = fs.lstatSync(candidate);
  const realVarRoot = fs.realpathSync(VAR_ROOT);
  const realCandidate = fs.realpathSync(candidate);
  if (!details.isDirectory() || details.isSymbolicLink() || !pathIsWithin(realVarRoot, realCandidate)) {
    throw new Error('self-test oracle root must be a contained regular directory beneath torture-test/var');
  }
  return realCandidate;
}

