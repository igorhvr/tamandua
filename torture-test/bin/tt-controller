const O9_TARGETED_PROBES_PATH = process.env.TT_CONTROLLER_O9_PROBES_PATH === undefined
  ? path.join(TT_ROOT, 'bin', 'o9-targeted-probes.mjs')
  : path.resolve(process.env.TT_CONTROLLER_O9_PROBES_PATH);
