// (path.join(input.ttRoot, 'var', 'chaos', 'chaos.log')).
const TT_CHAOS_PATH = process.env.TT_CONTROLLER_TT_CHAOS_PATH === undefined
  ? path.join(TT_ROOT, 'bin', 'tt-chaos')
