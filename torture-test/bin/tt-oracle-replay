#!/usr/bin/env node
// tt-oracle-replay — zero-token offline evidence-replay delta reporter (E3.B US-010).
//
// Re-runs every oracle of a campaign against the campaign's KEPT evidence in a
// copy-on-replay workspace and prints a before/after verdict delta table.
//
//   - Walks <campaign>/evidence/<case>/attempt-*/oracles/<oracle>/ and collects
//     every (context.json, stdout.json) pair.
//   - The source campaign is STRICTLY READ-ONLY: a sha256 digest of every file
//     is computed before the replay and re-verified after. Any modification of
//     the source campaign is a hard failure (exit 1).
//   - Each case bundle is copied into a fresh session workspace under
//     torture-test/var/tt-oracle-replay (gitignored): state.json + snapshots/
//     are copied verbatim (file modes preserved, so the database snapshot stays
//     read-only as the oracle contract requires), and every oracle gets a FRESH
//     evidence directory containing only its context.json — oracles write their
//     evidence exclusively (O_EXCL), so stale artifacts must never be copied.
//   - The oracle is re-invoked exactly as the controller would:
//       oracles/<id> --contract-version 1 --context <workspace-context>
//     with TT_* env and cwd = the workspace evidence dir. The response is
//     validated with the oracle output contract (PASS/FAIL/ERROR/NOT_EVALUABLE
//     bound to exit codes 0/1/2/3).
//   - Deterministic ordering (case, attempt, oracle — byte-wise ascending);
//     zero tokens; no daemon contact; replay workspaces are removed on exit
//     unless --keep-workspaces is given.
//   - --verify-invariants (E3.B US-011) pins the campaign-#7 honest-verdict
//     invariants on top of the replay: CNEV O1_TERMINAL_EVENT_MISSING and
//     O8 seeded failures must behave per the named pins, RUNAWAY cases
//     must keep an honest FAIL backing (cases with no oracle evidence are
//     noted as skipped), and the ONLY flips allowed are the scoped artifact
//     classes (S5 O1_DURATION_FLOOR_* disappearing, S6 O11 loop findings,
//     S7 O8 boundary findings on W3.17a/b, S13 O2/O9/O10
//     ERROR->NOT_EVALUABLE + the W1.REPLAY-ts O9 foreign-row finding,
//     S19 O8_SEEDED_TEST_CHANGED replaced by the informational
//     O8_SEEDED_TEST_EXTENDED on an additive seeded-test delta, S20
//     O2_REF_TRANSITION_COUNT on O2, S21 O9_LEDGER_TREE_UNRESOLVED on O9,
//     S26 O10 reconciliation-ERROR flips to their true verdict + O9
//     O9_REPLAY_ROW_MISSING heals, and S23 O1_DURATION_FLOOR_* APPEARING
//     on a stored PASS). Any honest verdict flip fails the replay loudly.
//   - --verify-s26-invariants (S26 US-005) pins the S26 replay contract on
//     top of the replay: the ONLY allowed flips are (a) a stored O10
//     ORACLE_RUNTIME_ERROR carrying the 'suite_ledger does not reconcile
//     byte-for-field' summary replaying to its TRUE verdict
//     (PASS/FAIL/NOT_EVALUABLE — the US-002 scoped-reconciliation heal) and
//     (b) an O9 FAIL -> PASS heal whose every stored finding is an
//     O9_REPLAY_ROW_MISSING / O9_SINGLEFLIGHT_* false positive from the
//     US-003 row-resolution alignment. Every O10 reconciliation-ERROR row
//     MUST heal (a stored reconciliation ERROR that still replays ERROR is
//     the red arm), and any OTHER flip — including any O10 non-reconciliation
//     ERROR flip or any non-O10 change — violates the pin and exits 1.
//   - --verify-s27-invariants (S27 US-006) pins the S27 replay contract on
//     top of the replay: the S26 classes plus the new S27 class (an O10
//     stored FAIL -> PASS whose every stored finding is a calibration class —
//     O10_EVENT_SET_MISMATCH and/or O10_REROUTE_COUNT — the real-cell
//     two-regime heal, W4.01's class). On the attempt-2 campaign the exact
//     post-S27 delta shape is enforced: the 21 documented calibration cases
//     replay O10 PASS, the O10 FAIL survivors (W4.17-b / W4.18 / W4.dsh-fdmw)
//     keep their genuine findings, W4.29 stays O10 ERROR, non-O10 flips are
//     EXACTLY the 2 S26 O9 heals, and every other non-O10 row is byte-
//     identical. Every stored O10 reconciliation ERROR must still heal (S26
//     red arm), and any flip outside the classes — including an O10 survivor
//     losing a genuine finding (silent absorption) — exits 1.
//
// Exit codes:
//   0  replay completed: every pair attempted and recorded (and, under
//      --verify-invariants / --verify-s26-invariants / --verify-s27-invariants,
//      every pinned invariant held)
//   1  usage error, campaign missing/empty, source campaign modified during
//      replay, no pair could be invoked at all, or an E3.B / S26 / S27
//      invariant violation under the corresponding --verify-* flag

import { createHash } from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath, pathToFileURL } from 'node:url';

import { validateOracleResponse } from '../oracles/lib/output.mjs';

const TT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const ORACLES_ROOT = path.join(TT_ROOT, 'oracles');
const DEFAULT_WORKSPACE_ROOT = path.join(TT_ROOT, 'var', 'tt-oracle-replay');
const AUTO_DETECT_PREFIX = 'campaign-20260813T123604986Z-';
const ORACLE_TIMEOUT_MS = 120_000;
const MAX_BUFFER = 16 * 1024 * 1024;
const VALID_RESULTS = new Set(['PASS', 'FAIL', 'ERROR', 'NOT_EVALUABLE']);
const REPLAY_ERROR_FINDING = 'ORACLE_REPLAY_INVOKE_ERROR';
const INVALID_RESPONSE_FINDING = 'ORACLE_REPLAY_INVALID_RESPONSE';

export function usage() {
  return `usage: tt-oracle-replay [options]

Offline evidence replay: re-runs every oracle of a campaign against its kept
evidence in copy-on-replay workspaces and prints a before/after delta table.

options:
  --campaign <dir>         campaign results directory to replay (contains
                           state.json + evidence/<case>/attempt-*/oracles/<id>/)
  --workspace-root <dir>   base dir for replay workspaces (default:
                           torture-test/var/tt-oracle-replay; must be absolute)
  --json <path>            also write the machine-readable row list + summary
  --keep-workspaces        do not remove the replay workspace after the run
  --verify-invariants      pin the E3.B honest-verdict invariants on the
                           replay (CNEV/O8-seeded pins hold; only
                           S5/S6/S7/S13/S19/S20/S21/S23/S26 artifact
                           classes may flip) and exit 1 when any pinned
                           invariant is violated
  --verify-s26-invariants  pin the S26 replay contract on the replay (the
                           ONLY flips allowed are O10 reconciliation-ERROR
                           -> true verdict and O9 replay-row heals; every
                           stored O10 reconciliation ERROR must heal) and
                           exit 1 when any pinned invariant is violated
  --verify-s27-invariants  pin the S27 replay contract on the replay (the
                           S26 classes plus the S27 class: an O10 stored
                           FAIL -> PASS whose every stored finding is a
                           calibration class — O10_EVENT_SET_MISMATCH and/or
                           O10_REROUTE_COUNT); on the attempt-2 campaign the
                           exact post-S27 delta shape is enforced (21 O10
                           calibration PASS, the W4.17-b / W4.18 / W4.dsh-fdmw
                           FAIL survivors with their genuine findings, W4.29
                           ERROR unchanged, non-O10 byte-identical except the
                           2 S26 O9 heals) and exit 1 when any pinned
                           invariant is violated
  -h, --help               show this help

Campaign selection: --campaign wins, then TT_REPLAY_CAMPAIGN_DIR, then
auto-detection of campaign-20260813T123604986Z-* under torture-test/var/results
(exactly one match required).

Exit codes: 0 = replay completed (and, under --verify-invariants /
--verify-s26-invariants / --verify-s27-invariants, every pinned invariant
held); 1 = usage error, no pairs, source campaign modified during replay, no
pair could be invoked, or an E3.B / S26 / S27 invariant violation under the
corresponding --verify-* flag.`;
}

export function parseArgs(argv) {
  const options = {
    campaign: null, workspaceRoot: DEFAULT_WORKSPACE_ROOT, jsonPath: null,
    keepWorkspaces: false, verifyInvariants: false, verifyS26Invariants: false, verifyS27Invariants: false,
  };
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === '-h' || argument === '--help') return { ...options, help: true };
    if (argument === '--keep-workspaces') {
      options.keepWorkspaces = true;
      continue;
    }
    if (argument === '--verify-invariants') {
      options.verifyInvariants = true;
      continue;
    }
    if (argument === '--verify-s26-invariants') {
      options.verifyS26Invariants = true;
      continue;
    }
    if (argument === '--verify-s27-invariants') {
      options.verifyS27Invariants = true;
      continue;
    }
    if (!['--campaign', '--workspace-root', '--json'].includes(argument) || index + 1 >= argv.length) {
      throw new Error(`invalid argument: ${argument} (run with --help for usage)`);
    }
    const value = argv[++index];
    if (argument === '--campaign') options.campaign = path.resolve(value);
    else if (argument === '--workspace-root') options.workspaceRoot = path.resolve(value);
    else if (argument === '--json') options.jsonPath = path.resolve(value);
  }
  if (options.workspaceRoot === TT_ROOT || options.workspaceRoot === path.dirname(TT_ROOT)
      || options.workspaceRoot === '/') {
    throw new Error('--workspace-root must be a dedicated replay directory, not a source tree root');
  }
  return options;
}

export function sha256Content(content) {
  return createHash('sha256').update(content).digest('hex');
}

// Returns a sorted list of { key, sha256 } for every regular file beneath the
// campaign (posix-relative keys). Directories and symlinks are not hashed.
export function computeCampaignDigest(campaignDir) {
  const entries = [];
  const walk = (directory) => {
    for (const entry of fs.readdirSync(directory, { withFileTypes: true }).sort((left, right) => left.name.localeCompare(right.name))) {
      const candidate = path.join(directory, entry.name);
      if (entry.isDirectory()) walk(candidate);
      else if (entry.isFile()) {
        entries.push({ key: path.relative(campaignDir, candidate).split(path.sep).join('/'), sha256: sha256Content(fs.readFileSync(candidate)) });
      }
    }
  };
  walk(campaignDir);
  return entries.sort((left, right) => left.key.localeCompare(right.key));
}

// Compares a fresh digest against the pre-replay one; returns the keys that
// changed (added, removed, or different content).
export function verifyCampaignUnchanged(before, campaignDir) {
  const after = computeCampaignDigest(campaignDir);
  const afterByKey = new Map(after.map((entry) => [entry.key, entry.sha256]));
  const changed = [];
  for (const entry of before) {
    if (afterByKey.get(entry.key) !== entry.sha256) changed.push(entry.key);
  }
  const beforeKeys = new Set(before.map((entry) => entry.key));
  for (const entry of after) {
    if (!beforeKeys.has(entry.key)) changed.push(entry.key);
  }
  return changed.sort((left, right) => left.localeCompare(right));
}

export function autoDetectCampaign(resultsRoot) {
  let matches = [];
  try {
    matches = fs.readdirSync(resultsRoot, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && entry.name.startsWith(AUTO_DETECT_PREFIX))
      .map((entry) => path.join(resultsRoot, entry.name))
      .sort((left, right) => left.localeCompare(right));
  } catch {
    matches = [];
  }
  if (matches.length === 1) return matches[0];
  if (matches.length === 0) {
    throw new Error(`no ${AUTO_DETECT_PREFIX}* campaign found under ${resultsRoot}; pass --campaign or set TT_REPLAY_CAMPAIGN_DIR`);
  }
  throw new Error(`multiple ${AUTO_DETECT_PREFIX}* campaigns under ${resultsRoot}; pass --campaign explicitly: ${matches.join(', ')}`);
}

export function resolveCampaignDir(options, env = process.env) {
  const candidate = options.campaign ?? env.TT_REPLAY_CAMPAIGN_DIR ?? null;
  if (candidate !== null) {
    const resolved = path.resolve(candidate);
    let details;
    try {
      details = fs.lstatSync(resolved);
    } catch (error) {
      throw new Error(`campaign directory is not accessible: ${resolved} (${error.code ?? error.message})`);
    }
    if (!details.isDirectory()) throw new Error(`campaign is not a directory: ${resolved}`);
    if (!fs.existsSync(path.join(resolved, 'state.json'))) {
      throw new Error(`campaign directory has no state.json marker: ${resolved}`);
    }
    return resolved;
  }
  return autoDetectCampaign(path.join(TT_ROOT, 'var', 'results'));
}

// Collects every replayable (case, attempt, oracle) pair, deterministically
// ordered. A pair is replayable when its oracle dir holds context.json AND
// stdout.json as regular files.
export function collectReplayPairs(campaignDir) {
  const evidenceRoot = path.join(campaignDir, 'evidence');
  const pairs = [];
  let caseIds = [];
  try {
    caseIds = fs.readdirSync(evidenceRoot, { withFileTypes: true })
      .filter((entry) => entry.isDirectory())
      .map((entry) => entry.name)
      .sort((left, right) => left.localeCompare(right));
  } catch {
    caseIds = [];
  }
  for (const caseId of caseIds) {
    const caseDir = path.join(evidenceRoot, caseId);
    const attempts = fs.readdirSync(caseDir, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && entry.name.startsWith('attempt-'))
      .map((entry) => entry.name)
      .sort((left, right) => left.localeCompare(right));
    for (const attempt of attempts) {
      const oraclesDir = path.join(caseDir, attempt, 'oracles');
      let oracleIds = [];
      try {
        oracleIds = fs.readdirSync(oraclesDir, { withFileTypes: true })
          .filter((entry) => entry.isDirectory())
          .map((entry) => entry.name)
          .sort((left, right) => left.localeCompare(right));
      } catch {
        oracleIds = [];
      }
      for (const oracle of oracleIds) {
        const oracleDir = path.join(oraclesDir, oracle);
        const contextPath = path.join(oracleDir, 'context.json');
        const stdoutPath = path.join(oracleDir, 'stdout.json');
        let hasContext = false;
        let hasStdout = false;
        try {
          hasContext = fs.lstatSync(contextPath).isFile();
          hasStdout = fs.lstatSync(stdoutPath).isFile();
        } catch {
          hasContext = false;
          hasStdout = false;
        }
        if (hasContext && hasStdout) {
          pairs.push({ caseId, attempt, oracle, contextPath, stdoutPath });
        }
      }
    }
  }
  return pairs;
}

export function readStoredVerdict(stdoutPath) {
  try {
    const stored = JSON.parse(fs.readFileSync(stdoutPath, 'utf8'));
    const result = stored?.result;
    if (typeof result === 'string' && VALID_RESULTS.has(result)) return result;
    return 'UNKNOWN';
  } catch {
    return 'UNKNOWN';
  }
}

// Returns the full finding objects (id + summary) recorded in the stored
// stdout.json (the BEFORE findings of a replay pair). Unparsable or
// finding-less files yield [] and non-string finding ids are normalized to
// UNKNOWN_FINDING so invariant classification can never silently drop a
// finding. The summaries let the S26 pin distinguish the O10
// suite-ledger reconciliation ERROR from other O10 ORACLE_RUNTIME_ERRORs.
export function readStoredFindingObjects(stdoutPath) {
  try {
    const stored = JSON.parse(fs.readFileSync(stdoutPath, 'utf8'));
    if (!Array.isArray(stored?.findings)) return [];
    return stored.findings.map((finding) => ({
      id: typeof finding?.id === 'string' ? finding.id : 'UNKNOWN_FINDING',
      summary: typeof finding?.summary === 'string' ? finding.summary : '',
    }));
  } catch {
    return [];
  }
}

// Returns the finding ids recorded in the stored stdout.json (the BEFORE
// findings of a replay pair).
export function readStoredFindings(stdoutPath) {
  return readStoredFindingObjects(stdoutPath).map((finding) => finding.id);
}

function readContext(contextPath) {
  let context;
  try {
    context = JSON.parse(fs.readFileSync(contextPath, 'utf8'));
  } catch (error) {
    throw new Error(`cannot parse context ${contextPath}: ${error.message}`);
  }
  if (typeof context?.oracle_id !== 'string' || context.oracle_id.length === 0
      || typeof context?.case?.id !== 'string' || context.case.id.length === 0
      || typeof context?.campaign?.id !== 'string' || context.campaign.id.length === 0) {
    throw new Error(`context ${contextPath} lacks oracle_id/case.id/campaign.id`);
  }
  return context;
}

// Invokes one oracle exactly as the controller would. Returns
// { verdict, findings, invokeError } where invokeError is null when the oracle
// process ran and produced a contract-valid response.
export function invokeOracle({ oracleId, oraclePath, contextPath, evidenceDir, context, timeoutMs }) {
  const env = {
    ...process.env,
    TT_ORACLE_CONTRACT_VERSION: '1',
    TT_ORACLE_ID: oracleId,
    TT_ORACLE_CONTEXT: contextPath,
    TT_ORACLE_EVIDENCE_DIR: evidenceDir,
    TT_CASE_ID: context.case.id,
    TT_CAMPAIGN_ID: context.campaign.id,
  };
  if (context.run_id !== null && context.run_id !== undefined) env.TT_RUN_ID = context.run_id;
  else delete env.TT_RUN_ID;
  const result = spawnSync(oraclePath, ['--contract-version', '1', '--context', contextPath], {
    cwd: evidenceDir,
    env,
    encoding: 'utf8',
    shell: false,
    timeout: timeoutMs,
    maxBuffer: MAX_BUFFER,
  });
  if (result.error !== undefined || result.signal !== null) {
    return {
      verdict: 'ERROR',
      findings: [{ id: REPLAY_ERROR_FINDING, summary: `oracle invocation failed: ${result.error?.message ?? `terminated by ${result.signal}`}` }],
      invokeError: result.error?.message ?? `signal ${result.signal}`,
    };
  }
  let response;
  try {
    response = JSON.parse(result.stdout.trim());
  } catch (error) {
    return {
      verdict: 'ERROR',
      findings: [{ id: INVALID_RESPONSE_FINDING, summary: `oracle stdout is not one JSON object: ${error.message}` }],
      invokeError: `unparsable stdout (exit ${result.status})`,
    };
  }
  const validationErrors = validateOracleResponse(response, oracleId, result.status, evidenceDir);
  if (validationErrors.length > 0) {
    return {
      verdict: 'ERROR',
      findings: [{ id: INVALID_RESPONSE_FINDING, summary: `oracle response violates the output contract: ${validationErrors.join('; ')}` }],
      invokeError: null,
    };
  }
  const verdict = response.result;
  if (!VALID_RESULTS.has(verdict)) {
    return {
      verdict: 'ERROR',
      findings: [{ id: INVALID_RESPONSE_FINDING, summary: `oracle returned an unknown result ${JSON.stringify(verdict)}` }],
      invokeError: null,
    };
  }
  return { verdict, findings: response.findings ?? [], invokeError: null };
}

// Copies the read-only evidence of the source campaign into a fresh session
// workspace: state.json + snapshots/ verbatim (modes preserved); the evidence/
// tree is rebuilt fresh per pair so oracles never collide with stale artifacts.
export function buildReplayWorkspace({ campaignDir, sessionDir }) {
  fs.mkdirSync(sessionDir, { recursive: true, mode: 0o700 });
  fs.copyFileSync(path.join(campaignDir, 'state.json'), path.join(sessionDir, 'state.json'));
  const sourceSnapshots = path.join(campaignDir, 'snapshots');
  if (fs.existsSync(sourceSnapshots)) {
    fs.cpSync(sourceSnapshots, path.join(sessionDir, 'snapshots'), { recursive: true, preserveTimestamps: true, verbatimSymlinks: false });
  }
}

function preparePairWorkspace({ sessionDir, pair }) {
  const evidenceDir = path.join(sessionDir, 'evidence', pair.caseId, pair.attempt, 'oracles', pair.oracle);
  fs.mkdirSync(evidenceDir, { recursive: true, mode: 0o700 });
  const contextPath = path.join(evidenceDir, 'context.json');
  fs.copyFileSync(pair.contextPath, contextPath);
  return { evidenceDir, contextPath };
}

function renderTable(rows) {
  const columns = [
    { key: 'case', label: 'CASE', get: (row) => row.caseId },
    { key: 'attempt', label: 'ATTEMPT', get: (row) => row.attempt },
    { key: 'oracle', label: 'ORACLE', get: (row) => row.oracle },
    { key: 'before', label: 'BEFORE', get: (row) => row.before },
    { key: 'after', label: 'AFTER', get: (row) => row.after },
    { key: 'delta', label: 'DELTA', get: (row) => row.delta },
    { key: 'findings', label: 'FINDINGS', get: (row) => (row.findingIds.length === 0 ? '-' : row.findingIds.join(',')) },
  ];
  const widths = columns.map((column) => Math.max(column.label.length, ...rows.map((row) => column.get(row).length)));
  const format = (row) => columns.map((column, index) => column.get(row).padEnd(widths[index])).join('  ');
  const header = columns.map((column, index) => column.label.padEnd(widths[index])).join('  ');
  const lines = [header, ...rows.map(format)];
  return lines.join('\n');
}

export function renderSummary(rows) {
  const flips = rows.filter((row) => row.delta === 'flip');
  const transitions = new Map();
  for (const row of flips) {
    const key = `${row.before}->${row.after}`;
    transitions.set(key, (transitions.get(key) ?? 0) + 1);
  }
  const invokeFailures = rows.filter((row) => row.invokeError !== null).length;
  const lines = [
    `pairs: ${rows.length}  flips: ${flips.length}  unchanged: ${rows.length - flips.length}  invoke_failures: ${invokeFailures}`,
  ];
  if (transitions.size > 0) {
    lines.push(`transitions: ${[...transitions.entries()].sort(([left], [right]) => left.localeCompare(right)).map(([key, count]) => `${key}: ${count}`).join(', ')}`);
  }
  return lines.join('\n');
}

// ── E3.B US-011 honest-verdict invariant verification ──────────────────────
//
// The scoped artifact classes are the ONLY findings that may disappear
// between a stored campaign verdict and its replayed verdict:
//
//   S5  O1_DURATION_FLOOR_*                      (wave-family floor artifacts)
//   S6  O11_DONE_WITHOUT_EXPECTS_SUCCESS and
//       O11_COMPLETED_FROM_RETRY_VERDICT         (loop-step model artifacts)
//   S7  O8_EXISTING_OUTSIDE_BOUNDARY and
//       O8_NEW_OUTSIDE_ALLOWED_DIRECTORIES       (bare fixture-root boundary
//                                                 artifacts — W3.17a/b only)
//   S13 O9_LEDGER_TREE_UNRESOLVED on W1.REPLAY-ts (foreign-row artifact) plus
//       ERROR->NOT_EVALUABLE on O2/O9/O10        (null gate_key degradation)
//   S19 O8_SEEDED_TEST_CHANGED                   (S19 adopted policy,
//       2026-08-24): may disappear only when the replay's findings carry the
//       informational O8_SEEDED_TEST_EXTENDED on the same pair — the seeded
//       delta is provably additive, so FAIL->PASS is an allowed flip; any
//       other seeded finding shape stays honest.
//   S20 O2_REF_TRANSITION_COUNT on O2            (2026-08-24, S20 reflog
//       parser calibration 7172a999): the landing update-ref writes reflog
//       entries with no message segment; the pre-S20 parser captured them
//       raw-only and counted 0 transitions, so the stored
//       O2_REF_TRANSITION_COUNT finding was a false positive. The fixed
//       parser recovers raw-only transitions, so the stored finding may
//       legitimately vanish on replay (scoped on O2 only).
//   S21 O9_LEDGER_TREE_UNRESOLVED on O9          (2026-08-24, S21 ledger
//       scoping calibration 7172a999): the ledger bundle previously kept
//       rows by origin_repo path only, so rows written by PRIOR campaign
//       attempts tripped O9_LEDGER_TREE_UNRESOLVED (17 findings / 8 cases).
//       The fixed oracle keeps only current-attempt rows (run_id NULL kept),
//       so stored O9_LEDGER_TREE_UNRESOLVED findings may legitimately vanish
//       on replay — the FAIL->PASS flip is the S21 transition class. (S13's
//       W1.REPLAY-ts foreign-row class is the earlier, narrower expression
//       of the same calibration; S21 now scopes O9 generally.)
//   S23 O1_DURATION_FLOOR_* APPEARING            (2026-08-24, SFX-B
//       un-deadened guard): the mirror of S5. The stored wave-1 do-now
//       verdicts were captured with the dead duration-floor guard (PASS, no
//       findings); the current O1 fires O1_DURATION_FLOOR_MISSING /
//       O1_DURATION_FLOOR_RATE on the 46-102s honest wave-1 runs under the
//       spec-era 120s floor (recalibrated to 30s in US-006/007). A PASS->FAIL
//       flip is legal ONLY when every replayed finding is an O1_DURATION_FLOOR_*
//       artifact (S23 transition class).
//
// Everything else — CNEV O1_TERMINAL_EVENT_MISSING, O8 seeded findings
// outside the S19 replacement, and any other finding id — is an HONEST
// verdict: it must survive the replay with the same verdict, or the replay
// fails loudly.

export const INVARIANT_PINS = {
  // O1_TERMINAL_EVENT_MISSING (CNEV) failures named by the story must survive.
  cnev: [
    { caseId: 'W1.L2-python', oracle: 'O1', finding: 'O1_TERMINAL_EVENT_MISSING' },
    { caseId: 'W1.L3-python', oracle: 'O1', finding: 'O1_TERMINAL_EVENT_MISSING' },
    { caseId: 'W1.L3-ts', oracle: 'O1', finding: 'O1_TERMINAL_EVENT_MISSING' },
  ],
  // O8 seeded pins (S19 adopted policy, 2026-08-24): each pinned case's
  // flagged seeded-test delta was diffed (baseline blob vs terminal blob)
  // against the ACTUAL campaign #7/#8 evidence and is PROVABLY ADDITIVE —
  // every baseline line present and unmodified. The stored
  // O8_SEEDED_TEST_CHANGED finding therefore legitimately replays as the
  // informational O8_SEEDED_TEST_EXTENDED and the verdict flips FAIL -> PASS.
  // A pin with policy 'flip-to-extended' requires the after findings to carry
  // O8_SEEDED_TEST_EXTENDED with a PASS verdict; policy 'survive' keeps the
  // old survival contract (stored FAIL with O8_SEEDED_TEST_CHANGED stays FAIL)
  // for any future non-additive pin.
  o8Seeded: [
    { caseId: 'W1.L3-ts', oracle: 'O8', policy: 'flip-to-extended', storedFinding: 'O8_SEEDED_TEST_CHANGED', replayedFinding: 'O8_SEEDED_TEST_EXTENDED' },
    { caseId: 'W2.22-non-main-bfmw', oracle: 'O8', policy: 'flip-to-extended', storedFinding: 'O8_SEEDED_TEST_CHANGED', replayedFinding: 'O8_SEEDED_TEST_EXTENDED' },
    { caseId: 'W3.01-bfmw-pi-python', oracle: 'O8', policy: 'flip-to-extended', storedFinding: 'O8_SEEDED_TEST_CHANGED', replayedFinding: 'O8_SEEDED_TEST_EXTENDED' },
    { caseId: 'W3.02-bfmw-pi-ts', oracle: 'O8', policy: 'flip-to-extended', storedFinding: 'O8_SEEDED_TEST_CHANGED', replayedFinding: 'O8_SEEDED_TEST_EXTENDED' },
    // W3.03-bfmw-hermes-ts: campaign #7 stored a PASS O8 verdict (no seeded
    // finding in its stdout.json) and campaign #8 stored FAIL on an additive
    // delta — the 'pass-stays-pass' policy covers both: a stored PASS must
    // stay PASS, and a stored FAIL + O8_SEEDED_TEST_CHANGED must replay PASS
    // with the informational O8_SEEDED_TEST_EXTENDED (S19 flip shape).
    { caseId: 'W3.03-bfmw-hermes-ts', oracle: 'O8', policy: 'pass-stays-pass', storedFinding: 'O8_SEEDED_TEST_CHANGED', replayedFinding: 'O8_SEEDED_TEST_EXTENDED' },
  ],
};

const S6_LOOP_FINDINGS = new Set(['O11_DONE_WITHOUT_EXPECTS_SUCCESS', 'O11_COMPLETED_FROM_RETRY_VERDICT']);
const S7_BOUNDARY_FINDINGS = new Set(['O8_EXISTING_OUTSIDE_BOUNDARY', 'O8_NEW_OUTSIDE_ALLOWED_DIRECTORIES']);
const S7_BOUNDARY_CASES = new Set(['W3.17a-marathon-natural', 'W3.17b-marathon-chaos']);
const S13_FOREIGN_ROW_FINDINGS = new Set(['O9_LEDGER_TREE_UNRESOLVED']);
const S13_FOREIGN_ROW_CASES = new Set(['W1.REPLAY-ts']);
const S13_NOT_EVALUABLE_ORACLES = new Set(['O2', 'O9', 'O10']);

// afterFindingIds carries the REPLAYED findings of the same pair, so the S19
// class can verify that a vanished O8_SEEDED_TEST_CHANGED was replaced by the
// informational O8_SEEDED_TEST_EXTENDED on that exact pair (the FAIL->PASS
// flip is only legal when the seeded delta is provably additive).
export function isScopedDisappearing({ caseId, oracle, findingId, afterFindingIds = [] }) {
  if (findingId.startsWith('O1_DURATION_FLOOR_')) return true; // S5
  if (S6_LOOP_FINDINGS.has(findingId)) return true; // S6
  if (S7_BOUNDARY_FINDINGS.has(findingId)) return S7_BOUNDARY_CASES.has(caseId); // S7
  // S21 (2026-08-24, S21 ledger scoping calibration): O9_LEDGER_TREE_UNRESOLVED
  // was a false positive when the ledger bundle included rows from PRIOR
  // campaign attempts; the fixed oracle keeps only current-attempt rows, so
  // stored findings may vanish on O9 replays (the FAIL->PASS flip is the S21
  // class). S13's W1.REPLAY-ts pin remains for its narrower foreign-row case.
  if (findingId === 'O9_LEDGER_TREE_UNRESOLVED') return oracle === 'O9'; // S21
  // S26 (2026-08-24, S26 O9 alignment): O9_REPLAY_ROW_MISSING was a false
  // positive when the replay row-resolution path treated foreign-origin /
  // stale-attempt rows (reused var/fixtures/work/<case>/<fixture> origin
  // paths across campaigns) as missing; the fixed oracle reserves the
  // finding for a row id absent from BOTH the case scope and the database
  // snapshot, so stored findings legitimately vanish on O9 replays.
  if (findingId === 'O9_REPLAY_ROW_MISSING') return oracle === 'O9'; // S26
  if (S13_FOREIGN_ROW_FINDINGS.has(findingId)) return S13_FOREIGN_ROW_CASES.has(caseId); // S13
  // ORACLE_RUNTIME_ERROR is the stored shape of the null-gate_key degradation
  // on O2/O9/O10 (campaign #7 W2.22/W3.0x merge cases): the S13 fix replaces
  // it with a NOT_EVALUABLE result, so it may vanish only on those oracles.
  if (findingId === 'ORACLE_RUNTIME_ERROR') return S13_NOT_EVALUABLE_ORACLES.has(oracle);
  // S20 (2026-08-24, S20 reflog parser calibration): O2_REF_TRANSITION_COUNT
  // was a false positive on landing cases (the pre-S20 parser counted 0
  // transitions from message-less reflog lines); the fixed parser recovers
  // raw-only transitions, so the stored finding may vanish on O2 replays.
  if (findingId === 'O2_REF_TRANSITION_COUNT') return oracle === 'O2'; // S20
  // S19 (2026-08-24, adopted triage decision): O8_SEEDED_TEST_CHANGED may
  // disappear from the replayed findings when the replay's findings carry the
  // informational O8_SEEDED_TEST_EXTENDED on the same case/attempt/oracle —
  // the seeded-test delta was provably additive, so the FAIL->PASS flip is an
  // allowed transition class. Without O8_SEEDED_TEST_EXTENDED present, the
  // stored seeded finding stays an honest verdict and must survive.
  if (findingId === 'O8_SEEDED_TEST_CHANGED') return oracle === 'O8' && afterFindingIds.includes('O8_SEEDED_TEST_EXTENDED');
  return false;
}

// Reads the campaign report.json (when present) and returns the case ids that
// carry a RUNAWAY kind-finding. The replay never rewrites the campaign (the
// sha256 contract above), so "RUNAWAY findings remain visible" reduces to:
// each RUNAWAY case must keep at least one honest FAIL verdict in the replay.
export function readRunawayCases(campaignDir, reportPath = null) {
  const file = reportPath ?? (campaignDir === null ? null : path.join(campaignDir, 'report.json'));
  if (file === null) return { present: false, cases: [] };
  if (!fs.existsSync(file)) return { present: false, cases: [] };
  let report;
  try {
    report = JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return { present: true, unparsable: true, cases: [] };
  }
  const rows = Array.isArray(report?.rows) ? report.rows : [];
  const cases = rows
    .filter((row) => Array.isArray(row?.findings) && row.findings.some((finding) => finding?.type === 'RUNAWAY'))
    .map((row) => row.id)
    .sort((left, right) => left.localeCompare(right));
  return { present: true, cases };
}

// The named pins are enforced strictly when the campaign IS campaign #7 (the
// delta-table contract) or when the pinned case exists in the campaign at all;
// for unrelated campaigns the pins are skipped (noted in the check).
function isCampaignSeven(campaignDir) {
  if (campaignDir === null) return false;
  return path.basename(campaignDir).startsWith('campaign-20260813T123604986Z-');
}

// Verifies the E3.B honest-verdict invariants over replay rows. Returns
// { ok, violations, checks, runawayCases }; ok is true only when zero
// violations were found.
export function verifyReplayInvariants({ rows, campaignDir = null, campaignCaseIds = null, pins = INVARIANT_PINS }) {
  const violations = [];
  const checks = [];
  const strictPins = campaignCaseIds === null || isCampaignSeven(campaignDir);
  const caseUniverse = campaignCaseIds === null ? null : new Set(campaignCaseIds);
  const pinApplies = (caseId) => strictPins || (caseUniverse !== null && caseUniverse.has(caseId));
  const skippedPin = (caseId, oracle) => `${caseId}/${oracle}: pin skipped (case not part of this campaign)`;

  // I1 — honest-finding preservation: no before finding outside the scoped
  // classes may disappear from the replayed findings.
  {
    const label = 'honest-finding-preservation';
    const local = [];
    for (const row of rows) {
      for (const findingId of row.beforeFindingIds ?? []) {
        if (!isScopedDisappearing({ caseId: row.caseId, oracle: row.oracle, findingId, afterFindingIds: row.findingIds ?? [] })
            && !(row.findingIds ?? []).includes(findingId)) {
          local.push(`${row.caseId}/${row.attempt}/${row.oracle}: honest finding ${findingId} vanished (${row.before} -> ${row.after})`);
        }
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local });
  }

  // I2 — transition classes: the only allowed flips are FAIL->PASS where
  // every before finding is scoped (S5/S6/S7/S13/S19/S20/S21/S26), PASS->FAIL
  // where every AFTER finding is an O1_DURATION_FLOOR_* artifact (S23 — the
  // SFX-B un-deadened guard fires the wave-1 floor findings the dead guard
  // stored as PASS), ERROR->NOT_EVALUABLE on O2/O9/O10 (S13
  // degraded-evidence vocabulary), and ERROR->PASS/FAIL on O10 when the
  // stored ERROR is the S26 suite-ledger reconciliation class (the US-002
  // scoped fix replays it to its true verdict).
  {
    const label = 'flip-transition-classes';
    const local = [];
    for (const row of rows) {
      if (row.delta !== 'flip') continue;
      const key = `${row.caseId}/${row.attempt}/${row.oracle}`;
      if (row.before === 'FAIL' && row.after === 'PASS') {
        const beforeIds = row.beforeFindingIds ?? [];
        if (beforeIds.length === 0) {
          local.push(`${key}: FAIL -> PASS flip with no recorded before findings (unexplained verdict change)`);
        } else {
          const unScoped = beforeIds.filter((findingId) => !isScopedDisappearing({ caseId: row.caseId, oracle: row.oracle, findingId, afterFindingIds: row.findingIds ?? [] }));
          if (unScoped.length > 0) {
            local.push(`${key}: FAIL -> PASS flip dropped non-scoped finding(s) ${unScoped.join(', ')}`);
          }
        }
      } else if (row.before === 'PASS' && row.after === 'FAIL') {
        // S23 (2026-08-24, SFX-B un-deadened guard): the stored verdict was
        // captured with the dead duration-floor guard; the current O1 fires
        // O1_DURATION_FLOOR_* findings on the honest wave-1 runs under the
        // spec-era 120s floor. The flip is legal ONLY when every replayed
        // finding is an O1_DURATION_FLOOR_* artifact — any other finding
        // appearing on a stored PASS is an honest regression.
        const afterIds = row.findingIds ?? [];
        if (afterIds.length === 0 || !afterIds.every((findingId) => findingId.startsWith('O1_DURATION_FLOOR_'))) {
          local.push(`${key}: PASS -> FAIL flip introduced non-floor finding(s) ${afterIds.join(', ') || '(none)'} (S23 class is O1_DURATION_FLOOR_* only)`);
        }
      } else if (row.before === 'ERROR' && row.after === 'NOT_EVALUABLE') {
        if (!S13_NOT_EVALUABLE_ORACLES.has(row.oracle)) {
          local.push(`${key}: ERROR -> NOT_EVALUABLE flip on ${row.oracle} (S13 vocabulary is scoped to O2/O9/O10)`);
        }
      } else if (row.before === 'ERROR' && isO10ReconciliationErrorRow(row)
          && ['PASS', 'FAIL', 'NOT_EVALUABLE'].includes(row.after)) {
        // S26 (2026-08-24, S26 US-002): the O10 suite-ledger reconciliation
        // is scoped to the case's suite origins, so a stored O10
        // ORACLE_RUNTIME_ERROR with the 'suite_ledger does not reconcile
        // byte-for-field' summary legitimately replays to its true verdict
        // (PASS/FAIL/NOT_EVALUABLE). Any O10 non-reconciliation ERROR flip
        // stays an honest verdict (caught by the unclassified branch below).
      } else {
        local.push(`${key}: unclassified flip ${row.before} -> ${row.after} (outside the S5/S6/S7/S13/S19/S20/S21/S23/S26 classes)`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local });
  }

  // I3 — named CNEV pins: O1_TERMINAL_EVENT_MISSING survives on the story's
  // example cases with a FAIL verdict before and after. Shape-aware (2026-08-24,
  // US-005): the pins were written against campaign #7's stored FAIL +
  // O1_TERMINAL_EVENT_MISSING shape; campaign #8 stored PASS (no finding) on
  // W1.L2-python / W1.L3-python / W1.L3-ts O1 because the SFX-B un-deadened
  // guard and S23 wave reporting changed what O1 fires. A stored PASS shape
  // (no O1_TERMINAL_EVENT_MISSING to preserve) must stay PASS or flip only
  // via the scoped classes (S23 O1_DURATION_FLOOR_* appearing); a stored FAIL
  // + O1_TERMINAL_EVENT_MISSING shape must survive unchanged.
  {
    const label = 'cnev-pins';
    const local = [];
    const skipped = [];
    for (const pin of pins.cnev ?? []) {
      if (!pinApplies(pin.caseId)) {
        skipped.push(skippedPin(pin.caseId, pin.oracle));
        continue;
      }
      const matches = rows.filter((row) => row.caseId === pin.caseId && row.oracle === pin.oracle);
      if (matches.length === 0) {
        local.push(`${pin.caseId}/${pin.oracle}: pinned pair missing from the replay`);
        continue;
      }
      for (const row of matches) {
        const storedShape = (row.beforeFindingIds ?? []).includes(pin.finding);
        if (row.before === 'PASS') {
          // Stored PASS shape (campaign #8): no O1_TERMINAL_EVENT_MISSING to
          // preserve. The replayed verdict must stay PASS, or flip to FAIL
          // only via the S23 floor-artifact class (the SFX-B guard
          // un-deadening firing O1_DURATION_FLOOR_* findings); any other
          // PASS -> FAIL is an honest verdict change the I1/I2 checks catch.
          if (row.after === 'FAIL') {
            const afterIds = row.findingIds ?? [];
            if (afterIds.length === 0 || !afterIds.every((findingId) => findingId.startsWith('O1_DURATION_FLOOR_'))) {
              local.push(`${row.caseId}/${row.attempt}/${row.oracle}: CNEV pin violated (stored PASS flipped to ${row.after} [${afterIds.join(',')}] outside the S23 floor-artifact class)`);
            }
          }
          continue;
        }
        if (row.before !== 'FAIL' || !storedShape || row.after !== 'FAIL'
            || !(row.findingIds ?? []).includes(pin.finding)) {
          local.push(`${row.caseId}/${row.attempt}/${row.oracle}: CNEV pin violated (before ${row.before} [${(row.beforeFindingIds ?? []).join(',')}] -> after ${row.after} [${(row.findingIds ?? []).join(',')}])`);
        }
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local, skipped });
  }

  // I4 — named O8 seeded pins (S19 adopted policy, 2026-08-24). Two pin
  // policies:
  //   - 'flip-to-extended': the stored FAIL + O8_SEEDED_TEST_CHANGED finding
  //     must replay as PASS + O8_SEEDED_TEST_EXTENDED (the seeded delta is
  //     provably additive). Any other shape — stored verdict not FAIL, stored
  //     finding missing, replay not PASS, replayed finding missing — is a
  //     violation.
  //   - 'pass-stays-pass' (W3.03-bfmw-hermes-ts): the replayed verdict must be
  //     PASS. A stored PASS stays PASS; a stored FAIL with the seeded finding
  //     flips to PASS only when O8_SEEDED_TEST_EXTENDED is present (S19).
  //   - 'survive' (legacy default, kept for future non-additive pins): verdict
  //     preserved; FAIL cases keep the O8_SEEDED_TEST_CHANGED finding before
  //     and after.
  {
    const label = 'o8-seeded-pins';
    const local = [];
    const skipped = [];
    for (const pin of pins.o8Seeded ?? []) {
      if (!pinApplies(pin.caseId)) {
        skipped.push(skippedPin(pin.caseId, pin.oracle));
        continue;
      }
      const matches = rows.filter((row) => row.caseId === pin.caseId && row.oracle === pin.oracle);
      if (matches.length === 0) {
        local.push(`${pin.caseId}/${pin.oracle}: pinned pair missing from the replay`);
        continue;
      }
      for (const row of matches) {
        const policy = pin.policy ?? 'survive';
        const storedFinding = pin.storedFinding ?? pin.finding;
        const replayedFinding = pin.replayedFinding ?? null;
        if (policy === 'flip-to-extended' || policy === 'pass-stays-pass') {
          // S19: the replayed verdict must be PASS with the informational
          // O8_SEEDED_TEST_EXTENDED present. A stored PASS stays PASS only
          // under 'pass-stays-pass' (W3.03 campaign #7 stored PASS).
          if (row.before === 'PASS' && policy === 'pass-stays-pass') {
            if (row.after !== 'PASS') {
              local.push(`${row.caseId}/${row.attempt}/${row.oracle}: O8 seeded pin violated (stored PASS flipped to ${row.after})`);
            }
            continue;
          }
          if (row.before !== 'FAIL' || !(row.beforeFindingIds ?? []).includes(storedFinding)
              || row.after !== 'PASS' || replayedFinding === null || !(row.findingIds ?? []).includes(replayedFinding)) {
            local.push(`${row.caseId}/${row.attempt}/${row.oracle}: O8 seeded pin violated (stored ${row.before} [${(row.beforeFindingIds ?? []).join(',')}] must replay PASS with ${replayedFinding ?? storedFinding}, got ${row.after} [${(row.findingIds ?? []).join(',')}])`);
          }
        } else if (row.before !== row.after) {
          local.push(`${row.caseId}/${row.attempt}/${row.oracle}: O8 seeded pin violated (stored ${row.before} flipped to ${row.after})`);
        } else if (row.before === 'FAIL' && (!(row.beforeFindingIds ?? []).includes(storedFinding)
            || !(row.findingIds ?? []).includes(storedFinding))) {
          local.push(`${row.caseId}/${row.attempt}/${row.oracle}: O8 seeded pin violated (O8_SEEDED_TEST_CHANGED missing from ${row.before} findings)`);
        }
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local, skipped });
  }

  // I5 — RUNAWAY backing: every RUNAWAY case in the campaign report must keep
  // at least one FAIL verdict after the replay, so the RUNAWAY kind-finding
  // stays visible instead of being masked by an all-PASS flip. A RUNAWAY case
  // with NO replay rows at all (2026-08-24, US-005 — W3.19-pause-drain died
  // with TEST_INFRA_FAIL probe-action-failed before any oracle evidence was
  // captured) has nothing to mask: the RUNAWAY finding lives in the campaign
  // report and is untouched by the replay, so it is noted as skipped rather
  // than flagged.
  const runaway = readRunawayCases(campaignDir);
  {
    const label = 'runaway-backing';
    const local = [];
    const skipped = [];
    if (runaway.present === false) {
      checks.push({ label, ok: true, violations: [], skipped: 'no campaign report.json (RUNAWAY check not applicable)' });
    } else if (runaway.unparsable === true) {
      local.push(`campaign report.json is not parsable (cannot verify RUNAWAY visibility)`);
      violations.push(...local);
      checks.push({ label, ok: false, violations: local });
    } else {
      for (const caseId of runaway.cases) {
        const caseRows = rows.filter((row) => row.caseId === caseId);
        if (caseRows.length === 0) {
          skipped.push(`${caseId}: RUNAWAY case has no replay rows (no oracle evidence captured — nothing to mask)`);
          continue;
        }
        const backing = caseRows.filter((row) => row.after === 'FAIL');
        if (backing.length === 0) {
          local.push(`${caseId}: RUNAWAY case lost every FAIL verdict in the replay (RUNAWAY visibility would be masked)`);
        }
      }
      violations.push(...local);
      checks.push({ label, ok: local.length === 0, violations: local, skipped, runawayCases: runaway.cases });
    }
  }

  return { ok: violations.length === 0, violations, checks, runawayCases: runaway.cases };
}

// ── S26 US-005: O10 reconciliation replay-contract pin ──────────────────────
//
// The S26 replay contract (pinned by --verify-s26-invariants): the ONLY
// allowed verdict flips between a stored campaign verdict and its replay are
//
//   A  O10 reconciliation heal: a stored O10 ERROR whose findings carry
//      ORACLE_RUNTIME_ERROR with the 'suite_ledger does not reconcile
//      byte-for-field' summary replays to its TRUE verdict — PASS, FAIL or
//      NOT_EVALUABLE. The US-002 scoped-reconciliation fix recomputes the
//      case's suite-origin scope from O10's own inputs, so the stored
//      ERROR (a full-table false positive from foreign-origin rows) is no
//      longer thrown. EVERY such stored row must heal: a reconciliation
//      ERROR that still replays ERROR is the red arm and violates the pin.
//   B  O9 replay-row heal: an O9 FAIL -> PASS where every stored finding is
//      an O9_REPLAY_ROW_MISSING / O9_SINGLEFLIGHT_* false positive that the
//      US-003 row-resolution alignment (foreign/stale rows annotated and
//      skipped, never missing) heals on replay.
//
// Any OTHER flip — including an O10 non-reconciliation ERROR flip (e.g. the
// 'target ref identity changed between snapshots' class) or any non-O10 /
// non-O9 change — violates the pin and exits 1.

const O10_RECONCILIATION_SUMMARY = 'suite_ledger does not reconcile byte-for-field';
const S26_O9_HEAL_FINDINGS = new Set([
  'O9_REPLAY_ROW_MISSING',
  'O9_SINGLEFLIGHT_EXECUTOR_COUNT',
  'O9_SINGLEFLIGHT_RECOVERY_ORDER',
  'O9_SINGLEFLIGHT_WAITER_UNRESOLVED',
]);

// True when the replay row's BEFORE shape is the S26 O10 suite-ledger
// reconciliation ERROR: oracle O10, stored verdict ERROR, and an
// ORACLE_RUNTIME_ERROR finding whose summary carries the reconciliation
// message. Rows without stored finding summaries (synthetic fixtures) fall
// back to the finding id — any O10 ORACLE_RUNTIME_ERROR is treated as the
// reconciliation class.
export function isO10ReconciliationErrorRow(row) {
  if (row.oracle !== 'O10' || row.before !== 'ERROR') return false;
  const findings = row.beforeFindings ?? [];
  if (findings.length > 0) {
    return findings.some((finding) => finding.id === 'ORACLE_RUNTIME_ERROR'
      && typeof finding.summary === 'string' && finding.summary.includes(O10_RECONCILIATION_SUMMARY));
  }
  return (row.beforeFindingIds ?? []).includes('ORACLE_RUNTIME_ERROR');
}

// True when the flip is the S26 O9 replay-row heal: oracle O9, stored FAIL
// -> replayed PASS, O9_REPLAY_ROW_MISSING among the stored findings, and
// EVERY stored finding an S26 O9 heal-class false positive (US-003).
export function isO9ReplayRowHeal(row) {
  if (row.oracle !== 'O9' || row.before !== 'FAIL' || row.after !== 'PASS') return false;
  const beforeIds = row.beforeFindingIds ?? [];
  if (!beforeIds.includes('O9_REPLAY_ROW_MISSING')) return false;
  return beforeIds.every((findingId) => S26_O9_HEAL_FINDINGS.has(findingId));
}

// Verifies the S26 replay-contract invariants over replay rows. Returns
// { ok, violations, checks }; ok is true only when zero violations were
// found.
export function verifyS26Invariants({ rows }) {
  const violations = [];
  const checks = [];

  // S26-I1 — O10 reconciliation heals: every stored O10 reconciliation-ERROR
  // row must replay to its true verdict (PASS/FAIL/NOT_EVALUABLE). A stored
  // reconciliation ERROR that still replays ERROR is the red arm (pre-US-002
  // code shape) and fails the pin.
  {
    const label = 's26-o10-reconciliation-heal';
    const local = [];
    for (const row of rows) {
      if (!isO10ReconciliationErrorRow(row)) continue;
      if (!['PASS', 'FAIL', 'NOT_EVALUABLE'].includes(row.after)) {
        local.push(`${row.caseId}/${row.attempt}/${row.oracle}: S26 invariant violated (stored O10 suite-ledger reconciliation ERROR must replay to its true verdict (PASS/FAIL/NOT_EVALUABLE), got ${row.after})`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local });
  }

  // S26-I2 — flip scope: the ONLY allowed flips are the S26 classes (O10
  // reconciliation heal, O9 replay-row heal). Any other flip — including any
  // O10 non-reconciliation ERROR flip or any non-O10 change — violates.
  {
    const label = 's26-flip-scope';
    const local = [];
    for (const row of rows) {
      if (row.delta !== 'flip') continue;
      const key = `${row.caseId}/${row.attempt}/${row.oracle}`;
      if (isO10ReconciliationErrorRow(row) && ['PASS', 'FAIL', 'NOT_EVALUABLE'].includes(row.after)) continue;
      if (isO9ReplayRowHeal(row)) continue;
      if (isO10ReconciliationErrorRow(row)) {
        local.push(`${key}: S26 invariant violated (O10 reconciliation ERROR flipped to ${row.after}, not a true verdict)`);
      } else {
        local.push(`${key}: S26 invariant violated (flip ${row.before} -> ${row.after} outside the O10 reconciliation-ERROR -> true-verdict / O9 replay-row-heal classes)`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local });
  }

  return { ok: violations.length === 0, violations, checks };
}

export function renderS26Report(verification) {
  const lines = ['S26 invariant report (--verify-s26-invariants):'];
  for (const check of verification.checks) {
    lines.push(`  [${check.ok ? 'OK' : 'VIOLATION'}] ${check.label}`);
  }
  lines.push(`s26: ${verification.ok ? 'OK' : `FAILED (${verification.violations.length} violation(s))`}`);
  return lines.join('\n');
}

// ── S27 US-006: O10 real-cell calibration replay-contract pin ────────────────
//
// The S27 replay contract (pinned by --verify-s27-invariants) codifies the
// green contract of the tier-2 attempt-2 campaign replay under the
// US-001/US-002 recalibrated two-regime O10 model (S27 US-001..US-005). The
// ONLY allowed verdict flips are
//
//   A  O10 reconciliation heal (S26 class): a stored O10 ERROR carrying
//      ORACLE_RUNTIME_ERROR with the 'suite_ledger does not reconcile
//      byte-for-field' summary replays to its TRUE verdict — PASS, FAIL or
//      NOT_EVALUABLE. EVERY such stored row must heal (a stored
//      reconciliation ERROR that still replays ERROR is the red arm).
//   B  O9 replay-row heal (S26 class): an O9 FAIL -> PASS where every stored
//      finding is an O9_REPLAY_ROW_MISSING / O9_SINGLEFLIGHT_* false positive
//      (the US-003 row-resolution alignment).
//   C  O10 calibration FAIL heal (S27 class, the W4.01 class): an O10 stored
//      FAIL -> PASS where every stored finding is a calibration class
//      (O10_EVENT_SET_MISMATCH and/or O10_REROUTE_COUNT) — the real-cell
//      two-regime model heals the multi-step-running / legal-corridor-reroute
//      artifacts that the pre-S27 single-step model mis-filed as genuine.
//
// Any OTHER flip — including any O10 non-reconciliation ERROR flip (e.g. the
// 'target ref identity changed between snapshots' class) or any non-O10 /
// non-O9 change — violates the pin and exits 1.
//
// On top of the class checks, the pin enforces the EXACT attempt-2 delta
// shape (the S27 US-004 audit ground truth): the 21 documented calibration
// cases replay O10 PASS (W4.01's stored FAIL heal + 20 reconciliation-ERROR
// heals), the 3 O10 FAIL survivors (W4.17-b / W4.18 / W4.dsh-fdmw) keep
// their genuine findings (never silently absorbed), W4.29 stays O10 ERROR
// (non-reconciliation target-ref identity, unchanged), non-O10 flips are
// EXACTLY the 2 S26 O9 heals, and every other non-O10 row is byte-identical
// (same verdict AND same finding ids). The exact-shape pins follow the E3.B
// pinApplies semantics: strict when no campaign universe is given (unit
// pins) or when the campaign IS the attempt-2 campaign; otherwise they apply
// per documented case id present in the campaign universe and are noted as
// skipped otherwise (so the class checks remain the universal contract).

export const S27_O10_PASS_CASES = [
  'W4.01-missing-evidence-reroute',
  'W4.02-fail-missing-refusal',
  'W4.03-red-adjacent-commit',
  'W4.04a-mechanical-override',
  'W4.04b-behavioral-bait',
  'W4.05-slow-suite-contention',
  'W4.06-colleague-rebase',
  'W4.07-conflicting-colleague-commit',
  'W4.13-worktree-deletion',
  'W4.15-story-flood',
  'W4.16-scope-bait',
  'W4.17-a-red-baseline-land-annotated',
  'W4.26-unreachable-origin',
  'W4.28-tstx-cross-repo-collision',
  'W4.31-precommit-amend',
  'W4.32-enospc',
  'W4.33c-deleted-worktree-refusal',
  'W4.39-b-union-dishonest',
  'W4.45-branch-delete',
  'W4.45-gc-aggressive',
  'W5.storm-capacity-scaled',
];

export const S27_O10_FAIL_EXPECTATIONS = {
  'W4.17-b-red-baseline-refuse': [
    'O10_EVENT_SET_MISMATCH', 'O10_MERGER_INVOCATION_COUNT', 'O10_REF_MOVEMENT',
    'O10_REFUSAL_DIAGNOSIS', 'O10_REROUTE_COUNT', 'O10_TERMINAL_DISPOSITION',
  ],
  'W4.18-flaky-alternator': ['O10_EVENT_SET_MISMATCH'],
  'W4.dsh-fdmw': [
    'O10_EVENT_SET_MISMATCH', 'O10_EVENT_SET_MISMATCH', 'O10_EVENT_SET_MISMATCH',
    'O10_EVENT_SET_MISMATCH', 'O10_EVENT_SET_MISMATCH', 'O10_EVENT_SET_MISMATCH',
    'O10_MERGER_INVOCATION_COUNT', 'O10_REF_MOVEMENT', 'O10_TERMINAL_DISPOSITION',
  ],
};

export const S27_W4_29_CASE = 'W4.29-strict-gate-retry-finalize';

const S27_CALIBRATION_FINDINGS = new Set(['O10_EVENT_SET_MISMATCH', 'O10_REROUTE_COUNT']);

const ATTEMPT_TWO_CAMPAIGN_PREFIX = 'campaign-20260826T225744158Z-4bf26d7f-';

function isAttemptTwoCampaign(campaignDir) {
  if (campaignDir === null) return false;
  return path.basename(campaignDir).startsWith(ATTEMPT_TWO_CAMPAIGN_PREFIX);
}

// True when the row is one of the S27 genuine O10 FAIL survivors with EXACTLY
// the documented finding ids (order-insensitive compare; the replay preserves
// emit order, so byte compare would also work, but the audit contract is the
// finding SET — a survivor that loses a genuine finding is the red arm).
function isS27GenuineFailRow(row) {
  if (row.oracle !== 'O10' || row.after !== 'FAIL') return false;
  const expected = S27_O10_FAIL_EXPECTATIONS[row.caseId];
  if (expected === undefined) return false;
  const actual = [...(row.findingIds ?? [])].sort();
  const wanted = [...expected].sort();
  return actual.length === wanted.length
    && actual.every((findingId, index) => findingId === wanted[index]);
}

// True when the flip is the S27 calibration-FAIL heal (the W4.01 class): an
// O10 stored FAIL -> PASS whose every stored finding is a calibration class
// (O10_EVENT_SET_MISMATCH and/or O10_REROUTE_COUNT). The calibration classes
// are themselves the real-cell markers of the US-001/US-002 two-regime model:
// the multi-step-running multiplicity and the legal-corridor reroute count
// that the pre-S27 single-step model mis-filed. A stored FAIL carrying any
// non-calibration finding can never heal under the S27 class.
export function isS27CalibrationFailHeal(row) {
  if (row.oracle !== 'O10' || row.before !== 'FAIL' || row.after !== 'PASS') return false;
  const beforeIds = row.beforeFindingIds ?? [];
  return beforeIds.length > 0 && beforeIds.every((findingId) => S27_CALIBRATION_FINDINGS.has(findingId));
}

// Verifies the S27 replay-contract invariants over replay rows. Returns
// { ok, violations, checks }; ok is true only when zero violations were
// found. campaignDir / campaignCaseIds scope the exact-shape pins (E3.B
// pinApplies semantics): strict for the attempt-2 campaign (or when no
// campaign universe is given), per-case otherwise.
export function verifyS27Invariants({ rows, campaignDir = null, campaignCaseIds = null }) {
  const violations = [];
  const checks = [];
  const o10Rows = rows.filter((row) => row.oracle === 'O10');
  const strictPins = campaignCaseIds === null || isAttemptTwoCampaign(campaignDir);
  const caseUniverse = campaignCaseIds === null ? null : new Set(campaignCaseIds);
  const pinApplies = (caseId) => strictPins || (caseUniverse !== null && caseUniverse.has(caseId));
  const skippedPin = (caseId, kind) => `${caseId}: ${kind} pin skipped (case not part of this campaign)`;

  // S27-I1 — S26 red-arm carry-over: every stored O10 reconciliation ERROR
  // must replay to its true verdict (PASS/FAIL/NOT_EVALUABLE). A stored
  // reconciliation ERROR that still replays ERROR is the red arm and fails
  // the S27 pin too.
  {
    const label = 's27-o10-reconciliation-heal';
    const local = [];
    for (const row of rows) {
      if (!isO10ReconciliationErrorRow(row)) continue;
      if (!['PASS', 'FAIL', 'NOT_EVALUABLE'].includes(row.after)) {
        local.push(`${row.caseId}/${row.attempt}/${row.oracle}: S27 invariant violated (stored O10 suite-ledger reconciliation ERROR must replay to its true verdict (PASS/FAIL/NOT_EVALUABLE), got ${row.after})`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local });
  }

  // S27-I2 — flip scope: the ONLY allowed flips are the S26 classes (O10
  // reconciliation heal, O9 replay-row heal) and the S27 class (O10 stored
  // FAIL -> PASS whose every stored finding is a calibration class). Any
  // other flip — including any O10 non-reconciliation ERROR flip, an O10
  // stored FAIL -> PASS carrying a non-calibration finding, or any non-O10 /
  // non-O9 change — violates.
  {
    const label = 's27-flip-scope';
    const local = [];
    for (const row of rows) {
      if (row.delta !== 'flip') continue;
      const key = `${row.caseId}/${row.attempt}/${row.oracle}`;
      if (isO10ReconciliationErrorRow(row) && ['PASS', 'FAIL', 'NOT_EVALUABLE'].includes(row.after)) continue;
      if (isO9ReplayRowHeal(row)) continue;
      if (isS27CalibrationFailHeal(row)) continue;
      if (isO10ReconciliationErrorRow(row)) {
        local.push(`${key}: S27 invariant violated (O10 reconciliation ERROR flipped to ${row.after}, not a true verdict)`);
      } else if (row.oracle === 'O10' && row.before === 'FAIL' && row.after === 'PASS') {
        local.push(`${key}: S27 invariant violated (O10 stored FAIL -> PASS carries non-calibration stored finding(s) ${(row.beforeFindingIds ?? []).join(', ')})`);
      } else {
        local.push(`${key}: S27 invariant violated (flip ${row.before} -> ${row.after} outside the O10 reconciliation-ERROR -> true-verdict / O10 calibration-FAIL -> PASS / O9 replay-row-heal classes)`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local });
  }

  // S27-I3 — calibration PASS set: on the attempt-2 shape EXACTLY the 21
  // documented cases replay O10 PASS (W4.01's stored FAIL heal + the 20
  // reconciliation-ERROR heals), and every one of them does (a documented
  // case replaying anything else — including a W4.01-class FAIL that does
  // not heal or a reconciliation ERROR that does not heal — is a red arm).
  // Per-case when the pin applies to a subset of the documented cases.
  {
    const label = 's27-calibration-pass-set';
    const local = [];
    const skipped = [];
    const applicable = S27_O10_PASS_CASES.filter((caseId) => pinApplies(caseId));
    if (applicable.length === S27_O10_PASS_CASES.length) {
      const passCases = o10Rows.filter((row) => row.after === 'PASS').map((row) => row.caseId).sort();
      const expected = [...S27_O10_PASS_CASES].sort();
      if (passCases.length !== expected.length
          || !passCases.every((caseId, index) => caseId === expected[index])) {
        local.push(`O10 PASS set mismatch: expected [${expected.join(', ')}] got [${passCases.join(', ')}]`);
      }
      for (const row of o10Rows) {
        if (row.after === 'PASS' && !S27_O10_PASS_CASES.includes(row.caseId)) {
          local.push(`unexpected O10 PASS on ${row.caseId}`);
        }
        if (row.after !== 'PASS' && S27_O10_PASS_CASES.includes(row.caseId)) {
          local.push(`${row.caseId}: documented calibration PASS case replays ${row.after}`);
        }
      }
    } else {
      for (const caseId of applicable) {
        const match = o10Rows.find((row) => row.caseId === caseId);
        if (match === undefined) {
          local.push(`${caseId}: documented calibration PASS case missing from the replay`);
        } else if (match.after !== 'PASS') {
          local.push(`${caseId}: documented calibration PASS case replays ${match.after}`);
        }
      }
      const skippedCases = S27_O10_PASS_CASES.filter((caseId) => !pinApplies(caseId));
      if (skippedCases.length > 0) skipped.push(`${skippedCases.length} calibration-PASS pin(s) skipped: not part of this campaign`);
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local, skipped });
  }

  // S27-I4 — genuine FAIL survivors: W4.17-b / W4.18 / W4.dsh-fdmw replay O10
  // FAIL with EXACTLY the documented genuine findings (never silently
  // absorbed; losing a finding is the red arm).
  {
    const label = 's27-genuine-fail-survivors';
    const local = [];
    const skipped = [];
    for (const [caseId, expected] of Object.entries(S27_O10_FAIL_EXPECTATIONS)) {
      if (!pinApplies(caseId)) {
        skipped.push(skippedPin(caseId, 'survivor'));
        continue;
      }
      const row = o10Rows.find((candidate) => candidate.caseId === caseId);
      if (row === undefined) {
        local.push(`${caseId}: O10 survivor row missing from the replay`);
        continue;
      }
      if (!isS27GenuineFailRow(row)) {
        local.push(`${caseId}: O10 survivor must replay FAIL with exactly [${expected.join(', ')}], got ${row.after} [${(row.findingIds ?? []).join(', ')}]`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local, skipped });
  }

  // S27-I5 — W4.29 stays O10 ERROR (non-reconciliation target-ref identity,
  // unchanged — the S26 pin's non-heal class).
  {
    const label = 's27-w4-29-error-pin';
    const local = [];
    const skipped = [];
    if (!pinApplies(S27_W4_29_CASE)) {
      skipped.push(skippedPin(S27_W4_29_CASE, 'W4.29'));
    } else {
      const row = o10Rows.find((candidate) => candidate.caseId === S27_W4_29_CASE);
      if (row === undefined) {
        local.push(`${S27_W4_29_CASE}: row missing from the replay`);
      } else if (row.before !== 'ERROR' || row.after !== 'ERROR' || row.delta !== 'same') {
        local.push(`${S27_W4_29_CASE}: must stay ERROR (non-reconciliation target-ref identity), got ${row.before} -> ${row.after}`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local, skipped });
  }

  // S27-I6 — non-O10 byte-identity: on the attempt-2 shape the ONLY non-O10
  // flips are the 2 S26 O9 replay-row heals; every other non-O10 row keeps
  // its verdict AND its exact finding ids (byte-identical — a row whose
  // finding ids changed is a silent-absorption red arm).
  {
    const label = 's27-non-o10-byte-identical';
    const local = [];
    const skipped = [];
    const o9Heals = rows.filter((row) => row.oracle === 'O9'
      && row.before === 'FAIL' && row.after === 'PASS' && row.delta === 'flip'
      && (row.beforeFindingIds ?? []).every((findingId) => findingId === 'O9_REPLAY_ROW_MISSING')
      && (row.findingIds ?? []).length === 0);
    const nonO10Flips = rows.filter((row) => row.oracle !== 'O10' && row.delta === 'flip');
    if (strictPins && (nonO10Flips.length !== 2 || o9Heals.length !== 2)) {
      local.push(`expected exactly 2 non-O10 flips (the S26 O9 heals), got ${nonO10Flips.length} flips / ${o9Heals.length} O9 heals: ${nonO10Flips.map((row) => `${row.caseId}/${row.oracle} ${row.before}->${row.after}`).join(', ')}`);
    }
    for (const row of rows) {
      if (row.oracle === 'O10') continue;
      if (row.delta !== 'same') continue;
      const beforeIds = row.beforeFindingIds ?? [];
      const afterIds = row.findingIds ?? [];
      if (JSON.stringify(beforeIds) !== JSON.stringify(afterIds)) {
        local.push(`${row.caseId}/${row.oracle}: non-O10 row changed finding ids ${JSON.stringify(beforeIds)} -> ${JSON.stringify(afterIds)} (byte-identity violation)`);
      }
    }
    violations.push(...local);
    checks.push({ label, ok: local.length === 0, violations: local, skipped });
  }

  return { ok: violations.length === 0, violations, checks };
}

export function renderS27Report(verification) {
  const lines = ['S27 invariant report (--verify-s27-invariants):'];
  for (const check of verification.checks) {
    let suffix = '';
    if (check.skipped !== undefined) {
      if (typeof check.skipped === 'string') suffix = ` (${check.skipped})`;
      else if (check.skipped.length > 0) suffix = ` (${check.skipped.join('; ')})`;
    }
    lines.push(`  [${check.ok ? 'OK' : 'VIOLATION'}] ${check.label}${suffix}`);
  }
  lines.push(`s27: ${verification.ok ? 'OK' : `FAILED (${verification.violations.length} violation(s))`}`);
  return lines.join('\n');
}

export function renderInvariantReport(verification) {
  const mark = (ok) => (ok ? 'OK' : 'VIOLATION');
  const skip = (check) => {
    if (check.skipped === undefined) return '';
    if (typeof check.skipped === 'string') return ` (${check.skipped})`;
    if (check.skipped.length === 0) return '';
    const allPins = check.skipped.every((entry) => entry.includes('pin skipped'));
    if (allPins) return ` (${check.skipped.length} pin(s) skipped: not part of this campaign)`;
    return ` (${check.skipped.length} skipped: ${check.skipped.join('; ')})`;
  };
  const lines = ['invariant report (--verify-invariants, E3.B US-011):'];
  for (const check of verification.checks) {
    lines.push(`  [${mark(check.ok)}] ${check.label}${skip(check)}`);
  }
  lines.push(`invariants: ${verification.ok ? 'OK' : `FAILED (${verification.violations.length} violation(s))`}`);
  return lines.join('\n');
}

export function replayCampaign(options, io = {}) {
  const stdout = io.stdout ?? ((line) => process.stdout.write(`${line}\n`));
  const stderr = io.stderr ?? ((line) => process.stderr.write(`${line}\n`));
  const campaignDir = resolveCampaignDir(options);
  const pairs = collectReplayPairs(campaignDir);
  if (pairs.length === 0) throw new Error(`campaign has no replayable evidence pairs (evidence/<case>/attempt-*/oracles/<oracle>/{context.json,stdout.json}): ${campaignDir}`);
  const timeoutMs = options.timeoutMs ?? ORACLE_TIMEOUT_MS;
  const digestBefore = computeCampaignDigest(campaignDir);

  fs.mkdirSync(options.workspaceRoot, { recursive: true, mode: 0o700 });
  const sessionDir = fs.mkdtempSync(path.join(options.workspaceRoot, 'replay-'));
  let rows = [];
  let sourceViolation = null;
  try {
    buildReplayWorkspace({ campaignDir, sessionDir });
    stdout(`tt-oracle-replay: campaign ${campaignDir}`);
    stdout(`tt-oracle-replay: workspace ${sessionDir}`);
    for (const pair of pairs) {
      const { evidenceDir, contextPath } = preparePairWorkspace({ sessionDir, pair });
      const before = readStoredVerdict(pair.stdoutPath);
      let context = null;
      let contextError = null;
      try {
        context = readContext(pair.contextPath);
      } catch (error) {
        contextError = error.message;
      }
      let after;
      let findingIds;
      let invokeError;
      if (contextError !== null) {
        after = 'ERROR';
        findingIds = [REPLAY_ERROR_FINDING];
        invokeError = contextError;
      } else {
        const oraclePath = path.join(ORACLES_ROOT, pair.oracle);
        let oracleUsable = false;
        try {
          const details = fs.lstatSync(oraclePath);
          oracleUsable = details.isFile() && !details.isSymbolicLink() && (details.mode & 0o111) !== 0;
        } catch {
          oracleUsable = false;
        }
        if (!oracleUsable) {
          after = 'ERROR';
          findingIds = [REPLAY_ERROR_FINDING];
          invokeError = `oracle ${oraclePath} is not an executable regular file`;
        } else {
          const outcome = invokeOracle({
            oracleId: pair.oracle,
            oraclePath,
            contextPath,
            evidenceDir,
            context,
            timeoutMs,
          });
          after = outcome.verdict;
          findingIds = outcome.findings.map((finding) => finding.id);
          invokeError = outcome.invokeError;
        }
      }
      rows.push({
        caseId: pair.caseId,
        attempt: pair.attempt,
        oracle: pair.oracle,
        before,
        beforeFindingIds: readStoredFindings(pair.stdoutPath),
        beforeFindings: readStoredFindingObjects(pair.stdoutPath),
        after,
        delta: before === after ? 'same' : 'flip',
        findingIds,
        invokeError,
      });
    }
    sourceViolation = verifyCampaignUnchanged(digestBefore, campaignDir);
  } finally {
    if (!options.keepWorkspaces) {
      fs.rmSync(sessionDir, { recursive: true, force: true });
    } else {
      stdout(`tt-oracle-replay: workspace kept at ${sessionDir}`);
    }
  }

  const summary = {
    pairs: rows.length,
    flips: rows.filter((row) => row.delta === 'flip').length,
    unchanged: rows.filter((row) => row.delta === 'same').length,
    invoke_failures: rows.filter((row) => row.invokeError !== null).length,
    source_campaign_unchanged: sourceViolation === null || sourceViolation.length === 0,
  };

  stdout(renderTable(rows));
  stdout(renderSummary(rows));
  const invariants = options.verifyInvariants === true
    ? verifyReplayInvariants({ rows, campaignDir, campaignCaseIds: pairs.map((pair) => pair.caseId) })
    : null;
  if (invariants !== null) {
    stdout(renderInvariantReport(invariants));
    for (const violation of invariants.violations) stderr(`tt-oracle-replay invariant violation: ${violation}`);
  }
  const s26 = options.verifyS26Invariants === true
    ? verifyS26Invariants({ rows })
    : null;
  if (s26 !== null) {
    stdout(renderS26Report(s26));
    for (const violation of s26.violations) stderr(`tt-oracle-replay S26 invariant violation: ${violation}`);
  }
  const s27 = options.verifyS27Invariants === true
    ? verifyS27Invariants({ rows, campaignDir, campaignCaseIds: pairs.map((pair) => pair.caseId) })
    : null;
  if (s27 !== null) {
    stdout(renderS27Report(s27));
    for (const violation of s27.violations) stderr(`tt-oracle-replay S27 invariant violation: ${violation}`);
  }
  if (options.jsonPath !== null) {
    const payload = { tool: 'tt-oracle-replay', campaign: campaignDir, rows, summary };
    if (invariants !== null) payload.invariants = invariants;
    if (s26 !== null) payload.s26 = s26;
    if (s27 !== null) payload.s27 = s27;
    fs.writeFileSync(options.jsonPath, `${JSON.stringify(payload, null, 2)}\n`);
    stdout(`tt-oracle-replay: machine-readable rows written to ${options.jsonPath}`);
  }
  if (sourceViolation !== null && sourceViolation.length > 0) {
    stderr(`tt-oracle-replay: SOURCE CAMPAIGN MODIFIED during replay: ${sourceViolation.join(', ')}`);
    return 1;
  }
  if (rows.length > 0 && rows.every((row) => row.invokeError !== null)) {
    stderr('tt-oracle-replay: no pair could be invoked (every row recorded an invocation error)');
    return 1;
  }
  if (invariants !== null && !invariants.ok) {
    stderr(`tt-oracle-replay: E3.B invariant verification FAILED (${invariants.violations.length} violation(s))`);
    return 1;
  }
  if (s26 !== null && !s26.ok) {
    stderr(`tt-oracle-replay: S26 invariant verification FAILED (${s26.violations.length} violation(s))`);
    return 1;
  }
  if (s27 !== null && !s27.ok) {
    stderr(`tt-oracle-replay: S27 invariant verification FAILED (${s27.violations.length} violation(s))`);
    return 1;
  }
  return 0;
}

function main() {
  let options;
  try {
    options = parseArgs(process.argv.slice(2));
  } catch (error) {
    process.stderr.write(`tt-oracle-replay: ${error.message}\n`);
    process.exitCode = 1;
    return;
  }
  if (options.help === true) {
    process.stdout.write(`${usage()}\n`);
    process.exitCode = 0;
    return;
  }
  try {
    process.exitCode = replayCampaign(options);
  } catch (error) {
    process.stderr.write(`tt-oracle-replay: ${error.message}\n`);
    process.exitCode = 1;
  }
}

if (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) {
  main();
}
