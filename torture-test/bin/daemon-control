#!/usr/bin/env bash
# daemon-control — the ONLY sanctioned start/stop/restart/status/reset-state
# path for torture-test daemons (spec 01 §Daemon containment, spec 12
# §daemon-control).
#
# Usage: daemon-control <real|scripted> <start|stop|restart|status|reset-state>
#
# Applies the matching env script (tt-env.sh or tt-env-scripted.sh) to
# spawned processes ONLY — never mutates the caller's env.
#
# Production guards: refuses absolutely to touch production ports
# 3334/3338/3339 or the real ~/.tamandua, and fails CLOSED (FIX10 US-004)
# when a kind's resolved HOME or TAMANDUA_STATE_DIR escapes
# torture-test/var — so a daemon can never be started under an uncontained
# HOME (the 2026-08-05 ~/.gitconfig breach surface).
#
# E3.C.1 US-004: every signal (SIGTERM/SIGKILL escalation, lingering-listener
# cleanup) is gated on the RECORDED process-start identity — the daemon's
# startTime is recorded in provenance at start and must match the pid's
# current /proc starttime before any signal; a stale/reused pid is refused,
# never signalled (a cwd/cmdline-only match is never sufficient).
#
# Where systemd-run --user --scope is available, starts daemons inside
# dedicated named scopes and re-asserts cgroup membership after every
# start/restart, recording provenance to
# torture-test/var/daemon-control/<name>.json. When systemd is unavailable
# (or TT_FORCE_NO_SYSTEMD=1 forces the fallback — MACP4 US-001), starts the
# daemon as a plain nohup background process; that fallback path applies the
# SAME contained PATH reconstruction (contained_path_for_kind, S24/US-006)
# and records provenance with cgroupVerified=false.
#
# MACP4 US-001: the port liveness probes (wait_for_port/is_port_listening)
# are SOURCED from the shared address-exact helper
# (torture-test/lib/port-probe.sh) — a `node -e` net.connect to 127.0.0.1
# with a bounded 1s in-process timeout. The old GNU-`timeout` dependent
# `timeout 1 bash -c "echo >/dev/tcp/..."` probe is a linux-ism (macOS
# ships no `timeout`), and the old 127.0.0.1-then-::1 fallback is replaced
# by the helper's address-exact semantics, so every scripted
# start/status/stop works on Darwin. Node is already a hard runtime
# dependency (tt-process-identity), so the probe adds no new requirement
# and behaves identically on linux and Darwin.
#
# MACP4 US-002 (Darwin identity/ownership + operator home):
#   - Process-start identity: on linux the identity is /proc starttime
#     (tt-process-identity 'proc:<starttime>'). On Darwin (/proc absent) the
#     identity tool falls back to `ps -p <pid> -o lstart=` ('darwin:<lstart>',
#     1-second granularity — documented in tt-process-identity.mjs), so the
#     identity-gated stop/escalation corridors (verify_recorded_identity /
#     --check) work on /proc-less hosts. Fail-closed semantics unchanged:
#     an unverifiable pid is refused, never signalled.
#   - TT-ownership evidence: verify_process_tt_owned reads /proc cwd+cmdline
#     on linux; on Darwin it uses PORTABLE evidence (`lsof -a -p <pid>
#     -d cwd -Fn` for the cwd, `ps -p <pid> -o command=` for the cmdline),
#     so CLI-auto-daemon stop (stop_cli_auto_daemon, the W2.21 restart
#     corridor) and the escalation paths still verify TT-ownership on the
#     mac. The lsof evidence probe is BOUNDED (lsof_bounded, LSOF-EVTA
#     US-006) so a stale FUSE/network mount can never wedge ownership
#     verification. Unavailable evidence -> refuse, exactly as on linux. The
#     cmdline arm does NOT require the literal 'tamandua' (S54): it accepts
#     the CLI-wrapper argv OR this repo's built daemon entry
#     ($TT_REPO_ROOT/dist/server/daemon.js — a checkout named e.g. by run
#     id carries no 'tamandua' in argv).
#   - Operator home: _tt_operator_home (REAL_TAMANDUA_STATE + the S24
#     operator_bin_dirs reorder) resolves via getent -> dscl (macOS
#     NFSHomeDirectory) -> `eval echo ~<user>` -> $HOME — the mac's
#     getent-less home, so the production guard and the PATH reorder stay
#     correct on Darwin.
#
# MACP5 US-001 (real-Darwin W2 run): the plain-background fallback start
# recorded a DEAD WRAPPER pid in provenance — on Darwin the nohup/background
# chain double-forks, so the state-dir tamandua.pid can name a wrapper that
# exits while the real daemon lives ("pid alive: false ... STATUS: UNKNOWN"
# -> scenario abort; the fail-closed status verifier was CORRECT). Fixes:
#   - cmd_start accepts a tamandua.pid candidate ONLY after the triple gate
#     verify_launched_daemon_pid: (a) kill -0 alive, (b) tt-process-identity
#     --get returns a non-empty start identity, (c) verify_process_tt_owned
#     passes. An unverified candidate (wrapper/zombie/stale) is a failed
#     launch attempt — retried within the bounded deadline, failing CLOSED
#     (exit non-zero, no provenance) when the deadline expires unverified.
#   - write_provenance refuses an empty startTime identity (exit non-zero,
#     no provenance written) instead of the old WARNING-and-continue.
#   - cmd_status is portable for /proc-less hosts: liveness via kill -0
#     alone (the linux-only `[ -d /proc/<pid> ]` requirement dropped), and
#     cmdline verification via the portable ps arm on Darwin
#     (`ps -p <pid> -o command=`) behind the TT_DC_PLATFORM seam, with the
#     /proc read retained on linux. RUNNING still requires alive AND a TT
#     daemon cmdline (S54: the literal 'tamandua' OR this repo's built
#     daemon argv under $TT_REPO_ROOT/dist/server/) AND a listening port;
#     unverifiable -> UNKNOWN.
#
# T2.1 US-009: scope unit names are PER-WORKTREE (tamandua-tt-<kind>-<hash>
# derived from the repo root), never the old fixed per-user name — a
# concurrent campaign in another worktree must not be able to stop or
# collide with this worktree's daemon scope. cmd_start additionally waits
# (bounded, TT_DAEMON_PORT_WAIT_SECONDS, default 30 — S56) for the kind's
# FIXED ports to free before launching, so concurrent worktrees serialize
# on the shared ports instead of failing their bootstrap with EADDRINUSE,
# and clears a stale tamandua.pid left by a killed daemon.
set -euo pipefail

# ── path resolution ──────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TT_DIR="$(dirname "$SCRIPT_DIR")"                        # torture-test/
TT_REPO_ROOT="$(dirname "$TT_DIR")"                      # repo root
export TT_ROOT="${TT_REPO_ROOT}/torture-test/var"

# ── shared port-probe helper (MACP4 US-001) ──────────────────────────
# The port liveness probes (port_probe / is_port_listening /
# wait_for_port) are sourced from the shared address-exact helper —
# a `node -e` net.connect to 127.0.0.1 with a bounded 1s in-process
# timeout (no GNU `timeout`, no `localhost` hostname lookup, no ::1
# fallback). daemon-control no longer carries an inline net.connect
# probe body; the helper is the single canonical definition for the
# whole suite (also sourced by tt-daemon-up).
. "$TT_DIR/lib/port-probe.sh"

# ── bounded lsof probes (LSOF-EVTA US-006) ───────────────────────────
#
# lsof walks the kernel's process/file tables and can block FOREVER inside
# the kernel on a host with a stale FUSE or network mount (the 2026 vaivm
# incident left 24 lsof processes wedged for five days, hanging every
# caller with them). macOS ships no GNU `timeout`, so EVERY lsof probe in
# this tool goes through lsof_bounded: `lsof -b -w <args>` runs in the
# BACKGROUND with its stdout redirected to a temp file, is polled for up
# to TT_LSOF_TIMEOUT_S seconds (default 5), and is SIGKILLed AND reaped
# (`wait`) when the bound expires. `-b` avoids blocking kernel calls and
# `-w` suppresses warnings; both flags exist on the BSD (macOS) and GNU
# lsof.
#
# Evidence contract: a completed probe prints lsof's stdout and returns 0.
# A timed-out probe prints NOTHING (partial output is discarded, never
# treated as evidence) and returns 1 AFTER the child is killed and reaped;
# a host without lsof also returns 1. Callers MUST treat a non-zero return
# as NO EVIDENCE (fail-closed) — never as "no open file" / "no listener".
# The timeout also prints a degradation line to stderr so operators can
# see the blocked probe.

# tt_lsof_timeout_s: the bounded seconds a single lsof probe may run.
# TT_LSOF_TIMEOUT_S overrides it; a blank / non-numeric / non-positive
# value falls back to the default (an unbounded probe is impossible). The
# default is a local literal so the function is self-contained (the
# hermetic self-tests extract and run it in isolation).
tt_lsof_timeout_s() {
  local default_s=5
  local v="${TT_LSOF_TIMEOUT_S:-}"
  case "$v" in
    ''|*[!0-9]*) v="$default_s" ;;
  esac
  if [ "$v" -lt 1 ] 2>/dev/null; then
    v="$default_s"
  fi
  printf '%s' "$v"
}

# lsof_bounded <lsof-arg>...: run `lsof -b -w <args>` under the hard bound
# and print its stdout. Prints nothing (and returns 1) when the probe times
# out or lsof is unavailable — fail-closed for every caller.
lsof_bounded() {
  local timeout_s
  timeout_s="$(tt_lsof_timeout_s)"
  if ! command -v lsof >/dev/null 2>&1; then
    return 1
  fi
  local out_file
  out_file="$(mktemp "${TMPDIR:-/tmp}/tt-daemon-control-lsof.XXXXXX")" || return 1
  lsof -b -w "$@" > "$out_file" 2>/dev/null &
  local child_pid=$!
  local max_ticks=$(( timeout_s * 10 ))
  local ticks=0
  while kill -0 "$child_pid" 2>/dev/null; do
    if [ "$ticks" -ge "$max_ticks" ]; then
      kill -KILL "$child_pid" 2>/dev/null || true
      wait "$child_pid" 2>/dev/null || true
      rm -f "$out_file"
      echo "daemon-control: lsof probe timed out after ${timeout_s}s — no evidence (fail-closed)" >&2
      return 1
    fi
    sleep 0.1
    ticks=$(( ticks + 1 ))
  done
  wait "$child_pid" 2>/dev/null || true
  cat "$out_file"
  rm -f "$out_file"
  return 0
}

# Process-start identity CLI (E3.C.1 US-001/US-004): the ONLY sanctioned
# way to read/verify a pid's /proc starttime identity. Every signal
# daemon-control fires is gated on a recorded identity verified through
# this tool — never on cwd/cmdline evidence alone.
IDENTITY_TOOL="$SCRIPT_DIR/tt-process-identity.mjs"

# Env script paths (TT_DC_ENV_* overrides are the MACP7 US-001 test seam:
# daemon-control.test.sh's containment-refusal case points the SCRIPTED
# spawn env at a fake env script whose TAMANDUA_STATE_DIR escapes
# torture-test/var, and asserts reset-state fails closed through
# guard_kind_containment with the escape target untouched. Unset in
# production = the bundled env scripts; the seam changes nothing unless
# explicitly set).
TT_ENV_REAL="${TT_DC_ENV_REAL:-$TT_DIR/env/tt-env.sh}"
TT_ENV_SCRIPTED="${TT_DC_ENV_SCRIPTED:-$TT_DIR/env/tt-env-scripted.sh}"

# Provenance directory
PROV_DIR="$TT_ROOT/daemon-control"

# Production ports (spec 01: real daemon on 43xx; production is 33xx)
PROD_PORTS="3334 3338 3339"
# Real tamandua state dir (the production ~/.tamandua that must NEVER be
# touched). Resolved from the OPERATOR's actual home (via the uid's passwd
# entry), NOT from $HOME: when the contained spawn env (env/tt-env.sh) is in
# force, $HOME is the CONTAINED home (torture-test/var/home) and deriving the
# production path from it would misclassify the contained state dir as
# production (and refuse to manage the real TT daemon). The fallback chain
# (MACP4 US-002) keeps the guard intact on Darwin, where getent is absent.

# resolve_operator_home: the OPERATOR's real home directory, resolved
# INDEPENDENTLY of $HOME (the contained spawn env overrides HOME to
# torture-test/var/home... — deriving the production path from $HOME would
# misclassify the contained state dir as production). MACP4 US-002 fallback
# chain (the tt-provision-home convention, extended with the shell tilde
# step):
#   1. getent passwd <uid>            (linux passwd db)
#   2. dscl . -read /Users/<user> NFSHomeDirectory
#                                     (macOS directory service — getent absent)
#   3. shell tilde expansion of the named user (`eval echo ~<user>`)
#                                     (works with no getent AND no dscl)
#   4. $HOME last resort
# Every step fails closed to the next; the TRUE operator home is what keeps
# REAL_TAMANDUA_STATE (the production guard) and operator_bin_dirs (the S24
# PATH reorder) correct on both platforms.
resolve_operator_home() {
  # CRED-SURF US-003 test seam: TT_DC_OPERATOR_HOME pins the OPERATOR home
  # (mirrors the tt-provision-home TT_OPERATOR_HOME seam) so red-arm tests
  # can point the hermes-dotenv credential source at a fixture with a fake
  # ~/.hermes/.env. Unset in production = the real operator home.
  if [ -n "${TT_DC_OPERATOR_HOME:-}" ]; then
    printf '%s' "$TT_DC_OPERATOR_HOME"
    return 0
  fi
  local pw_home
  pw_home="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || true)"
  if [ -n "$pw_home" ]; then
    printf '%s' "$pw_home"
    return 0
  fi
  # macOS fallback: getent is absent; read the NFS home directory via dscl.
  if command -v dscl >/dev/null 2>&1; then
    pw_home="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
    if [ -n "$pw_home" ]; then
      printf '%s' "$pw_home"
      return 0
    fi
  fi
  # Shell tilde expansion of the named user — no getent, no dscl needed.
  # An unknown user leaves the literal `~<user>` (or a bare `~` when the
  # command substitution is empty); only a real absolute home is accepted.
  pw_home="$(eval echo ~"$(id -un)" 2>/dev/null || true)"
  case "$pw_home" in
    '~'*|'') ;; # unknown user / empty — fall through
    *) printf '%s' "$pw_home"; return 0 ;;
  esac
  printf '%s' "${HOME:-}"
}

_tt_operator_home="$(resolve_operator_home)"
REAL_TAMANDUA_STATE="${_tt_operator_home:-${HOME}}/.tamandua"

# CRED-SURF US-003: OPERATOR_HOME is the READ-ONLY hermes-dotenv credential
# source for the contained REAL spawn env (env_for_kind below). Same
# resolution as REAL_TAMANDUA_STATE — the operator's REAL home (never the
# contained $HOME override), pinned by TT_DC_OPERATOR_HOME in red-arm tests.
# The contained env never writes under OPERATOR_HOME; only the EXACT
# enumerated `KEY=VALUE` line is read from OPERATOR_HOME/.hermes/.env.
OPERATOR_HOME="$_tt_operator_home"

# ── production guards ─────────────────────────────────────────────────

# is_production_port: checks if a port number is a production port.
is_production_port() {
  local port="$1"
  for p in $PROD_PORTS; do
    if [ "$port" = "$p" ]; then return 0; fi
  done
  return 1
}

# is_production_cwd: checks if a directory is the REAL ~/.tamandua or
# under the real HOME/.tamandua (i.e. NOT a TT-contained path). Returns
# 0 if it IS production (dangerous), 1 if safe.
is_production_cwd() {
  local dir="$1"
  # Absolute realpath of the directory being checked
  local rp
  rp="$(cd "$dir" 2>/dev/null && pwd || true)"
  if [ -z "$rp" ]; then return 1; fi
  # Real ~/.tamandua
  local real_state
  real_state="$(cd "$REAL_TAMANDUA_STATE" 2>/dev/null && pwd || true)"
  if [ -n "$real_state" ] && [ "$rp" = "$real_state" ]; then return 0; fi
  # Under TT_ROOT is safe
  local tt_root_rp
  tt_root_rp="$(cd "$TT_ROOT" 2>/dev/null && pwd || true)"
  if [ -n "$tt_root_rp" ]; then
    case "$rp" in
      "$tt_root_rp"|"$tt_root_rp"/*) return 1 ;; # TT-contained = safe
    esac
  fi
  # Anything else under the real HOME that ends with .tamandua is suspect,
  # EXCEPT worktrees (which live at ~/.tamandua/worktrees/ and are part of
  # the development workspace, not the production state).
  case "$rp" in
    "$HOME/.tamandua") return 0 ;;
    "$HOME/.tamandua/worktrees"|"$HOME/.tamandua/worktrees"/*) return 1 ;;
    "$HOME/.tamandua"/*) return 0 ;;
  esac
  return 1
}

# production_target: checks if a (port, cwd) pair targets production.
# Returns 0 if it IS production (block!), 1 if safe.
production_target() {
  local port="$1"
  local cwd="$2"
  if is_production_port "$port"; then return 0; fi
  if is_production_cwd "$cwd"; then return 0; fi
  return 1
}

# refuse_production: prints an error message and exits 1 with a clear
# explanation of which guard tripped.
refuse_production() {
  local reason="$1"
  cat >&2 <<EOF
daemon-control: REFUSING — production guard tripped.
  Reason: $reason
  This tool is designed to ONLY manage torture-test daemons.
  It MUST NOT touch the production tamandua instance on ports 3334/3338/3339
  or the real ~/.tamandua state directory.
  Aborting.
EOF
  exit 1
}

# ── systemd detection ────────────────────────────────────────────────

# has_systemd_scope: checks mechanically whether systemd-run --user --scope
# is available on this host. Returns 0 (true) only when systemd-run is
# present AND a probe scope actually starts.
#
# TT_FORCE_NO_SYSTEMD=1 (MACP4 US-001) forces the plain-background fallback
# launch path even on a systemd host: it makes has_systemd_scope return
# false so cmd_start uses the nohup spawn — the platform-neutral path that
# Darwin always takes. The W2 scripted cells must be provable through BOTH
# launch paths on linux; this override is the mechanical forcing for the
# fallback proof. Default behavior on systemd hosts is unchanged.
has_systemd_scope() {
  if [ "${TT_FORCE_NO_SYSTEMD:-}" = "1" ]; then
    return 1
  fi
  if command -v systemd-run >/dev/null 2>&1; then
    if systemd-run --user --scope --quiet true 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

# ── env script application ───────────────────────────────────────────

# CRED-SURF US-003 — enumerated harness API-key env map (env var name ->
# provider name), identical to tt-provision-home's PI_ENV_API_KEY_MAP. The
# contained REAL daemon is started under `env -i` (no operator env
# inherited), so the enumerated keys are surfaced into the contained spawn
# env (credential_env_lines below): the contained daemon AND its dsh workers
# then resolve their credentials from the environment (dsh-llm-deepseek
# default apiKeyEnv DEEPSEEK_API_KEY; dsh-credentials-local inherited-env
# layer wins) — the tier-2 dsh lane's MISSING_CREDENTIAL abort is fixed.
PI_ENV_API_KEY_MAP=(
  "ANTHROPIC_API_KEY|anthropic"
  "ANT_LING_API_KEY|ant-ling"
  "OPENAI_API_KEY|openai"
  "DEEPSEEK_API_KEY|deepseek"
  "NVIDIA_API_KEY|nvidia"
  "GEMINI_API_KEY|google"
  "MISTRAL_API_KEY|mistral"
  "GROQ_API_KEY|groq"
  "CEREBRAS_API_KEY|cerebras"
  "XAI_API_KEY|xai"
  "OPENROUTER_API_KEY|openrouter"
  "AI_GATEWAY_API_KEY|vercel-ai-gateway"
  "ZAI_API_KEY|zai"
  "MINIMAX_API_KEY|minimax"
  "HF_TOKEN|huggingface"
  "FIREWORKS_API_KEY|fireworks"
  "TOGETHER_API_KEY|together"
  "KIMI_API_KEY|kimi-coding"
  "OPENCODE_API_KEY|opencode"
)

# read_hermes_dotenv_value: read EXACTLY the `KEY=VALUE` line for <envvar>
# from the operator's real ~/.hermes/.env (read-only) and print its VALUE.
# Mirrors tt-provision-home / tt-harness-auth-probe verbatim: the file is
# NEVER copied, only the enumerated `KEY=` line is read; comments, blank
# lines, and non-enumerated lines are ignored; nothing is ever written to
# the operator's HOME. A leading `export ` prefix and matching surrounding
# quotes (dotenv conventions) are tolerated; the printed value is the
# unquoted key. Prints nothing (absent) when the file or the key line is
# missing.
read_hermes_dotenv_value() {
  local envvar="$1" dotenv="$2"
  [ -f "$dotenv" ] || return 0
  local line val
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    case "$line" in
      export[[:space:]]*)
        line="${line#export}"
        line="${line#"${line%%[![:space:]]*}"}"
        ;;
    esac
    case "$line" in
      "${envvar}="*)
        val="${line#${envvar}=}"
        case "$val" in
          '"'*'"') val="${val#\"}"; val="${val%\"}" ;;
          "'"*"'") val="${val#\'}"; val="${val%\'}" ;;
        esac
        [ -n "$val" ] || return 0
        printf '%s' "$val"
        return 0
        ;;
    esac
  done < "$dotenv"
  return 0
}

# credential_env_lines: print the enumerated harness API-key KEY=VALUE lines
# for the contained REAL spawn env (CRED-SURF US-003). Per-key resolution,
# in priority order:
#   env            — the key is SET in the CALLER environment (wins). This
#                    precedence must be resolved HERE, in env_for_kind's
#                    process, because the env scripts run under `env -i`
#                    and never see the caller env.
#   hermes-dotenv  — the EXACT `KEY=VALUE` line from the operator's real
#                    ~/.hermes/.env (read-only enumerated fallback for
#                    darwin non-interactive shells; never copied wholesale,
#                    never written).
#   absent         — the key is OMITTED (no error for its absence; the
#                    other enumerated keys are still forwarded).
# The values flow into the contained daemon's spawn env exclusively through
# `env -i $(env_for_kind real) ...` composition (run_under_env / cmd_start)
# — they are consumed internally, never logged, never written to provenance,
# evidence, or audit files. Keys are surfaced ONLY for the real kind: the
# scripted kind runs fake zero-token harnesses that need no credentials.
credential_env_lines() {
  local entry envvar val
  for entry in "${PI_ENV_API_KEY_MAP[@]}"; do
    envvar="${entry%%|*}"
    val="${!envvar:-}"
    if [ -z "$val" ]; then
      val="$(read_hermes_dotenv_value "$envvar" "$OPERATOR_HOME/.hermes/.env")"
    fi
    if [ -n "$val" ]; then
      printf '%s=%s\n' "$envvar" "$val"
    fi
  done
}

# env_for_kind: prints environment variables for the given kind
# (real|scripted) as KEY=VALUE lines, suitable for `env $(...)` composition.
# This NEVER sources into the caller shell.
env_for_kind() {
  local kind="$1"
  case "$kind" in
    real)
      env -i bash "$TT_ENV_REAL" print
      ;;
    scripted)
      env -i bash "$TT_ENV_SCRIPTED" print
      ;;
    *)
      echo "daemon-control: internal error — unknown kind '$kind'" >&2
      exit 2
      ;;
  esac
  # Forward additional env vars from the caller's environment — these
  # are per-scenario knobs not baked into the static env scripts.
  for v in TAMANDUA_SCRIPTED_BEHAVIORS TAMANDUA_SCRIPTED_STATE; do
    local val="${!v:-}"
    if [ -n "$val" ]; then
      printf '%s=%s\n' "$v" "$val"
    fi
  done
  # CRED-SURF US-003: surface the enumerated harness API keys into the
  # contained REAL env (env wins, else the operator's real ~/.hermes/.env
  # line, else omitted). The env scripts run under `env -i` above, so the
  # caller env is NOT visible to them — the env-wins precedence is resolved
  # HERE, in the caller-visible env_for_kind.
  if [ "$kind" = "real" ]; then
    credential_env_lines
  fi
}

# ── contained PATH reconstruction (S24 / US-006) ─────────────────────
#
# The contained daemon's launch PATH MUST carry var/adapters-bin FIRST so
# installable harness stubs (e.g. the managed pi-token-saver) resolve INSIDE
# the containment (mirroring tt-daemon-up's ADAPTERS_BIN_DIR prepend —
# tt-daemon-up line ~59). daemon-control relaunches daemons under `env -i`
# (run_under_env + cmd_start) and used to forward the CALLER's PATH verbatim
# (PATH="${PATH}"): when the controller spawns `daemon-control <kind>
# restart` with a childEnv whose PATH lacks the adapters-bin prepend
# (tt-controller executeDaemonRestart), the restarted contained daemon
# resolved the OPERATOR's ~/.local/bin/pi-token-saver — a foreign binary
# executed inside the contained run (the W3.23 containment-leak root cause
# after W3.22's restart probe). daemon-control now reconstructs the contained
# PATH itself on EVERY launch:
#   1. var/adapters-bin FIRST (created empty, idempotent; inert when empty,
#      safe when the dir does not exist yet)
#   2. the env script's PATH (the kind's node-bin prepend) when it prints one
#   3. the remaining caller PATH with any OPERATOR bin dirs (e.g.
#      ~/.local/bin) REORDERED AFTER the contained dirs — an operator binary
#      can never precede the contained prepend on a contained daemon's PATH.

# operator_bin_dirs: the operator's personal bin dirs that must never precede
# the contained dirs on a contained daemon's PATH. Prints each as a separate
# line. Resolved from the REAL operator home (resolve_operator_home — the
# getent/dscl/tilde chain, the same source as REAL_TAMANDUA_STATE, so the
# contained spawn HOME never misidentifies var/home as the operator home)
# AND from $HOME (covers a test/fake operator home; when $HOME is the
# contained home the dirs are contained — not on the contained PATH in
# practice — and reordering them is harmless).
operator_bin_dirs() {
  if [ -n "${_tt_operator_home:-}" ]; then
    printf '%s\n' "$_tt_operator_home/.local/bin" "$_tt_operator_home/bin"
  fi
  if [ -n "${HOME:-}" ]; then
    printf '%s\n' "$HOME/.local/bin" "$HOME/bin"
  fi
}

# path_has_component: 0 iff the colon-list $1 contains component $2.
path_has_component() {
  case ":$1:" in
    *":$2:"*) return 0 ;;
  esac
  return 1
}

# contained_path_for_kind: print the reconstructed contained launch PATH for
# the given kind (real|scripted). See the block comment above.
contained_path_for_kind() {
  local kind="$1"
  local adapters_bin="$TT_DIR/var/adapters-bin"
  mkdir -p "$adapters_bin"   # inert when empty; safe when it does not exist yet
  local env_path
  env_path="$(env_for_kind "$kind" | grep '^PATH=' | head -n1 | cut -d= -f2- || true)"
  local -a operator_bins=()
  local op_bin
  while IFS= read -r op_bin; do
    [ -n "$op_bin" ] && operator_bins+=("$op_bin")
  done < <(operator_bin_dirs)
  local parts=("$adapters_bin")
  local seen="$adapters_bin"
  local seg
  # env-script PATH (node-bin prepend) comes right after the contained prepend
  local -a env_segs=()
  IFS=':' read -r -a env_segs <<< "${env_path:-}"
  for seg in "${env_segs[@]:-}"; do
    [ -n "$seg" ] || continue
    if ! path_has_component "$seen" "$seg"; then
      parts+=("$seg")
      seen="$seen:$seg"
    fi
  done
  # caller PATH: operator bin dirs are pulled out and appended LAST
  local -a caller_segs=()
  IFS=':' read -r -a caller_segs <<< "${PATH:-}"
  local -a extra=()
  local is_operator=false
  for seg in "${caller_segs[@]:-}"; do
    [ -n "$seg" ] || continue
    if path_has_component "$seen" "$seg"; then continue; fi
    is_operator=false
    for op_bin in "${operator_bins[@]:-}"; do
      if [ "$seg" = "$op_bin" ]; then is_operator=true; break; fi
    done
    if $is_operator; then
      extra+=("$seg")          # moved AFTER the contained dirs
    else
      parts+=("$seg")
    fi
    seen="$seen:$seg"
  done
  # operator bin dirs LAST — never before the contained prepend
  for op_bin in "${extra[@]:-}"; do
    parts+=("$op_bin")
  done
  local out=""
  for seg in "${parts[@]:-}"; do
    out="$out${out:+:}$seg"
  done
  printf '%s' "$out"
}

# run_under_env: runs a command under the spawn env for the given kind.
# Usage: run_under_env <real|scripted> <cmd...>
run_under_env() {
  local kind="$1"
  shift
  env -i $(env_for_kind "$kind") PATH="$(contained_path_for_kind "$kind")" "$@"
}

# ── S55: the contained daemon MUST run the WORKTREE/checkout dist ─────
#
# Every contained daemon launch (cmd_start launch script, the graceful
# dashboard/mcp CLI stops) invokes the repo's OWN bin/tamandua by ABSOLUTE
# path — NEVER a PATH lookup. A PATH lookup could resolve an installed build
# from ANOTHER checkout (the S55 defect: a campaign's contained daemon
# silently ran the operator's installed dist — tt-daemon-up's S15 parity
# guard only caught it AFTER the fact on the real kind, and the scripted
# kind had no guard at all). bin/tamandua is a wrapper around
# <TT_REPO_ROOT>/dist/cli/cli.js, so launching it by absolute path guarantees
# the daemon runs the checkout's OWN dist.
#
# Test seam: hermetic fake-CLI fixtures (tier1-s56-daemon-stop-wait and the
# tier1-s54 lifecycle arm) model the product CLI with a fake shim and point
# TT_DC_TAMANDUA_BIN at it — the fake cannot live at the real
# $TT_REPO_ROOT/bin/tamandua.

# resolve_tt_cli: print the resolved contained-daemon launcher CLI —
# TT_DC_TAMANDUA_BIN (test seam / hermetic fake fixtures) or
# $TT_REPO_ROOT/bin/tamandua (the worktree's own CLI, never a PATH lookup).
resolve_tt_cli() {
  printf '%s' "${TT_DC_TAMANDUA_BIN:-$TT_REPO_ROOT/bin/tamandua}"
}

# fetch_dc_health_version: GET <ctrl>/control/health via `node -e` fetch (no
# curl dependency; node is guaranteed — daemon-control already requires it).
# Prints the trimmed buildVersion on success, NOTHING on failure (non-JSON,
# connection refused, timeout, missing field). Never exits non-zero so set -e
# can not be tripped by a degraded daemon.
fetch_dc_health_version() {
  local port="$1"
  node -e '
    const port = Number(process.argv[1]);
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 2000);
    const done = () => clearTimeout(timer);
    fetch(`http://127.0.0.1:${port}/control/health`, { signal: ctrl.signal })
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error("http " + res.status))))
      .then((body) => {
        if (body && typeof body.buildVersion === "string") process.stdout.write(body.buildVersion.trim());
      })
      .catch(() => {})
      .finally(done);
  ' "$port"
}

# resolve_dc_expected_version: the LAUNCHING CLI's own dist version — the
# version file of the checkout whose bin/tamandua launches the daemon
# (TT_DC_EXPECTED_VERSION_FILE test seam, default <TT_REPO_ROOT>/dist/version,
# mirroring tt-daemon-up's TT_DAEMON_EXPECTED_VERSION_FILE). Empty when the
# file is missing/empty (caller fails closed — an unverifiable expected
# version is never a silent pass).
resolve_dc_expected_version() {
  local vf="${TT_DC_EXPECTED_VERSION_FILE:-$TT_REPO_ROOT/dist/version}"
  if [ -f "$vf" ]; then
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$vf"
  fi
}

# verify_launch_dist_parity: S55 dist/version parity gate — the daemon a
# launch produced must report a /control/health buildVersion EQUAL to the
# launching CLI's dist version (the checkout whose bin/tamandua launched it).
# A mismatch or an unverifiable health response is a parity failure (a
# worktree whose dist differs from the installed checkout must never make a
# campaign run against the WRONG daemon). Sets the global DC_PARITY_OBSERVED
# (observed version, or empty when the health query failed) for the
# fail-closed DETAILS and the provenance record. Returns 0 on parity, 1 on
# mismatch OR unverifiable health OR unresolvable expected version.
DC_PARITY_OBSERVED=""
verify_launch_dist_parity() {
  local ctrl_port="$1"
  DC_PARITY_OBSERVED="$(fetch_dc_health_version "$ctrl_port")"
  local expected
  expected="$(resolve_dc_expected_version)"
  if [ -z "$expected" ]; then
    echo "daemon-control: dist/version parity: no expected version (TT_DC_EXPECTED_VERSION_FILE / <TT_REPO_ROOT>/dist/version missing or empty) — cannot verify, fail closed (classified as infrastructure, never a product fault)" >&2
    return 1
  fi
  if [ -z "$DC_PARITY_OBSERVED" ]; then
    echo "daemon-control: dist/version parity: health query on control port $ctrl_port failed (non-JSON/refused/timeout) — fail closed, never launch against an unverifiable daemon (classified as infrastructure, never a product fault)" >&2
    return 1
  fi
  if [ "$DC_PARITY_OBSERVED" != "$expected" ]; then
    echo "daemon-control: dist/version parity: MISMATCH — daemon reports '$DC_PARITY_OBSERVED', the launching CLI dist is '$expected' (control port $ctrl_port): the contained daemon did NOT run this checkout dist (classified as infrastructure, never a product fault)" >&2
    return 1
  fi
  echo "daemon-control: dist/version parity: OK (daemon build '$DC_PARITY_OBSERVED' matches the launching CLI dist '$expected')." >&2
  return 0
}

# read_lifecycle_daemon_start: parse the NEWEST "daemon.start" entry from the
# contained daemon's lifecycle.log (<state_dir>/lifecycle.log — the product
# journals one JSON line per daemon lifecycle action; the daemon.start entry
# carries the running dist version AND callerArgv = the daemon entry argv
# `node <TT_REPO_ROOT>/dist/server/daemon.js`, which names the dist that
# ran). Prints compact JSON {"version": "...", "callerArgv": [...]} — both
# fields empty when the journal is absent or has no daemon.start entry yet
# (hermetic fake-CLI fixtures journal nothing). Never exits non-zero.
read_lifecycle_daemon_start() {
  local state_dir="$1"
  node -e '
    const fs = require("fs");
    const stateDir = process.argv[1];
    const file = stateDir + "/lifecycle.log";
    let last = null;
    try {
      const lines = fs.readFileSync(file, "utf8").split(/\r?\n/);
      for (const line of lines) {
        if (line.indexOf("daemon.start") < 0) continue;
        try { last = JSON.parse(line); } catch (e) { /* skip unparseable line */ }
      }
    } catch (e) { /* no journal */ }
    const version = last && typeof last.version === "string" ? last.version : "";
    const callerArgv = last && Array.isArray(last.callerArgv) ? last.callerArgv : [];
    process.stdout.write(JSON.stringify({ version, callerArgv }));
  ' "$state_dir"
}

# ── directory setup ──────────────────────────────────────────────────

ensure_prov_dir() {
  mkdir -p "$PROV_DIR"
}

# ── port extraction for a given kind ─────────────────────────────────

ports_for_kind() {
  local kind="$1"
  case "$kind" in
    real)     echo "4334 4338 4339" ;;
    scripted) echo "5334 5338 5339" ;;
  esac
}

dashboard_port_for_kind() {
  local kind="$1"
  case "$kind" in
    real)     echo "4334" ;;
    scripted) echo "5334" ;;
  esac
}

# ── production guard check for a given kind ──────────────────────────

guard_kind_ports() {
  local kind="$1"
  local ports; ports="$(ports_for_kind "$kind")"
  for port in $ports; do
    if is_production_port "$port"; then
      refuse_production "kind '$kind' port $port is a production port"
    fi
  done
}

guard_kind_cwd() {
  local kind="$1"
  local state_dir
  state_dir="$(env_for_kind "$kind" | grep '^TAMANDUA_STATE_DIR=' | cut -d= -f2-)"
  if [ -n "$state_dir" ] && is_production_cwd "$state_dir"; then
    refuse_production "kind '$kind' state dir '$state_dir' is production"
  fi
}

# ── FIX10 US-004 fail-closed containment guard ──────────────────────

# resolve_contained_dir: resolve $1 to a real (symlink-free) directory path,
# walking up to the nearest EXISTING ancestor when the path itself does not
# exist yet (fresh checkout: var/home-scripted is provisioned at daemon
# start, but a guard may run before that). Mirrors the US-003
# resolveExistingRealPath semantics in bin/tt-containment.mjs: a
# not-yet-provisioned contained home is judged by where it WILL live (inside
# var), never by the operator's real HOME. Prints the resolved path on
# success, nothing on failure.
resolve_contained_dir() {
  local candidate="$1"
  while [ ! -e "$candidate" ] && [ "$candidate" != "/" ]; do
    candidate="$(dirname "$candidate")"
  done
  if [ -d "$candidate" ]; then
    (cd "$candidate" && pwd -P)
  fi
}

# guard_kind_containment: fails CLOSED unless the kind's resolved HOME and
# TAMANDUA_STATE_DIR are STRICTLY inside torture-test/var ($TT_ROOT).
#
# WHY: a daemon whose spawn env resolves outside var would run tamandua
# agents under a HOME the operator does not control — and a git-identity
# write under such a HOME is exactly the 2026-08-05 ~/.gitconfig breach
# surface (an uncontained HOME redirected the hook's --global write to the
# OPERATOR's real config). The env scripts are static, but a tampered env
# script, a broken TT_REPO_ROOT, or a future env override must never fall
# through to a daemon spawn with an escaping HOME. Refuse before any start.
guard_kind_containment() {
  local kind="$1"
  local spawn_env
  spawn_env="$(env_for_kind "$kind")"
  local tt_root_rp
  tt_root_rp="$(resolve_contained_dir "$TT_ROOT")"
  if [ -z "$tt_root_rp" ]; then
    refuse_production "cannot resolve torture-test/var containment root ($TT_ROOT)"
  fi
  local spec value rp
  for spec in HOME TAMANDUA_STATE_DIR; do
    value="$(echo "$spawn_env" | grep "^$spec=" | cut -d= -f2-)"
    if [ -z "$value" ]; then
      refuse_production "kind '$kind' spawn env $spec is unset or empty"
    fi
    rp="$(resolve_contained_dir "$value")"
    if [ -z "$rp" ]; then
      refuse_production "kind '$kind' spawn env $spec does not resolve to a directory: $value"
    fi
    if [ "$rp" = "$tt_root_rp" ]; then
      # Resolved to var itself: acceptable ONLY when the requested path is a
      # not-yet-provisioned CHILD (fresh checkout, judged by its nearest
      # existing ancestor); var itself as a live HOME is refused.
      if [ ! -e "$value" ]; then continue; fi
      refuse_production "kind '$kind' spawn env $spec is torture-test/var itself: $value"
    fi
    case "$rp/" in
      "$tt_root_rp"/*) ;;
      *)
        refuse_production "kind '$kind' spawn env $spec escapes torture-test/var: $value (resolves to $rp)"
        ;;
    esac
  done
}

# ── usage ────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
daemon-control — manage torture-test daemons (start/stop/restart/status/reset-state).

Usage: daemon-control <real|scripted> <start|stop|restart|status|reset-state>
       daemon-control --help

Manages tamandua daemons for the torture-test environment. This is the
ONLY sanctioned path for starting, stopping, restarting, checking
the status of, or resetting the state of TT daemons. Production daemons
(ports 3334/3338/3339, real ~/.tamandua) are ABSOLUTELY rejected — this
tool will never touch the live instance by construction.

Daemon kinds:
  real      The real-harness daemon (ports 4334/4338/4339, HOME=TT_HOME)
  scripted  The scripted-harness zero-token daemon (ports 5334/5338/5339,
            HOME=TT_HOME-scripted). The scripted daemon start works even
            before scripted harness runtimes are installed — harness
            resolution happens at dispatch time, not at daemon start.

Containment (T2.1 US-009):
  - The systemd scope unit name is PER-WORKTREE (tamandua-tt-<kind>-<hash>
    derived from the repo root), so concurrent campaigns in different
    worktrees never stop or collide with each other's daemon scope.
  - The kind's ports are FIXED (shared per user); cmd_start waits (bounded,
    TT_DAEMON_PORT_WAIT_SECONDS, default 30s — S56) for them to free before
    launching, so concurrent worktrees serialize instead of failing the
    bootstrap with EADDRINUSE. A stale tamandua.pid left by a killed daemon
    is cleared before launch.
  - The contained launch PATH is RECONSTRUCTED on every start/restart
    (S24/US-006): var/adapters-bin FIRST, then the env script's PATH, then
    the remaining caller PATH with any OPERATOR bin dirs (e.g. ~/.local/bin)
    reordered AFTER the contained dirs — a foreign operator binary can never
    be resolved before the contained prepend on a contained daemon's PATH.

Commands:
  start     Start the daemon inside a systemd user scope (when available)
            or as a plain background process. Records provenance to
            torture-test/var/daemon-control/<name>.json, including the
            daemon's process-start identity (startTime).
  stop      Stop the daemon gracefully via tamandua CLI, escalating only
            to identity-verified process signals: the recorded startTime
            must match the pid's current /proc starttime before ANY
            SIGTERM/SIGKILL (E3.C.1 US-004) — a stale/reused provenance
            pid is refused, never signalled. Lingering port listeners are
            killed only when they are the recorded daemon with a matching
            identity; unconfirmed listeners (decoy cwd/cmdline matches)
            are refused.
  restart   Stop then start, re-asserting cgroup membership after start.
  status    Report daemon running state (RUNNING/STOPPED/UNKNOWN) from
            provenance file and liveness checks.
  reset-state
            Reset the CONTAINED SCRIPTED state (torture-test/var/
            home-scripted/.tamandua — DB, events, run bookkeeping) to a
            known-clean empty state dir, so a campaign attempt starts with
            no stale orphaned runs from a previous attempt (MACP7: a
            restarted scripted daemon must never recover yesterday's runs
            or collide with fresh registrations). SCRIPTED-ONLY: kind=real
            is refused — this operation must never touch
            var/home/.tamandua (the real contained state) or the
            operator's ~/.tamandua. The state dir is resolved from the
            spawn env and verified strictly inside torture-test/var before
            any removal (fail closed via guard_kind_containment + an
            in-operation containment re-check). Refuses (non-zero) while
            the scripted daemon is RUNNING (identity-verified) or a live
            identity-verified daemon is recorded in the state-dir pidfile;
            stop it first (tolerant stop), then reset. Prints the
            machine-parseable marker STATUS: RESET_STATE_OK on success.

Environment:
  Spawn env is applied ONLY to the tamandua process, never to the caller.
  - real:     torture-test/env/tt-env.sh
  - scripted: torture-test/env/tt-env-scripted.sh
  CRED-SURF US-003 — dsh credential surfacing (real kind only): the
    enumerated harness API keys (PI_ENV_API_KEY_MAP: DEEPSEEK_API_KEY and
    the other pi/hermes provider keys) are surfaced into the contained REAL
    spawn env as KEY=VALUE lines. Per-key resolution: the CALLER
    environment wins, else the EXACT `KEY=VALUE` line is read from the
    operator's real ~/.hermes/.env (read-only enumerated fallback for
    darwin non-interactive shells), else the key is omitted (no error).
    This is what lets the contained real daemon AND its dsh workers resolve
    a DEEPSEEK credential (dsh-llm-deepseek default apiKeyEnv
    DEEPSEEK_API_KEY; dsh-credentials-local inherited-env layer wins) — the
    tier-2 dsh lane's MISSING_CREDENTIAL abort is fixed. The operator's
    ~/.dsh is NEVER copied, sessions/ stays out, and nothing is ever
    written under the operator's HOME. The scripted kind surfaces nothing
    (fake zero-token harnesses need no credentials).
  TT_DAEMON_CONTROL_ENV_PRINT=<real|scripted> (self-test seam, CRED-SURF
    US-003): print the full contained spawn env for the kind (env script
    lines + forwarded caller knobs + surfaced credential KEY=VALUE lines for
    real) and exit — no daemon start, no guards, no writes.
  TT_DC_OPERATOR_HOME=<dir> (self-test seam, CRED-SURF US-003): pin the
    OPERATOR home used for the hermes-dotenv credential fallback (mirrors
    tt-provision-home's TT_OPERATOR_HOME) so red-arm tests can point it at
    a fixture with a fake ~/.hermes/.env. Unset in production = the real
    operator home.
  TT_DAEMON_PORT_WAIT_SECONDS: bounded seconds cmd_start waits for the
    kind's fixed ports (scripted 5334/5338/5339, real 4334/4338/4339) to be
    free before launching (default 30 — S56: the start path must wait a
    bounded, configurable interval of >= 30s by default for port release) —
    concurrent worktrees serialize on the shared ports instead of
    EADDRINUSE-failing their bootstrap. A busy-port refusal after the bound
    is classified INFRA and names every holder's pid + cmdline.
  TT_DAEMON_STOP_WAIT_SECONDS: bounded seconds cmd_stop waits AFTER its
    graceful/escalation/scope-teardown work for the kind's fixed ports to be
    free AND the recorded dashboard/mcp/control-plane children to exit
    before it returns (default 30 — S56). A stop NEVER returns success
    while a listener is still bound or a child is still alive: residue at
    the bound is classified INFRA with the holder pid/cmdline and fails the
    stop (exit 1), so the next start cannot collide with EADDRINUSE.
  TT_LSOF_TIMEOUT_S: bounded seconds a single lsof probe may run before the
    child is SIGKILLed and reaped (default 5 — LSOF-EVTA US-006). Every
    lsof probe (the Darwin cwd ownership evidence and both port-listener
    pid extractions) goes through lsof_bounded, which always passes -b -w;
    a timed-out probe yields NO evidence (fail-closed) so a stale FUSE/
    network mount can never wedge ownership verification or a stop.
  TT_FORCE_NO_SYSTEMD=1 (MACP4 US-001): force the plain-background fallback
    launch path even on a systemd host — has_systemd_scope() returns false
    so cmd_start uses the nohup spawn (marker: "systemd not available —
    using plain background spawn") with the SAME contained PATH
    reconstruction (contained_path_for_kind, S24/US-006) and provenance
    with cgroupVerified=false. This is the launch path Darwin always takes;
    the override is the mechanical linux-side forcing for the W2 scripted
    cells' dual-path proof. Default behavior on systemd hosts is unchanged.
  S55 (which dist the contained daemon runs):
  - Contained daemons are launched by the WORKTREE's OWN bin/tamandua
    (resolve_tt_cli) — an ABSOLUTE path, never a PATH lookup that could
    resolve an installed build from another checkout. The graceful CLI stops
    use the same resolved launcher.
  - TT_DC_TAMANDUA_BIN=<path> (self-test seam, S55): point the launcher at a
    hermetic fake-CLI shim (tier1-s54/s56 lifecycle fixtures). Unset in
    production = $TT_REPO_ROOT/bin/tamandua.
  - TT_DC_HEALTH_PARITY=<0|1> (S55): when 1 (default), cmd_start fails
    closed as INFRA unless the launched daemon's /control/health
    buildVersion equals the launching CLI's dist version
    (TT_DC_EXPECTED_VERSION_FILE, default <TT_REPO_ROOT>/dist/version) — a
    daemon built from a DIFFERENT checkout is stopped and never recorded.
    Hermetic fake-CLI fixtures that cannot serve /control/health set it to 0
    (documented test seam, never a production path).
  - TT_DC_EXPECTED_VERSION_FILE=<file> (self-test seam, S55): the expected
    dist version compared against the daemon's health buildVersion (default
    <TT_REPO_ROOT>/dist/version). Mirrors tt-daemon-up's
    TT_DAEMON_EXPECTED_VERSION_FILE.
  - The provenance record (<var>/daemon-control/<kind>.json) carries which
    dist ran: daemonVersion (the parity-observed /control/health
    buildVersion), callerArgv (the daemon entry argv recorded in the
    daemon.start lifecycle journal of the contained daemon — it names the
    exact dist that ran), and launchCli (the absolute CLI that launched the
    daemon). Campaign evidence writers (state.json/report) surface these.
  Port liveness probes (wait_for_port/is_port_listening) use a PORTABLE
    node net.connect probe (port_probe) — no GNU timeout(1) dependency, so
    start/status/stop work on Darwin (macOS ships no timeout(1)).
  MACP4 US-002: on Darwin (no procfs, no getent) the daemon stop/escalation
    identity gates use a ps lstart identity source, TT-ownership evidence
    uses lsof cwd + ps command, and the operator home (REAL_TAMANDUA_STATE,
    the S24 PATH reorder) resolves via getent -> dscl -> shell tilde ->
    $HOME — all fail-closed exactly as on linux.

The systemd scope unit name is PER-WORKTREE:
  tamandua-tt-<kind>-<8-hex-cksum of TT_REPO_ROOT>
so concurrent worktrees never stop or collide with each other's daemon scope
(E3.C.2 US-002; the old fixed tamandua-tt-<kind> name let a concurrent run's
stop TERM another run's in-flight daemon launch).

Production guards:
  - Ports 3334/3338/3339 are blocked by construction.
  - Real ~/.tamandua is blocked by construction.
  - A kind whose resolved HOME or TAMANDUA_STATE_DIR escapes
    torture-test/var is refused before any daemon start (FIX10 US-004
    fail-closed containment — an uncontained HOME is the 2026-08-05
    ~/.gitconfig breach surface).
  - Any attempt to target production exits with an error.
  - The guard checks BEFORE every signal, not just at startup.
  - Every signal is gated on the recorded process-start identity
    (E3.C.1 US-004): the pid's current /proc starttime must match the
    startTime recorded in provenance, or the signal is refused. Never
    signal on cwd/cmdline evidence alone.

Examples:
  daemon-control real start        # start the real-harness TT daemon
  daemon-control real stop         # stop it gracefully
  daemon-control real restart      # stop + start with cgroup re-assertion
  daemon-control real status       # check if it's running
  daemon-control scripted start    # start the scripted TT daemon (43→53)
  daemon-control scripted reset-state  # reset the CONTAINED scripted state
  daemon-control --help            # this help
EOF
}

# ── start subcommand ─────────────────────────────────────────────────
#
# Port liveness probes (port_probe / wait_for_port / is_port_listening)
# are provided by the shared address-exact helper sourced at the top of
# this file (torture-test/lib/port-probe.sh — MACP4 US-001).
# daemon-control no longer carries an inline node net.connect probe
# body: the helper is the single source of truth, and its 127.0.0.1-only
# semantics (no `localhost` hostname resolution, no ::1 fallback) apply
# everywhere a port is checked.

# verify_cgroup: check whether PID $1 lives under the expected systemd scope
# unit name $2. Returns 0 if verified, 1 otherwise.
# linux-only /proc read (MACP5 US-001): cgroup evidence exists only on
# systemd hosts (linux) — the fallback path (Darwin) never calls this.
verify_cgroup() {
  local pid="$1"
  local scope_unit="$2"
  local cgroup_file="/proc/$pid/cgroup"
  if [ -f "$cgroup_file" ] && grep -q "$scope_unit" "$cgroup_file" 2>/dev/null; then
    return 0
  fi
  return 1
}

# verify_process_tt_owned: check that a PID belongs to the TT environment.
# $1 = PID, $2 = expected cwd from provenance (for reference; actual check
# is against TT_REPO_ROOT).
# Returns 0 if proven TT-owned, 1 otherwise.
#
# Evidence sources:
#   linux (default): /proc/$PID/cwd + /proc/$PID/cmdline (procfs — the
#     exact /proc starttime-grade evidence; MACP3 US-003 linux-only).
#   Darwin (MACP4 US-002): no procfs — PORTABLE evidence via `lsof -a -p
#     <pid> -d cwd -Fn` (the cwd, BSD/linux lsof both emit the `n<path>`
#     name row) and `ps -p <pid> -o command=` (the full command line,
#     supported by both BSD ps on macOS and procps on linux). The lsof read
#     is BOUNDED (lsof_bounded, LSOF-EVTA US-006). When the evidence is
#     unavailable (lsof/ps absent, pid dead, a foreign pid lsof cannot
#     introspect, or a timed-out lsof probe) the function REFUSES exactly
#     as the linux path does — TT-ownership must be PROVEN, never assumed.
#
# Cmdline acceptance (S54): the cmdline must NOT require the literal
# 'tamandua'. The real daemon's argv is `node <TT_REPO_ROOT>/dist/server/
# daemon.js` (daemonctl.ts startDaemon) — under a checkout whose directory
# name does not contain 'tamandua' (e.g. a worktree named by run id) that
# argv carries no 'tamandua' at all, yet the process IS this repo's daemon
# (cwd already proven under TT_REPO_ROOT). Two arms, either proves the
# cmdline:
#   (a) the literal 'tamandua' (the CLI wrapper argv — `tamandua daemon
#       start`, `node .../bin/tamandua daemon ...` — and the fake scripted
#       CLI shims, which embed 'tamandua' in argv), OR
#   (b) a script path under THIS repo's built product
#       ($TT_REPO_ROOT/dist/server/ — daemon.js, dashboard-standalone.js,
#       mcp-standalone.js, control-standalone.js — the real daemon family).
# A foreign cmdline (`node /usr/bin/server.js`, a bare `bash -c ...` with
# no repo path) is REFUSED exactly as before — TT-ownership must be PROVEN,
# never assumed; the 'tamandua' grep arm is unchanged and keeps every
# pre-S54 acceptance intact.
#
# Cmdline acceptance (S54): the cmdline must NOT require the literal
# 'tamandua'. The real daemon's argv is `node <TT_REPO_ROOT>/dist/server/
# daemon.js` (daemonctl.ts startDaemon) — under a checkout whose directory
# name does not contain 'tamandua' (e.g. a worktree named by run id) that
# argv carries no 'tamandua' at all, yet the process IS this repo's daemon
# (cwd already proven under TT_REPO_ROOT). Two arms, either proves the
# cmdline:
#   (a) the literal 'tamandua' (the CLI wrapper argv — `tamandua daemon
#       start`, `node .../bin/tamandua daemon ...` — and the fake scripted
#       CLI shims, which embed 'tamandua' in argv), OR
#   (b) a script path under THIS repo's built product
#       ($TT_REPO_ROOT/dist/server/ — daemon.js, dashboard-standalone.js,
#       mcp-standalone.js, control-standalone.js — the real daemon family).
# A foreign cmdline (`node /usr/bin/server.js`, a bare `bash -c ...` with
# no repo path) is REFUSED exactly as before — TT-ownership must be PROVEN,
# never assumed; the 'tamandua' grep arm is unchanged and keeps every
# pre-S54 acceptance intact.
#
# TT_DC_PLATFORM (MACP4 US-002 test seam): forces the evidence branch on
# any host ('Darwin' | anything else = linux /proc) so the Darwin branch
# is hermetic-testable on linux (see
# self-tests/tier1-daemon-control-darwin-identity.test.ts).
verify_process_tt_owned() {
  local pid="$1"
  local expected_cwd="$2"

  local platform
  platform="${TT_DC_PLATFORM:-$(uname -s)}"

  local actual_cwd cmdline
  case "$platform" in
    Darwin)
      # /proc-less host (macOS): portable evidence. `lsof -a -p <pid>
      # -d cwd -Fn` prints the cwd as an `n<path>` row (the p<pid> row
      # and lsof fd-name row, if any, are ignored); `ps -p <pid>
      # -o command=` prints the full command line. Both are mechanical
      # and present on macOS by default (/usr/sbin/lsof, /bin/ps). The
      # lsof probe is BOUNDED (lsof_bounded, LSOF-EVTA US-006): a
      # timeout yields no cwd evidence, and the empty actual_cwd below
      # refuses ownership (fail-closed).
      actual_cwd="$(lsof_bounded -a -p "$pid" -d cwd -Fn | sed -n 's/^n//p' | head -1 || true)"
      cmdline="$(ps -p "$pid" -o command= 2>/dev/null | head -1 || true)"
      ;;
    *)
      # linux /proc evidence (unchanged)
      # Check /proc/$PID/cwd — must be under TT_REPO_ROOT
      if [ -L "/proc/$pid/cwd" ]; then
        actual_cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || true)
      fi
      # Check /proc/$PID/cmdline (linux /proc read — never reached on
      # /proc-less hosts)
      cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
      ;;
  esac

  if [ -z "$actual_cwd" ]; then
    return 1  # cannot verify — refuse
  fi

  # Must be under the TT repo root
  case "$actual_cwd" in
    "$TT_REPO_ROOT"|"$TT_REPO_ROOT"/*) ;;
    *) return 1 ;;  # not under TT repo — not ours
  esac

  if [ -z "$cmdline" ]; then
    return 1  # cannot read cmdline — refuse
  fi
  # S54: accept the CLI-wrapper tamandua argv arm OR the repo built daemon
  # entry ($TT_REPO_ROOT/dist/server/… — grep -F: the path is a literal,
  # never a regex) — never the literal-tamandua-only refusal.
  if ! { echo "$cmdline" | grep -q 'tamandua' \
      || echo "$cmdline" | grep -Fq "$TT_REPO_ROOT/dist/server/"; }; then
    return 1  # cmdline neither names tamandua nor the repo dist — refuse
  fi

  return 0
}

# verify_launched_daemon_pid: full identity+ownership gate for a pid read
# from the state-dir tamandua.pid — the daemon's OWN pidfile, the authority
# for BOTH the systemd and the plain-background fallback launch paths. A
# candidate is accepted ONLY after ALL of:
#   (a) kill -0 — the pid is alive (portable; no /proc dependency);
#   (b) `node tt-process-identity.mjs --get <pid>` returns a non-empty
#       process-start identity ('proc:<n>' on linux, 'darwin:<lstart>' on
#       /proc-less hosts — MACP4 US-002);
#   (c) verify_process_tt_owned <pid> <state_dir> — the pid is PROVEN
#       TT-owned (cwd under TT_REPO_ROOT + a TT daemon cmdline — the
#       literal 'tamandua' OR $TT_REPO_ROOT/dist/server/…, S54).
#
# MACP5 US-001: on Darwin the nohup/background chain double-forks, so the
# pidfile can name a WRAPPER pid (or a stale/zombie pid) that exits while
# the real daemon lives — the OLD acceptance (kill -0 alone) recorded that
# dead wrapper in provenance and the status verifier correctly reported
# "pid alive: false ... STATUS: UNKNOWN". An unverified candidate is
# therefore REFUSED (treated as a failed launch attempt, retried within the
# bounded deadline) — provenance must carry the REAL daemon pid, and it is
# never recorded unverified.
#
# $1 = pid, $2 = state dir (the kind's TAMANDUA_STATE_DIR).
# Returns 0 only when ALL THREE gates pass; 1 otherwise.
verify_launched_daemon_pid() {
  local pid="$1"
  local state_dir="$2"

  # (a) alive — portable liveness probe (works on /proc-less hosts).
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  # (b) identity readable — the E3.C.1/MACP4 identity tool.
  local ident
  ident="$(node "$IDENTITY_TOOL" --get "$pid" 2>/dev/null || true)"
  if [ -z "$ident" ]; then
    return 1
  fi
  # (c) TT-owned (fail-closed: ownership must be PROVEN, never assumed).
  if ! verify_process_tt_owned "$pid" "$state_dir"; then
    return 1
  fi
  return 0
}

# verify_recorded_identity: ABA-safe process-start identity check for the
# RECORDED daemon pid BEFORE any signal (E3.C.1 US-004). $1 = pid,
# $2 = recorded startTime identity ('proc:<n>' from provenance).
#
# The recorded identity is mandatory: when the provenance record carries no
# startTime the check REFUSES (fail closed — an unverifiable pid is never
# signalled). A mismatch between the recorded identity and the pid's CURRENT
# /proc starttime means the pid was reused since the daemon was recorded
# (e.g. a stale provenance pid now naming a repo-cwd tamandua CLI child of
# the worker) — refuse, never signal a reused pid.
verify_recorded_identity() {
  local pid="$1"
  local recorded="$2"
  if [ -z "$recorded" ]; then
    echo "daemon-control: REFUSING — no recorded startTime identity for PID $pid; cannot verify before signalling" >&2
    return 1
  fi
  if ! node "$IDENTITY_TOOL" --check "$pid" "$recorded" >/dev/null 2>&1; then
    echo "daemon-control: REFUSING — PID $pid startTime does not match the recorded daemon identity ($recorded); the pid may have been reused (ABA). No signal sent." >&2
    return 1
  fi
  return 0
}

# verify_listener_target: full signal-target verification for a lingering
# port listener pid (resolved by port scan, so it needs the complete US-004
# gate): pid alive, recorded startTime identity match, target is NOT an
# ancestor of daemon-control, and the target's pgid is disjoint from
# daemon-control's own pgid. $1 = pid, $2 = recorded startTime identity.
# Returns 0 when verified; prints a REFUSING reason and returns 1 otherwise.
verify_listener_target() {
  local pid="$1"
  local recorded="$2"
  local out
  out="$(node "$IDENTITY_TOOL" --verify "$pid" "$recorded" 2>&1)" || {
    echo "daemon-control: REFUSING — $out" >&2
    return 1
  }
  return 0
}

# update_provenance_after_stop: add stoppedAt and exitCode to a provenance
# JSON file. Uses jq if available, otherwise sed-based fallback.
update_provenance_after_stop() {
  local prov_file="$1"
  local exit_code="$2"
  local stopped_at
  stopped_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  if command -v jq >/dev/null 2>&1; then
    local tmp_file="${prov_file}.tmp"
    jq --arg stoppedAt "$stopped_at" --arg exitCode "$exit_code" \
      '. + {stoppedAt: $stoppedAt, exitCode: ($exitCode | tonumber)}' \
      "$prov_file" > "$tmp_file" && mv "$tmp_file" "$prov_file"
  else
    # Fallback: read file, strip closing brace, add fields
    local tmp_file="${prov_file}.tmp"
    sed '$d' "$prov_file" > "$tmp_file"
    printf ',\n  "stoppedAt": "%s",\n  "exitCode": %s\n}\n' "$stopped_at" "$exit_code" >> "$tmp_file"
    mv "$tmp_file" "$prov_file"
  fi
}

# write_provenance: write JSON provenance record to
# $PROV_DIR/$NAME.json. Uses jq if available, otherwise writes a
# minimal JSON with printf.
#
# S55 (which dist ran): the record additionally carries the daemon's dist
# version (daemonVersion — the /control/health buildVersion the launch's
# parity gate observed, or the lifecycle.log daemon.start version), the
# lifecycle callerArgv (the daemon entry argv from the daemon.start journal —
# names the exact dist that ran), and launchCli (the absolute CLI that
# launched this daemon — the worktree's own bin/tamandua). Empty/absent on
# hermetic fake-CLI fixtures (no real product journal).
write_provenance() {
  local name="$1"
  local kind="$2"
  local pid="$3"
  local ports="$4"  # space-separated
  local scope_unit="$5"
  local cgroup_ok="$6"
  local started_at="$7"
  local cmdline="$8"
  local cwd="$9"
  local start_time="${10}"  # 'proc:<n>' process-start identity (US-004)
  local daemon_version="${11:-}"
  local caller_argv_json="${12:-[]}"
  local launch_cli="${13:-}"
  local prov_file="$PROV_DIR/$name.json"

  # MACP5 US-001: provenance MUST carry the daemon's process-start identity
  # (E3.C.1 US-004 / MACP4 US-002). An empty startTime means the pid was
  # never identity-verified — recording it would let a stale/reused pid be
  # signalled later or reported RUNNING on weak evidence. FAIL CLOSED: exit
  # non-zero with NO provenance written (the caller's start is refused; the
  # next cmd_start retry starts from a clean slate).
  if [ -z "$start_time" ]; then
    echo "daemon-control: FATAL — refusing to write provenance with an empty startTime identity for PID $pid; no provenance written (fail closed)" >&2
    exit 1
  fi

  # Convert space-separated ports to a JSON array. The input MUST end with a
  # newline: `while read` treats a final line WITHOUT a trailing newline as
  # EOF-with-no-data and silently SKIPS it, so `printf '%s'` (no newline)
  # dropped the LAST port from the record — the control port 5339 for the
  # scripted kind. A stop whose provenance omits the control port sees only
  # dashboard/MCP free and returns "already stopped" while a CLI-auto-started
  # daemon still holds 5339 (the tier1 W2.21 restart failure: the cell's
  # `workflow run` auto-start holds exactly the control port, invisible to the
  # provenance-scoped stop; the next start then blocks on the busy port).
  local ports_json
  ports_json="$(printf '%s\n' "$ports" | tr ' ' '\n' | while read -r p; do [ -n "$p" ] && printf '"%s",' "$p"; done | sed 's/,$//')"
  ports_json="[$ports_json]"

  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --arg name "$name" \
      --arg kind "$kind" \
      --arg pid "$pid" \
      --argjson ports "$ports_json" \
      --arg scopeUnit "$scope_unit" \
      --arg cgroupVerified "$cgroup_ok" \
      --arg startedAt "$started_at" \
      --arg cmdline "$cmdline" \
      --arg cwd "$cwd" \
      --arg startTime "$start_time" \
      --arg daemonVersion "$daemon_version" \
      --argjson callerArgv "$caller_argv_json" \
      --arg launchCli "$launch_cli" \
      '{
        name: $name,
        kind: $kind,
        pid: ($pid | tonumber),
        ports: $ports,
        scopeUnit: $scopeUnit,
        cgroupVerified: ($cgroupVerified == "true"),
        startedAt: $startedAt,
        cmdline: $cmdline,
        cwd: $cwd,
        startTime: $startTime,
        daemonVersion: $daemonVersion,
        callerArgv: $callerArgv,
        launchCli: $launchCli
      }' > "$prov_file"
  else
    # Fallback: write JSON with printf (no jq dependency for basic operation)
    cat > "$prov_file" <<PROVEOF
{
  "name": "$name",
  "kind": "$kind",
  "pid": $pid,
  "ports": $ports_json,
  "scopeUnit": "$scope_unit",
  "cgroupVerified": $cgroup_ok,
  "startedAt": "$started_at",
  "cmdline": "$cmdline",
  "cwd": "$cwd",
  "startTime": "$start_time",
  "daemonVersion": "$daemon_version",
  "callerArgv": $caller_argv_json,
  "launchCli": "$launch_cli"
}
PROVEOF
  fi
  echo "daemon-control: provenance written to $prov_file" >&2
}

# scope_suffix_for_root: stable per-worktree scope suffix (8-hex cksum of the
# repo root) used to derive the systemd scope unit name (E3.C.2 US-002,
# mirroring the T2.1 US-009 pattern prototyped in worktree 865). The OLD unit
# name (tamandua-tt-<kind>) was FIXED and shared by every worktree, so a
# concurrent run's cmd_start pre-launch clean-slate or cmd_stop cleanup
# TERM'd another run's in-flight systemd-run daemon launch (the E3.C.2
# scripted-start SIGTERM regression: bash prints `Terminated <cmd>`, set -e
# exits 143). Deriving the unit name from TT_REPO_ROOT gives every worktree
# its own scope: no other worktree can stop or collide with it.
scope_suffix_for_root() {
  local root="$1"
  local suffix
  suffix="$(printf '%s' "$root" | cksum 2>/dev/null | awk '{printf "%08x", $1}')"
  [ -n "$suffix" ] || suffix="default"
  printf '%s' "$suffix"
}

# scope_unit_is_ours: returns 0 iff the recorded scope unit $1 is THIS
# worktree's derived per-worktree unit for kind $2 — the ONLY scope
# daemon-control may stop. A provenance record naming the OLD fixed scope
# (tamandua-tt-<kind>, shared by every worktree — the E3.C.2 collision
# surface) or a foreign worktree's unit is refused, never stopped.
scope_unit_is_ours() {
  local candidate="$1"
  local kind="$2"
  [ "$candidate" = "tamandua-tt-$kind-$(scope_suffix_for_root "$TT_REPO_ROOT")" ]
}

cmd_start() {
  local kind="$1"
  local name="$kind"

  # Gather spawn env
  local spawn_env; spawn_env="$(env_for_kind "$kind")"

  # Extract key values from spawn env
  local spawn_home;  spawn_home="$(echo "$spawn_env" | grep '^HOME=' | cut -d= -f2-)"
  local dash_port;   dash_port="$(echo "$spawn_env" | grep '^TAMANDUA_DASHBOARD_PORT=' | cut -d= -f2-)"
  local mcp_port;    mcp_port="$(echo "$spawn_env" | grep '^TAMANDUA_MCP_PORT=' | cut -d= -f2-)"
  local ctrl_port;   ctrl_port="$(echo "$spawn_env" | grep '^TAMANDUA_CONTROL_PORT=' | cut -d= -f2-)"
  local state_dir;   state_dir="$(echo "$spawn_env" | grep '^TAMANDUA_STATE_DIR=' | cut -d= -f2-)"

  # Double-check production guard (already run in main but belt-and-suspenders)
  for port in $dash_port $mcp_port $ctrl_port; do
    if [ -n "$port" ] && is_production_port "$port"; then
      refuse_production "kind '$kind' port $port is a production port"
    fi
  done
  if [ -n "$state_dir" ] && is_production_cwd "$state_dir"; then
    refuse_production "kind '$kind' state dir '$state_dir' is production"
  fi

  # Ensure state dir exists so the daemon can write its PID file
  mkdir -p "$state_dir"

  # FIX10 US-006: clear an orphaned daemon-start.lock before launching.
  # The product's startDaemon holds an O_EXCL daemon-start.lock for the whole
  # start; a launch CLI that is SIGINT'd/SIGKILL'd mid-startDaemon (a cell arm
  # killing `workflow run` at the auto-start barrier — W4.11 arm E) dies
  # without running startDaemon's finally-released lock, leaving a FRESH
  # orphaned lock. The next `tamandua daemon start` then sees the non-stale
  # lock (< 30s), waits 10s for a daemon pid that never appears
  # ("Timed out waiting for another daemon start attempt to finish") and
  # fails — the operator-campaign W4.12 bootstrap failure ("daemon-control
  # scripted start failed", ~11s, no daemon log entries). daemon-control is
  # the sanctioned starter and already does a clean-slate systemd scope
  # teardown above; the orphaned start lock must not survive into this start.
  # Safe: within a worktree, daemon-control start is serialized by the
  # scenario daemon lock, and a cell's workflow-run auto-start happens only
  # AFTER this bootstrap returns.
  rm -f -- "$state_dir/daemon-start.lock"

  # Ensure provenance directory exists
  ensure_prov_dir

  echo "daemon-control: starting $kind daemon..." >&2

  local daemon_pid_file="$state_dir/tamandua.pid"
  local use_systemd=false
  # E3.C.2 US-002: per-worktree systemd scope unit name
  # (tamandua-tt-<kind>-<8-hex-cksum of TT_REPO_ROOT>, T2.1 US-009 pattern).
  # The OLD fixed name (tamandua-tt-scripted / tamandua-tt-real) was shared
  # by every concurrent worktree, so one run's cmd_start pre-launch
  # `systemctl --user stop <old fixed scope>.scope` SIGTERM'd ANOTHER
  # run's in-flight systemd-run launch (the E3.C.2 scripted-start regression:
  # bash prints `Terminated <cmd>`, set -e exits 143). Deriving a STABLE
  # per-worktree suffix from the repo root gives each worktree its own scope
  # unit — no other worktree can stop or collide with it.
  local scope_suffix
  scope_suffix="$(scope_suffix_for_root "$TT_REPO_ROOT")"
  local scope_unit="tamandua-tt-$name-$scope_suffix"

  # Build the launch command: start daemon (control-plane+motor),
  # then dashboard, then MCP — all under the spawn env.
  #
  # S55: the launch invokes the WORKTREE's OWN bin/tamandua by ABSOLUTE path
  # (resolve_tt_cli — TT_DC_TAMANDUA_BIN seam or $TT_REPO_ROOT/bin/tamandua),
  # NEVER a bare `tamandua` PATH lookup: a PATH lookup could resolve an
  # installed build from another checkout and the campaign would silently run
  # the WRONG dist. Fail closed (INFRA) when the resolved launcher is missing
  # or not executable — no PATH-lookup fallback, ever.
  local tt_cli
  tt_cli="$(resolve_tt_cli)"
  if [ ! -f "$tt_cli" ] || [ ! -x "$tt_cli" ]; then
    echo "daemon-control: INFRA — the contained daemon launcher '$tt_cli' is missing or not executable (TT_DC_TAMANDUA_BIN / \$TT_REPO_ROOT/bin/tamandua); refusing to launch via a PATH lookup that could resolve a foreign checkout's dist — classified as infrastructure (a launch/infra failure, never a product fault)" >&2
    exit 1
  fi
  local launch_script
  launch_script="\"$tt_cli\" daemon start && \"$tt_cli\" dashboard start --port $dash_port && \"$tt_cli\" mcp start --port $mcp_port"

  # E3.C.2 US-002: bounded port-free wait BEFORE launching (both launch
  # paths). With per-worktree scope names a concurrent worktree's daemon can
  # no longer be SIGTERM'd by our clean-slate, but it may still be RUNNING
  # and holding this kind's FIXED ports (scripted 5334/5338/5339, real
  # 4334/4338/4339) — launching into a busy control port would fail the
  # daemon start with EADDRINUSE. Wait (bounded; env-overridable
  # TT_DAEMON_PORT_WAIT_SECONDS, default >= 30s — S56 requires the start
  # path to wait a bounded, configurable interval of at least 30s by
  # default) for the ports to free — the other worktree's scenario ends and
  # stops its daemon — then launch; fail with a clear INFRA diagnostic
  # naming the holder pid/cmdline if the bound is exceeded (a stuck foreign
  # daemon).
  local port_wait_seconds="${TT_DAEMON_PORT_WAIT_SECONDS:-30}"
  case "$port_wait_seconds" in
    ''|*[!0-9]*) port_wait_seconds=30 ;;
  esac
  local port_wait_deadline; port_wait_deadline=$(($(date +%s) + port_wait_seconds))
  # E3.C.2 US-004 FINDING: a busy port here may be held by the CLI-auto-
  # started daemon OF THIS WORKTREE (`workflow run` ->
  # ensureDaemonControlAvailable -> startDaemon — no provenance, no scope,
  # recorded only in the state-dir tamandua.pid; e.g. a scenario that
  # launched the run with the daemon down and then calls daemon-control
  # start). Stop it (identity-verified, per-worktree) so the wait below
  # finds the ports free; a foreign-worktree daemon or an unverifiable pid
  # is refused by the helper and the bounded wait/refusal below applies.
  stop_cli_auto_daemon "$kind"
  # Require the ports to be free STABLY (two consecutive observations
  # separated by a settle): a foreign daemon that binds inside the settle
  # window is absorbed by continuing the bounded wait instead of racing us
  # into EADDRINUSE.
  #
  # T2.1 US-010 round 2: even the settle-confirm cannot make the
  # check-then-act atomic — a foreign daemon can win a shared port in the
  # instant between the settle-recheck and OUR bind (the re-proof campaign's
  # W4.20 bootstrap failed exactly this way: the foreign scope and ours both
  # started in the same second; the foreign daemon bound first, our daemon
  # died EADDRINUSE and the pid-file wait failed the cell). The whole
  # wait+launch+verify cycle is therefore retried within the SAME bounded
  # deadline: a failed launch attempt (no live pid — foreign port contention
  # or daemon crash) tears down its scope and loops back to the stable-free
  # wait. Only a deadline expiry with no live daemon fails the start.
  local still_busy=""
  local daemon_pid=""
  # T2.1 US-010 round 3: idempotent reuse of an ALREADY-RUNNING daemon of OUR
  # OWN. A scripted cell's `workflow run` auto-starts the daemon through the
  # PRODUCT CLI (ensureDaemonControlAvailable -> startDaemon): it writes
  # $state_dir/tamandua.pid and binds the control port, but records NO
  # daemon-control provenance (the W2.23c cell restarts the daemon to ensure
  # clean state right after such an auto-start). The stable-free wait below
  # exists for FOREIGN contention, so it must NOT block on the control port
  # our own live daemon legitimately holds. Detect that case (live TT-owned
  # pid file + control port listening) and skip the wait: the launch script
  # is idempotent — `tamandua daemon start` reuses the running daemon and the
  # dashboard/MCP ports bind fresh. A foreign squatter (no live TT pid file)
  # still enters the wait and fails with the port-free diagnostic (the
  # busy-port test arms 73b/73c are unaffected).
  local reuse_running_daemon=false
  if [ -f "$daemon_pid_file" ]; then
    local running_pid
    running_pid="$(cat "$daemon_pid_file" 2>/dev/null || true)"
    # MACP5 US-001: the reuse detection uses the SAME triple gate as the
    # pid-wait acceptance (alive + identity + TT-owned) — a wrapper/stale
    # pidfile candidate is never treated as a running daemon of ours.
    if [ -n "$running_pid" ] && verify_launched_daemon_pid "$running_pid" "$state_dir" \
       && is_port_listening "$ctrl_port"; then
      reuse_running_daemon=true
      echo "daemon-control: reusing already-running $kind daemon (PID $running_pid, identity-verified, control port $ctrl_port listening)" >&2
    fi
  fi
  while [ "$(date +%s)" -lt "$port_wait_deadline" ] && [ -z "$daemon_pid" ]; do
    # MACP5 US-001: re-check the pidfile for an identity-verified pid at the
    # TOP of every iteration. On the plain-background fallback path a failed
    # launch attempt tears down NO scope, so a PREVIOUS attempt's real daemon
    # can be up and its (rewritten) pidfile carries the REAL pid — accept it
    # as our daemon instead of failing on the busy ports it holds. Only a
    # fully-launched daemon qualifies (dashboard port listening — the launch
    # script binds all three); a control-port-only CLI-auto-start is handled
    # by reuse_running_daemon below, which re-runs the launch to bind the
    # dashboard/MCP ports.
    if [ -f "$daemon_pid_file" ]; then
      local verified_pid
      verified_pid="$(cat "$daemon_pid_file" 2>/dev/null || true)"
      if [ -n "$verified_pid" ] \
         && verify_launched_daemon_pid "$verified_pid" "$state_dir" \
         && is_port_listening "$dash_port"; then
        daemon_pid="$verified_pid"
        echo "daemon-control: daemon PID $daemon_pid (identity-verified via state-dir tamandua.pid)" >&2
        break
      fi
    fi
    still_busy=""
    for port in $dash_port $mcp_port $ctrl_port; do
      if [ -n "$port" ] && is_port_listening "$port"; then still_busy="$still_busy $port"; fi
    done
    if [ -n "$still_busy" ] && ! $reuse_running_daemon; then
      sleep 1
      continue
    fi
    # Free on this pass: confirm it STAYS free across a settle so a foreign
    # daemon that binds between our check and the launch is caught here
    # (back into the bounded wait) instead of racing us.
    sleep 2
    still_busy=""
    for port in $dash_port $mcp_port $ctrl_port; do
      if [ -n "$port" ] && is_port_listening "$port"; then still_busy="$still_busy $port"; fi
    done
    if [ -n "$still_busy" ] && ! $reuse_running_daemon; then
      sleep 1
      continue
    fi
    # ── ports stable-free: launch attempt ─────────────────────────────
    # T2.1 US-009: a daemon killed by a foreign worktree's former clean-slate
    # (or SIGKILL/crash) can leave a STALE tamandua.pid (dead pid). The pid
    # wait below treats an EXISTING pid file as "daemon ready", so a stale file
    # would break the wait immediately and fail "PID is not alive". Ports are
    # free here (checked above), so any pid file is stale: remove it so the
    # launch starts a fresh wait for the NEW daemon's pid.
    if [ -f "$daemon_pid_file" ]; then
      local stale_pid
      stale_pid="$(cat "$daemon_pid_file" 2>/dev/null || true)"
      if [ -z "$stale_pid" ] || ! kill -0 "$stale_pid" 2>/dev/null; then
        rm -f -- "$daemon_pid_file"
      fi
    fi
    if has_systemd_scope; then
      use_systemd=true
      echo "daemon-control: using systemd scope: $scope_unit" >&2
      # Clear any lingering scope unit from a previous failed run
      systemctl --user stop "${scope_unit%.scope}.scope" 2>/dev/null || true
      systemctl --user reset-failed "${scope_unit%.scope}.scope" 2>/dev/null || true
      # systemd-run exits immediately; the daemon+runs inside the scope.
      # We pass the full env via env -i composition. PATH is reconstructed
      # by contained_path_for_kind (S24/US-006): var/adapters-bin FIRST,
      # operator bin dirs never before the contained dirs.
      systemd-run --user --scope --unit="$scope_unit" --quiet \
        env -i $(env_for_kind "$kind") PATH="$(contained_path_for_kind "$kind")" bash -c "$launch_script" >/dev/null 2>&1
    else
      echo "daemon-control: systemd not available — using plain background spawn" >&2
      nohup env -i $(env_for_kind "$kind") PATH="$(contained_path_for_kind "$kind")" bash -c "$launch_script" >/dev/null 2>&1 &
    fi
    # Wait for the daemon PID file to appear
    local pid_deadline; pid_deadline=$(($(date +%s) + 15))
    while [ "$(date +%s)" -lt "$pid_deadline" ]; do
      if [ -f "$daemon_pid_file" ]; then break; fi
      sleep 0.5
    done
    if [ -f "$daemon_pid_file" ]; then
      local candidate_pid; candidate_pid="$(cat "$daemon_pid_file" 2>/dev/null || true)"
      # MACP5 US-001: the candidate is accepted ONLY after the full
      # identity+ownership gate (verify_launched_daemon_pid) — on Darwin the
      # nohup/background chain can leave a WRAPPER pid in the pidfile that
      # dies while the real daemon lives; a wrapper/zombie/stale candidate
      # is REFUSED (never recorded in provenance) and the launch attempt is
      # retried within the bounded deadline.
      if [ -n "$candidate_pid" ] && verify_launched_daemon_pid "$candidate_pid" "$state_dir"; then
        daemon_pid="$candidate_pid"
        echo "daemon-control: daemon PID $daemon_pid (identity-verified)" >&2
        break
      fi
      echo "daemon-control: pidfile candidate '$candidate_pid' is not an identity-verified TT-owned daemon — treating the launch attempt as failed (classified as infrastructure: an unverifiable/foreign pidfile candidate is a launch/infra condition, never a product fault)" >&2
    fi
    # Launch attempt failed (a foreign daemon won a shared port in the instant
    # between the settle-recheck and our bind — EADDRINUSE — or the daemon
    # crashed, or the pidfile candidate was never identity-verified — the
    # Darwin wrapper-pid case): tear down the scope and RETRY within the
    # bounded wait.
    echo "daemon-control: launch attempt collided (foreign port contention, daemon crash, or unverifiable pid) — retrying within the bounded wait" >&2
    if $use_systemd; then
      systemctl --user stop "${scope_unit%.scope}.scope" 2>/dev/null || true
      systemctl --user reset-failed "${scope_unit%.scope}.scope" 2>/dev/null || true
    fi
    rm -f -- "$daemon_pid_file"
    sleep 1
  done
  if [ -z "$daemon_pid" ]; then
    if [ -n "$still_busy" ]; then
      echo "daemon-control: ERROR — $kind ports$still_busy are still in use after ${port_wait_seconds}s (a concurrent worktree daemon or a stuck listener); refusing to launch into a busy port" >&2
      # S56: a 'ports still in use' outcome classifies as INFRA and carries
      # the holder pid + cmdline in the reason (never a silent race, never a
      # product-fault classification).
      local busy_port holder
      for busy_port in $still_busy; do
        holder="$(describe_port_holder "$busy_port")"
        echo "daemon-control: INFRA — $holder is not a TT daemon this tool can stop; a concurrent worktree's start/stop must clear it first — classified as infrastructure" >&2
      done
    else
      # S54: a deadline expiry with NO identity-verified daemon pid (launch
      # collisions, a daemon crash, or every pidfile candidate refused) is a
      # LAUNCH/INFRA failure — classified INFRA with a non-zero exit, never
      # anything a consumer could read as a product fault.
      echo "daemon-control: INFRA — $kind daemon did not start within ${port_wait_seconds}s: no identity-verified daemon pid appeared (launch attempts collided, the daemon crashed, or every pidfile candidate was an unverifiable wrapper); failing closed with no provenance written — classified as infrastructure (a launch/infra failure, never a product fault)" >&2
    fi
    exit 1
  fi

  # Record the daemon's process-start identity (E3.C.1 US-004): stop/restart
  # verify the recorded startTime against the pid's CURRENT start identity
  # (procfs starttime on linux, ps lstart on Darwin — MACP4 US-002) before
  # ANY signal, so a stale/reused provenance pid (a pid that now names a
  # different process — e.g. a repo-cwd tamandua CLI child of the worker)
  # is refused instead of signalled.
  local daemon_start_time
  daemon_start_time="$(node "$IDENTITY_TOOL" --get "$daemon_pid" 2>/dev/null || true)"
  # MACP5 US-001: write_provenance must NEVER record an empty startTime
  # identity — an identity-less record would let a stale/reused pid pass the
  # stop/escalation corridors unchecked or report RUNNING on weak evidence.
  # The pid passed verify_launched_daemon_pid above (identity was readable
  # at acceptance), so an empty read here means the daemon died mid-launch:
  # FAIL CLOSED (exit non-zero, no provenance written) instead of the old
  # WARNING-and-continue.
  if [ -z "$daemon_start_time" ]; then
    echo "daemon-control: FATAL — cannot read startTime identity for daemon PID $daemon_pid; refusing to write provenance without an identity (fail closed). The daemon may have died mid-launch — classified as infrastructure (a launch failure, never a product fault)." >&2
    exit 1
  fi

  # Verify cgroup membership when systemd was used
  local cgroup_ok=false
  if $use_systemd; then
    if verify_cgroup "$daemon_pid" "$scope_unit"; then
      cgroup_ok=true
      echo "daemon-control: cgroup membership verified for $scope_unit" >&2
    else
      echo "daemon-control: WARNING — cgroup verification failed for $scope_unit" >&2
    fi
  fi

  # Wait for each port to be listening
  local port_ok=true
  for port in $dash_port $mcp_port $ctrl_port; do
    echo "daemon-control: waiting for port $port..." >&2
    if wait_for_port "$port" 15; then
      echo "daemon-control: port $port is listening" >&2
    else
      echo "daemon-control: WARNING — port $port did not become available within timeout" >&2
      port_ok=false
    fi
  done

  # ── S55: dist/version parity + which-dist-ran evidence ─────────────
  # The launch is complete and every port is listening. The daemon MUST
  # report the launching CLI's own dist version (/control/health
  # buildVersion == <TT_REPO_ROOT>/dist/version) — a campaign must never run
  # against a daemon built from a DIFFERENT checkout (the S55 defect). Fail
  # closed as INFRA when the parity check fails or the health response is
  # unverifiable, and stop the daemon this launch produced (identity-
  # verified; the scope teardown reaps the dashboard/MCP siblings on the
  # systemd path). Hermetic fake-CLI fixtures (which cannot serve
  # /control/health) disable the gate with TT_DC_HEALTH_PARITY=0 — a
  # documented test seam, never a production path.
  if [ "${TT_DC_HEALTH_PARITY:-1}" = "1" ]; then
    if ! verify_launch_dist_parity "$ctrl_port"; then
      echo "daemon-control: INFRA — dist/version parity FAILED for the $kind daemon PID $daemon_pid (expected '$(resolve_dc_expected_version)', observed '${DC_PARITY_OBSERVED:-<health query failed>}'): stopping the mismatched daemon and failing closed with no provenance — classified as infrastructure (never a product fault)" >&2
      if $use_systemd; then
        # The scope teardown reaps the daemon AND the dashboard/MCP siblings.
        systemctl --user stop "${scope_unit%.scope}.scope" 2>/dev/null || true
        systemctl --user reset-failed "${scope_unit%.scope}.scope" 2>/dev/null || true
      else
        # Plain-background path (the only path Darwin can take): TERM the
        # identity-verified mismatched daemon (read from the state-dir
        # tamandua.pid — the recorded registry of this launch attempt — under
        # the SAME var name the registry stop paths use), then stop the
        # dashboard/MCP standalones via the same resolved launcher (never
        # leave a foreign-dist daemon or its siblings holding the shared
        # ports).
        local lingering_pid
        lingering_pid="$(cat "$daemon_pid_file" 2>/dev/null || true)"
        if [ -n "$daemon_start_time" ] && [ -n "$lingering_pid" ] && verify_recorded_identity "$lingering_pid" "$daemon_start_time"; then
          echo "daemon-control: sending SIGTERM to identity-verified mismatched daemon PID $lingering_pid" >&2
          kill -TERM "$lingering_pid" 2>/dev/null || true
        fi
        run_under_env "$kind" "$tt_cli" dashboard stop >/dev/null 2>&1 || true
        run_under_env "$kind" "$tt_cli" mcp stop >/dev/null 2>&1 || true
      fi
      rm -f -- "$daemon_pid_file"
      exit 1
    fi
  fi

  # Which dist ran (S55 evidence): the product journals a daemon.start
  # lifecycle line in <state_dir>/lifecycle.log carrying the running dist
  # version and callerArgv (the daemon entry argv `node <TT_REPO_ROOT>/dist/
  # server/daemon.js`). Read it best-effort; the provenance record surfaces
  # it for the campaign evidence writers (state.json/report). The bounded
  # wait for the journal only runs on a REAL launch (parity enabled) — the
  # journal lands around the port bind; hermetic fake-CLI fixtures journal
  # nothing and get a single read (empty fields, no stall).
  local lc_json
  lc_json="$(read_lifecycle_daemon_start "$state_dir")"
  if [ "${TT_DC_HEALTH_PARITY:-1}" = "1" ] && ! printf '%s' "$lc_json" | grep -q '"version":"[^"]'; then
    local dc_lifecycle_deadline; dc_lifecycle_deadline=$(($(date +%s) + 8))
    while [ "$(date +%s)" -lt "$dc_lifecycle_deadline" ]; do
      sleep 0.5
      lc_json="$(read_lifecycle_daemon_start "$state_dir")"
      if printf '%s' "$lc_json" | grep -q '"version":"[^"]'; then
        break
      fi
    done
  fi
  local dc_daemon_version="" dc_caller_argv_json="[]"
  if [ -n "$lc_json" ]; then
    dc_daemon_version="$(printf '%s' "$lc_json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(JSON.parse(s).version??"")}catch{}})' 2>/dev/null || true)"
    dc_caller_argv_json="$(printf '%s' "$lc_json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const a=JSON.parse(s).callerArgv||[];process.stdout.write(JSON.stringify(a))}catch{process.stdout.write("[]")}})' 2>/dev/null || true)"
  fi
  # Prefer the parity-observed version when the journal is silent (e.g. a
  # reuse path where the health query is authoritative).
  if [ -z "$dc_daemon_version" ] && [ -n "$DC_PARITY_OBSERVED" ]; then
    dc_daemon_version="$DC_PARITY_OBSERVED"
  fi

  local started_at; started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # Write provenance
  write_provenance \
    "$name" \
    "$kind" \
    "$daemon_pid" \
    "$dash_port $mcp_port $ctrl_port" \
    "$scope_unit" \
    "$cgroup_ok" \
    "$started_at" \
    "tamandua daemon start" \
    "$state_dir" \
    "$daemon_start_time" \
    "$dc_daemon_version" \
    "$dc_caller_argv_json" \
    "$tt_cli"

  echo "daemon-control: $kind daemon started on ports $dash_port (dashboard) $mcp_port (MCP) $ctrl_port (control)" >&2

  if ! $port_ok; then
    echo "daemon-control: WARNING — one or more ports did not become available; the daemon may not be fully ready" >&2
  fi
}

# stop_cli_auto_daemon: stop the CLI-auto-started daemon OF THIS WORKTREE.
# (E3.C.2 US-004 FINDING) A `tamandua workflow run` whose CLI finds no
# reachable daemon auto-starts a PLAIN background daemon via
# ensureDaemonControlAvailable -> startDaemon (src/server/daemonctl.ts): no
# systemd scope, no daemon-control provenance, but it DOES record its pid in
# the kind state-dir tamandua.pid (the same pidfile daemon-control own
# daemon writes) and holds the kind control port. The provenance-based
# stop paths cannot see it (no provenance record), so without this step a
# later cmd_start bounded port-wait refuses on the busy port (the
# deterministic W2.21 restart race). The pidfile is the recorded registry;
# the stop is identity-verified and per-worktree-scoped: the pid must be
# alive, must NOT be the provenance pid (the recorded daemon is handled by
# the provenance path), /proc cwd must be under TT_REPO_ROOT + cmdline must
# be a TT daemon cmdline (verify_process_tt_owned — the literal 'tamandua'
# OR $TT_REPO_ROOT/dist/server/…, S54), and /proc environ must name
# the state dir OF THIS WORKTREE (a foreign-worktree daemon has a different
# TAMANDUA_STATE_DIR and is REFUSED, never stopped). The startTime identity
# is captured and re-verified before every signal (ABA-safe, E3.C.1
# US-004). $1 = kind. Returns 0 always (a refusal is not an error).
stop_cli_auto_daemon() {
  local kind="$1"
  local state_dir
  state_dir="$(env_for_kind "$kind" | grep '^TAMANDUA_STATE_DIR=' | cut -d= -f2-)"
  [ -n "$state_dir" ] || return 0
  local cli_pid_file="$state_dir/tamandua.pid"
  [ -f "$cli_pid_file" ] || return 0
  # The state-dir pidfile is the CLI daemon recorded registry. It is the
  # SAME pidfile daemon-control own daemon writes, so the provenance-pid
  # comparison below keeps the normal path from double-stopping.
  local lingering_pid
  lingering_pid="$(cat "$cli_pid_file" 2>/dev/null || true)"
  if [ -z "$lingering_pid" ] || ! echo "$lingering_pid" | grep -qE '^[0-9]+$'; then
    return 0  # empty/garbage pidfile — nothing to stop
  fi
  if ! kill -0 "$lingering_pid" 2>/dev/null; then
    return 0  # stale pidfile (dead daemon) — cmd_start clears it
  fi
  # The provenance pid is handled by the provenance stop path (never
  # double-stop the same daemon).
  if [ -f "$PROV_DIR/$kind.json" ]; then
    local prov_pid
    prov_pid="$(jq -r '.pid // 0' "$PROV_DIR/$kind.json" 2>/dev/null || echo 0)"
    if [ "$lingering_pid" = "$prov_pid" ] && [ "$prov_pid" -gt 0 ] 2>/dev/null; then
      return 0
    fi
  fi
  # ── Identity verification (fail-closed) ───────────────────────────
  if ! verify_process_tt_owned "$lingering_pid" "$state_dir"; then
    echo "daemon-control: REFUSING — state-dir pidfile PID $lingering_pid is not proven TT-owned (cwd/cmdline check failed); not stopping a foreign/unverified process" >&2
    return 0
  fi
  # Per-worktree discriminator: the daemon environ must name the state
  # dir OF THIS WORKTREE. A foreign-worktree CLI daemon has a different
  # TAMANDUA_STATE_DIR in its environ and must never be stopped.
  # (MACP4 US-002: on Darwin /proc is absent so the environ cannot be read
  # and the check degrades to "cannot read -> no refusal on this basis" —
  # exactly the linux behavior when /proc environ is unreadable (EACCES);
  # the TT-owned + identity gates above/below still hold.)
  # linux-only /proc read (MACP5 US-001): the environ exists only under
  # procfs — on /proc-less hosts the read degrades to empty (documented
  # above); the identity + TT-owned gates remain the load-bearing checks.
  local cli_env_state_dir
  cli_env_state_dir="$(tr '\0' '\n' < "/proc/$lingering_pid/environ" 2>/dev/null | sed -n 's/^TAMANDUA_STATE_DIR=//p' | head -1 || true)"
  if [ -n "$cli_env_state_dir" ] && [ "$cli_env_state_dir" != "$state_dir" ]; then
    echo "daemon-control: REFUSING — state-dir pidfile PID $lingering_pid environ names a foreign state dir ($cli_env_state_dir); not stopping a foreign-worktree daemon" >&2
    return 0
  fi
  # ABA-safe: capture the startTime identity now, re-verify before each
  # signal (a pid that died and was reused between capture and signal fails
  # the check and is never signalled).
  local cli_start_time
  cli_start_time="$(node "$IDENTITY_TOOL" --get "$lingering_pid" 2>/dev/null || true)"
  if [ -z "$cli_start_time" ]; then
    echo "daemon-control: REFUSING — cannot read startTime identity for state-dir pidfile PID $lingering_pid; not stopping an unverifiable process" >&2
    return 0
  fi
  echo "daemon-control: stopping the CLI-auto-started daemon of this worktree (PID $lingering_pid, identity-verified)..." >&2
  if verify_recorded_identity "$lingering_pid" "$cli_start_time"; then
    echo "daemon-control: sending SIGTERM to identity-verified CLI daemon PID $lingering_pid" >&2
    kill -TERM "$lingering_pid" 2>/dev/null || true
    sleep 2
    if kill -0 "$lingering_pid" 2>/dev/null; then
      if verify_recorded_identity "$lingering_pid" "$cli_start_time"; then
        echo "daemon-control: sending SIGKILL to identity-verified CLI daemon PID $lingering_pid" >&2
        kill -KILL "$lingering_pid" 2>/dev/null || true
      else
        echo "daemon-control: REFUSING SIGKILL — PID $lingering_pid identity no longer matches" >&2
      fi
    fi
  else
    echo "daemon-control: REFUSING — PID $lingering_pid identity check failed; no signal sent" >&2
  fi
  return 0
}

# ── S56 helpers: bounded stop residue gate ─────────────────────────────
#
# A scripted/real daemon stop must NOT return while a listener is still
# bound or a dashboard/mcp/control-plane child is still alive: a stop that
# returns early lets the NEXT start collide with EADDRINUSE on the kind's
# FIXED ports (the bare --tier0 33/33 gate; scenario stop->start barriers
# such as w4.12-port-squatter). The helpers below give cmd_stop a bounded
# final gate over (ports free AND children exited), and give every
# 'ports still in use' outcome an INFRA classification that names the
# holder pid + cmdline — never a silent race, never a product-fault
# classification.

# listener_pid_for_port <port>: print the pid of the process listening on
# port <port>, or nothing when the port is free. lsof is the portable
# source (linux + macOS); the netstat fallback is linux-only (the same pair
# cmd_stop's lingering-listener cleanup and daemon-control's status use).
# The lsof probe is BOUNDED (lsof_bounded, LSOF-EVTA US-006): a timeout
# yields no lsof pid evidence and falls through to the netstat arm, so the
# probe can never hang (fail-closed — no pid is ever fabricated).
listener_pid_for_port() {
  local port="$1"
  local pid
  pid="$(lsof_bounded -nP -iTCP:"$port" -sTCP:LISTEN -t | head -1 || true)"
  if [ -z "$pid" ]; then
    pid="$(netstat -tlnp 2>/dev/null | grep ":$port " | awk '{print $NF}' | grep -Eo '[0-9]+' | head -1 || true)"
  fi
  printf '%s' "$pid"
}

# cmdline_for_pid <pid>: print the process command line, or nothing when it
# cannot be read. linux /proc read; a portable `ps -p <pid> -o command=`
# arm on /proc-less hosts (the same portable evidence
# verify_process_tt_owned / cmd_status use behind the TT_DC_PLATFORM seam).
cmdline_for_pid() {
  local pid="$1"
  local platform
  platform="${TT_DC_PLATFORM:-$(uname -s)}"
  case "$platform" in
    Darwin) ps -p "$pid" -o command= 2>/dev/null | head -1 || true ;;
    *) tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true ;;
  esac
}

# describe_port_holder <port>: one-line holder evidence for a busy port —
# the pid AND the command line (S56: 'ports still in use' must classify as
# INFRA with the holder pid/cmdline in the reason), e.g.
#   port 5334 (pid 1234: node .../dist/server/dashboard-standalone.js 5334)
describe_port_holder() {
  local port="$1"
  local pid
  pid="$(listener_pid_for_port "$port")"
  if [ -z "$pid" ]; then
    printf 'port %s is in use (no listener pid resolved)' "$port"
    return 0
  fi
  local cmdline
  cmdline="$(cmdline_for_pid "$pid" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  printf 'port %s (pid %s: %s)' "$port" "$pid" "${cmdline:-cmdline unavailable}"
}

# gate_children_for_state <state_dir> <extra_pid>: the pids a stop must
# wait to EXIT before returning — the recorded daemon pid (<extra_pid>,
# when > 0 and alive) plus every pid recorded in the state-dir pid files
# (tamandua.pid / dashboard.pid / mcp.pid). Only LIVE pids that are PROVEN
# TT-owned at capture time are included (verify_process_tt_owned): a
# foreign/recycled pidfile pid is never waited on, so the bounded gate can
# never hang on a process that is not the contained daemon's own child.
# Prints one pid per line.
gate_children_for_state() {
  local state_dir="$1"
  local extra_pid="$2"
  local seen=""
  if [ -n "$extra_pid" ] && echo "$extra_pid" | grep -qE '^[0-9]+$' && kill -0 "$extra_pid" 2>/dev/null; then
    seen="$extra_pid"
    printf '%s\n' "$extra_pid"
  fi
  if [ -z "$state_dir" ] || [ ! -d "$state_dir" ]; then
    return 0
  fi
  local pidfile cand
  for pidfile in "$state_dir"/tamandua.pid "$state_dir"/dashboard.pid "$state_dir"/mcp.pid; do
    [ -f "$pidfile" ] || continue
    cand="$(cat "$pidfile" 2>/dev/null || true)"
    if [ -z "$cand" ] || ! echo "$cand" | grep -qE '^[0-9]+$'; then
      continue
    fi
    if ! kill -0 "$cand" 2>/dev/null; then
      continue
    fi
    if ! verify_process_tt_owned "$cand" "$state_dir"; then
      continue
    fi
    case " $seen " in
      *" $cand "*) continue ;;
    esac
    seen="$seen $cand"
    printf '%s\n' "$cand"
  done
}

# wait_stop_gate <kind> <label> <state_dir> <extra_pid> <ports>: the S56
# final gate. Waits (bounded, TT_DAEMON_STOP_WAIT_SECONDS, default 30) until
# none of <ports> (space-separated) is listening AND every captured child
# pid (gate_children_for_state) has exited, then returns 0. If the bound
# expires with a listener or a live child, prints the INFRA classification
# (each busy port's holder pid + cmdline, plus any surviving child's pid +
# cmdline) and returns 1 — a stop never returns success while a listener or
# child survives.
wait_stop_gate() {
  local kind="$1"
  local label="$2"
  local state_dir="$3"
  local extra_pid="$4"
  shift 4
  local ports="$*"
  local wait_seconds="${TT_DAEMON_STOP_WAIT_SECONDS:-30}"
  case "$wait_seconds" in
    ''|*[!0-9]*) wait_seconds=30 ;;
  esac
  local deadline
  deadline=$(($(date +%s) + wait_seconds))
  local children
  children="$(gate_children_for_state "$state_dir" "$extra_pid")"
  local busy=""
  local survivors=""
  local port child
  while [ "$(date +%s)" -lt "$deadline" ]; do
    busy=""
    for port in $ports; do
      if [ -n "$port" ] && is_port_listening "$port"; then busy="$busy $port"; fi
    done
    survivors=""
    for child in $children; do
      if kill -0 "$child" 2>/dev/null; then survivors="$survivors $child"; fi
    done
    if [ -z "$busy" ] && [ -z "$survivors" ]; then
      return 0
    fi
    sleep 0.5
  done
  # Bound expired with residue: INFRA classification with holder evidence.
  local detail=""
  local holder
  for port in $busy; do
    holder="$(describe_port_holder "$port")"
    detail="$detail $holder"
  done
  local child_cmdline
  for child in $survivors; do
    child_cmdline="$(cmdline_for_pid "$child" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    detail="$detail child-pid $child (${child_cmdline:-cmdline unavailable})"
  done
  echo "daemon-control: INFRA — $label: listeners/children still in use after ${wait_seconds}s:$detail (a later start on the $kind fixed ports would collide with EADDRINUSE; the holder is not a process this tool may stop — classified as infrastructure, never as a product fault)" >&2
  return 1
}

# cmd_stop — stop the kind's TT daemon through the identity-gated corridor
# (graceful CLI stop -> identity-verified SIGTERM/SIGKILL escalation ->
# lingering-listener cleanup -> systemd scope teardown -> the S56 bounded
# final gate). Every signal is gated on the RECORDED process-start
# identity; a stale/reused pid is refused, never signalled.
#
# Lingering-listener lsof probe (LSOF-EVTA US-006): the
# `lsof -nP -iTCP:<port> -sTCP:LISTEN -t` pid extraction is BOUNDED via
# lsof_bounded (always `-b -w`, hard TT_LSOF_TIMEOUT_S bound, SIGKILL +
# reap on expiry) so a stale FUSE/network mount can never wedge a stop. A
# timed-out probe is NO evidence, so an empty lingering_pid is never
# killed (fail-closed).
#
# NOTE (harness context window): keep this doc block BEFORE the function.
# torture-test/bin/daemon-control.test.sh asserts the first 301 lines of
# cmd_stop's body with `grep -A 300 '^cmd_stop()' | grep -q ...`; on macOS
# that pipeline is killed by SIGPIPE (rc=141 under `set -o pipefail`) once
# the body window exceeds the 16 KiB pipe buffer and the downstream
# `grep -q` exits on its first match. Adding comment bytes inside the
# first 301 lines silently breaks those structural assertions.

cmd_stop() {
  local kind="$1"
  local name="$kind"
  local prov_file="$PROV_DIR/$name.json"

  # ── Handle missing provenance ──────────────────────────────────────
  if [ ! -f "$prov_file" ]; then
    echo "daemon-control: no provenance record for $kind — daemon was never started by this tool" >&2
    # E3.C.2 US-004 FINDING: a CLI-auto-started daemon (no provenance by
    # construction) may be the only holder of the kind ports. Stop the CLI
    # daemon OF THIS WORKTREE (state-dir pidfile, identity-verified) before
    # declaring the ports unknown — a foreign-worktree daemon is never
    # touched (stop_cli_auto_daemon refuses it).
    stop_cli_auto_daemon "$kind"
    # S56: even without provenance the stop must not return while a
    # listener/child survives — wait the bounded gate, then classify any
    # residue as INFRA with the holder pid/cmdline (never a silent single-
    # shot check that races the killed CLI daemon's port release).
    local no_prov_state_dir
    no_prov_state_dir="$(env_for_kind "$kind" | grep '^TAMANDUA_STATE_DIR=' | cut -d= -f2-)"
    if ! wait_stop_gate "$kind" "$kind daemon stop (no provenance record)" "$no_prov_state_dir" "" "$(ports_for_kind "$kind")"; then
      echo "daemon-control: ERROR — port(s) in use but no provenance record exists; refusing to report a clean stop while an unidentified process holds the kind ports" >&2
      exit 1
    fi
    echo "daemon-control: $kind daemon is already stopped (no provenance, ports free)" >&2
    return 0
  fi

  # ── Read provenance ────────────────────────────────────────────────
  local prov_pid prov_ports prov_scope prov_cwd prov_start_time
  prov_pid=$(jq -r '.pid // 0' "$prov_file" 2>/dev/null)
  prov_ports=$(jq -r '.ports | join(" ")' "$prov_file" 2>/dev/null)
  prov_scope=$(jq -r '.scopeUnit // ""' "$prov_file" 2>/dev/null)
  prov_cwd=$(jq -r '.cwd // ""' "$prov_file" 2>/dev/null)
  prov_start_time=$(jq -r '.startTime // ""' "$prov_file" 2>/dev/null)

  # ── Already stopped: ports free → no-op ────────────────────────────
  local all_ports_free=true
  for port in $prov_ports; do
    if [ -n "$port" ] && is_port_listening "$port"; then
      all_ports_free=false
      break
    fi
  done

  if $all_ports_free; then
    echo "daemon-control: $kind daemon is already stopped" >&2
    # E3.C.2 US-004 FINDING: a CLI-auto-started daemon (workflow run ->
    # ensureDaemonControlAvailable -> startDaemon) has no provenance record
    # and no systemd scope, so it is invisible to the provenance paths
    # above. It can still be alive and holding the kind control port
    # (recorded only in the state-dir tamandua.pid). Stop the CLI daemon OF
    # THIS WORKTREE (identity-verified, per-worktree) so the next cmd_start
    # finds the ports free — a foreign-worktree daemon is never touched.
    stop_cli_auto_daemon "$kind"
    # A descendant that no longer owns a listener (for example an SSH control
    # process spawned by a daemon child) can keep the transient scope alive.
    # Tear down the provenanced scope even on this idempotent path so the next
    # scenario can reuse daemon-control's per-worktree unit name without
    # colliding. E3.C.2 US-002: only THIS worktree's derived scope is ever
    # stopped — a recorded legacy/fixed name or a foreign worktree's unit is
    # refused, never stopped (stopping it would TERM another run's daemon).
    if [ -n "$prov_scope" ] && [ "$prov_scope" != "null" ] && has_systemd_scope; then
      if scope_unit_is_ours "$prov_scope" "$name"; then
        echo "daemon-control: cleaning up residual systemd scope $prov_scope..." >&2
        systemctl --user stop "${prov_scope%.scope}.scope" 2>/dev/null || true
        systemctl --user reset-failed "${prov_scope%.scope}.scope" 2>/dev/null || true
      else
        echo "daemon-control: REFUSING — provenance scope $prov_scope is not this worktree's scope; not stopping a foreign/legacy scope" >&2
      fi
    fi
    local has_stopped_at
    has_stopped_at=$(jq -r '.stoppedAt // ""' "$prov_file" 2>/dev/null)
    # S56: even the idempotent 'already stopped' path must not return while
    # a just-stopped CLI-auto daemon's listeners/children are still dying —
    # run the bounded final gate so the caller's next start cannot collide
    # with EADDRINUSE on the kind's fixed ports.
    local idle_state_dir
    idle_state_dir="$(env_for_kind "$kind" | grep '^TAMANDUA_STATE_DIR=' | cut -d= -f2-)"
    if ! wait_stop_gate "$kind" "$kind daemon stop (already stopped)" "$idle_state_dir" "$prov_pid" "$(ports_for_kind "$kind")"; then
      echo "daemon-control: ERROR — $kind did not fully stop (see INFRA classification above); not reporting a clean stop" >&2
      update_provenance_after_stop "$prov_file" "1"
      return 1
    fi
    if [ -z "$has_stopped_at" ]; then
      update_provenance_after_stop "$prov_file" "0"
    fi
    return 0
  fi

  # ── Production guard (provenance evidence) ─────────────────────────
  for port in $prov_ports; do
    if [ -n "$port" ] && is_production_port "$port"; then
      refuse_production "provenance shows port $port — this is a production port"
    fi
  done
  if [ -n "$prov_cwd" ] && [ "$prov_cwd" != "null" ] && is_production_cwd "$prov_cwd"; then
    refuse_production "provenance cwd points to production: $prov_cwd"
  fi

  # ── PID liveness ──────────────────────────────────────────────────
  local pid_alive=true
  if [ "$prov_pid" -gt 0 ] 2>/dev/null; then
    if ! kill -0 "$prov_pid" 2>/dev/null; then
      pid_alive=false
      echo "daemon-control: provenance PID $prov_pid is not alive, but ports are still in use" >&2
    fi
  else
    pid_alive=false
  fi

  # ── Step 0: also stop the CLI-auto-started daemon OF THIS WORKTREE ──
  # (E3.C.2 US-004 FINDING) When the ports are busy but the provenance PID
  # is dead (or the provenance records a DIFFERENT, already-stopped daemon),
  # the busy ports may be held by a PLAIN daemon auto-started by the CLI
  # (`workflow run` -> ensureDaemonControlAvailable -> startDaemon) — no
  # provenance, no systemd scope, recorded only in the state-dir
  # tamandua.pid. The provenance steps below cannot stop it (its pid is not
  # the recorded pid and it has no scope), so a later cmd_start bounded
  # port-wait would refuse on the busy port. Stop it now, identity-verified
  # and per-worktree-scoped (a foreign-worktree daemon is never touched).
  stop_cli_auto_daemon "$kind"

  echo "daemon-control: stopping $kind daemon (PID $prov_pid)..." >&2

  # ── Step 1: Graceful stop via tamandua CLI under spawn env ─────────
  # MACP4 US-001: stop the standalone MCP too. The launch script starts the
  # dashboard AND the MCP as STANDALONE processes; on the systemd path the
  # scope teardown (Step 5) used to kill the MCP survivor, but the
  # plain-background fallback path (Darwin's ONLY path) has no scope —
  # without this step a fallback stop left the MCP standalone holding its
  # port, and the next start refused on the busy port (the W2 cells'
  # restart corridor would fail on Darwin). The product CLI stop is
  # pid-file + canSignalPid gated (no identity weakening); the recorded-
  # identity escalation below remains the backstop.
  echo "daemon-control: graceful stop via tamandua dashboard/mcp stop..." >&2
  # S55: the CLI stop invokes the same resolved launcher as the start
  # (resolve_tt_cli — the worktree's own bin/tamandua by absolute path, never
  # a PATH lookup that could stop a DIFFERENT checkout's daemon).
  local tt_cli
  tt_cli="$(resolve_tt_cli)"
  run_under_env "$kind" "$tt_cli" dashboard stop >/dev/null 2>&1 || true
  run_under_env "$kind" "$tt_cli" mcp stop >/dev/null 2>&1 || true

  # ── Step 2: Poll for graceful shutdown (up to 10s) ─────────────────
  local all_stopped=false
  local deadline; deadline=$(($(date +%s) + 10))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    all_stopped=true
    for port in $prov_ports; do
      if [ -n "$port" ] && is_port_listening "$port"; then
        all_stopped=false
        break
      fi
    done
    if $all_stopped; then break; fi
    sleep 0.5
  done

  if $all_stopped; then
    echo "daemon-control: $kind daemon stopped gracefully" >&2
  else
    # ── Step 3: Escalate → SIGTERM → SIGKILL (identity-verified only) ──
    echo "daemon-control: daemon did not stop within timeout — escalating..." >&2

    if $pid_alive && [ "$prov_pid" -gt 0 ] 2>/dev/null; then
      # Production guard: refuse if cwd resolves to production
      if [ -n "$prov_cwd" ] && [ "$prov_cwd" != "null" ] && is_production_cwd "$prov_cwd"; then
        refuse_production "refusing to signal PID $prov_pid — cwd is production"
      fi

      # E3.C.1 US-004: verify the RECORDED process-start identity before ANY
      # signal. A stale/reused provenance pid (e.g. a repo-cwd process with
      # 'tamandua' in its cmdline that happens to reuse the recorded pid)
      # fails the startTime check and is refused — never signalled. The
      # cwd/cmdline check below remains as belt-and-suspenders ONLY for an
      # already identity-verified recorded pid.
      if verify_recorded_identity "$prov_pid" "$prov_start_time"; then
        # Verify TT-owned via /proc evidence before signaling
        if verify_process_tt_owned "$prov_pid" "$prov_cwd"; then
          echo "daemon-control: sending SIGTERM to identity-verified TT daemon PID $prov_pid" >&2
          kill -TERM "$prov_pid" 2>/dev/null || true
          sleep 2
          if kill -0 "$prov_pid" 2>/dev/null; then
            # Re-verify identity before the SIGKILL escalation: the pid must
            # STILL be the recorded daemon — a pid that died and was reused
            # within the SIGTERM window must not be SIGKILLed.
            if verify_recorded_identity "$prov_pid" "$prov_start_time"; then
              echo "daemon-control: sending SIGKILL to identity-verified PID $prov_pid" >&2
              kill -KILL "$prov_pid" 2>/dev/null || true
            else
              echo "daemon-control: REFUSING SIGKILL — PID $prov_pid identity no longer matches the recorded daemon" >&2
            fi
          fi
        else
          echo "daemon-control: REFUSING — PID $prov_pid is NOT proven TT-owned (cwd/cmdline evidence check failed)" >&2
        fi
      else
        echo "daemon-control: REFUSING — PID $prov_pid identity check failed; no signal sent (stale/reused provenance pid)" >&2
      fi
    else
      # PID not alive but ports still in use — cannot safely stop
      # (name-only matching is forbidden by spec)
      echo "daemon-control: WARNING — PID not alive but ports still in use; cannot escalate without evidence" >&2
    fi
  fi

  # ── Step 4: Clean up any remaining port listeners (MCP may survive
  # the daemon PID death). E3.C.1 US-004: a lingering listener is killed
  # ONLY when it IS the recorded daemon pid with a matching startTime
  # identity AND it passes the full signal-target check (not an ancestor
  # of daemon-control, pgid disjoint from daemon-control's own group).
  # A listener whose identity cannot be confirmed — a decoy with matching
  # cwd/cmdline, an unrecorded pid, or a mismatched startTime — is REFUSED,
  # never killed on cwd/cmdline evidence alone.
  for port in $prov_ports; do
    if [ -n "$port" ] && is_port_listening "$port"; then
      local lingering_pid
      # PORTABLE pid extraction (MACP5 US-006): iproute2 `ss` (and its
      # `pid=` output) is linux-only — macOS has no `ss`. lsof's
      # `-iTCP:<port> -sTCP:LISTEN -t` prints the listener PID(s) portably
      # (first wins), preserving the exact first-pid semantics on both
      # platforms. The netstat fallback keeps the linux-only path for hosts
      # without lsof.
      lingering_pid=$(lsof_bounded -nP -iTCP:"$port" -sTCP:LISTEN -t | head -1 || true)
      if [ -z "$lingering_pid" ]; then
        lingering_pid=$(netstat -tlnp 2>/dev/null | grep ":$port " | awk '{print $NF}' | grep -Eo '[0-9]+' | head -1 || true)
      fi
      if [ -n "$lingering_pid" ]; then
        if [ "$lingering_pid" = "$prov_pid" ] && [ -n "$prov_start_time" ]; then
          if verify_listener_target "$lingering_pid" "$prov_start_time" \
              && verify_process_tt_owned "$lingering_pid" "$prov_cwd"; then
            echo "daemon-control: killing identity-verified lingering TT process on port $port (PID $lingering_pid)" >&2
            kill -KILL "$lingering_pid" 2>/dev/null || true
          else
            echo "daemon-control: REFUSING — lingering listener PID $lingering_pid on port $port is not identity-confirmed; not killed" >&2
          fi
        else
          echo "daemon-control: REFUSING — lingering listener PID $lingering_pid on port $port is not the recorded daemon (or its identity is unrecorded); not killed" >&2
        fi
      fi
    fi
  done

  # ── Step 5: Clean up systemd scope ─────────────────────────────────
  # E3.C.2 US-002: only THIS worktree's derived scope is ever stopped — a
  # recorded legacy/fixed name or a foreign worktree's unit is refused, never
  # stopped (stopping it would TERM another run's daemon).
  if [ -n "$prov_scope" ] && [ "$prov_scope" != "null" ] && has_systemd_scope; then
    if scope_unit_is_ours "$prov_scope" "$name"; then
      echo "daemon-control: cleaning up systemd scope $prov_scope..." >&2
      systemctl --user stop "${prov_scope%.scope}.scope" 2>/dev/null || true
      # reset-failed clears the unit so a fresh systemd-run can reuse the name
      systemctl --user reset-failed "${prov_scope%.scope}.scope" 2>/dev/null || true
    else
      echo "daemon-control: REFUSING — provenance scope $prov_scope is not this worktree's scope; not stopping a foreign/legacy scope" >&2
    fi
  fi

  # ── Step 6 (S56): bounded final gate — listeners released AND the
  #    dashboard/mcp/control-plane children have exited BEFORE the stop
  #    returns. The OLD tail checked the ports ONCE after a 0.5s settle and
  #    returned 0 (a WARNING only) while a listener/child survived — the
  #    silent race that let the NEXT start collide with EADDRINUSE on the
  #    kind's fixed ports (the bare --tier0 33/33 gate; scenario stop->start
  #    barriers such as w4.12-port-squatter). The gate waits (bounded,
  #    TT_DAEMON_STOP_WAIT_SECONDS, default 30s) for BOTH conditions; any
  #    residue is classified INFRA with the holder pid/cmdline and fails the
  #    stop (exit 1) — never a silent success.
  local final_state_dir
  final_state_dir="$(env_for_kind "$kind" | grep '^TAMANDUA_STATE_DIR=' | cut -d= -f2-)"
  local kind_ports
  kind_ports="$(ports_for_kind "$kind")"
  if wait_stop_gate "$kind" "$kind daemon stop" "$final_state_dir" "$prov_pid" "$kind_ports"; then
    echo "daemon-control: $kind daemon stopped successfully (all listeners released, dashboard/mcp/control-plane children exited)" >&2
    update_provenance_after_stop "$prov_file" "0"
  else
    echo "daemon-control: ERROR — $kind daemon did not fully stop within the bound (see INFRA classification above); not reporting a clean stop" >&2
    update_provenance_after_stop "$prov_file" "1"
    return 1
  fi
}

cmd_restart() {
  local kind="$1"
  local name="$kind"
  local prov_file="$PROV_DIR/$name.json"

  echo "daemon-control: restarting $kind daemon..." >&2

  # Check if daemon is currently running (provenance exists + ports active)
  local need_stop=false
  if [ -f "$prov_file" ]; then
    local prov_ports
    if command -v jq >/dev/null 2>&1; then
      prov_ports=$(jq -r '.ports | join(" ")' "$prov_file" 2>/dev/null || true)
    else
      prov_ports=$(grep -o '"ports": *\[[^]]*\]' "$prov_file" 2>/dev/null | sed 's/.*\[//;s/\]//;s/"//g;s/,/ /g' || true)
    fi
    for port in $prov_ports; do
      if [ -n "$port" ] && is_port_listening "$port"; then
        need_stop=true
        break
      fi
    done
  fi

  if $need_stop; then
    echo "daemon-control: stopping existing daemon..." >&2
    cmd_stop "$kind"
    echo "daemon-control: stop complete, waiting for ports to settle..." >&2
    # T2.1 US-010 round 4: the post-stop port check must be a BOUNDED
    # stable-free wait, not a single shot. cmd_stop's graceful stop escalates
    # to SIGTERM/SIGKILL on the daemon PID, but the kind's OTHER listeners
    # (MCP/dashboard standalone processes spawned by the same launch script)
    # can take a moment longer to release their sockets after the daemon PID
    # dies — the re-proof campaign-20260818T145745610Z W4.36 TEST_INFRA_FAIL:
    # `daemon-control scripted restart` exited 1 in ~15s because the single
    # `sleep 1` + one-pass check ran while a port was still draining
    # (lifecycle log: stop.dashboard 14:59:16.6, daemon SIGTERM 14:59:26.6,
    # restart refused 14:59:31). The restart now waits (bounded, the SAME
    # TT_DAEMON_PORT_WAIT_SECONDS deadline as cmd_start) for the ports to be
    # free STABLY (two consecutive free observations across a settle) before
    # starting — the identical settle-confirm the launch path uses. A port
    # that never frees (a stuck foreign listener) still refuses with the
    # explicit diagnostic after the bound; a port that drains a few seconds
    # late is absorbed instead of failing the cell.
    local port_wait_seconds="${TT_DAEMON_PORT_WAIT_SECONDS:-180}"
    case "$port_wait_seconds" in
      ''|*[!0-9]*) port_wait_seconds=180 ;;
    esac
    local port_wait_deadline; port_wait_deadline=$(($(date +%s) + port_wait_seconds))
    if [ -f "$prov_file" ]; then
      local post_stop_ports
      if command -v jq >/dev/null 2>&1; then
        post_stop_ports=$(jq -r '.ports | join(" ")' "$prov_file" 2>/dev/null || true)
      else
        post_stop_ports=$(grep -o '"ports": *\[[^]]*\]' "$prov_file" 2>/dev/null | sed 's/.*\[//;s/\]//;s/"//g;s/,/ /g' || true)
      fi
      local still_busy=""
      while [ "$(date +%s)" -lt "$port_wait_deadline" ]; do
        still_busy=""
        for port in $post_stop_ports; do
          if [ -n "$port" ] && is_port_listening "$port"; then
            still_busy="$still_busy $port"
          fi
        done
        if [ -z "$still_busy" ]; then
          # Free on this pass: confirm it STAYS free across a settle so a
          # draining listener that re-appears is caught here (back into the
          # bounded wait) instead of racing the start.
          sleep 2
          still_busy=""
          for port in $post_stop_ports; do
            if [ -n "$port" ] && is_port_listening "$port"; then
              still_busy="$still_busy $port"
            fi
          done
          if [ -z "$still_busy" ]; then
            break
          fi
        fi
        sleep 1
      done
      if [ -n "$still_busy" ]; then
        echo "daemon-control: ERROR — ports$still_busy not freed after stop within ${port_wait_seconds}s; cannot restart" >&2
        exit 1
      fi
    fi
  else
    echo "daemon-control: no running daemon found — performing clean start" >&2
  fi

  # Start (re-asserts cgroup membership via cmd_start's systemd + verify_cgroup logic)
  cmd_start "$kind"
}

cmd_status() {
  local kind="$1"
  local name="$kind"
  local prov_file="$PROV_DIR/$name.json"

  # ── No provenance file ───────────────────────────────────────────
  if [ ! -f "$prov_file" ]; then
    echo "STATUS: NO_PROVENANCE"
    echo "  kind: $kind"
    echo "  reason: no provenance file at $prov_file"
    return 0
  fi

  # ── Read provenance fields ───────────────────────────────────────
  local prov_pid prov_ports prov_started prov_stopped prov_cmdline prov_cwd prov_start_time
  if command -v jq >/dev/null 2>&1; then
    prov_pid=$(jq -r '.pid // 0' "$prov_file" 2>/dev/null || echo "0")
    prov_ports=$(jq -r '.ports | join(" ")' "$prov_file" 2>/dev/null || true)
    prov_started=$(jq -r '.startedAt // ""' "$prov_file" 2>/dev/null || true)
    prov_stopped=$(jq -r '.stoppedAt // ""' "$prov_file" 2>/dev/null || true)
    prov_cmdline=$(jq -r '.cmdline // ""' "$prov_file" 2>/dev/null || true)
    prov_cwd=$(jq -r '.cwd // ""' "$prov_file" 2>/dev/null || true)
    prov_start_time=$(jq -r '.startTime // ""' "$prov_file" 2>/dev/null || true)
  else
    prov_pid=$(grep -o '"pid": *[0-9]*' "$prov_file" 2>/dev/null | sed 's/.*: *//' || echo "0")
    prov_ports=$(grep -o '"ports": *\[[^]]*\]' "$prov_file" 2>/dev/null | sed 's/.*\[//;s/\]//;s/"//g;s/,/ /g' || true)
    prov_started=$(grep -o '"startedAt": *"[^"]*"' "$prov_file" 2>/dev/null | sed 's/.*"\([^"]*\)".*/\1/' || true)
    prov_stopped=$(grep -o '"stoppedAt": *"[^"]*"' "$prov_file" 2>/dev/null | sed 's/.*"\([^"]*\)".*/\1/' || true)
    prov_cmdline=$(grep -o '"cmdline": *"[^"]*"' "$prov_file" 2>/dev/null | sed 's/.*"\([^"]*\)".*/\1/' || true)
    prov_cwd=$(grep -o '"cwd": *"[^"]*"' "$prov_file" 2>/dev/null | sed 's/.*"\([^"]*\)".*/\1/' || true)
    prov_start_time=$(grep -o '"startTime": *"[^"]*"' "$prov_file" 2>/dev/null | sed 's/.*"\([^"]*\)".*/\1/' || true)
  fi

  # ── Production guard ────────────────────────────────────────────
  for port in $prov_ports; do
    if [ -n "$port" ] && is_production_port "$port"; then
      refuse_production "status: provenance port $port is a production port"
    fi
  done

  # ── Process liveness (kill -0 — portable, no /proc dependency) ────
  # MACP5 US-001: the linux-only `[ -d /proc/<pid> ]` requirement is
  # DROPPED — kill -0 is the portable liveness probe and works on
  # /proc-less hosts (Darwin). Fail-closed semantics unchanged: a pid that
  # is not alive can never contribute to RUNNING.
  local pid_alive=false
  if [ -n "$prov_pid" ] && [ "$prov_pid" != "null" ] && [ "$prov_pid" -gt 0 ] 2>/dev/null; then
    if kill -0 "$prov_pid" 2>/dev/null; then
      pid_alive=true
    fi
  fi

  # ── Port listening status ───────────────────────────────────────
  local ports_active=false
  local any_port_listening=false
  for port in $prov_ports; do
    if [ -n "$port" ] && is_port_listening "$port"; then
      any_port_listening=true
      break
    fi
  done
  if $pid_alive && $any_port_listening; then
    ports_active=true
  fi

  # ── Cmdline verification (S54: TT daemon argv — not literal 'tamandua') ─
  # MACP5 US-001: PORTABLE cmdline evidence behind the TT_DC_PLATFORM seam
  # (mirroring verify_process_tt_owned): on Darwin (no procfs) the cmdline
  # comes from `ps -p <pid> -o command=` (BSD + procps portable); on linux
  # the /proc/<pid>/cmdline read is retained (linux-only — never reached on
  # /proc-less hosts). RUNNING requires the cmdline to be a TT daemon
  # cmdline: it must contain the literal 'tamandua' (the CLI wrapper argv
  # and fake scripted shims) OR reference THIS repo's built product
  # ($TT_REPO_ROOT/dist/server/… — the real daemon's `node
  # <TT_REPO_ROOT>/dist/server/daemon.js` argv, which carries no 'tamandua'
  # under a checkout named e.g. by run id — S54). Unavailable cmdline
  # evidence -> cmdline_ok=false -> UNKNOWN (never RUNNING on ports alone —
  # fail-closed unchanged).
  local cmdline_ok=false
  if $pid_alive; then
    local actual_cmdline
    local status_platform
    status_platform="${TT_DC_PLATFORM:-$(uname -s)}"
    case "$status_platform" in
      Darwin)
        actual_cmdline="$(ps -p "$prov_pid" -o command= 2>/dev/null | head -1 || true)"
        ;;
      *)
        # linux-only /proc read (MACP5 US-001): guarded by the platform
        # branch above — never reached on /proc-less hosts.
        actual_cmdline=$(tr '\0' ' ' < "/proc/$prov_pid/cmdline" 2>/dev/null || true)
        ;;
    esac
    if echo "$actual_cmdline" | grep -q 'tamandua' \
       || echo "$actual_cmdline" | grep -Fq "$TT_REPO_ROOT/dist/server/"; then
      cmdline_ok=true
    fi
  fi

  # ── Determine and report status ─────────────────────────────────
  if $pid_alive && $cmdline_ok && $ports_active; then
    echo "STATUS: RUNNING"
    echo "  kind: $kind"
    echo "  pid: $prov_pid"
    echo "  ports: $prov_ports"
    echo "  startedAt: $prov_started"
    echo "  startTime: $prov_start_time"
    echo "  cmdline: tamandua ✓"
    for port in $prov_ports; do
      if [ -n "$port" ] && is_port_listening "$port"; then
        echo "  - port $port: LISTENING"
      else
        echo "  - port $port: free"
      fi
    done
  elif [ -n "$prov_stopped" ] && [ "$prov_stopped" != "null" ] && ! $pid_alive && ! $any_port_listening; then
    echo "STATUS: STOPPED"
    echo "  kind: $kind"
    echo "  pid: $prov_pid (not alive)"
    echo "  ports: $prov_ports"
    echo "  startedAt: $prov_started"
    echo "  stoppedAt: $prov_stopped"
    for port in $prov_ports; do
      echo "  - port $port: free"
    done
  else
    echo "STATUS: UNKNOWN"
    echo "  kind: $kind"
    echo "  pid: $prov_pid"
    echo "  pid alive: $pid_alive"
    echo "  cmdline verified: $cmdline_ok"
    echo "  ports active: $any_port_listening"
    echo "  ports: $prov_ports"
    echo "  startedAt: $prov_started"
    [ -n "$prov_stopped" ] && [ "$prov_stopped" != "null" ] && echo "  stoppedAt: $prov_stopped"
    for port in $prov_ports; do
      if [ -n "$port" ] && is_port_listening "$port"; then
        echo "  - port $port: LISTENING"
      else
        echo "  - port $port: free"
      fi
    done
  fi
}

# ── reset-state subcommand (MACP7 US-001) ─────────────────────────────

# cmd_reset_state: reset the CONTAINED SCRIPTED state to a known-clean
# empty state dir (torture-test/var/home-scripted/.tamandua — the DB,
# events, and run bookkeeping) so a campaign attempt starts with NO stale
# orphaned runs from a previous attempt (the MACP7 W2 collision: a
# restarted scripted daemon recovers yesterday's runs and new
# registrations collide with "harness workdir is already set").
#
# Guards (all fail closed):
#   1. scripted-only — kind=real (and anything else) is REFUSED with a
#      distinct reason: this operation must never touch
#      var/home/.tamandua (the REAL contained state) or the operator's
#      ~/.tamandua.
#   2. containment — the state dir is resolved from the SPAWN env
#      (env_for_kind, the same env the daemon would spawn under) and
#      verified strictly inside torture-test/var via resolve_contained_dir
#      BEFORE any destructive operation. (guard_kind_containment already
#      runs in main() before dispatch; this re-verification is the
#      belt-and-suspenders at the destructive site — a future refactor
#      can never reset an escaping path.)
#   3. not-running — refused while the scripted daemon reports RUNNING
#      (identity-verified cmd_status), and also when the state-dir
#      tamandua.pid names a live identity-verified TT-owned daemon (the
#      CLI-auto-start shape: a `workflow run` auto-start records NO
#      daemon-control provenance, so cmd_status alone would report
#      NO_PROVENANCE while a live daemon holds the state dir). The caller
#      stops the daemon first (tolerant stop), then resets.
#
# Success: removes the contained state dir and recreates it (mkdir -p,
# like cmd_start), printing the machine-parseable marker:
#   STATUS: RESET_STATE_OK
#   state_dir: <path>
cmd_reset_state() {
  local kind="$1"

  # ── Guard 1: scripted-only ─────────────────────────────────────────
  if [ "$kind" != "scripted" ]; then
    echo "daemon-control: REFUSING — reset-state is valid ONLY for kind=scripted (the CONTAINED scripted state). kind='$kind' is refused: this operation must never touch var/home/.tamandua (the real contained state) or the operator's ~/.tamandua." >&2
    exit 1
  fi

  # ── Resolve the state dir from the spawn env ───────────────────────
  local spawn_env; spawn_env="$(env_for_kind "$kind")"
  local state_dir; state_dir="$(echo "$spawn_env" | grep '^TAMANDUA_STATE_DIR=' | cut -d= -f2-)"
  if [ -z "$state_dir" ]; then
    echo "daemon-control: ERROR — kind '$kind' spawn env TAMANDUA_STATE_DIR is unset or empty; cannot resolve the contained state dir" >&2
    exit 1
  fi

  # ── Guard 2: containment (fail closed before any destructive op) ───
  local rp; rp="$(resolve_contained_dir "$state_dir")"
  if [ -z "$rp" ]; then
    echo "daemon-control: REFUSING — state dir '$state_dir' does not resolve to a directory; refusing reset-state (fail closed)" >&2
    exit 1
  fi
  local tt_root_rp; tt_root_rp="$(resolve_contained_dir "$TT_ROOT")"
  if [ -z "$tt_root_rp" ]; then
    echo "daemon-control: REFUSING — cannot resolve torture-test/var containment root; refusing reset-state (fail closed)" >&2
    exit 1
  fi
  case "$rp/" in
    "$tt_root_rp"/*) ;;
    *)
      # Resolved to the containment root itself (or above it): acceptable
      # ONLY when the requested path is a not-yet-provisioned CHILD (fresh
      # checkout — the nearest existing ancestor is var itself, judged by
      # resolve_contained_dir); the root itself as a live state dir is
      # refused. Mirrors guard_kind_containment's fresh-checkout semantics.
      if [ "$rp" = "$tt_root_rp" ] && [ ! -e "$state_dir" ]; then
        :
      else
        echo "daemon-control: REFUSING — state dir '$state_dir' escapes torture-test/var (resolves to $rp); refusing reset-state (fail closed)" >&2
        exit 1
      fi
      ;;
  esac

  # ── Guard 2b: never the REAL contained state ────────────────────────
  # kind=scripted + the bundled env resolves home-scripted/.tamandua, but a
  # tampered env script (the TT_DC_ENV_SCRIPTED seam) could point
  # TAMANDUA_STATE_DIR at var/home/.tamandua — which IS under torture-test/
  # var and would pass the containment check above. reset-state must NEVER
  # touch the REAL contained state (var/home/.tamandua) or the operator's
  # ~/.tamandua: refuse when the state dir is var/home/.tamandua or any
  # path under the real contained home var/home/ (fail closed,
  # belt-and-suspenders). Literal-prefix on the unresolved path (the env
  # script emits the literal path) so a not-yet-provisioned home can never
  # alias var itself through resolve_contained_dir's nearest-ancestor walk.
  case "$state_dir/" in
    "$TT_ROOT/home/"*)
      echo "daemon-control: REFUSING — state dir '$state_dir' is under the REAL contained home (var/home/); reset-state is home-scripted ONLY and must never touch var/home/.tamandua or the operator's ~/.tamandua (fail closed)" >&2
      exit 1
      ;;
  esac

  # ── Guard 3: not-running (identity-verified) ───────────────────────
  local status_out
  status_out="$(cmd_status "$kind" 2>&1 || true)"
  if echo "$status_out" | grep -q 'STATUS: RUNNING'; then
    echo "daemon-control: REFUSING — the $kind daemon is RUNNING; stop it first (daemon-control $kind stop) before reset-state" >&2
    exit 1
  fi
  # CLI-auto-start shape (E3.C.2 US-004): a `workflow run` auto-start
  # records NO provenance, so cmd_status reports NO_PROVENANCE while a live
  # identity-verified daemon holds the state-dir pidfile. Refuse then too —
  # the state dir must never be removed out from under a live daemon.
  local pid_file="$state_dir/tamandua.pid"
  if [ -f "$pid_file" ]; then
    local recorded_pid
    recorded_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [ -n "$recorded_pid" ] && verify_launched_daemon_pid "$recorded_pid" "$state_dir"; then
      echo "daemon-control: REFUSING — a live $kind daemon is recorded in the state-dir pidfile (PID $recorded_pid, identity-verified); stop it first (daemon-control $kind stop) before reset-state" >&2
      exit 1
    fi
  fi

  # ── Destructive step: remove the contained state dir, recreate it ──
  rm -rf -- "$state_dir"
  mkdir -p "$state_dir"

  echo "STATUS: RESET_STATE_OK"
  echo "  state_dir: $state_dir"
}

# ── main dispatch ────────────────────────────────────────────────────

main() {
  # --help (standalone or as first argument)
  case "${1:-}" in
    --help|-h) usage; exit 0 ;;
  esac

  # S24/US-006 self-test seam: TT_DAEMON_CONTROL_CONTAINED_PATH=<kind>
  # prints the reconstructed contained launch PATH for the kind and exits —
  # no daemon start, no guards; the only side effect is mkdir -p
  # var/adapters-bin (inert when empty). Used by daemon-control.test.sh to
  # exercise the PATH reconstruction (adapters-bin first, operator bin dirs
  # reordered after) without starting a daemon.
  if [ -n "${TT_DAEMON_CONTROL_CONTAINED_PATH:-}" ]; then
    case "$TT_DAEMON_CONTROL_CONTAINED_PATH" in
      real|scripted)
        contained_path_for_kind "$TT_DAEMON_CONTROL_CONTAINED_PATH"
        exit 0
        ;;
      *)
        echo "daemon-control: invalid TT_DAEMON_CONTROL_CONTAINED_PATH '$TT_DAEMON_CONTROL_CONTAINED_PATH' (expected real|scripted)" >&2
        exit 2
        ;;
    esac
  fi

  # CRED-SURF US-003 self-test seam: TT_DAEMON_CONTROL_ENV_PRINT=<kind>
  # prints the full contained spawn env (env_for_kind output — env script
  # lines + forwarded caller knobs + the surfaced credential KEY=VALUE lines
  # for the real kind) and exits — no daemon start, no guards, no writes.
  # Used by daemon-control.test.sh to exercise the dsh credential surfacing
  # (env wins / hermes-dotenv fallback / absent omission) without starting
  # a daemon.
  if [ -n "${TT_DAEMON_CONTROL_ENV_PRINT:-}" ]; then
    case "$TT_DAEMON_CONTROL_ENV_PRINT" in
      real|scripted)
        env_for_kind "$TT_DAEMON_CONTROL_ENV_PRINT"
        exit 0
        ;;
      *)
        echo "daemon-control: invalid TT_DAEMON_CONTROL_ENV_PRINT '$TT_DAEMON_CONTROL_ENV_PRINT' (expected real|scripted)" >&2
        exit 2
        ;;
    esac
  fi

  if [ $# -lt 2 ]; then
    echo "daemon-control: missing arguments." >&2
    echo "Usage: daemon-control <real|scripted> <start|stop|restart|status|reset-state>" >&2
    echo "       daemon-control --help" >&2
    exit 1
  fi

  local kind="$1"
  local cmd="$2"

  # Validate kind
  case "$kind" in
    real|scripted) ;;
    *)
      echo "daemon-control: invalid kind '$kind'. Expected 'real' or 'scripted'." >&2
      echo "Usage: daemon-control <real|scripted> <start|stop|restart|status|reset-state>" >&2
      exit 1
      ;;
  esac

  # Ensure provenance directory exists
  ensure_prov_dir

  # Production guard: refuse absolutely if any TT port maps to a production port.
  # This is a belt-and-suspenders check — the env scripts set non-production
  # ports by construction, but this guard is the backstop.
  guard_kind_ports "$kind"
  guard_kind_cwd "$kind"
  # FIX10 US-004: fail closed unless the kind's resolved HOME and
  # TAMANDUA_STATE_DIR are strictly inside torture-test/var. Every daemon
  # operation (start/restart/stop/status) refuses when the spawn env would
  # escape var, so a daemon can never be started under an uncontained HOME.
  guard_kind_containment "$kind"

  # Dispatch subcommand
  case "$cmd" in
    start)       cmd_start "$kind" ;;
    stop)        cmd_stop "$kind" ;;
    restart)     cmd_restart "$kind" ;;
    status)      cmd_status "$kind" ;;
    reset-state) cmd_reset_state "$kind" ;;
    *)
      echo "daemon-control: invalid command '$cmd'. Expected start, stop, restart, status, or reset-state." >&2
      echo "Usage: daemon-control <real|scripted> <start|stop|restart|status|reset-state>" >&2
      exit 1
      ;;
  esac
}

main "$@"
