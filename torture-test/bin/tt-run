#!/usr/bin/env bash
# tt-run — torture-test controller entrypoint (invoked via ../run-torture-test).
#
# Launcher contract (spec 12 + operator decision 2026-07-30):
#   - Bare invocation: print a warning, the token/wall estimate for the most
#     comprehensive AVAILABLE tier, usage help, then a visible 32-second
#     countdown; if not interrupted (Ctrl-C), launch that maximum tier.
#   - An explicit tier flag skips all ceremony and just runs.
#   - Exit code is the verdict: 0 green, 1 findings/red, 2 infra failure,
#     3 not-yet-implemented, 4 usage error.
set -euo pipefail

TT_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TT_DIR="$(dirname "$TT_BIN_DIR")"                 # torture-test/
TT_REPO_ROOT="$(dirname "$TT_DIR")"               # repo root
export TT_REPO_ROOT
TT_VAR="$TT_DIR/var"

# Tier registry: name | available(0/1) | est. tokens | est. wall | descr.
# Availability flips as implementation phases land (A: smoke; D: scripted
# scenario battery folds INTO smoke; E: tier0; campaigns: tier1/tier2).
tier_available() {
  case "$1" in
    smoke)
      [ -x "$TT_BIN_DIR/tt-controller" ] \
        && [ -x "$TT_BIN_DIR/tt-verify-environment" ] \
        && [ -f "$TT_DIR/cases/smoke.jsonl" ]
      ;;
    tier0)
      [ -x "$TT_BIN_DIR/tt-controller" ] \
        && [ -x "$TT_BIN_DIR/tt-tier0-assets" ] \
        && [ -f "$TT_DIR/cases/tier0.jsonl" ] \
        && "$TT_BIN_DIR/tt-tier0-assets" "$TT_DIR/cases/tier0.jsonl" >/dev/null 2>&1
      ;;
    tier1)
      [ -x "$TT_BIN_DIR/tt-controller" ] \
        && [ -x "$TT_BIN_DIR/tt-tier1-assets" ] \
        && [ -f "$TT_DIR/cases/tier1.jsonl" ] \
        && "$TT_BIN_DIR/tt-controller" --manifest "$TT_DIR/cases/tier1.jsonl" --validate-only >/dev/null 2>&1 \
        && "$TT_BIN_DIR/tt-tier1-assets" "$TT_DIR/cases/tier1.jsonl" >/dev/null 2>&1
      ;;
    tier2) return 1 ;;
    *) return 1 ;;
  esac
}

tier_info() {
  case "$1" in
    smoke) printf '%s|%s|%s\n' "0 tokens"        "minutes"  "zero-token battery: environment gates, scripted scenarios, oracle self-tests" ;;
    tier0) printf '%s|%s|%s\n' "~2M tokens"      "~3h"      "push gate: delivery corridor + verdict matrix + 1 real bfmw + 1 hermes do-now" ;;
    tier1) printf '%s|%s|%s\n' "~15M tokens"     "~24-30h"  "MVP campaign: ~40 runs, tt-ts/tt-python/tt-poly-lite" ;;
    tier2) printf '%s|%s|%s\n' "~50M tokens (65M hard abort)" "~48h" "full campaign: all languages, all workflows, harness duel, storm" ;;
  esac
}

max_available_tier() {
  local t
  for t in tier2 tier1 tier0 smoke; do
    if tier_available "$t"; then printf '%s' "$t"; return 0; fi
  done
  return 1
}

usage() {
  cat <<EOF
run-torture-test — tamandua torture-test suite (spec: torture-test/tamandua-torture-test-spec/)

Usage: run-torture-test [--smoke | --tier0 [--include-real] | --tier1 | --tier2 | --report | --help]

Tiers (explicit flag = run immediately, no countdown):
EOF
  local t avail info
  for t in smoke tier0 tier1 tier2; do
    info="$(tier_info "$t")"
    if tier_available "$t"; then avail="available"; else avail="NOT YET IMPLEMENTED"; fi
    printf '  --%-6s %-28s %-9s %s [%s]\n' "$t" \
      "$(printf '%s' "$info" | cut -d'|' -f1)" \
      "$(printf '%s' "$info" | cut -d'|' -f2)" \
      "$(printf '%s' "$info" | cut -d'|' -f3)" \
      "$avail"
  done
  cat <<EOF

  --report   Print the most recent results summary and exit.
  --help     This help.

  --tier0 runs the scripted/local push-gate cases only (zero tokens).
  --tier0 --include-real includes both real canaries.
  --tier1 reports + validates Tier-1 cases as pending-real (zero tokens).
  --tier1 --include-real executes the full Tier-1 campaign.
  --case <id>  Run exactly ONE manifest case id (focused rerun).
               Combine with --tier0/--tier1 and optionally --include-real.
  WARNING: --include-real launches real pi and Hermes work and spends real tokens.

Bare invocation (no flags): after a 32s countdown, runs the most
comprehensive available tier. Ctrl-C during the countdown cancels.
All state stays under torture-test/var/ (gitignored).
EOF
}

report_latest() {
  local latest
  latest="$(ls -1dt "$TT_VAR"/results/*/ 2>/dev/null | head -1 || true)"
  if [ -z "$latest" ]; then
    echo "No results yet under torture-test/var/results/."
    return 0
  fi
  echo "Latest results: $latest"
  if [ -f "$latest/report.txt" ]; then cat "$latest/report.txt"; else
    echo "(no report.txt in it yet; contents:)"; ls -la "$latest"
  fi
}

run_tier() {
  local tier="$1"
  local include_real="${2:-false}"
  local case_id="${3:-}"
  if ! tier_available "$tier"; then
    info="$(tier_info "$tier")"
    echo "Tier '$tier' is unavailable because its required assets are not installed or valid ($(printf '%s' "$info" | cut -d'|' -f3))." >&2
    exit 3
  fi
  local manifest="$TT_DIR/cases/$tier.jsonl"
  if [ "$tier" = "smoke" ]; then
    manifest="$TT_DIR/cases/smoke.jsonl"
  fi
  local case_args=()
  if [ -n "$case_id" ]; then
    case_args=(--case "$case_id")
  fi
  case "$tier" in
    smoke)
      exec "$TT_BIN_DIR/tt-controller" --manifest "$manifest" "${case_args[@]}"
      ;;
    tier0)
      if [ "$include_real" = true ]; then
        exec "$TT_BIN_DIR/tt-controller" --manifest "$manifest" "${case_args[@]}"
      fi
      exec "$TT_BIN_DIR/tt-controller" --manifest "$manifest" "${case_args[@]}" --scripted-only
      ;;
    tier1)
      if [ "$include_real" = true ]; then
        exec "$TT_BIN_DIR/tt-controller" --manifest "$manifest" "${case_args[@]}"
      fi
      exec "$TT_BIN_DIR/tt-controller" --manifest "$manifest" "${case_args[@]}" --scripted-only
      ;;
    *)
      echo "internal error: tier '$tier' marked available but has no runner" >&2
      exit 2
      ;;
  esac
}

countdown_and_run_max() {
  local max
  if ! max="$(max_available_tier)"; then
    echo "No tier is implemented yet. Implementation status: bd show tamandua-0j7" >&2
    exit 3
  fi
  local info; info="$(tier_info "$max")"
  cat <<EOF
================================================================
  TAMANDUA TORTURE TEST
  About to run the most comprehensive available tier: --$max
    estimated spend : $(printf '%s' "$info" | cut -d'|' -f1)
    estimated wall  : $(printf '%s' "$info" | cut -d'|' -f2)
    what it does    : $(printf '%s' "$info" | cut -d'|' -f3)

  This can take a long time and (for token-bearing tiers) costs
  real harness tokens. To run a smaller tier instead, Ctrl-C now
  and re-invoke with an explicit flag:
      run-torture-test --smoke     (zero tokens)
      run-torture-test --tier0     (push gate)
      run-torture-test --tier1     (MVP campaign)
      run-torture-test --tier2     (full campaign)
================================================================
EOF
  local i
  for i in $(seq 32 -1 1); do
    printf '\r  Starting --%s in %2ds  (Ctrl-C to cancel) ' "$max" "$i"
    sleep 1
  done
  printf '\r%-60s\r' ' '
  echo "Launching --$max"
  run_tier "$max"
}

if [ "$#" -eq 0 ]; then
  countdown_and_run_max
  exit 0
fi

# Parsed flags: exactly one tier flag, optional --include-real and --case <id>.
# --report is an exclusive mode: it renders the newest campaign report and may
# not be combined with any tier/selection flag (fail-closed, never a silent
# half-parse).
tier=""
include_real="false"
case_id=""
report_requested="false"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --smoke|--tier0|--tier1|--tier2)
      if [ -n "$tier" ] && [ "$tier" != "$1" ]; then
        echo "Conflicting tier flags: $tier and $1" >&2
        usage >&2
        exit 4
      fi
      tier="$1"
      ;;
    --include-real)
      include_real="true"
      ;;
    --case)
      if [ "$#" -lt 2 ]; then
        echo "--case requires a case id" >&2
        usage >&2
        exit 4
      fi
      case_id="$2"
      shift
      ;;
    --report)
      report_requested="true"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 4
      ;;
  esac
  shift
done

if [ "$report_requested" = "true" ]; then
  if [ -n "$tier" ] || [ "$include_real" = "true" ] || [ -n "$case_id" ]; then
    echo "--report cannot be combined with tier flags, --include-real, or --case" >&2
    usage >&2
    exit 4
  fi
  report_latest
  exit 0
fi

if [ -z "$tier" ]; then
  echo "A tier flag (--smoke/--tier0/--tier1/--tier2) is required when --include-real/--case are used" >&2
  usage >&2
  exit 4
fi

if [ "$include_real" = "true" ] && [ "$tier" != "--tier0" ] && [ "$tier" != "--tier1" ]; then
  echo "--include-real is only valid with --tier0 or --tier1" >&2
  usage >&2
  exit 4
fi

case "$tier" in
  --smoke)  run_tier smoke "$include_real" "$case_id" ;;
  --tier0)  run_tier tier0 "$include_real" "$case_id" ;;
  --tier1)  run_tier tier1 "$include_real" "$case_id" ;;
  --tier2)  run_tier tier2 "$include_real" "$case_id" ;;
  *)        echo "internal error: unknown tier flag $tier" >&2; exit 4 ;;
esac
