#!/usr/bin/env bash
# tt-provision-home — idempotently provisions TT_HOME directories.
#
# Creates real TT_HOME (torture-test/var/home/) and scripted TT_HOME
# (torture-test/var/home-scripted/) per spec 01 TT_HOME provisioning
# checklist.
#
# Modes:
#   (no args)           — idempotent best-effort provisioning (Phase A).
#   --fail-closed       — ITERATIVE fail-closed preflight: provisions the REAL
#                         contained TT home (resolved from env/tt-env.sh, never
#                         the operator's ~/.tamandua) and VERIFIES the spec-01
#                         required legs. On ANY leg that cannot be established
#                         (missing dirs, gitconfig identity, copy failure) it
#                         exits non-zero and emits the DISTINCT machine-parseable
#                         reason string `tt-home-unprovisioned` on stderr.
#                         Idempotent: repeated runs against a healthy home are
#                         no-ops.
#
# E2.6 US-004 — minimal harness-credential surfacing:
# Instead of blindly copying the WHOLE ~/.pi and ~/.hermes (hermes state.db is
# 1.5GB), this helper surfaces ONLY the enumerated minimal auth/config files
# each harness actually reads to resolve a model + API key. The operator's
# env-provided API keys (e.g. DEEPSEEK_API_KEY) are additionally materialized
# into the contained home (pi auth.json + hermes .env) because the contained
# daemon is started under `env -i` (daemon-control) and never inherits the
# operator's environment. No ~/.tamandua, ~/.ssh, or operator gitconfig is ever
# surfaced. The enumerated set is documented in `usage` and in
# torture-test/impl-tasks/E2.6-catalog-and-harness-credentials.md.
#
# Idempotent: safe to run repeatedly — second run is a no-op.
# Follows spec 01 two-env rule: never mutates caller environment.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TT_DIR="$(dirname "$SCRIPT_DIR")"                        # torture-test/
TT_REPO_ROOT="$(dirname "$TT_DIR")"                      # repo root
# Allow override for testing
TT_VAR="${TT_VAR:-$TT_DIR/var}"

REAL_TT_HOME="$TT_VAR/home"
SCRIPTED_TT_HOME="$TT_VAR/home-scripted"

# ── helpers ───────────────────────────────────────────────────────────

log() { printf '[tt-provision-home] %s\n' "$*"; }
log_verbose() { log "$@"; }

# resolve_operator_home: the OPERATOR's real HOME — the copy SOURCE for the
# enumerated harness auth/config files. This must NOT be `$HOME`: the contained
# spawn env (env/tt-env.sh) overrides HOME to the contained TT home, so a
# `$HOME`-based source would self-copy the contained home (the original E2.6
# bug — the operator's ~/.pi/~/.hermes were never surfaced under the controller).
# Priority:
#   1. TT_OPERATOR_HOME env override (test seam / explicit pin)
#   2. passwd database (getent passwd) — the real operator home, independent
#      of the HOME override
#   3. $HOME fallback (standalone manual runs)
resolve_operator_home() {
  if [ -n "${TT_OPERATOR_HOME:-}" ]; then
    printf '%s' "$TT_OPERATOR_HOME"
    return 0
  fi
  local pw_home
  pw_home="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || true)"
  if [ -n "$pw_home" ]; then
    printf '%s' "$pw_home"
    return 0
  fi
  # macOS fallback: getent is absent; read the NFS home directory via dscl.
  if command -v dscl >/dev/null 2>&1; then
    pw_home="$(dscl . -read /Users/$(id -un) NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
    if [ -n "$pw_home" ]; then
      printf '%s' "$pw_home"
      return 0
    fi
  fi
  printf '%s' "${HOME:-}"
}

# OPERATOR_HOME (copy source) and REAL_HOME (audit rewrite source path). Both
# resolve via getent/passwd so the controller's contained-HOME override can't
# break credential surfacing. Assigned at top level after resolve_operator_home
# is defined; the surfacing functions below read them as globals.
OPERATOR_HOME="$(resolve_operator_home)"
REAL_HOME="$OPERATOR_HOME"

# ── Enumerated minimal harness auth/config files (E2.6 US-004) ───────
#
# These are the ONLY files surfaced from the operator's real HOME into the
# contained TT home. Each harness reads these to resolve a model + API key;
# everything else (sessions, state.db, caches, skills, logs, .ssh, gitconfig)
# is deliberately excluded.
#
# pi reads these from ~/.pi/agent/ (pi config/auth resolution; see
# src/installer/paths.ts and pi docs models.md/providers.md):
#   settings.json  — defaultProvider/defaultModel/thinking level; the selected
#                    model comes from here when tamandua invokes `pi --print`
#                    with no --model override.
#   models.json    — custom provider definitions (baseUrl + inline apiKey +
#                    model list); the operator's local-dspark provider lives here.
#   auth.json      — NOT in the verbatim-copy list: it is produced by
#                    surface_env_api_keys below (operator auth.json base +
#                    env-provided API keys merged in), so there is a single
#                    writer and the copy never clobbers the merged result.
PI_AGENT_FILES=("settings.json" "models.json")

# hermes reads these from ~/.hermes/ (HERMES_HOME):
#   config.yaml    — default model/provider + auxiliary provider slots; the
#                    model+provider selection for every hermes round.
#   auth.json      — OAuth/API-key credential store (openai-codex id_token +
#                    refresh_token + credential_pool); the source of hermes auth.
HERMES_FILES=("config.yaml" "auth.json")

# pi built-in provider API-key env map (env var name -> pi auth.json provider
# key). pi resolves provider API keys from auth.json first, then these
# environment variables (pi docs providers.md). We materialize any that are
# SET in the operator environment into the contained pi auth.json so the
# contained daemon (started under `env -i`) can still resolve them. hermes
# reads the SAME KEY=VALUE pairs from ~/.hermes/.env via load_hermes_dotenv.
PI_ENV_API_KEY_MAP=(
  "ANTHROPIC_API_KEY|anthropic"
  "ANT_LING_API_KEY|ant-ling"
  "OPENAI_API_KEY|openai"
  "DEEPSEEK_API_KEY|deepseek"
  "NVIDIA_API_KEY|nvidia"
  "GEMINI_API_KEY|google"
  "MISTRAL_API_KEY|mistral"
  "GROQ_API_KEY|groq"
  "CEREBRAS_API_KEY|cerebras"
  "XAI_API_KEY|xai"
  "OPENROUTER_API_KEY|openrouter"
  "AI_GATEWAY_API_KEY|vercel-ai-gateway"
  "ZAI_API_KEY|zai"
  "MINIMAX_API_KEY|minimax"
  "HF_TOKEN|huggingface"
  "FIREWORKS_API_KEY|fireworks"
  "TOGETHER_API_KEY|together"
  "KIMI_API_KEY|kimi-coding"
  "OPENCODE_API_KEY|opencode"
)

# ── .gitconfig creation ──────────────────────────────────────────────

provision_gitconfig() {
  local dest="$1"
  local dest_gitconfig="$dest/.gitconfig"

  mkdir -p "$dest"

  if [ -f "$dest_gitconfig" ]; then
    log "  .gitconfig already exists at $dest_gitconfig — skipping"
    return 0
  fi

  log "Creating $dest_gitconfig"
  cat > "$dest_gitconfig" <<'GITCONF'
[user]
    name = Tamandua Torture Test
    email = tt@tamandua.test
[commit]
    gpgsign = false
[init]
    defaultBranch = main
[pull]
    ff = only
GITCONF
}

# ── minimal-file surfacing (E2.6 US-004) ─────────────────────────────

# surface_minimal_file: copy ONE enumerated harness auth/config file from the
# operator's real HOME into the contained TT home (never a whole directory).
# Audits for absolute real-HOME path references and rewrites them (spec 01),
# recording rewrites in the audit file. Idempotent: compares the AUDITED
# content against the current destination, so a file already rewritten by an
# earlier run is a byte-for-byte no-op (no churn, no re-audit).
surface_minimal_file() {
  local src="$1"       # absolute source path (operator HOME)
  local dest="$2"      # absolute destination path (contained HOME)
  local audit_file="$3"
  local home="$4"      # contained HOME root (for relative audit paths)

  if [ ! -f "$src" ]; then
    log "  $src does not exist — skipping (operator has no such file)"
    return 0
  fi

  mkdir -p "$(dirname "$dest")"

  # Build the audited content in a temp file (source with any real-HOME paths
  # rewritten to the contained destination directory).
  local tmp rewrites
  tmp="$(mktemp "${TMPDIR:-/tmp}/tt-provision-audit.XXXXXX")"
  rm -f "$tmp"
  cp -a "$src" "$tmp"
  rewrites=0
  if grep -qF "$REAL_HOME" "$tmp" 2>/dev/null; then
    local sed_real_home sed_dest_dir
    sed_real_home="$(printf '%s' "$REAL_HOME" | sed 's/|/\\|/g')"
    sed_dest_dir="$(printf '%s' "$(dirname "$dest")" | sed 's/|/\\|/g')"
    rewrites="$(grep -cF "$REAL_HOME" "$tmp" 2>/dev/null || echo 0)"
    # PORTABLE in-place rewrite (MACP5 US-004): GNU sed's `-i` is a GNU-ism —
    # BSD/macOS sed requires a suffix argument and misparses the file as a
    # script. Write to a temp file and atomically mv instead. (Reachable on
    # Darwin via the bare-tier1 campaign preflight's home-provision leg.)
    sed "s|${sed_real_home}|${sed_dest_dir}|g" "$tmp" > "$tmp.rewrite" && mv "$tmp.rewrite" "$tmp"
  fi

  # Idempotent: identical audited content already in place → no-op.
  if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"
    return 0
  fi

  log "  Surfacing $src → $dest"
  cp -a "$tmp" "$dest"
  rm -f "$tmp"

  if [ "$rewrites" -gt 0 ]; then
    printf '{"file":"%s","replacements":%s,"old":"%s","new":"%s"}\n' \
      "${dest#"$home/"}" "$rewrites" "$REAL_HOME" "$(dirname "$dest")" \
      >> "$audit_file"
    log "  Audited: $rewrites path rewrite(s) in $dest"
  fi
}

# surface_pi_files: surface the enumerated pi agent config files (settings +
# models). auth.json is NOT handled here — surface_env_api_keys owns it so the
# env-key merge is never clobbered by a verbatim re-copy on later runs.
surface_pi_files() {
  local home="$1"
  local src_agent="$OPERATOR_HOME/.pi/agent"
  local dest_agent="$home/.pi/agent"
  local f
  for f in "${PI_AGENT_FILES[@]}"; do
    surface_minimal_file "$src_agent/$f" "$dest_agent/$f" "$home/provision-audit.json" "$home"
  done
}

# surface_hermes_files: surface the enumerated hermes config files (config +
# auth). Hermes OAuth tokens are fully contained in auth.json; the deepseek
# API-key env materialization goes to .env in surface_env_api_keys.
surface_hermes_files() {
  local home="$1"
  local src="$OPERATOR_HOME/.hermes"
  local dest="$home/.hermes"
  local f
  for f in "${HERMES_FILES[@]}"; do
    surface_minimal_file "$src/$f" "$dest/$f" "$home/provision-audit.json" "$home"
  done
}

# surface_env_api_keys: materialize the operator's env-provided harness API
# keys into the contained home so the contained daemon (started under `env -i`
# by daemon-control — no operator env inherited) can still resolve a model +
# API key. This is what fixes the E2.6 `No API key found for the selected
# model` failures.
#   pi:     merges the operator's ~/.pi/agent/auth.json base with any SET
#           API-key env vars (pi auth.json format: {"<provider>":{"type":
#           "api_key","key":"..."}}), writing 0600.
#   hermes: writes the SET API-key env vars verbatim into ~/.hermes/.env
#           (dotenv KEY=VALUE format; hermes loads it via load_hermes_dotenv).
# Idempotent: only writes when the resulting content would change.
surface_env_api_keys() {
  local home="$1"

  # Newline-separated ENVVAR=provider pairs (no secrets on the command line;
  # values are read directly from the process env by the node helper).
  local pairs="" entry envvar provider
  for entry in "${PI_ENV_API_KEY_MAP[@]}"; do
    envvar="${entry%%|*}"
    provider="${entry##*|}"
    if [ -n "${!envvar:-}" ]; then
      pairs="${pairs}${envvar}=${provider}"$'\n'
    fi
  done

  # ── pi: merge operator auth.json + env keys into contained auth.json ──
  local pi_auth="$home/.pi/agent/auth.json"
  mkdir -p "$(dirname "$pi_auth")"
  local pi_src_auth="$OPERATOR_HOME/.pi/agent/auth.json"
  node - "$pi_auth" "$pi_src_auth" "$pairs" <<'NODE'
'use strict';
const fs = require('fs');
const [authPath, srcAuthPath, pairsRaw] = process.argv.slice(2);
let auth = {};
if (srcAuthPath && fs.existsSync(srcAuthPath)) {
  try { auth = JSON.parse(fs.readFileSync(srcAuthPath, 'utf8')); } catch { auth = {}; }
}
for (const line of (pairsRaw || '').split('\n')) {
  const i = line.indexOf('=');
  if (i <= 0) continue;
  const envVar = line.slice(0, i);
  const provider = line.slice(i + 1);
  const key = process.env[envVar];
  if (key && key.length > 0) auth[provider] = { type: 'api_key', key };
}
const out = JSON.stringify(auth, null, 2) + '\n';
let current = '';
try { current = fs.readFileSync(authPath, 'utf8'); } catch { current = ''; }
if (current !== out) {
  fs.writeFileSync(authPath, out, { mode: 0o600 });
  fs.chmodSync(authPath, 0o600);
  process.stderr.write('[tt-provision-home] surfaced pi env API keys into ' + authPath + '\n');
}
NODE

  # ── hermes: write SET API-key env vars verbatim into ~/.hermes/.env ──
  local hermes_env="$home/.hermes/.env"
  mkdir -p "$(dirname "$hermes_env")"
  local new_env="" val
  for entry in "${PI_ENV_API_KEY_MAP[@]}"; do
    envvar="${entry%%|*}"
    val="${!envvar:-}"
    if [ -n "$val" ]; then
      new_env="${new_env}${envvar}=${val}"$'\n'
    fi
  done
  local cur_env=""
  if [ -f "$hermes_env" ]; then
    cur_env="$(cat "$hermes_env")"
  fi
  # Compare after command-substitution normalization (strips trailing
  # newlines on both sides) so a byte-identical .env is a no-op.
  if [ "$(printf '%s' "$new_env")" != "$cur_env" ]; then
    if [ -n "$new_env" ]; then
      printf '%s' "$new_env" > "$hermes_env"
    else
      : > "$hermes_env"
    fi
    chmod 600 "$hermes_env"
    log "  Surfaced operator API-key env vars into $hermes_env"
  fi
}

# ── remove .ssh if it exists ─────────────────────────────────────────

remove_ssh_dir() {
  local dest="$1"
  if [ -d "$dest/.ssh" ]; then
    log "  Removing $dest/.ssh (not permitted in TT_HOME)"
    rm -rf "$dest/.ssh"
  fi
}

# ── contained TT_HOME resolution (fail-closed) ──────────────────────

# resolve_contained_tt_home: prints the REAL contained TT_HOME (the home the
# spawned tamandua/pi/hermes processes actually use). Resolution priority:
#   1. TT_VAR env override (test seam) → $TT_VAR/home
#   2. env/tt-env.sh `print` output → TT_HOME (the contained home under
#      torture-test/var, ports 43xx)
#   3. ultimate fallback → $TT_DIR/var/home
#
# It NEVER resolves to the operator's real ~/.tamandua: the env script derives
# TT_HOME from TT_REPO_ROOT (torture-test/var/home), which is inside the repo.
resolve_contained_tt_home() {
  if [ -n "${TT_VAR:-}" ]; then
    printf '%s' "$TT_VAR/home"
    return 0
  fi
  local env_script="$TT_DIR/env/tt-env.sh"
  if [ -f "$env_script" ]; then
    local home_line
    home_line="$(env -i bash "$env_script" print 2>/dev/null | grep '^TT_HOME=' | head -n1 || true)"
    if [ -n "$home_line" ]; then
      local home
      home="${home_line#TT_HOME=}"
      if [ -n "$home" ]; then
        printf '%s' "$home"
        return 0
      fi
    fi
  fi
  printf '%s' "$TT_VAR/home"
}

# verify_gitconfig_identity: returns 0 if $1/.gitconfig carries the spec-01
# required identity fields rooted at the contained home; prints the failing
# leg names otherwise (never exits the script).
verify_gitconfig_identity() {
  local cfg="$1/.gitconfig"
  [ -f "$cfg" ] || { printf 'gitconfig-missing'; return 1; }
  local required=("user.name" "user.email" "commit.gpgsign" "init.defaultBranch" "pull.ff")
  local missing=""
  local r
  for r in "${required[@]}"; do
    local val
    val="$(git config -f "$cfg" --get "$r" 2>/dev/null || true)"
    if [ -z "$val" ]; then
      missing="${missing}${r};"
    fi
  done
  # Belt-and-suspenders: the exact TT identity per spec 01 (a wrong identity
  # is a provisioning defect even though the keys parse).
  local name email
  name="$(git config -f "$cfg" --get user.name 2>/dev/null || true)"
  email="$(git config -f "$cfg" --get user.email 2>/dev/null || true)"
  [ "$name" != "Tamandua Torture Test" ] && missing="${missing}identity:user.name;"
  [ "$email" != "tt@tamandua.test" ] && missing="${missing}identity:user.email;"
  if [ -n "$missing" ]; then
    printf '%s' "$missing"
    return 1
  fi
  return 0
}

# fail_closed_real_home: ensures the REAL contained TT home is provisioned and
# fail-closes with the DISTINCT reason `tt-home-unprovisioned` if any leg cannot
# be established. Runs entirely under the contained env semantics — the copy
# sources are the operator's real ~/.pi and ~/.hermes, but every WRITE lands
# under the contained TT_VAR; the operator's ~/.tamandua and 33xx daemon are
# never touched.
fail_closed_real_home() {
  local home
  home="$(resolve_contained_tt_home)"
  local fail=""

  # Provisioning must be best-effort here so the verification legs below are
  # what decides the outcome (a sub-step failure is a leg, not an abort).
  set +e
  provision_gitconfig "$home"
  surface_pi_files "$home"
  surface_hermes_files "$home"
  surface_env_api_keys "$home"
  remove_ssh_dir "$home"

  # ── verification legs (fail-closed) ──
  if [ ! -d "$home" ]; then
    fail="${fail}missing-dir:${home};"
  fi
  if [ -d "$home" ]; then
    local gitcfg_fail
    gitcfg_fail="$(verify_gitconfig_identity "$home")" && true
    if [ "$gitcfg_fail" != "" ] || [ ! -f "$home/.gitconfig" ]; then
      fail="${fail}gitconfig:${gitcfg_fail:-missing};"
    fi
  else
    fail="${fail}gitconfig:no-home;"
  fi

  # Minimal-file copy legs: a copy is a failure ONLY when the operator source
  # exists but the contained destination is absent (a genuine copy failure).
  # If the operator has no such file the base tool skips intentionally — not a
  # leg. auth.json (pi) is produced by the env-key merge and is verified to
  # exist regardless of operator/env-key presence.
  local src_file dest_file
  for src_file in ".pi/agent/settings.json" ".pi/agent/models.json" \
                  ".hermes/config.yaml" ".hermes/auth.json"; do
    if [ -f "${OPERATOR_HOME}/${src_file}" ] && [ ! -f "${home}/${src_file}" ]; then
      fail="${fail}copy-missing:${src_file};"
    fi
  done
  if [ ! -f "$home/.pi/agent/auth.json" ]; then
    fail="${fail}copy-missing:.pi/agent/auth.json;"
  fi
  set -e

  if [ -n "$fail" ]; then
    echo "REASON: tt-home-unprovisioned" >&2
    echo "DETAILS: ${fail}" >&2
    log "FAIL: contained TT home NOT provisioned ($home)" >&2
    return 1
  fi
  log "OK: contained TT home provisioned at $home"
  return 0
}

# ── usage ────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
tt-provision-home — idempotently provisions TT_HOME directories.

Usage: tt-provision-home [--fail-closed] [--help]

Provisions:
  torture-test/var/home/          (real TT_HOME)
  torture-test/var/home-scripted/ (scripted TT_HOME)

Real TT_HOME gets (E2.6 US-004 — MINIMAL enumerated set, no whole-dir copy):
  - .gitconfig with TT-specific identity settings
  - .pi/agent/settings.json   (default model/provider selection)
  - .pi/agent/models.json     (custom provider defs + inline apiKey)
  - .pi/agent/auth.json       (operator auth.json base + env API keys merged)
  - .hermes/config.yaml       (default model/provider + auxiliary slots)
  - .hermes/auth.json         (OAuth/API-key credential store)
  - .hermes/.env              (operator env API keys, dotenv KEY=VALUE)
  - NO .ssh directory, NO ~/.tamandua, NO operator gitconfig, NO ~/.hermes
    state.db/caches/sessions (the whole-directory copy is removed)

Env-provided API keys (e.g. DEEPSEEK_API_KEY/OPENAI_API_KEY/ANTHROPIC_API_KEY)
are materialized into the contained home (pi auth.json + hermes .env) because
the contained daemon starts under env -i and never inherits the operator env.

Scripted TT_HOME gets:
  - .gitconfig only (same settings)
  - NO .pi / .hermes copies

--fail-closed (E2.5): preflight mode for real-case campaigns. Resolves the
  contained real TT_HOME (from env/tt-env.sh — never the operator's
  ~/.tamandua), provisions it if absent, then FAILS CLOSED with the DISTINCT
  machine-parseable reason string 'tt-home-unprovisioned' (exit non-zero) if
  any spec-01 required leg cannot be established. Idempotent: repeated runs
  against a healthy home are no-ops (exit 0). Never touches the operator's
  ~/.tamandua or the 33xx daemon.

Idempotent: safe to run repeatedly — second run is a no-op.
Never mutates the caller's environment (spec 01 two-env rule).
EOF
}

# ── main ──────────────────────────────────────────────────────────────

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --fail-closed|-f) FAIL_CLOSED=1 ;;  # leading marker; handled below
  "")
    ;;
  *)
    echo "Unknown argument: $1" >&2
    usage >&2
    exit 2
    ;;
esac

# ── dispatch ──────────────────────────────────────────────────────────

if [ "${FAIL_CLOSED:-0}" = "1" ]; then
  fail_closed_real_home
  exit $?
fi


log "Starting TT_HOME provisioning"
log "  Real TT_HOME  : $REAL_TT_HOME"
log "  Scripted TT_HOME: $SCRIPTED_TT_HOME"
log "  Real HOME     : $REAL_HOME"

# ──────── real TT_HOME ────────────────────────────────────────────────

echo ""
log "── Real TT_HOME ($REAL_TT_HOME) ──"

provision_gitconfig "$REAL_TT_HOME"

# Surface ONLY the enumerated minimal pi/hermes auth/config files (US-004),
# then materialize the operator's env-provided API keys.
surface_pi_files "$REAL_TT_HOME"
surface_hermes_files "$REAL_TT_HOME"
surface_env_api_keys "$REAL_TT_HOME"

# Remove .ssh if present (belt-and-suspenders)
remove_ssh_dir "$REAL_TT_HOME"

# ──────── scripted TT_HOME ────────────────────────────────────────────

echo ""
log "── Scripted TT_HOME ($SCRIPTED_TT_HOME) ──"

provision_gitconfig "$SCRIPTED_TT_HOME"

# No .pi / .hermes copies for scripted
# No .ssh either
remove_ssh_dir "$SCRIPTED_TT_HOME"

echo ""
log "Provisioning complete."
log "  Real TT_HOME    : $REAL_TT_HOME"
log "  Scripted TT_HOME: $SCRIPTED_TT_HOME"
log "  Audit file      : $REAL_TT_HOME/provision-audit.json"
