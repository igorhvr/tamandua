#!/usr/bin/env bash
# tt-provision-home — idempotently provisions TT_HOME directories.
#
# Creates real TT_HOME (torture-test/var/home/) and scripted TT_HOME
# (torture-test/var/home-scripted/) per spec 01 TT_HOME provisioning
# checklist.
#
# Modes:
#   (no args)           — idempotent best-effort provisioning (Phase A).
#   --fail-closed       — ITERATIVE fail-closed preflight: provisions the REAL
#                         contained TT home (resolved from env/tt-env.sh, never
#                         the operator's ~/.tamandua) and VERIFIES the spec-01
#                         required legs. On ANY leg that cannot be established
#                         (missing dirs, gitconfig identity, copy failure) it
#                         exits non-zero and emits the DISTINCT machine-parseable
#                         reason string `tt-home-unprovisioned` on stderr.
#                         Idempotent: repeated runs against a healthy home are
#                         no-ops.
#
# Idempotent: safe to run repeatedly — second run is a no-op.
# Follows spec 01 two-env rule: never mutates caller environment.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TT_DIR="$(dirname "$SCRIPT_DIR")"                        # torture-test/
TT_REPO_ROOT="$(dirname "$TT_DIR")"                      # repo root
# Allow override for testing
TT_VAR="${TT_VAR:-$TT_DIR/var}"

REAL_TT_HOME="$TT_VAR/home"
SCRIPTED_TT_HOME="$TT_VAR/home-scripted"

REAL_HOME="${HOME}"

# ── helpers ───────────────────────────────────────────────────────────

log() { printf '[tt-provision-home] %s\n' "$*"; }
log_verbose() { log "$@"; }

# ── .gitconfig creation ──────────────────────────────────────────────

provision_gitconfig() {
  local dest="$1"
  local dest_gitconfig="$dest/.gitconfig"

  mkdir -p "$dest"

  if [ -f "$dest_gitconfig" ]; then
    log "  .gitconfig already exists at $dest_gitconfig — skipping"
    return 0
  fi

  log "Creating $dest_gitconfig"
  cat > "$dest_gitconfig" <<'GITCONF'
[user]
    name = Tamandua Torture Test
    email = tt@tamandua.test
[commit]
    gpgsign = false
[init]
    defaultBranch = main
[pull]
    ff = only
GITCONF
}

# ── directory copy with path audit ───────────────────────────────────

copy_and_audit() {
  local src_dir="$1"
  local dest_dir="$2"
  local audit_file="$3"
  local label="$4"

  if [ ! -d "$src_dir" ]; then
    log "  $src_dir does not exist — skipping $label copy"
    mkdir -p "$dest_dir" 2>/dev/null || true
    return 0
  fi

  if [ -d "$dest_dir" ] && [ -n "$(ls -A "$dest_dir" 2>/dev/null || true)" ]; then
    log "  $dest_dir already exists and is non-empty — skipping $label copy"
    return 0
  fi

  log "Copying $src_dir → $dest_dir (NOT a symlink)"
  rm -rf "$dest_dir"
  cp -a "$src_dir" "$dest_dir"

  # Audit for absolute paths pointing at the real HOME
  log "  Auditing $dest_dir for real-home paths ($REAL_HOME) ..."
  local rewrites=0
  while IFS= read -r file; do
    if [ ! -f "$file" ]; then continue; fi
    if grep -qF "$REAL_HOME" "$file" 2>/dev/null; then
      log_verbose "    Found real-home reference in: $file"
      # Escape for sed: use | as delimiter since paths contain /
      # But first we must also escape | characters if they appear in the home path
      local sed_real_home
      sed_real_home="$(printf '%s' "$REAL_HOME" | sed 's/|/\\|/g')"
      local sed_tt_home
      sed_tt_home="$(printf '%s' "$dest_dir" | sed 's/|/\\|/g')"

      # Count and record rewrites before doing them
      local count
      count="$(grep -cF "$REAL_HOME" "$file" 2>/dev/null || echo 0)"

      sed -i "s|${sed_real_home}|${sed_tt_home}|g" "$file"

      printf '{"file":"%s","replacements":%s,"old":"%s","new":"%s"}\n' \
        "${file#"$dest_dir/"}" "$count" "$REAL_HOME" "$dest_dir" \
        >> "$audit_file"
      rewrites=$((rewrites + count))
    fi
  done < <(find "$dest_dir" -type f 2>/dev/null || true)

  if [ "$rewrites" -gt 0 ]; then
    log "  Audited: $rewrites path rewrite(s) in $label copy → $audit_file"
  else
    log "  Audited: no real-home paths found in $label copy"
  fi
}

# ── remove .ssh if it exists ─────────────────────────────────────────

remove_ssh_dir() {
  local dest="$1"
  if [ -d "$dest/.ssh" ]; then
    log "  Removing $dest/.ssh (not permitted in TT_HOME)"
    rm -rf "$dest/.ssh"
  fi
}

# ── contained TT_HOME resolution (fail-closed) ──────────────────────

# resolve_contained_tt_home: prints the REAL contained TT_HOME (the home the
# spawned tamandua/pi/hermes processes actually use). Resolution priority:
#   1. TT_VAR env override (test seam) → $TT_VAR/home
#   2. env/tt-env.sh `print` output → TT_HOME (the contained home under
#      torture-test/var, ports 43xx)
#   3. ultimate fallback → $TT_DIR/var/home
#
# It NEVER resolves to the operator's real ~/.tamandua: the env script derives
# TT_HOME from TT_REPO_ROOT (torture-test/var/home), which is inside the repo.
resolve_contained_tt_home() {
  if [ -n "${TT_VAR:-}" ]; then
    printf '%s' "$TT_VAR/home"
    return 0
  fi
  local env_script="$TT_DIR/env/tt-env.sh"
  if [ -f "$env_script" ]; then
    local home_line
    home_line="$(env -i bash "$env_script" print 2>/dev/null | grep '^TT_HOME=' | head -n1 || true)"
    if [ -n "$home_line" ]; then
      local home
      home="${home_line#TT_HOME=}"
      if [ -n "$home" ]; then
        printf '%s' "$home"
        return 0
      fi
    fi
  fi
  printf '%s' "$TT_VAR/home"
}

# verify_gitconfig_identity: returns 0 if $1/.gitconfig carries the spec-01
# required identity fields rooted at the contained home; prints the failing
# leg names otherwise (never exits the script).
verify_gitconfig_identity() {
  local cfg="$1/.gitconfig"
  [ -f "$cfg" ] || { printf 'gitconfig-missing'; return 1; }
  local required=("user.name" "user.email" "commit.gpgsign" "init.defaultBranch" "pull.ff")
  local missing=""
  local r
  for r in "${required[@]}"; do
    local val
    val="$(git config -f "$cfg" --get "$r" 2>/dev/null || true)"
    if [ -z "$val" ]; then
      missing="${missing}${r};"
    fi
  done
  # Belt-and-suspenders: the exact TT identity per spec 01 (a wrong identity
  # is a provisioning defect even though the keys parse).
  local name email
  name="$(git config -f "$cfg" --get user.name 2>/dev/null || true)"
  email="$(git config -f "$cfg" --get user.email 2>/dev/null || true)"
  [ "$name" != "Tamandua Torture Test" ] && missing="${missing}identity:user.name;"
  [ "$email" != "tt@tamandua.test" ] && missing="${missing}identity:user.email;"
  if [ -n "$missing" ]; then
    printf '%s' "$missing"
    return 1
  fi
  return 0
}

# fail_closed_real_home: ensures the REAL contained TT home is provisioned and
# fail-closes with the DISTINCT reason `tt-home-unprovisioned` if any leg cannot
# be established. Runs entirely under the contained env semantics — the copy
# sources are the operator's real ~/.pi and ~/.hermes, but every WRITE lands
# under the contained TT_VAR; the operator's ~/.tamandua and 33xx daemon are
# never touched.
fail_closed_real_home() {
  local home
  home="$(resolve_contained_tt_home)"
  local fail=""

  # Provisioning must be best-effort here so the verification legs below are
  # what decides the outcome (a sub-step failure is a leg, not an abort).
  set +e
  provision_gitconfig "$home"
  copy_and_audit "$HOME/.pi"      "$home/.pi"      "$home/provision-audit.json" "~/.pi"
  copy_and_audit "$HOME/.hermes"  "$home/.hermes"  "$home/provision-audit.json" "~/.hermes"
  remove_ssh_dir "$home"

  # ── verification legs (fail-closed) ──
  if [ ! -d "$home" ]; then
    fail="${fail}missing-dir:${home};"
  fi
  if [ -d "$home" ]; then
    local gitcfg_fail
    gitcfg_fail="$(verify_gitconfig_identity "$home")" && true
    if [ "$gitcfg_fail" != "" ] || [ ! -f "$home/.gitconfig" ]; then
      fail="${fail}gitconfig:${gitcfg_fail:-missing};"
    fi
  else
    fail="${fail}gitconfig:no-home;"
  fi
  # Copy legs: a copy is a failure ONLY when the operator source exists but the
  # contained destination is absent (a genuine copy failure). If the operator
  # has no ~/.pi / ~/.hermes the base tool skips intentionally — not a leg.
  local copy_item src dst
  for copy_item in ".pi" ".hermes"; do
    src="${HOME}/${copy_item}"
    dst="${home}/${copy_item}"
    if [ -d "$src" ] && [ ! -d "$dst" ]; then
      fail="${fail}copy-missing:${copy_item};"
    fi
  done
  set -e

  if [ -n "$fail" ]; then
    echo "REASON: tt-home-unprovisioned" >&2
    echo "DETAILS: ${fail}" >&2
    log "FAIL: contained TT home NOT provisioned ($home)" >&2
    return 1
  fi
  log "OK: contained TT home provisioned at $home"
  return 0
}

# ── usage ────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
tt-provision-home — idempotently provisions TT_HOME directories.

Usage: tt-provision-home [--fail-closed] [--help]

Provisions:
  torture-test/var/home/          (real TT_HOME)
  torture-test/var/home-scripted/ (scripted TT_HOME)

Real TT_HOME gets:
  - .gitconfig with TT-specific identity settings
  - COPY of ~/.pi/ and ~/.hermes/ (audited for absolute paths)
  - NO .ssh directory

Scripted TT_HOME gets:
  - .gitconfig only (same settings)
  - NO .pi / .hermes copies

--fail-closed (E2.5): preflight mode for real-case campaigns. Resolves the
  contained real TT_HOME (from env/tt-env.sh — never the operator's
  ~/.tamandua), provisions it if absent, then FAILS CLOSED with the DISTINCT
  machine-parseable reason string 'tt-home-unprovisioned' (exit non-zero) if
  any spec-01 required leg cannot be established. Idempotent: repeated runs
  against a healthy home are no-ops (exit 0). Never touches the operator's
  ~/.tamandua or the 33xx daemon.

Idempotent: safe to run repeatedly — second run is a no-op.
Never mutates the caller's environment (spec 01 two-env rule).
EOF
}

# ── main ──────────────────────────────────────────────────────────────

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --fail-closed|-f) FAIL_CLOSED=1 ;;  # leading marker; handled below
  "")
    ;;
  *)
    echo "Unknown argument: $1" >&2
    usage >&2
    exit 2
    ;;
esac

# ── dispatch ──────────────────────────────────────────────────────────

if [ "${FAIL_CLOSED:-0}" = "1" ]; then
  fail_closed_real_home
  exit $?
fi


log "Starting TT_HOME provisioning"
log "  Real TT_HOME  : $REAL_TT_HOME"
log "  Scripted TT_HOME: $SCRIPTED_TT_HOME"
log "  Real HOME     : $REAL_HOME"

# ──────── real TT_HOME ────────────────────────────────────────────────

echo ""
log "── Real TT_HOME ($REAL_TT_HOME) ──"

provision_gitconfig "$REAL_TT_HOME"

# Copy pi config
copy_and_audit \
  "$REAL_HOME/.pi" \
  "$REAL_TT_HOME/.pi" \
  "$REAL_TT_HOME/provision-audit.json" \
  "~/.pi"

# Copy hermes config
copy_and_audit \
  "$REAL_HOME/.hermes" \
  "$REAL_TT_HOME/.hermes" \
  "$REAL_TT_HOME/provision-audit.json" \
  "~/.hermes"

# Remove .ssh if present (belt-and-suspenders)
remove_ssh_dir "$REAL_TT_HOME"

# ──────── scripted TT_HOME ────────────────────────────────────────────

echo ""
log "── Scripted TT_HOME ($SCRIPTED_TT_HOME) ──"

provision_gitconfig "$SCRIPTED_TT_HOME"

# No .pi / .hermes copies for scripted
# No .ssh either
remove_ssh_dir "$SCRIPTED_TT_HOME"

echo ""
log "Provisioning complete."
log "  Real TT_HOME    : $REAL_TT_HOME"
log "  Scripted TT_HOME: $SCRIPTED_TT_HOME"
log "  Audit file      : $REAL_TT_HOME/provision-audit.json"
