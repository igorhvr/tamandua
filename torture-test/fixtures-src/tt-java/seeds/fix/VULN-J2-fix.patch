+package com.tamandua.ledger;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Tests for ExportService.
+ *
+ * <p>These tests verify that the VULN-J2 fix properly prevents path
+ * traversal attacks in file export. The tests are added by the VULN-J2
+ * fix patch.</p>
+ */
+class ExportServiceTest {
+
+    private Path exportDir;
+    private Path testFile;
+
+    @BeforeEach
+    void setUp() throws IOException {
+        // Create the exports directory used by ExportService
+        exportDir = Path.of(System.getProperty("user.dir"), "exports");
+        Files.createDirectories(exportDir);
+        testFile = exportDir.resolve("test-export.jsonl");
+    }
+
+    @AfterEach
+    void tearDown() throws IOException {
+        // Clean up test files in exports directory
+        if (Files.exists(testFile)) {
+            Files.delete(testFile);
+        }
+    }
+
+    private List<LedgerEntry> sampleEntries() {
+        List<LedgerEntry> entries = new ArrayList<>();
+        entries.add(LedgerEntry.create(
+                LocalDate.of(2025, 1, 15), "Groceries",
+                new BigDecimal("100.50"), "food"));
+        entries.add(LedgerEntry.create(
+                LocalDate.of(2025, 1, 16), "Salary",
+                new BigDecimal("5000.00"), "income"));
+        return entries;
+    }
+
+    @Test
+    @DisplayName("export entries to a file in the allowed directory")
+    void exportToAllowedDirectory() throws IOException {
+        List<LedgerEntry> entries = sampleEntries();
+        String filename = testFile.toString();
+
+        assertDoesNotThrow(() -> ExportService.exportToFile(entries, filename),
+                "Export to allowed directory should not throw");
+
+        assertTrue(Files.exists(testFile), "Export file should exist");
+        String content = Files.readString(testFile);
+        assertTrue(content.contains("Groceries"));
+        assertTrue(content.contains("Salary"));
+    }
+
+    @Test
+    @DisplayName("export empty list creates file")
+    void exportEmptyList() throws IOException {
+        List<LedgerEntry> empty = List.of();
+        String filename = testFile.toString();
+
+        assertDoesNotThrow(() -> ExportService.exportToFile(empty, filename));
+        assertTrue(Files.exists(testFile));
+    }
+
+    @Test
+    @DisplayName("regression VULN-J2: path traversal is rejected")
+    void regressionVulnJ2PathTraversalRejected() {
+        List<LedgerEntry> entries = sampleEntries();
+
+        // Attempt to escape the exports directory via relative path traversal
+        String traversalPath = exportDir.resolve("../../../etc/passwd").toString();
+
+        SecurityException ex = assertThrows(SecurityException.class,
+                () -> ExportService.exportToFile(entries, traversalPath),
+                "VULN-J2: path traversal should be detected and rejected");
+
+        assertTrue(ex.getMessage().contains("Path traversal"),
+                "Exception message should mention 'Path traversal'");
+        assertTrue(ex.getMessage().contains("outside the allowed export directory"),
+                "Exception message should explain the constraint");
+    }
+
+    @Test
+    @DisplayName("regression VULN-J2: simple relative traversal with ../ is rejected")
+    void regressionVulnJ2RelativeTraversalRejected() {
+        List<LedgerEntry> entries = sampleEntries();
+
+        // Use a simple "../" relative path
+        String traversalPath = "../etc/critical-file";
+
+        SecurityException ex = assertThrows(SecurityException.class,
+                () -> ExportService.exportToFile(entries, traversalPath),
+                "VULN-J2: relative path traversal with '../' should be rejected");
+
+        assertTrue(ex.getMessage().contains("Path traversal"),
+                "Exception message should mention 'Path traversal'");
+    }
+
+    @Test
+    @DisplayName("null entries throws IllegalArgumentException")
+    void nullEntriesThrows() {
+        assertThrows(IllegalArgumentException.class,
+                () -> ExportService.exportToFile(null, testFile.toString()));
+    }
+
+    @Test
+    @DisplayName("null filename throws IllegalArgumentException")
+    void nullFilenameThrows() {
+        List<LedgerEntry> entries = sampleEntries();
+        assertThrows(IllegalArgumentException.class,
+                () -> ExportService.exportToFile(entries, null));
+    }
+}
