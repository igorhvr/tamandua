@@ -95,6 +95,46 @@ func (p *WorkerPool) Completed() int64 {
 	return p.completed.Load()
 }
 
+// worker is the goroutine that processes tasks from the task queue.
+func (p *WorkerPool) worker(id int) {
+	defer p.wg.Done()
+	for {
+		select {
+		case <-p.ctx.Done():
+			// Drain remaining tasks before exiting.
+			for {
+				select {
+				case task, ok := <-p.taskQueue:
+					if !ok {
+						return
+					}
+					p.running.Add(1)
+					result := p.executeTask(task)
+					p.running.Add(-1)
+					p.completed.Add(1)
+					p.resultQueue <- result
+				default:
+					return
+				}
+			}
+		case task, ok := <-p.taskQueue:
+			if !ok {
+				return
+			}
+			p.running.Add(1)
+			result := p.executeTask(task)
+			p.running.Add(-1)
+			p.completed.Add(1)
+			select {
+			case p.resultQueue <- result:
+			case <-p.ctx.Done():
+				// Keep trying to deliver until successful.
+				p.resultQueue <- result
+			}
+		}
+	}
+}
+
 // executeTask runs a single task and captures its result with timing.
 // It recovers from panics in the task function and converts them to
 // descriptive errors so that a panic never crashes a worker goroutine.
@@ -107,9 +147,9 @@ func (p *WorkerPool) executeTask(task Task) Result {
 		defer func() {
 			if r := recover(); r != nil {
 				err = &PanicError{
-					TaskID:   task.ID,
+					TaskID: task.ID,
 					TaskName: task.Name,
-					Panic:    r,
+					Panic:   r,
 				}
 			}
 		}()
