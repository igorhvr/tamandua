+package ttgo
+
+import (
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestBugG4NoDataRaceOnCompletedCounter(t *testing.T) {
+	t.Run("high-concurrency completed counter has no race", func(t *testing.T) {
+		p := NewPool(8, 200)
+		n := 200
+		for i := 0; i < n; i++ {
+			task := Task{
+				ID:   fmt.Sprintf("g4-race-%d", i),
+				Name: "g4-race",
+				Func: func() (any, error) {
+					time.Sleep(100 * time.Microsecond)
+					return "ok", nil
+				},
+			}
+			if err := p.Submit(task); err != nil {
+				t.Fatalf("Submit #%d returned error: %v", i, err)
+			}
+		}
+		p.Shutdown()
+		results := collectResults(p)
+		if len(results) != n {
+			t.Errorf("expected %d results, got %d", n, len(results))
+		}
+		if c := p.Completed(); c != int64(n) {
+			t.Errorf("expected Completed()=%d, got %d", n, c)
+		}
+	})
+	t.Run("sequential operation still works", func(t *testing.T) {
+		p := NewPool(1, 5)
+		for i := 0; i < 5; i++ {
+			_ = p.Submit(Task{ID: fmt.Sprintf("g4-seq-%d", i), Name: "seq", Func: func() (any, error) { return nil, nil }})
+		}
+		p.Shutdown()
+		_ = collectResults(p)
+	})
+}
