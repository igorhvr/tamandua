diff --git b/src/schedlib/conflict.py a/src/schedlib/conflict.py
index f1d07d1..e946a4c 100644
--- b/src/schedlib/conflict.py
+++ a/src/schedlib/conflict.py
@@ -80,14 +80,9 @@ def conflict_severity(a: Event, b: Event) -> ConflictSeverity:
     end = min(a.end, b.end)
     overlap_dur = end - start
 
-    # BUG-P2: CONTAINED check uses strict comparison (< >)
-    # instead of non-strict (<= >=).  Events with identical
-    # start/end bounds are no longer classified as CONTAINED
-    # and fall through to HARD.  A single-file revert of this
-    # alone does NOT restore green — the recurrence _advance
-    # bug in recurrence.py must also be fixed.
-    if (a.start < b.start and a.end > b.end) or (
-        b.start < a.start and b.end > a.end
+    # Contained: one event fully inside the other
+    if (a.start <= b.start and a.end >= b.end) or (
+        b.start <= a.start and b.end >= a.end
     ):
         return ConflictSeverity.CONTAINED
 
