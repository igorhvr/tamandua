+package ttgo
+
+import (
+	"fmt"
+	"testing"
+	"time"
+)
+
+// TestBugG2ShutdownResultsNotDropped verifies the BUG-G2 fix:
+// 1. ShutdownErr() must return ErrPoolShutdown directly (not wrapped).
+// 2. Tasks submitted before shutdown must produce results — no silent drops.
+func TestBugG2ShutdownResultsNotDropped(t *testing.T) {
+	t.Run("all tasks produce results during shutdown", func(t *testing.T) {
+		p := NewPool(2, 10)
+
+		n := 10
+		for i := 0; i < n; i++ {
+			task := Task{
+				ID:   fmt.Sprintf("g2-task-%d", i),
+				Name: "g2-shutdown",
+				Func: func() (any, error) {
+					time.Sleep(5 * time.Millisecond)
+					return "ok", nil
+				},
+			}
+			if err := p.Submit(task); err != nil {
+				t.Fatalf("Submit #%d returned error: %v", i, err)
+			}
+		}
+
+		p.Shutdown()
+		results := collectResults(p)
+
+		if len(results) != n {
+			t.Errorf("expected %d results, got %d — tasks submitted before shutdown had results dropped", n, len(results))
+		}
+		if c := p.Completed(); c != int64(n) {
+			t.Errorf("expected Completed()=%d, got %d", n, c)
+		}
+	})
+
+	t.Run("ShutdownErr returns sentinel directly", func(t *testing.T) {
+		p := NewPool(1, 1)
+
+		task := Task{
+			ID:   "g2-sentinel",
+			Name: "sentinel check",
+			Func: func() (any, error) {
+				return "ok", nil
+			},
+		}
+		_ = p.Submit(task)
+		p.Shutdown()
+		_ = collectResults(p)
+
+		if p.ShutdownErr() != ErrPoolShutdown {
+			t.Errorf("expected ShutdownErr() = ErrPoolShutdown, got %v", p.ShutdownErr())
+		}
+	})
+
+	t.Run("normal operation unaffected", func(t *testing.T) {
+		p := NewPool(3, 10)
+
+		for i := 0; i < 5; i++ {
+			task := Task{
+				ID:   fmt.Sprintf("g2-normal-%d", i),
+				Name: "normal",
+				Func: func() (any, error) {
+					return i, nil
+				},
+			}
+			if err := p.Submit(task); err != nil {
+				t.Fatalf("Submit #%d returned error: %v", i, err)
+			}
+		}
+
+		p.Shutdown()
+		if results := collectResults(p); len(results) != 5 {
+			t.Errorf("normal operation: expected 5 results, got %d", len(results))
+		}
+	})
+}
