+package ttgo
+
+import (
+	"fmt"
+	"testing"
+)
+
+// TestBugG1SubmittedCounterMatchesResults verifies the BUG-G1 fix:
+// the submitted counter must match the actual number of Results collected.
+// With the bug, rejected tasks still increment the submitted counter,
+// causing a mismatch.
+func TestBugG1SubmittedCounterMatchesResults(t *testing.T) {
+	t.Run("rejected submits do not inflate the counter", func(t *testing.T) {
+		p := NewPool(1, 1)
+
+		task := Task{
+			ID:   "g1-before",
+			Name: "before shutdown",
+			Func: func() (any, error) {
+				return "ok", nil
+			},
+		}
+		if err := p.Submit(task); err != nil {
+			t.Fatalf("Submit before shutdown: %v", err)
+		}
+
+		p.Shutdown()
+		_ = collectResults(p)
+
+		submittedBefore := p.Submitted()
+
+		lateTask := Task{
+			ID:   "g1-after",
+			Name: "after shutdown",
+			Func: func() (any, error) {
+				return "late", nil
+			},
+		}
+		err := p.Submit(lateTask)
+		if err != ErrPoolShutdown {
+			t.Fatalf("expected ErrPoolShutdown for late submit, got %v", err)
+		}
+
+		submittedAfter := p.Submitted()
+		if submittedAfter != submittedBefore {
+			t.Errorf("rejected submit incremented the counter: before=%d, after=%d (off by %d)",
+				submittedBefore, submittedAfter, submittedAfter-submittedBefore)
+		}
+	})
+
+	t.Run("submitted matches results without concurrent shutdown", func(t *testing.T) {
+		p := NewPool(2, 20)
+		n := 10
+
+		for i := 0; i < n; i++ {
+			task := Task{
+				ID:   fmt.Sprintf("g1-basic-%d", i),
+				Name: "g1-basic",
+				Func: func() (any, error) {
+					return "ok", nil
+				},
+			}
+			if err := p.Submit(task); err != nil {
+				t.Fatalf("Submit #%d returned error: %v", i, err)
+			}
+		}
+
+		p.Shutdown()
+		results := collectResults(p)
+
+		if submitted := p.Submitted(); submitted != int64(len(results)) {
+			t.Errorf("Submitted()=%d does not match len(results)=%d", submitted, len(results))
+		}
+		if submitted := p.Submitted(); submitted != int64(n) {
+			t.Errorf("Submitted()=%d, expected %d", submitted, n)
+		}
+		if completed := p.Completed(); completed != int64(n) {
+			t.Errorf("Completed()=%d, expected %d", completed, n)
+		}
+	})
+}
