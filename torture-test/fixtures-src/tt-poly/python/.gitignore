# The .venv is NOT committed (spec 02). Bootstrap creates it.
.venv/

# Python bytecode is deliberately NOT gitignored — it serves as
# the seeded/deterministic junk probe for the tt-poly python/ subtree
# (spec 02): a synthetic marker is planted at provisioning and must stay
# untracked + byte-identical. Interpreter-written in-tree caches (linux)
# are tolerated extra files. __pycache__/ is intentionally left untracked
# (not ignored).
#
# .pytest_cache/ and .flaky_counter are also deliberately NOT
# gitignored — they serve as regenerated junk probes.

# Setuptools build artifacts
*.egg-info/
dist/
build/
