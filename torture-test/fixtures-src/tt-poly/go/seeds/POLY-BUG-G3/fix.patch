+package ttgo
+
+import (
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestBugG3ShutdownDrainsAllTasks(t *testing.T) {
+	t.Run("many queued tasks all complete after shutdown", func(t *testing.T) {
+		p := NewPool(2, 100)
+		done := make(chan []Result, 1)
+		go func() { done <- collectResults(p) }()
+		n := 50
+		for i := 0; i < n; i++ {
+			task := Task{
+				ID:   fmt.Sprintf("g3-drain-%d", i),
+				Name: "g3-drain",
+				Func: func() (any, error) {
+					time.Sleep(1 * time.Millisecond)
+					return "ok", nil
+				},
+			}
+			if err := p.Submit(task); err != nil {
+				t.Fatalf("Submit #%d returned error: %v", i, err)
+			}
+		}
+		p.Shutdown()
+		select {
+		case results := <-done:
+			if len(results) != n {
+				t.Errorf("expected %d results, got %d", n, len(results))
+			}
+			if c := p.Completed(); c != int64(n) {
+				t.Errorf("expected Completed()=%d, got %d", n, c)
+			}
+		case <-time.After(15 * time.Second):
+			t.Fatal("pool hung")
+		}
+	})
+	t.Run("shutdown with empty queue still works", func(t *testing.T) {
+		p := NewPool(2, 10)
+		task := Task{ID: "g3-single", Name: "single", Func: func() (any, error) { return "done", nil }}
+		if err := p.Submit(task); err != nil {
+			t.Fatalf("Submit returned error: %v", err)
+		}
+		p.Shutdown()
+		results := collectResults(p)
+		if len(results) != 1 {
+			t.Errorf("expected 1 result, got %d", len(results))
+		}
+		if results[0].Value != "done" {
+			t.Errorf("expected Value='done', got %v", results[0].Value)
+		}
+	})
+}
