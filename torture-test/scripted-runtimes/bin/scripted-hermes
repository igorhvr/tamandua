#!/usr/bin/env bash
# scripted-hermes — wrapper for the scripted hermes runtime.
#
# Resolves the runtime .mjs file and execs it via an absolute node path.
# The daemon's PATH is not guaranteed, so we resolve node portably and
# fail closed:
#   TT_NODE_BIN (explicit override) -> `command -v node` on the shim's
#   own PATH -> a clear error (never a shell "command not found").
#
# Override: set TT_NODE_BIN to a different node binary.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# ── Node resolution (portable, fail-closed) ──────────────────────────
NODE_BIN="${TT_NODE_BIN:-}"
if [ -z "$NODE_BIN" ]; then
  NODE_BIN="$(command -v node 2>/dev/null || true)"
fi

if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
  echo "scripted-hermes: node binary not found at $NODE_BIN" >&2
  echo "Set TT_NODE_BIN to the absolute path of the node binary." >&2
  exit 1
fi

exec "$NODE_BIN" "$RUNTIME_DIR/runtime-hermes.mjs" "$@"
