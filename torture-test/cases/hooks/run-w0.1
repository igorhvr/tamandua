#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$repo_root"
# The controller intentionally gives every scripted/local hook the 53xx
# daemon environment. The repository test suite owns isolated state and random
# listener ports, so remove only that routing while retaining the contained
# HOME and deterministic harness binaries as zero-token backstops.
unset TT_ROOT TT_SCRIPTED_HOME HERMES_HOME \
  TAMANDUA_STATE_DIR TAMANDUA_DB_PATH \
  TAMANDUA_CONTROL_PORT TAMANDUA_MCP_PORT TAMANDUA_DASHBOARD_PORT \
  TAMANDUA_SCRIPTED_BEHAVIORS TAMANDUA_SCRIPTED_STATE \
  TAMANDUA_TEST_GUARD NODE_TEST_CONTEXT

# The outer controller HOME is intentionally contained and starts without the
# operator's Git or pi configuration. Nested unit tests create commits and a
# few workflow-install tests require settings.json even though every harness
# binary remains /bin/false. Seed only deterministic, non-secret test values.
mkdir -p "$HOME/.pi/agent"
printf '%s\n' '{"defaultProvider":"stub","defaultModel":"stub"}' \
  > "$HOME/.pi/agent/settings.json"
export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"
export GIT_CONFIG_NOSYSTEM=1
git config --global user.name "Tamandua Tier-0"
git config --global user.email "tier0@tetradactyla.invalid"
git config --global commit.gpgsign false
npm run build
npm test
