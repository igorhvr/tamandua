{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamandua.org/torture-test/case.schema.json",
  "title": "Tamandua torture-test case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "wave",
    "workflow",
    "fixture",
    "harness",
    "task",
    "context",
    "caps",
    "requires",
    "boundary_files",
    "forbidden",
    "oracles",
    "gates",
    "chaos",
    "shed_ok",
    "mandatory",
    "class"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "wave": {
      "type": "integer",
      "minimum": 0
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "fixture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$"
    },
    "seed": {
      "description": "OPTIONAL immutable seed git ref the working fixture clone should land on. Holds a ref NAME (e.g. 'BUG-P1' or 'seed/storm' or 'broken-tests'), never a 'refs/...' prefix: the provisioning stage resolves a bare name by checking it out directly as given, and resolves a branch-style name (no 'seed/' prefix) onto the working clone's current branch. A seed ref reproduces the case's exact starting tree (green base + exactly one seeded defect) per spec 02-fixture-projects.md green-base + seed-ref discipline. Absent or null => provision from the fixture's green baseline.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9._/-]*[A-Za-z0-9])?$"
        }
      ]
    },
    "harness": {
      "enum": ["pi", "hermes", "scripted-pi", "scripted-hermes", "local"]
    },
    "task": {
      "$ref": "#/$defs/relativePath"
    },
    "context": {
      "type": "object",
      "properties": {
        "execution_mode": {
          "enum": ["real", "scripted"]
        }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "wall_min"],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_min": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "requires": {
      "type": "object",
      "description": "CANONICAL HOST-ADAPTATION CONTRACT (predicates). Every entry is evaluated against the host capability profile emitted by W0.0 (tt-verify-environment) as host-profile.json. A predicate that the host cannot satisfy gates the case to outcome NOT_RUN (predicate) with evidence — it is never silently skipped and never a failure. See tamandua-torture-test-spec/01-environment-and-isolation.md and oracles/CONTRACT.md (host-adaptation note) for the single authoritative contract; every representation here MUST agree with the profile's real key names or the case drifts.",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "anyOf": [
            { "enum": ["linux", "darwin", "other"] },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["linux", "darwin", "other"]
              }
            }
          ]
        },
        "toolchains": {
          "type": "array",
          "description": "CANONICAL CONTRACT: an ARRAY of toolchain names; each name is SATISFIED iff the host profile records `toolchains.<name>.present === true` (a Boolean leaf) using the profile's REAL key names (python3, node, go, rust/cargo, java+maven). buildPassed/testPassed (W0.0's --fast probes leave them null) are NOT required for a predicate to be satisfied. A missing/inactive toolchain gates the case NOT_RUN (predicate) with expected true / observed evidence — never silently skipped.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["node", "python3", "go", "rust/cargo", "java+maven"]
          }
        },
        "capabilities": {
          "type": "array",
          "description": "CANONICAL CONTRACT: harness capabilities `pi` and `hermes` map to harness PRESENCE recorded in the host profile (harness.<name>.present Boolean leaf; spec 01 makes pi/hermes operator-preconfigured, so W0.0 RECORDS mechanical presence, never installs). Any other capability name is resolved against the profile per the same Boolean-leaf rule. An honestly-present capability must NOT be gated; an honestly-absent capability gates the case NOT_RUN (predicate) with expected/observed evidence.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "containment": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["systemd-user-scope", "procfs"]
          }
        },
        "node_min": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boundary_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "forbidden": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "oracles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "probe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "probes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "chaos": {
      "anyOf": [
        { "type": "null" },
        { "type": "object" }
      ]
    },
    "shed_ok": {
      "type": "boolean"
    },
    "mandatory": {
      "type": "boolean"
    },
    "class": {
      "enum": ["verification", "characterization", "exploratory"]
    },
    "spec_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "production_duration_floor_ms": {
      "type": "integer",
      "minimum": 1
    },
    "expected_fast_failure": {
      "type": "boolean"
    },
    "reset": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/hook" }
      ]
    },
    "command": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/hook" }
      ]
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "cwd"],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "cwd": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
